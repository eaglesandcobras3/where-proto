---
import BaseLayout from "./BaseLayout.astro";
import { currentUser } from "../data/catalog";
import { href } from "../lib/href";
import { VIEW_PUBLIC_LABEL } from "../lib/dashboard-v1";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const owner = currentUser();
---

<BaseLayout title={title} description={description} bare dashboardPreview>
  <div class="portal">
    <aside class="sidebar">
      <div class="sidebar__brand">
        <a class="logo" href={href("/")}>WhereTo<span>30A</span></a>
        <span class="badge">Merchant</span>
      </div>
      <nav class="nav" aria-label="Business management">
        <a class="nav__link active" href={href("/dashboard")}>Your businesses</a>
        <a class="nav__link" href={href("/add-business")}>Add a business</a>
      </nav>
    </aside>

    <div class="shell">
      <header class="topbar">
        <p class="topbar__title">Your businesses</p>
        <div class="topbar__actions">
          <a class="view-btn" href={href("/")} data-dash="legacy">View public site</a>
          <a class="view-btn" href={href("/")} data-dash="v1">{VIEW_PUBLIC_LABEL}</a>
          <div class="user">
            <div class="user__copy">
              <strong>{owner?.name ?? "Owner"}</strong>
              <span data-dash="legacy">Business owner</span>
              <span data-dash="v1">Verified owner</span>
            </div>
            <span class="user__avatar" aria-hidden="true">{(owner?.name ?? "O").charAt(0)}</span>
          </div>
        </div>
      </header>
      <div class="content">
        <slot />
      </div>
      <footer class="portal-foot">
        Business dashboard
        ·
        <a href={href("/")} data-dash="legacy">View public site</a>
        <a href={href("/")} data-dash="v1">{VIEW_PUBLIC_LABEL}</a>
      </footer>
    </div>
  </div>
</BaseLayout>

<style>
  :global(body.bare-shell) {
    background: var(--brand-sand);
  }
  :global(body.bare-shell main) {
    margin: 0;
    padding: 0;
    max-width: none;
  }
  .portal {
    display: grid;
    min-height: 100vh;
    background: var(--brand-sand);
    color: var(--brand-ink);
  }
  .sidebar {
    display: none;
  }
  .shell {
    min-width: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100vh;
  }
  .sidebar__brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 4rem;
    padding: 0 1.25rem;
  }
  .logo {
    font-family: var(--font-display);
    font-weight: var(--font-weight-8);
    color: var(--brand-deep);
    text-decoration: none;
  }
  .logo span {
    color: var(--brand-teal);
  }
  .badge {
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
    background: #e0f2f1;
    color: var(--brand-teal);
    font-size: 0.5625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .nav {
    display: grid;
    gap: 0.2rem;
    padding: 0.5rem 0.75rem;
  }
  .nav__link {
    display: flex;
    align-items: center;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-2);
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-6);
    text-decoration: none;
  }
  .nav__link:hover {
    background: #eff4ff;
    color: var(--brand-deep);
    text-decoration: none;
  }
  .nav__link.active {
    background: var(--brand-deep);
    color: white;
  }
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    min-height: 4rem;
    padding: 0.65rem 1rem;
    background: rgba(255, 255, 255, 0.95);
    border-bottom: 1px solid var(--brand-line);
    backdrop-filter: blur(10px);
  }
  .topbar__title {
    margin: 0;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .topbar__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .view-btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    background: #f1f5f9;
    color: var(--brand-deep);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    text-decoration: none;
  }
  .user {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .user__copy {
    display: none;
    text-align: right;
  }
  .user__copy strong {
    display: block;
    font-size: var(--font-size-0);
    color: var(--brand-deep);
  }
  .user__copy span {
    font-size: 0.625rem;
    color: var(--brand-ink-soft);
  }
  .user__avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--brand-deep);
    color: white;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
  }
  .content {
    padding: 1.25rem 1rem 2rem;
  }
  .portal-foot {
    padding: 0.75rem 1rem 1.25rem;
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  .portal-foot a {
    color: var(--brand-teal);
    font-weight: var(--font-weight-7);
  }
  @media (min-width: 960px) {
    .portal {
      grid-template-columns: 17.5rem minmax(0, 1fr);
    }
    .sidebar {
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      height: 100vh;
      background: white;
      border-right: 1px solid var(--brand-line);
    }
    .topbar {
      padding-inline: 1.5rem;
    }
    .content {
      padding: 1.5rem 1.5rem 2.5rem;
    }
    .user__copy {
      display: block;
    }
  }
</style>
