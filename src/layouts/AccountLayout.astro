---
import BaseLayout from "./BaseLayout.astro";
import AccountNav from "../components/AccountNav.astro";
import { currentUser, favorites, posts, questions } from "../data/catalog";

interface Props {
  title: string;
  active: "favorites" | "questions" | "posts" | "settings";
  description?: string;
}

const { title, active, description } = Astro.props;
const user = currentUser();
const stats = [
  { label: "Saved", value: String(favorites.filter((item) => item.userSlug === user?.slug).length) },
  { label: "Questions", value: String(questions.filter((item) => item.authorUserSlug === user?.slug).length) },
  { label: "Posts", value: String(posts.filter((item) => item.authorUserSlug === user?.slug).length) },
];
const memberSince = user?.memberSince
  ? new Date(`${user.memberSince}T12:00:00`).toLocaleDateString("en-US", { month: "long", year: "numeric" })
  : null;
const roleLabel = user?.role === "business-owner" ? "Business owner" : user?.role === "admin" ? "Admin" : user?.role === "visitor" ? "Visitor" : "Local";
---

<BaseLayout title={title} description={description}>
  <div class="container section">
    <section class="head">
      <div class="avatar img-placeholder" aria-hidden="true">{user?.name.charAt(0) ?? "M"}</div>
      <div class="identity">
        <h1>{user?.name ?? "Member"}</h1>
        <p class="meta">
          {roleLabel}
          {memberSince && <> · Member Since {memberSince}</>}
        </p>
        <div class="stats">
          {
            stats.map((stat) => (
              <div class="stat">
                <span class="value">{stat.value}</span>
                <span class="label">{stat.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>
    <AccountNav active={active} />
    <slot />
  </div>
</BaseLayout>

<style>
  .head {
    display: flex;
    gap: var(--size-5);
    align-items: center;
    margin-bottom: var(--size-6);
  }
  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    flex-shrink: 0;
    font-size: var(--font-size-7);
  }
  .identity h1 {
    margin: 0 0 var(--size-1);
    font-size: var(--font-size-6);
  }
  .meta {
    margin: 0;
    color: var(--brand-ink-soft);
  }
  .stats {
    display: flex;
    gap: var(--size-5);
    margin-top: var(--size-3);
  }
  .stat {
    display: flex;
    flex-direction: column;
  }
  .stat .value {
    font-size: var(--font-size-4);
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
    line-height: 1.1;
  }
  .stat .label {
    font-size: var(--font-size-0);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-ink-soft);
  }
  @media (max-width: 640px) {
    .head {
      align-items: flex-start;
    }
  }
</style>
