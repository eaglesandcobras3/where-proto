---
import BaseLayout from "./BaseLayout.astro";
import AccountNav from "../components/AccountNav.astro";
import BusinessesPanel from "../components/islands/BusinessesPanel.svelte";
import {
  businesses,
  currentUser,
  favorites,
  posts,
  questions,
  towns,
} from "../data/catalog";
import { href } from "../lib/href";
import { formatDate, roleLabel, userHandle } from "../lib/labels";

interface Props {
  title: string;
  active: "favorites" | "questions" | "posts" | "settings";
  description?: string;
}

const { title, active, description } = Astro.props;
const user = currentUser();
const savedCount = favorites.filter((item) => item.userSlug === user?.slug).length;
const questionCount = questions.filter((item) => item.authorUserSlug === user?.slug).length;
const postCount = posts.filter((item) => item.authorUserSlug === user?.slug).length;
const stats = [
  { label: "Saved", value: String(savedCount) },
  { label: "Questions", value: String(questionCount) },
  { label: "Posts", value: String(postCount) },
];
const memberSince = user?.memberSince ? formatDate(user.memberSince) : null;
const personRole = user ? roleLabel(user.role) : "Local";
const handle = user ? userHandle(user.slug) : null;

const favoriteTowns = favorites
  .filter((item) => item.userSlug === user?.slug && item.type === "town")
  .map((item) => towns.find((town) => town.slug === item.slug))
  .filter(Boolean);

const corridorTowns = (favoriteTowns.length > 0 ? favoriteTowns : towns.slice(0, 4)).map((town) => ({
  slug: town!.slug,
  name: town!.name,
}));

const seedBusinesses = businesses.map((biz) => ({
  slug: biz.slug,
  name: biz.name,
  townSlug: biz.townSlug,
  summary: biz.summary,
  ownerUserSlug: biz.ownerUserSlug,
  entityKind: biz.entityKind ?? (biz.isStay ? ("stay" as const) : ("business" as const)),
  isStay: biz.isStay,
}));
const townNames = Object.fromEntries(towns.map((town) => [town.slug, town.name]));
---

<BaseLayout title={title} description={description ?? user?.bio} account>
  <div class="account-page">
    <section class="hero">
      <div class="container hero__inner">
        <div class="identity">
          <div class="avatar-wrap">
            <div class="avatar img-placeholder" aria-hidden="true">{user?.slug.charAt(0) ?? "M"}</div>
            <span class="verified" title="Verified community member" aria-label="Verified community member">✓</span>
          </div>
          <div>
            <h1>{handle ?? "Member"}</h1>
            <p class="meta">
              <span class="pill">{personRole}</span>
              {memberSince && <span class="pill">Member since {memberSince}</span>}
            </p>
            <p class="bio">{user?.bio}</p>
            <ul class="facts">
              <li>
                <a href={href(`/u/${user?.slug}`)}>Public profile</a>
              </li>
            </ul>
          </div>
        </div>
        <div class="stats">
          {
            stats.map((stat) => (
              <div class="stat">
                <span class="value">{stat.value}</span>
                <span class="label">{stat.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <div class="tabs-bar">
      <div class="container tabs-bar__inner">
        <AccountNav
          active={active}
          savedCount={savedCount}
          questionCount={questionCount}
          postCount={postCount}
        />
        <p class="privacy">
          <strong>Verified community member</strong>
        </p>
      </div>
    </div>

    <div class="container layout">
      <div class="main">
        <slot />
      </div>
      <aside class="rail">
        <BusinessesPanel
          seedBusinesses={seedBusinesses}
          townNames={townNames}
          merchantsHref={href("/merchants")}
          addHref={href("/add-business")}
          dashboardRoot={href("/dashboard").replace(/\/$/, "")}
          variant="card"
          client:load
        />

        <section class="widget">
          <p class="widget__label">Contributor</p>
          <p class="muted">Verified community member. Questions, answers, comments, and posts show your handle.</p>
        </section>

        <section class="widget">
          <p class="widget__label">Favorite Towns</p>
          <ul class="towns">
            {
              corridorTowns.map((town) => (
                <li>
                  <a href={href(`/town/${town.slug}`)}>{town.name}</a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="widget help">
          <p class="widget__label">Need a hand?</p>
          <p class="muted">Account help, listing claims, or contributor badges.</p>
          <a href={href("/ask")}>Contact Local Concierge →</a>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .account-page {
    background: var(--brand-sand);
    color: var(--brand-ink);
  }
  .hero {
    background: var(--brand-deep);
    color: white;
    padding: var(--size-7) 0 var(--size-6);
  }
  .hero__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--size-5);
    align-items: center;
  }
  .identity {
    display: flex;
    gap: var(--size-4);
    align-items: flex-start;
    min-width: min(100%, 28rem);
  }
  .avatar-wrap {
    position: relative;
    flex-shrink: 0;
  }
  .avatar {
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 50%;
    font-size: var(--font-size-6);
    background: var(--brand-teal);
    color: white;
  }
  .verified {
    position: absolute;
    right: 0.1rem;
    bottom: 0.1rem;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: #22c55e;
    color: white;
    font-size: 0.7rem;
    font-weight: var(--font-weight-8);
    display: grid;
    place-items: center;
    border: 2px solid var(--brand-deep);
  }
  .identity h1 {
    margin: 0 0 0.2rem;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: white;
  }
  .meta {
    margin: 0 0 0.65rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 1.6rem;
    padding: 0.15rem 0.65rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.06);
    font-size: var(--font-size-0);
    color: #e2e8f0;
  }
  .bio {
    margin: 0 0 0.75rem;
    max-width: 36rem;
    color: #cbd5e1;
    font-size: var(--font-size-1);
  }
  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    font-size: var(--font-size-1);
    color: #94a3b8;
  }
  .facts a {
    color: #85f6e5;
  }
  .stats {
    display: flex;
    gap: 0.75rem;
  }
  .stat {
    min-width: 5.5rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-3);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }
  .stat .value {
    display: block;
    font-family: var(--font-display);
    font-size: var(--font-size-4);
    font-weight: var(--font-weight-7);
    color: white;
    line-height: 1.1;
  }
  .stat .label {
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #94a3b8;
  }
  .tabs-bar {
    background: white;
    border-bottom: 1px solid var(--brand-line);
  }
  .tabs-bar__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--size-3);
    align-items: center;
  }
  .privacy {
    margin: 0;
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  .privacy strong {
    color: var(--brand-teal);
    font-weight: var(--font-weight-7);
  }
  .layout {
    display: grid;
    gap: var(--size-5);
    padding-block: var(--size-6) var(--size-10);
    align-items: start;
  }
  .main {
    min-width: 0;
  }
  .rail {
    display: none;
    gap: var(--size-4);
  }
  .widget {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-card);
    padding: var(--size-4);
  }
  .widget__label {
    margin: 0 0 var(--size-3);
    font-family: var(--font-display);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-8);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .muted {
    margin: 0 0 var(--size-3);
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .widget a {
    color: var(--brand-teal);
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-6);
  }
  .help a {
    color: var(--brand-teal);
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-6);
  }
  .towns {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }
  .towns li {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    align-items: center;
    font-size: var(--font-size-1);
  }
  .towns a {
    color: var(--brand-ink);
    font-weight: var(--font-weight-6);
  }
  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 17rem;
    }
    .rail {
      display: grid;
    }
  }
</style>
