---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ExploreFilterBar from "../components/islands/ExploreFilterBar.svelte";
import SearchFilterBar from "../components/islands/SearchFilterBar.svelte";
import EventsFilterBar from "../components/islands/EventsFilterBar.svelte";
import AuthModal from "../components/islands/AuthModal.svelte";
import ProtoPersonaSwitch from "../components/islands/ProtoPersonaSwitch.svelte";
import { allLeaves, categories, towns } from "../data/catalog";
import { absHref, href } from "../lib/href";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/grids.css";
import "@awesome.me/webawesome/dist/styles/webawesome.css";

interface Props {
  title: string;
  description?: string;
  active?: string;
  noindex?: boolean;
  canonicalPath?: string;
  showBrowse?: boolean;
  /** Businesses/search chrome — separate from explore */
  showSearch?: boolean;
  /** Stays chrome — same shell as search, Guests facet */
  showStays?: boolean;
  /** Events chrome — search + date range expand/collapse */
  showEvents?: boolean;
  showGuides?: boolean;
  showAsk?: boolean;
  browseTown?: string;
  browseCategory?: string;
  browseExpanded?: boolean;
  /** Which explore popover opens when the bar expands */
  browseInitialPanel?: "town" | "category" | "";
  searchTown?: string;
  searchCategory?: string;
  searchQuery?: string;
  staysTown?: string;
  staysGuests?: string;
  staysQuery?: string;
  eventsTown?: string;
  eventsFrom?: string;
  eventsTo?: string;
  eventsQuery?: string;
  guidesTown?: string;
  guidesCategory?: string;
  guidesQuery?: string;
  askTown?: string;
  askTopic?: string;
  askQuery?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Skip site header/footer (merchant portal shell) */
  bare?: boolean;
}

const {
  title,
  description = "Your local guide to 30A and Florida's Emerald Coast. Curated listings, town guides, and hand-picked local favorites.",
  active = "",
  noindex,
  canonicalPath,
  showBrowse = false,
  showSearch = false,
  showStays = false,
  showEvents = false,
  showGuides = false,
  showAsk = false,
  browseTown,
  browseCategory,
  browseExpanded = false,
  browseInitialPanel = "category",
  searchTown = "",
  searchCategory = "",
  searchQuery = "",
  staysTown = "",
  staysGuests = "",
  staysQuery = "",
  eventsTown = "",
  eventsFrom = "",
  eventsTo = "",
  eventsQuery = "",
  guidesTown = "",
  guidesCategory = "",
  guidesQuery = "",
  askTown = "",
  askTopic = "",
  askQuery = "",
  jsonLd,
  bare = false,
} = Astro.props;

const stayGuestOptions = [
  { slug: "2", name: "Sleeps 2+" },
  { slug: "4", name: "Sleeps 4+" },
  { slug: "6", name: "Sleeps 6+" },
  { slug: "8", name: "Sleeps 8+" },
];
const askTopicOptions = [
  { slug: "parking", name: "Parking" },
  { slug: "dining", name: "Dining" },
  { slug: "family", name: "Family" },
  { slug: "getting-around", name: "Getting around" },
];

// Pages pass display names; the explore bar works in slugs
const matches = (item: { slug: string; name: string }, label?: string) =>
  Boolean(label) && (item.name === label || item.slug === label);
const browseTownSlug = towns.find((item) => matches(item, browseTown))?.slug ?? "";
const browseLeaf = allLeaves().find((item) => matches(item, browseCategory));
const browseGroupSlug =
  browseLeaf?.groupSlug ?? categories.find((item) => matches(item, browseCategory))?.slug ?? "";
const exploreTowns = towns.map(({ slug, name }) => ({ slug, name }));
const exploreCategories = categories.map(({ slug, name, leaves }) => ({
  slug,
  name,
  leaves: leaves.map((leaf) => ({ slug: leaf.slug, name: leaf.name })),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | WhereTo30A</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonicalPath && <link rel="canonical" href={absHref(canonicalPath)} />}
    {!canonicalPath && <link rel="canonical" href={absHref(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/")} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      try {
        var p = localStorage.getItem("w30a:persona");
        if (p === "guest" || p === "visitor" || p === "employer" || p === "town-manager") {
          document.documentElement.dataset.persona = p;
        } else {
          document.documentElement.dataset.persona = "guest";
        }
      } catch (e) {
        document.documentElement.dataset.persona = "guest";
      }
    </script>
  </head>
  <body class:list={[bare && "bare-shell"]}>
    {!bare && <Header active={active} />}
    {
      !bare && showBrowse && (
        <ExploreFilterBar
          towns={exploreTowns}
          categories={exploreCategories}
          initialTown={browseTownSlug}
          initialGroup={browseGroupSlug}
          initialLeaf={browseLeaf?.slug ?? ""}
          categoryLabel={browseCategory}
          expanded={browseExpanded}
          initialPanel={browseInitialPanel}
          base={import.meta.env.BASE_URL}
          client:load
        />
      )
    }
    {
      !bare && showSearch && (
        <SearchFilterBar
          towns={exploreTowns}
          categories={[
            ...categories.map(({ slug, name }) => ({ slug, name })),
            ...allLeaves().map((item) => ({ slug: item.slug, name: `${item.groupName} / ${item.name}` })),
          ]}
          initialTown={searchTown}
          initialCategory={searchCategory}
          initialQuery={searchQuery}
          client:load
        />
      )
    }
    {
      !bare && showStays && (
        <SearchFilterBar
          towns={exploreTowns}
          categories={stayGuestOptions}
          initialTown={staysTown}
          initialCategory={staysGuests}
          initialQuery={staysQuery}
          eventName="w30a:stays-filters"
          facetParam="guests"
          facetLabel="Guests"
          facetEmpty="Any guests"
          facetCollapsedEmpty="Any guests"
          keywordsPlaceholder="Town, sleeps, or partner..."
          searchAriaLabel="Search stays"
          client:load
        />
      )
    }
    {
      !bare && showEvents && (
        <EventsFilterBar
          towns={exploreTowns}
          initialTown={eventsTown}
          initialFrom={eventsFrom}
          initialTo={eventsTo}
          initialQuery={eventsQuery}
          client:load
        />
      )
    }
    {
      !bare && showGuides && (
        <SearchFilterBar
          towns={exploreTowns}
          categories={categories.map(({ slug, name }) => ({ slug, name }))}
          initialTown={guidesTown}
          initialCategory={guidesCategory}
          initialQuery={guidesQuery}
          eventName="w30a:guides-filters"
          facetParam="category"
          facetLabel="Topic"
          facetEmpty="Any topic"
          facetCollapsedEmpty="Any topic"
          keywordsPlaceholder="Guide title or keyword..."
          searchAriaLabel="Search guides"
          client:load
        />
      )
    }
    {
      !bare && showAsk && (
        <SearchFilterBar
          towns={exploreTowns}
          categories={askTopicOptions}
          initialTown={askTown}
          initialCategory={askTopic}
          initialQuery={askQuery}
          eventName="w30a:ask-filters"
          facetParam="topic"
          facetLabel="Topic"
          facetEmpty="Any topic"
          facetCollapsedEmpty="Any topic"
          keywordsPlaceholder="Question or keyword..."
          searchAriaLabel="Search questions"
          client:load
        />
      )
    }
    <main>
      <slot />
    </main>
    {!bare && <Footer />}
    <AuthModal
      homeHref={href("/")}
      legalTermsHref={href("/legal/terms")}
      legalPrivacyHref={href("/legal/privacy")}
      client:load
    />
    <ProtoPersonaSwitch client:load />
  </body>
</html>

<script>
  import "@awesome.me/webawesome/dist/components/button/button.js";
  import "@awesome.me/webawesome/dist/components/dialog/dialog.js";
  import "@awesome.me/webawesome/dist/components/input/input.js";
  import "@awesome.me/webawesome/dist/components/option/option.js";
  import "@awesome.me/webawesome/dist/components/select/select.js";
  import "@awesome.me/webawesome/dist/components/switch/switch.js";
  import "@awesome.me/webawesome/dist/components/textarea/textarea.js";
</script>
