---
import BaseLayout from "./BaseLayout.astro";
import type { Crumb } from "../lib/crumbs";

interface Props {
  title: string;
  description?: string;
  active?: string;
  crumbs: Crumb[];
  /** Detail pages default off; list/town hubs pass true when needed */
  showBrowse?: boolean;
  browseTown?: string;
  browseCategory?: string;
  browseExpanded?: boolean;
  noindex?: boolean;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  active,
  crumbs,
  showBrowse = false,
  browseTown,
  browseCategory,
  browseExpanded,
  noindex,
  canonicalPath,
  jsonLd,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  active={active}
  crumbs={crumbs}
  showBrowse={showBrowse}
  browseTown={browseTown}
  browseCategory={browseCategory}
  browseExpanded={browseExpanded}
  noindex={noindex}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <slot />
</BaseLayout>
