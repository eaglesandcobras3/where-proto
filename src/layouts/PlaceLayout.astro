---
import BaseLayout from "./BaseLayout.astro";
import { href } from "../lib/href";

interface Crumb {
  label: string;
  path?: string;
}

interface Props {
  title: string;
  description?: string;
  active?: string;
  crumbs: Crumb[];
  /** Explicit back control — defaults to the nearest crumb with a path */
  back?: { label: string; path: string };
  /** Detail pages default off; list/town hubs pass true when needed */
  showBrowse?: boolean;
  browseTown?: string;
  browseCategory?: string;
  browseExpanded?: boolean;
  noindex?: boolean;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  active,
  crumbs,
  back,
  showBrowse = false,
  browseTown,
  browseCategory,
  browseExpanded,
  noindex,
  canonicalPath,
  jsonLd,
} = Astro.props;

const parent = [...crumbs].reverse().find((crumb) => crumb.path);
const backLink = back ?? (parent?.path ? { label: parent.label, path: parent.path } : undefined);
---

<BaseLayout
  title={title}
  description={description}
  active={active}
  showBrowse={showBrowse}
  browseTown={browseTown}
  browseCategory={browseCategory}
  browseExpanded={browseExpanded}
  noindex={noindex}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <div class="container place-chrome">
    {
      backLink && (
        <p class="back">
          <a href={href(backLink.path)}>← Back to {backLink.label}</a>
        </p>
      )
    }
  </div>
  <slot />
</BaseLayout>

<style>
  .place-chrome {
    padding-top: var(--size-4);
  }
  .back {
    margin: 0;
  }
  .back a {
    font-weight: var(--font-weight-6);
    color: var(--brand-deep);
  }
</style>
