---
import BaseLayout from "./BaseLayout.astro";
import BusinessSwitcher from "../components/islands/BusinessSwitcher.svelte";
import { businessesOwnedBy, currentUser, mentionsForBusiness, townBySlug } from "../data/catalog";
import type { Business } from "../data/types";
import { href } from "../lib/href";
import {
  listingPublicStatusFromBusiness,
  listingPublicStatusLabel,
  VIEW_PUBLIC_LABEL,
} from "../lib/dashboard-v1";

type NavKey =
  | "overview"
  | "profile"
  | "posts"
  | "faqs"
  | "community"
  | "guides"
  | "advertise"
  | "photos";

interface Props {
  title: string;
  business: Business;
  active: NavKey;
  description?: string;
}

const { title, business, active, description } = Astro.props;
const owner = currentUser();
const owned = businessesOwnedBy("local_owner");
const town = townBySlug(business.townSlug);
const base = import.meta.env.BASE_URL;
const root = `/dashboard/${business.slug}`;
const mentionCount = mentionsForBusiness(business).length;
const listingStatus = listingPublicStatusFromBusiness(business);
const listingStatusLabel = listingPublicStatusLabel(listingStatus);
const publicHref = href(`/business/${business.slug}`);

type NavLink = { key: NavKey; label: string; path: string; badge?: string; badgeTone?: "teal" | "amber" };

const legacyLinks: NavLink[] = [
  { key: "overview", label: "Overview", path: root },
  { key: "profile", label: "Business profile", path: `${root}/listing` },
  { key: "posts", label: "Posts & events", path: `${root}/feed` },
  { key: "faqs", label: "FAQs & knowledge", path: `${root}/faqs` },
  { key: "community", label: "Community feed", path: `${root}/mentions`, badge: String(mentionCount), badgeTone: "teal" },
  { key: "guides", label: "Guide mentions", path: `${root}/guides` },
  { key: "advertise", label: "Advertise & grow", path: `${root}/advertise`, badge: "Growth", badgeTone: "amber" },
];

const v1Links: NavLink[] = [
  { key: "overview", label: "Overview", path: root },
  { key: "community", label: "Mentions", path: `${root}/mentions`, badge: String(mentionCount), badgeTone: "teal" },
  { key: "posts", label: "Posts & events", path: `${root}/feed` },
  { key: "photos", label: "Photos", path: `${root}/photos` },
  { key: "faqs", label: "FAQs & knowledge", path: `${root}/faqs` },
  { key: "profile", label: "Business profile", path: `${root}/listing` },
  { key: "guides", label: "Guide mentions", path: `${root}/guides` },
  { key: "advertise", label: "Advertise & grow", path: `${root}/advertise` },
];
---

<BaseLayout title={title} description={description} bare dashboardPreview>
  <div class="portal">
    <aside class="sidebar">
      <div class="sidebar__brand">
        <a class="logo" href={href("/")}>WhereTo<span>30A</span></a>
        <span class="badge">Merchant</span>
      </div>

      <nav class="nav" aria-label="Business management" data-dash="legacy">
        {
          legacyLinks.map((link) => (
            <a class:list={["nav__link", { active: active === link.key }]} href={href(link.path)}>
              <span>{link.label}</span>
              {link.badge && (
                <span class:list={["nav__chip", link.badgeTone === "amber" && "nav__chip--amber"]}>
                  {link.badge}
                </span>
              )}
            </a>
          ))
        }
      </nav>
      <nav class="nav" aria-label="Business management" data-dash="v1">
        {
          v1Links.map((link) => (
            <a class:list={["nav__link", { active: active === link.key }]} href={href(link.path)}>
              <span>{link.label}</span>
              {link.badge && (
                <span class:list={["nav__chip", link.badgeTone === "amber" && "nav__chip--amber"]}>
                  {link.badge}
                </span>
              )}
            </a>
          ))
        }
      </nav>

      <div class="sidebar__help">
        <p class="help-title">Need a hand?</p>
        <p class="help-body">See what visitors see, then fill any gaps.</p>
        <a class="help-btn" href={publicHref} data-dash="legacy">Preview profile</a>
        <a class="help-btn" href={publicHref} data-dash="v1">{VIEW_PUBLIC_LABEL}</a>
      </div>
    </aside>

    <div class="shell">
      <header class="topbar">
        <BusinessSwitcher
          businesses={owned.map((item) => ({
            slug: item.slug,
            name: item.name,
            status: listingPublicStatusFromBusiness(item),
          }))}
          selectedSlug={business.slug}
          live={listingStatus === "live"}
          statusLabel={listingStatusLabel}
          base={base}
          client:load
        />
        <div class="topbar__actions">
          <a class="view-btn" href={publicHref} data-dash="legacy">View public site</a>
          <a class="view-btn" href={publicHref} data-dash="v1">{VIEW_PUBLIC_LABEL}</a>
          <div class="user">
            <div class="user__copy">
              <strong>{owner?.name ?? "Owner"}</strong>
              <span data-dash="legacy">Business owner</span>
              <span data-dash="v1">Verified owner</span>
            </div>
            <span class="user__avatar" aria-hidden="true">{(owner?.name ?? "O").charAt(0)}</span>
          </div>
        </div>
      </header>

      <div class="content">
        <slot />
      </div>

      <footer class="portal-foot">
        Managing {business.name}
        {town && <> · {town.name}</>}
        ·
        <a href={publicHref} data-dash="legacy">View public site</a>
        <a href={publicHref} data-dash="v1">{VIEW_PUBLIC_LABEL}</a>
      </footer>
    </div>
  </div>
</BaseLayout>

<style>
  :global(body.bare-shell) {
    background: #f8f9ff;
  }
  :global(body.bare-shell main) {
    margin: 0;
    padding: 0;
    max-width: none;
  }
  .portal {
    display: grid;
    min-height: 100vh;
    background: #f8f9ff;
    color: var(--brand-ink);
  }
  .sidebar {
    display: none;
  }
  .shell {
    min-width: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100vh;
  }
  .sidebar__brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 4rem;
    padding: 0 1.25rem;
  }
  .logo {
    font-family: var(--font-display);
    font-weight: var(--font-weight-8);
    color: var(--brand-deep);
    text-decoration: none;
  }
  .logo span {
    color: var(--brand-teal);
  }
  .badge {
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
    background: #e0f2f1;
    color: var(--brand-teal);
    font-size: 0.5625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .nav {
    display: grid;
    gap: 0.2rem;
    padding: 0.5rem 0.75rem;
  }
  .nav__link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-2);
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-6);
    text-decoration: none;
  }
  .nav__link:hover {
    background: #eff4ff;
    color: var(--brand-deep);
    text-decoration: none;
  }
  .nav__link.active {
    background: var(--brand-deep);
    color: white;
  }
  .nav__chip {
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-pill);
    background: #e0f2f1;
    color: var(--brand-teal);
    font-size: 0.5625rem;
    font-weight: var(--font-weight-8);
  }
  .nav__link.active .nav__chip {
    background: rgba(255, 255, 255, 0.15);
    color: white;
  }
  .nav__chip--amber {
    background: #fef3c7;
    color: #92400e;
  }
  .sidebar__help {
    margin: auto 0.75rem 0.75rem;
    padding: 1rem;
    border-radius: var(--radius-3);
    background: #eff4ff;
  }
  .help-title {
    margin: 0 0 0.35rem;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-8);
    color: var(--brand-deep);
  }
  .help-body {
    margin: 0 0 0.75rem;
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
    line-height: 1.45;
  }
  .help-btn {
    display: inline-flex;
    justify-content: center;
    width: 100%;
    min-height: 2.25rem;
    align-items: center;
    border-radius: var(--radius-2);
    background: white;
    color: var(--brand-deep);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    text-decoration: none;
    box-shadow: 0 1px 3px rgba(12, 35, 46, 0.06);
  }
  .help-btn:hover {
    text-decoration: none;
    color: var(--brand-teal);
  }
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    min-height: 4rem;
    padding: 0.65rem 1rem;
    background: rgba(255, 255, 255, 0.95);
    border-bottom: 1px solid var(--brand-line);
    backdrop-filter: blur(10px);
  }
  .topbar__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .view-btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    background: #f1f5f9;
    color: var(--brand-deep);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    text-decoration: none;
  }
  .view-btn:hover {
    background: #e0f2f1;
    color: var(--brand-teal);
    text-decoration: none;
  }
  .user {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .user__copy {
    display: none;
    text-align: right;
  }
  .user__copy strong {
    display: block;
    font-size: var(--font-size-0);
    color: var(--brand-deep);
  }
  .user__copy span {
    font-size: 0.625rem;
    color: var(--brand-ink-soft);
  }
  .user__avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--brand-deep);
    color: white;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
  }
  .content {
    padding: 1.25rem 1rem 2rem;
  }
  .portal-foot {
    padding: 0.75rem 1rem 1.25rem;
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  .portal-foot a {
    color: var(--brand-teal);
    font-weight: var(--font-weight-7);
  }
  @media (min-width: 960px) {
    .portal {
      grid-template-columns: 17.5rem minmax(0, 1fr);
    }
    .sidebar {
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      height: 100vh;
      background: white;
      border-right: 1px solid var(--brand-line);
    }
    .topbar {
      padding-inline: 1.5rem;
    }
    .content {
      padding: 1.5rem 1.5rem 2.5rem;
    }
    .user__copy {
      display: block;
    }
  }
</style>
