---
import SiteHeader from "../components/proto/SiteHeader.astro";
import SiteFooter from "../components/proto/SiteFooter.astro";
import FilterBar from "../components/proto/FilterBar.astro";
import { absHref } from "../lib/href";
import "../styles/proto.css";

interface Props {
  title: string;
  activeNav?: string;
  filterTown?: string;
  filterCategory?: string;
  filterGroup?: string;
  filterSubcategory?: string;
  filterExpanded?: boolean;
  /** @deprecated use filterTown */
  filterPrimary?: string;
  /** @deprecated use filterCategory */
  filterSecondary?: string;
  headerTone?: "dark" | "light";
  noindex?: boolean;
  canonicalPath?: string;
  showFilter?: boolean;
}

const {
  title,
  activeNav = "",
  filterTown,
  filterCategory,
  filterGroup = "",
  filterSubcategory = "All in selected group",
  filterExpanded = false,
  filterPrimary = "Any town",
  filterSecondary = "Any category",
  headerTone = "dark",
  noindex,
  canonicalPath,
  showFilter = true,
} = Astro.props;

const townLabel = filterTown ?? filterPrimary;
const categoryLabel = filterCategory ?? filterSecondary;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · WhereTo30A</title>
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonicalPath && <link rel="canonical" href={absHref(canonicalPath)} />}
  </head>
  <body class="proto-body">
    <div class="proto-page">
      <SiteHeader active={activeNav} tone={headerTone} />
      {
        showFilter && (
          <FilterBar
            town={townLabel}
            category={categoryLabel}
            group={filterGroup}
            subcategory={filterSubcategory}
            expanded={filterExpanded}
          />
        )
      }
      <main class="proto-main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
