---
import { absHref, href } from "../lib/href";
import "../styles/wireframe.css";

interface Props {
  title: string;
  note?: string;
  noindex?: boolean;
  canonicalPath?: string;
}

const { title, note, noindex, canonicalPath } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · WhereTo30A wireframe</title>
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonicalPath && <link rel="canonical" href={absHref(canonicalPath)} />}
  </head>
  <body>
    <header>
      <p class="box-label">Site chrome</p>
      <p>WhereTo30A · wireframe · fake data</p>
      <nav aria-label="Primary">
        <a href={href("/")}>Homepage (Logo)</a>
        ·
        <a href={href("/towns")}>Towns</a>
        ·
        <a href={href("/areas")}>Areas</a>
        ·
        <a href={href("/search")}>Search</a>
        ·
        <a href={href("/events")}>Events</a>
        ·
        <a href={href("/stays")}>Stays</a>
        ·
        <a href={href("/guides")}>Guides</a>
        ·
        <a href={href("/ask")}>Ask</a>
      </nav>
      <nav aria-label="Account">
        <a href={href("/add-business")}>Add Business</a>
        ·
        <a href={href("/profile")}>Profile</a>
        ·
        <a href={href("/dashboard")}>Dashboard</a>
      </nav>
    </header>
    <main>
      <slot />
      {
        note && (
          <section class="box">
            <p class="box-label">Note</p>
            <p>{note}</p>
          </section>
        )
      }
    </main>
    <footer>
      <p class="box-label">Footer</p>
      <nav aria-label="Footer">
        <a href={href("/about")}>About</a>
        ·
        <a href={href("/legal")}>Legal</a>
        ·
        <a href={href("/advertise")}>Advertise</a>
        ·
        <a href={href("/areas")}>Areas</a>
        ·
        <a href={href("/newsletters/visitor")}>Visitor newsletter</a>
        ·
        <a href={href("/newsletters/business")}>Business newsletter</a>
        ·
        <a href={href("/auth/login")}>Login</a>
        ·
        <a href={href("/admin")}>Admin</a>
        ·
        <a href={href("/ia")}>All routes / IA</a>
      </nav>
    </footer>
  </body>
</html>
