---
import { href } from "../lib/href";

interface Props {
  townLabel?: string;
  categoryLabel?: string;
}

const { townLabel, categoryLabel } = Astro.props;
---

<div class="browse-bar">
  <div class="container bar-inner">
    <a class="pill" href={href("/search")}>
      <span class="pill-label">{townLabel ?? "Anywhere on 30A"}</span>
      <span class="pill-sub">{categoryLabel ?? "Any category"}</span>
    </a>
    <a class="explore" href={href("/search")}>Explore</a>
  </div>
</div>

<style>
  .browse-bar {
    background: var(--brand-deep);
    padding-block: var(--size-4);
  }
  .bar-inner {
    display: flex;
    align-items: center;
    gap: var(--size-3);
  }
  .pill {
    flex: 1;
    max-width: 560px;
    background: white;
    border-radius: var(--radius-4);
    padding: var(--size-2) var(--size-4);
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .pill:hover {
    text-decoration: none;
  }
  .pill-label {
    font-weight: var(--font-weight-7);
    color: var(--brand-ink);
    font-size: var(--font-size-2);
  }
  .pill-sub {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .explore {
    background: white;
    color: var(--brand-deep);
    font-weight: var(--font-weight-7);
    border-radius: var(--radius-4);
    padding: var(--size-2) var(--size-5);
    font-size: var(--font-size-1);
  }
  .explore:hover {
    text-decoration: none;
    background: var(--brand-teal-soft);
  }
</style>
