---
import type { Crumb } from "../lib/crumbs";
import { href } from "../lib/href";

interface Props {
  items: Crumb[];
  tone?: "page" | "hero";
}

const { items, tone = "page" } = Astro.props;
const trail = items[0]?.label === "Home" ? items : [{ label: "Home", path: "/" }, ...items];
---

<nav class:list={["crumbs", tone === "hero" && "crumbs--hero"]} aria-label="Breadcrumb">
  <ol>
    {
      trail.map((item, index) => {
        const last = index === trail.length - 1;
        return (
          <li>
            {index > 0 && <span class="sep" aria-hidden="true">|</span>}
            {last || !item.path ? (
              <span class="current" aria-current={last ? "page" : undefined}>{item.label}</span>
            ) : (
              <a href={href(item.path)}>{item.label}</a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .crumbs,
  ol,
  li,
  a,
  .current,
  .sep {
    margin: 0;
    padding: 0;
  }
  .crumbs {
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
  }
  li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .sep {
    flex: 0 0 auto;
    color: var(--brand-line);
    line-height: 1;
  }
  a {
    color: var(--brand-ink-soft);
  }
  a:hover {
    color: var(--brand-teal);
  }
  .current {
    color: var(--brand-ink);
    font-weight: var(--font-weight-7);
    max-width: 18rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .crumbs--hero {
    color: var(--brand-ink-on-navy);
  }
  .crumbs--hero a {
    color: var(--brand-ink-on-navy);
  }
  .crumbs--hero a:hover {
    color: var(--mint);
  }
  .crumbs--hero .sep {
    color: rgba(255, 255, 255, 0.35);
  }
  .crumbs--hero .current {
    color: white;
  }
</style>
