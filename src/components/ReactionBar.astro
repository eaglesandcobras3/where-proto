---
import type { Reaction } from "../data/types";

interface Props {
  reactions?: Reaction[];
}

const { reactions = [] } = Astro.props;

const icons: Record<Reaction["label"], string> = {
  up: "👍",
  heart: "❤️",
  wow: "😮",
};

const names: Record<Reaction["label"], string> = {
  up: "Thumbs up",
  heart: "Love",
  wow: "Surprised",
};

const shown: Reaction["label"][] = ["up", "heart", "wow"];
void reactions;
---

<div class="reactions" role="group" aria-label="Reactions">
  {
    shown.map((label) => (
      <button type="button" class="btn" aria-label={names[label]}>
        <span aria-hidden="true">{icons[label]}</span>
      </button>
    ))
  }
</div>

<style>
  .reactions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--size-1);
    border: 1px solid var(--brand-line);
    background: white;
    border-radius: var(--radius-pill);
    padding: 2px var(--size-2);
    font: inherit;
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
    cursor: pointer;
  }
  .btn:hover {
    border-color: var(--brand-teal);
    color: var(--brand-deep);
  }
</style>
