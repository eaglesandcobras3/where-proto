---
import { href } from "../lib/href";
import { reactionsFor, stays, townBySlug } from "../data/catalog";
import { stayPath } from "../lib/listing";
import ReactionCluster from "./ReactionCluster.astro";
import SectionIntro from "./SectionIntro.astro";

const kindFor = (slug: string) => {
  if (slug.includes("pearl") || slug.includes("inn")) return "Boutique Inns";
  if (slug.includes("cottage")) return "Beach Cottages";
  return "Vacation Homes";
};

const fromCatalog = stays.slice(0, 3).map((stay) => ({
  slug: stay.slug,
  name: stay.name,
  category: kindFor(stay.slug),
  summary: stay.summary,
  town: townBySlug(stay.townSlug)?.name ?? "30A",
  href: stayPath(stay),
}));

const items = [
  ...fromCatalog,
  {
    slug: "",
    name: "Alys Courtyard Villa",
    category: "Private Villas",
    summary:
      "Whitewashed courtyard villa steps from the Alys Beach green — pool, bike racks, and gulf access for a long weekend.",
    town: "Alys Beach",
    href: "/stays",
  },
].slice(0, 4);
---

<section class="stays-grid">
  <div class="container">
    <SectionIntro
      eyebrow="Where to Stay"
      title="Stays along Scenic 30A"
      lede="Boutique inns, beach cottages, and vacation homes, each in the town it actually sits in."
      linkHref="/stays"
      link="Explore all stays →"
    />

    <div class="h-scroll-pane">
      <div class="grid">
        {
          items.map((item) => (
            <a class="card" href={href(item.href)}>
              <div class="media img-placeholder" aria-hidden="true">
                <span>{item.name.charAt(0)}</span>
              </div>
              <p class="cat">{item.category}</p>
              <h3>{item.name}</h3>
              <p class="town">{item.town}</p>
              {item.slug && <ReactionCluster reactions={reactionsFor("stay", item.slug)} />}
              <p class="summary">{item.summary}</p>
              <span class="explore">Explore →</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .stays-grid {
    padding-block: var(--size-5) var(--size-6);
    background: white;
  }
  .grid {
    display: grid;
    gap: var(--size-5);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    min-width: 56rem;
    width: 100%;
  }
  .card {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    color: inherit;
    min-width: 0;
    border: 0;
    box-shadow: none;
    background: transparent;
  }
  .card:hover {
    text-decoration: none;
  }
  .media {
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-3);
    margin-bottom: 0.35rem;
    font-size: var(--font-size-5);
  }
  .cat {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: var(--font-weight-7);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-3);
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
    line-height: 1.25;
  }
  .town {
    margin: 0;
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  .summary {
    margin: 0;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .explore {
    margin-top: 0.15rem;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    color: var(--brand-teal);
  }
</style>
