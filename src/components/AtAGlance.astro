---
import type { TownView } from "../lib/town-view";

interface Props {
  town: TownView;
}

const { town } = Astro.props;
---

<section class="glance">
  <h2 class="section-title">{town.name} at a glance</h2>
  <div class="cards">
    {
      town.glance.map((fact) => (
        <div class="fact">
          <p class="label">{fact.label}</p>
          <p class="value">{fact.value}</p>
          <p class="detail">{fact.detail}</p>
        </div>
      ))
    }
  </div>
  <div class="highlights">
    {town.highlights.map((item) => <span class="chip">{item}</span>)}
  </div>
  <p class="disclaimer">
    Information provided is for general guidance only. Access rules, parking, and hours can change.
    Confirm with the town or your stay before you go.
  </p>
</section>

<style>
  .glance {
    margin-block: var(--size-8);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--size-4);
    margin-bottom: var(--size-5);
  }
  .fact {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-card);
    padding: var(--size-4);
  }
  .label {
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--brand-ink-soft);
    margin-bottom: var(--size-1);
  }
  .value {
    font-size: var(--font-size-3);
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
    margin-bottom: var(--size-2);
  }
  .detail {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
    margin: 0;
  }
  .highlights {
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2);
  }
  .chip {
    font-size: var(--font-size-1);
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-4);
    padding: var(--size-1) var(--size-3);
    background: white;
    color: var(--brand-ink);
  }
  .disclaimer {
    margin-top: var(--size-4);
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
    max-width: 72ch;
  }
</style>
