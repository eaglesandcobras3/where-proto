---
import SearchBar from "./islands/SearchBar.svelte";
import ConditionsBar from "./ConditionsBar.astro";
import { towns } from "../data/catalog";
import { href } from "../lib/href";

interface Props {
  active?: string;
}

const { active = "" } = Astro.props;
const base = import.meta.env.BASE_URL;
const townOptions = towns.map(({ slug, name }) => ({ slug, name }));

const links = [
  { label: "Towns", path: "/towns", key: "towns" },
  { label: "Businesses", path: "/search", key: "businesses" },
  { label: "Stays", path: "/stays", key: "stays" },
  { label: "Events", path: "/events", key: "events" },
  { label: "Guides", path: "/guides", key: "guides" },
  { label: "Ask", path: "/ask", key: "ask" },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href={href("/")}>
      <img src={href("/logo.png")} alt="WhereTo30A" width="320" height="79" />
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      {
        links.map((link) => (
          <a href={href(link.path)} class:list={[{ active: active === link.key }]}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a class="add-business" data-proto="add-business" href={href("/add-business")}>Add your business</a>
      <button class="sign-in" data-proto="sign-in" type="button" id="header-sign-in">Sign in</button>
      <SearchBar towns={townOptions} base={base} client:load />
      <div class="profile" data-proto="profile">
        <button
          class="icon-btn"
          type="button"
          id="profile-menu-btn"
          aria-label="Account"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="profile-menu"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <circle cx="12" cy="8" r="3.25" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
            <path d="M5 19c0-3.3 3.1-6 7-6s7 2.7 7 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
          </svg>
        </button>
        <div class="profile-menu" id="profile-menu" role="menu">
          <a role="menuitem" href={href("/profile")}>Profile</a>
          <a role="menuitem" data-proto="manage-business" href={href("/dashboard")}>Manage business</a>
          <a role="menuitem" data-proto="town-desk" href={href("/dashboard")}>Manage town</a>
          <button role="menuitem" type="button" data-proto="sign-out" id="menu-sign-out">Sign out</button>
        </div>
      </div>
      <button
        class="menu-btn"
        id="menu-btn"
        type="button"
        aria-label="Open menu"
        aria-controls="mobile-drawer"
        aria-expanded="false"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>
  <ConditionsBar />
</header>

<dialog class="mobile-drawer" id="mobile-drawer" aria-label="Menu">
  <div class="mobile-drawer-panel">
    <form method="dialog">
      <button class="menu-close" type="submit">Close</button>
    </form>
    <nav class="mobile-nav">
      {links.map((link) => <a href={href(link.path)}>{link.label}</a>)}
      <a data-proto="add-business" href={href("/add-business")}>Add your business</a>
      <button type="button" data-proto="sign-in" class="mobile-sign-in" id="mobile-sign-in">Sign in</button>
      <a data-proto="profile" href={href("/profile")}>Profile</a>
      <a data-proto="manage-business" href={href("/dashboard")}>Manage business</a>
      <a data-proto="town-desk" href={href("/dashboard")}>Manage town</a>
      <button type="button" data-proto="sign-out" class="mobile-sign-in" id="mobile-sign-out">Sign out</button>
    </nav>
  </div>
</dialog>

<script>
  const btn = document.getElementById("menu-btn");
  const drawer = document.getElementById("mobile-drawer");

  function setExpanded(open: boolean) {
    btn?.setAttribute("aria-expanded", open ? "true" : "false");
  }

  btn?.addEventListener("click", () => {
    if (!(drawer instanceof HTMLDialogElement)) return;
    drawer.showModal();
    setExpanded(true);
  });

  drawer?.addEventListener("close", () => setExpanded(false));
  drawer?.addEventListener("click", (event) => {
    if (event.target === drawer && drawer instanceof HTMLDialogElement) {
      drawer.close();
    }
  });

  function openAuth() {
    window.dispatchEvent(new CustomEvent("w30a:auth", { detail: { mode: "login" } }));
    if (drawer instanceof HTMLDialogElement && drawer.open) drawer.close();
  }

  document.getElementById("header-sign-in")?.addEventListener("click", openAuth);
  document.getElementById("mobile-sign-in")?.addEventListener("click", openAuth);

  const profileBtn = document.getElementById("profile-menu-btn");
  const profileMenu = document.getElementById("profile-menu");

  function setProfileOpen(open: boolean) {
    if (!(profileMenu instanceof HTMLElement) || !(profileBtn instanceof HTMLButtonElement)) return;
    profileMenu.classList.toggle("is-open", open);
    profileBtn.setAttribute("aria-expanded", open ? "true" : "false");
  }

  profileBtn?.addEventListener("click", () => {
    setProfileOpen(profileBtn.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("pointerdown", (event) => {
    if (!(event.target instanceof Node)) return;
    if (profileBtn?.contains(event.target) || profileMenu?.contains(event.target)) return;
    setProfileOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setProfileOpen(false);
  });

  function signOut() {
    setProfileOpen(false);
    window.localStorage.setItem("w30a:persona", "guest");
    document.documentElement.dataset.persona = "guest";
    window.dispatchEvent(new CustomEvent("w30a:persona", { detail: { persona: "guest" } }));
    if (drawer instanceof HTMLDialogElement && drawer.open) drawer.close();
  }

  document.getElementById("menu-sign-out")?.addEventListener("click", signOut);
  document.getElementById("mobile-sign-out")?.addEventListener("click", signOut);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: white;
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--size-2);
    min-height: var(--header-nav-h);
    min-width: 0;
    background: white;
    border-bottom: 1px solid var(--brand-line);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo img {
    display: block;
    height: 2.15rem;
    width: auto;
  }
  .logo:hover {
    text-decoration: none;
  }
  .desktop-nav {
    display: none;
    align-self: stretch;
    align-items: center;
    gap: 0.15rem;
  }
  .desktop-nav a {
    display: flex;
    align-items: center;
    align-self: stretch;
    padding: 0 0.75rem;
    border-bottom: 2px solid transparent;
    color: var(--brand-ink-soft);
    font-weight: var(--font-weight-5);
    font-size: var(--font-size-1);
    white-space: nowrap;
  }
  .desktop-nav a:hover {
    text-decoration: none;
    color: var(--brand-ink);
  }
  .desktop-nav a.active {
    color: var(--brand-deep);
    border-bottom-color: var(--brand-deep);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-left: auto;
    flex: 1;
    min-width: 0;
    justify-content: flex-end;
  }
  .add-business,
  .sign-in {
    display: none;
    margin-right: 0.35rem;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-5);
    color: var(--brand-ink-soft);
    white-space: nowrap;
  }
  .add-business:hover,
  .sign-in:hover {
    color: var(--brand-ink);
    text-decoration: none;
  }
  .sign-in {
    border: 0;
    background: none;
    padding: 0;
    cursor: pointer;
    font: inherit;
  }
  .mobile-sign-in {
    display: block;
    width: 100%;
    text-align: left;
    padding: var(--size-3);
    min-height: 44px;
    font: inherit;
    font-size: var(--font-size-3);
    color: var(--brand-ink);
    border: 0;
    background: none;
    cursor: pointer;
  }

  /* Prototype persona visibility — set on <html data-persona> */
  :global(html[data-persona="guest"]) [data-proto="profile"],
  :global(html[data-persona="guest"]) [data-proto="manage-business"],
  :global(html[data-persona="guest"]) [data-proto="town-desk"],
  :global(html[data-persona="town-manager"]) [data-proto="add-business"] {
    display: none !important;
  }
  :global(html:not([data-persona="guest"])) [data-proto="sign-in"],
  :global(body.account-shell) [data-proto="sign-in"] {
    display: none !important;
  }
  :global(html[data-persona="guest"]) [data-proto="sign-out"] {
    display: none !important;
  }
  :global(html[data-persona="visitor"]) [data-proto="town-desk"] {
    display: none !important;
  }
  :global(html[data-persona="employer"]) [data-proto="town-desk"] {
    display: none !important;
  }
  :global(html[data-persona="town-manager"]) [data-proto="manage-business"] {
    display: none !important;
  }
  .icon-btn {
    width: 2.75rem;
    height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: white;
    color: var(--brand-ink);
    box-shadow: 0 0 0 1px var(--brand-line);
    flex-shrink: 0;
    line-height: 0;
  }
  .icon-btn svg {
    display: block;
  }
  .icon-btn:hover {
    color: var(--brand-deep);
    text-decoration: none;
  }
  .profile {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
  }
  .profile-menu {
    display: none;
    position: absolute;
    top: calc(100% + 0.45rem);
    right: 0;
    z-index: 70;
    min-width: 12.5rem;
    padding: 0.35rem;
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: 0.85rem;
    box-shadow: 0 12px 32px rgba(8, 24, 40, 0.12);
  }
  .profile-menu.is-open {
    display: grid;
  }
  .profile-menu a,
  .profile-menu button {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0.55rem 0.7rem;
    border: 0;
    border-radius: 0.55rem;
    background: none;
    color: var(--brand-ink);
    font: inherit;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-5);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }
  .profile-menu a:hover,
  .profile-menu button:hover {
    background: var(--brand-sand);
    color: var(--brand-deep);
    text-decoration: none;
  }
  .menu-btn {
    background: none;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-2);
    padding: var(--size-2);
    min-width: 44px;
    min-height: 44px;
    cursor: pointer;
    color: var(--brand-ink);
    flex-shrink: 0;
  }
  .menu-btn[aria-expanded="true"] {
    background: var(--brand-teal-soft);
    border-color: var(--brand-teal);
  }
  .mobile-drawer {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }
  .mobile-drawer::backdrop {
    background: rgb(12 47 61 / 0.4);
  }
  .mobile-drawer-panel {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(20rem, 100vw);
    height: 100%;
    overflow: auto;
    background: var(--brand-sand);
    border-left: 1px solid var(--brand-line);
    padding: var(--size-4);
  }
  .menu-close {
    font: inherit;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    min-height: 44px;
    padding: var(--size-2) var(--size-3);
    margin-bottom: var(--size-3);
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-2);
    background: white;
    color: var(--brand-ink);
    cursor: pointer;
  }
  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: var(--size-1);
  }
  .mobile-nav a {
    padding: var(--size-3);
    min-height: 44px;
    font-size: var(--font-size-3);
    color: var(--brand-ink);
    border-bottom: 1px solid var(--brand-line);
  }
  @media (min-width: 960px) {
    .header-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: var(--size-4);
    }
    .logo {
      justify-self: start;
    }
    .desktop-nav {
      justify-self: center;
    }
    .header-actions {
      justify-self: end;
      margin-left: 0;
      flex: none;
    }
    .desktop-nav,
    .add-business,
    .sign-in {
      display: flex;
      align-items: center;
    }
    .menu-btn {
      display: none;
    }
  }
</style>
