---
import SearchBar from "./islands/SearchBar.svelte";
import { href } from "../lib/href";

interface Props {
  active?: string;
}

const { active = "" } = Astro.props;
const base = import.meta.env.BASE_URL;

const links = [
  { label: "Towns", path: "/towns", key: "towns" },
  { label: "Businesses", path: "/search", key: "businesses" },
  { label: "Stays", path: "/stays", key: "stays" },
  { label: "Events", path: "/events", key: "events" },
  { label: "Updates", path: "/updates", key: "updates" },
  { label: "Guides", path: "/guides", key: "guides" },
  { label: "Ask", path: "/ask", key: "ask" },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href={href("/")}>WhereTo<span>30A</span></a>

    <nav class="desktop-nav" aria-label="Primary">
      {
        links.map((link) => (
          <a href={href(link.path)} class:list={[{ active: active === link.key }]}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a class="add-business" href={href("/add-business")}>Add business</a>
      <a class="icon-btn" href={href("/ask")} aria-label="Ask locals">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M4 12.5 20 4l-4.5 16-3.2-5.3L4 12.5z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linejoin="round"
          ></path>
        </svg>
      </a>
      <SearchBar base={base} client:load />
      <a class="icon-btn" href={href("/profile")} aria-label="Profile">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="8" r="3.25" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
          <path d="M5 19c0-3.3 3.1-6 7-6s7 2.7 7 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
        </svg>
      </a>
      <button
        class="menu-btn"
        id="menu-btn"
        type="button"
        aria-label="Open menu"
        aria-controls="mobile-drawer"
        aria-expanded="false"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<dialog class="mobile-drawer" id="mobile-drawer" aria-label="Menu">
  <div class="mobile-drawer-panel">
    <form method="dialog">
      <button class="menu-close" type="submit">Close</button>
    </form>
    <nav class="mobile-nav">
      {links.map((link) => <a href={href(link.path)}>{link.label}</a>)}
      <a href={href("/add-business")}>Add business</a>
      <a href={href("/profile")}>Profile</a>
      <a href={href("/dashboard")}>Dashboard</a>
    </nav>
  </div>
</dialog>

<script>
  const btn = document.getElementById("menu-btn");
  const drawer = document.getElementById("mobile-drawer");

  function setExpanded(open: boolean) {
    btn?.setAttribute("aria-expanded", open ? "true" : "false");
  }

  btn?.addEventListener("click", () => {
    if (!(drawer instanceof HTMLDialogElement)) return;
    drawer.showModal();
    setExpanded(true);
  });

  drawer?.addEventListener("close", () => setExpanded(false));
  drawer?.addEventListener("click", (event) => {
    if (event.target === drawer && drawer instanceof HTMLDialogElement) {
      drawer.close();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--brand-sand);
    border-bottom: 1px solid var(--brand-line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--size-2);
    min-height: var(--header-h);
    min-width: 0;
  }
  .logo {
    font-size: var(--font-size-4);
    font-weight: var(--font-weight-8);
    font-style: italic;
    color: var(--brand-deep);
    text-decoration: none;
    white-space: nowrap;
  }
  .logo span {
    color: var(--brand-teal);
  }
  .logo:hover {
    text-decoration: none;
  }
  .desktop-nav {
    display: none;
    align-self: stretch;
    align-items: center;
    gap: 0.15rem;
    margin-inline: auto;
  }
  .desktop-nav a {
    display: flex;
    align-items: center;
    align-self: stretch;
    padding: 0 0.75rem;
    border-bottom: 2px solid transparent;
    color: var(--brand-ink-soft);
    font-weight: var(--font-weight-5);
    font-size: var(--font-size-1);
    white-space: nowrap;
  }
  .desktop-nav a:hover {
    text-decoration: none;
    color: var(--brand-ink);
  }
  .desktop-nav a.active {
    color: var(--brand-deep);
    border-bottom-color: var(--brand-deep);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-left: auto;
    flex: 1;
    min-width: 0;
    justify-content: flex-end;
  }
  .add-business {
    display: none;
    margin-right: 0.35rem;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-5);
    color: var(--brand-ink-soft);
    white-space: nowrap;
  }
  .add-business:hover {
    color: var(--brand-ink);
    text-decoration: none;
  }
  .icon-btn {
    width: 2.75rem;
    height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: white;
    color: var(--brand-ink);
    box-shadow: 0 0 0 1px var(--brand-line);
    flex-shrink: 0;
  }
  .icon-btn:hover {
    color: var(--brand-deep);
    text-decoration: none;
  }
  .menu-btn {
    background: none;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-2);
    padding: var(--size-2);
    min-width: 44px;
    min-height: 44px;
    cursor: pointer;
    color: var(--brand-ink);
    flex-shrink: 0;
  }
  .menu-btn[aria-expanded="true"] {
    background: var(--brand-teal-soft);
    border-color: var(--brand-teal);
  }
  .mobile-drawer {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }
  .mobile-drawer::backdrop {
    background: rgb(12 47 61 / 0.4);
  }
  .mobile-drawer-panel {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(20rem, 100vw);
    height: 100%;
    overflow: auto;
    background: var(--brand-sand);
    border-left: 1px solid var(--brand-line);
    padding: var(--size-4);
  }
  .menu-close {
    font: inherit;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    min-height: 44px;
    padding: var(--size-2) var(--size-3);
    margin-bottom: var(--size-3);
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-2);
    background: white;
    color: var(--brand-ink);
    cursor: pointer;
  }
  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: var(--size-1);
  }
  .mobile-nav a {
    padding: var(--size-3);
    min-height: 44px;
    font-size: var(--font-size-3);
    color: var(--brand-ink);
    border-bottom: 1px solid var(--brand-line);
  }
  @media (min-width: 960px) {
    .header-inner {
      gap: var(--size-4);
    }
    .header-actions {
      flex: 0 0 auto;
    }
    .desktop-nav,
    .add-business {
      display: flex;
    }
    .menu-btn {
      display: none;
    }
  }
</style>
