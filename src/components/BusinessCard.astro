---
import { href } from "../lib/href";
import { leafBySlug, townBySlug } from "../data/catalog";
import type { Business } from "../data/types";
import ListingTile from "./ListingTile.astro";

interface Props {
  business: Business;
  wide?: boolean;
}

const { business, wide = false } = Astro.props;
const town = townBySlug(business.townSlug);
const leaf = leafBySlug(business.leafSlug);
---

<a class:list={["listing-card", { wide }]} href={href(`/business/${business.slug}`)}>
  <ListingTile label={business.name.charAt(0)} alt="" wide={wide} />
  <div class="body">
    <h3>{business.name}</h3>
    <p class="meta">{town?.name ?? business.townSlug}</p>
    <p class="cat">
      {leaf?.name ?? business.leafSlug} in {town?.name ?? business.townSlug}
    </p>
    <p class="desc">{business.summary}</p>
    <span class="explore">Explore &rarr;</span>
  </div>
</a>

<style>
  .body {
    min-width: 0;
  }
  .body h3 {
    font-size: var(--font-size-3);
    margin-bottom: var(--size-1);
  }
  .meta {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
    margin-bottom: 0;
  }
  .cat {
    font-size: var(--font-size-1);
    color: var(--brand-coral);
    font-weight: var(--font-weight-6);
    margin-bottom: var(--size-2);
  }
  .desc {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .explore {
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
</style>
