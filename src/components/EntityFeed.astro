---
import { photosFor, reactionsFor, userBySlug } from "../data/catalog";
import { href } from "../lib/href";
import { cardImageSrc } from "../lib/card-image";
import { formatDate, roleLabel, userHandle } from "../lib/labels";
import type { Post } from "../data/types";

interface Props {
  posts: Post[];
  placeName: string;
}

const { posts, placeName } = Astro.props;

const entries = posts.map((post) => {
  const author = post.authorUserSlug ? userBySlug(post.authorUserSlug) : undefined;
  const shots = photosFor("post", post.slug);
  return {
    post,
    author,
    handle: author ? userHandle(author.slug) : "A visitor",
    role: author ? roleLabel(author.role) : "Visitor",
    initial: (author?.name ?? "V").charAt(0).toUpperCase(),
    photos: shots,
    hearts: reactionsFor("post", post.slug).reduce((sum, item) => sum + item.count, 0),
  };
});
---

<section class="panel entity-feed">
  <div class="head">
    <h2>Community feed</h2>
    <p>Visitor notes about {placeName} — not ratings, not reviews.</p>
  </div>

  {
    entries.length > 0 ? (
      <div class="feed">
        {entries.map((entry) => (
          <article class="item">
            <div class="avatar" aria-hidden="true">
              {entry.initial}
            </div>
            <div class="body">
              <p class="meta">
                {entry.post.authorUserSlug ? (
                  <a href={href(`/u/${entry.post.authorUserSlug}`)}>{entry.handle}</a>
                ) : (
                  <span>{entry.handle}</span>
                )}
                <span class="dot">·</span>
                <span>{entry.role}</span>
                <span class="dot">·</span>
                <time datetime={entry.post.createdAt}>{formatDate(entry.post.createdAt)}</time>
              </p>
              <p class="copy">{entry.post.body}</p>
              {entry.photos.length > 0 && (
                <div class="shots">
                  {entry.photos.map((photo) => (
                    <figure>
                      <img
                        src={cardImageSrc(photo.caption.charAt(0), "4/3")}
                        alt={photo.caption}
                        width="400"
                        height="300"
                      />
                      <figcaption>
                        <span class="badge">Community</span>
                        {photo.caption}
                      </figcaption>
                    </figure>
                  ))}
                </div>
              )}
              <p class="foot">
                {entry.hearts > 0 && <span>{entry.hearts} reactions</span>}
                <a href={href(`/posts/${entry.post.slug}`)}>Open post</a>
              </p>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty">No visitor notes yet. When someone shares a visit, it shows up here as a post — not a review.</p>
    )
  }
</section>

<style>
  .panel {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-card);
    padding: var(--size-5);
  }
  .head {
    margin-bottom: var(--size-4);
  }
  h2 {
    margin: 0 0 0.35rem;
    font-size: var(--font-size-3);
  }
  .head p,
  .empty {
    margin: 0;
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
  }
  .feed {
    display: grid;
    gap: var(--size-4);
  }
  .item {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.85rem;
    padding-top: var(--size-4);
    border-top: 1px solid var(--brand-line);
  }
  .item:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--brand-teal-soft);
    color: var(--brand-deep);
    font-family: var(--font-display);
    font-weight: var(--font-weight-8);
  }
  .meta {
    margin: 0 0 0.4rem;
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  .meta a {
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .dot {
    margin-inline: 0.2rem;
  }
  .copy {
    margin: 0;
    font-size: var(--font-size-2);
    line-height: 1.55;
  }
  .shots {
    display: flex;
    gap: 0.65rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    margin-top: 0.75rem;
  }
  figure {
    margin: 0;
    flex: 0 0 8.5rem;
  }
  img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-2);
    background: var(--brand-sand-dark);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.35rem;
    font-size: 0.625rem;
    color: var(--brand-ink-soft);
  }
  .badge {
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--brand-teal-soft);
    color: var(--brand-deep);
    font-weight: var(--font-weight-8);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .foot a {
    font-weight: var(--font-weight-7);
    color: var(--brand-teal);
  }
</style>
