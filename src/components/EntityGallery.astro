---
import GalleryToggle from "./islands/GalleryToggle.svelte";
import type { Photo } from "../data/types";

interface Props {
  photos: Photo[];
  communityPhotos?: Photo[];
  fallbackName: string;
  officialLabel?: string;
}

const {
  photos,
  communityPhotos = [],
  fallbackName,
  officialLabel = "Business photos",
} = Astro.props;

const official = photos.map((photo) => ({ kind: "photo" as const, label: photo.caption }));
const community = communityPhotos.map((photo) => ({
  kind: "photo" as const,
  label: photo.caption,
  badge: "Community",
}));
---

<section class="panel entity-gallery">
  <h2>Gallery</h2>
  <GalleryToggle
    {official}
    {community}
    {officialLabel}
    fallbackLabel={fallbackName}
    client:visible
  />
</section>

<style>
  .panel {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-card);
    padding: var(--size-5);
  }
  h2 {
    margin: 0 0 var(--size-3);
    font-size: var(--font-size-3);
  }
</style>
