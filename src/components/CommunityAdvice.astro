---
import { href } from "../lib/href";
import { formatDate } from "../lib/labels";

interface Row {
  question: { slug: string; title: string; createdAt: string };
  town?: { name: string };
  replies?: number;
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;

const prompts = [
  { label: "Sunset cocktails in Seaside", q: "Sunset cocktails in Seaside" },
  { label: "Bike rentals in WaterColor", q: "Bike rentals in WaterColor" },
  { label: "Best seafood without reservations", q: "Best seafood without reservations" },
];
---

<section class="advice">
  <div class="container">
    <header class="head">
      <div>
        <p class="eyebrow">Community Advice Column</p>
        <h2>Locals Know Best: Straight Talk on Golf Carts &amp; Walkovers</h2>
      </div>
      <div class="actions">
        <a class="ask-btn" href={href("/ask")}>Ask the Forum</a>
        <a class="browse" href={href("/ask")}>Browse answers →</a>
      </div>
    </header>

    <div class="threads">
      {
        rows.slice(0, 3).map(({ question, town, replies = 0 }) => (
          <article class="thread">
            <div class="thread__meta">
              <span>
                {(town?.name ?? "30A").toUpperCase()} · Asked {formatDate(question.createdAt)}
              </span>
              <span class="replies">{replies} {replies === 1 ? "reply" : "replies"}</span>
            </div>
            <h3>
              <a href={href(`/ask/${question.slug}`)}>{question.title}</a>
            </h3>
            <a class="view" href={href(`/ask/${question.slug}`)}>View Thread →</a>
          </article>
        ))
      }
    </div>

    <aside class="composer-card">
      <div class="composer-card__copy">
        <h3>Straight answers without the scroll</h3>
        <p>
          Ask residents about golf carts, walkovers, parking, dining, and trip logistics — then get
          replies from people who live on the corridor.
        </p>
      </div>
      <div class="composer-card__tools">
        <div class="prompts">
          {
            prompts.map((item) => (
              <a href={href(`/ask?q=${encodeURIComponent(item.q)}`)}>{item.label}</a>
            ))
          }
        </div>
        <form class="composer" action={href("/ask")} method="get">
          <label class="sr-only" for="community-ask-q">Ask the community</label>
          <input
            id="community-ask-q"
            name="q"
            type="search"
            placeholder="Ask anything about 30A…"
          />
          <button type="submit">Ask the Community →</button>
        </form>
      </div>
    </aside>
  </div>
</section>

<style>
  .advice {
    padding-block: clamp(2rem, 4vw, 3rem);
    background: #faf8f4;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--size-4);
    margin-bottom: var(--size-5);
  }
  .eyebrow {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-teal);
  }
  h2 {
    margin: 0;
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3vw, 2.1rem);
    font-weight: var(--font-weight-8);
    color: var(--brand-deep);
    line-height: 1.2;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }
  .ask-btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.5rem 1.15rem;
    border-radius: var(--radius-pill);
    background: var(--brand-deep);
    color: white;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
  }
  .ask-btn:hover {
    background: #163545;
    text-decoration: none;
  }
  .browse {
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .threads {
    display: grid;
    gap: var(--size-4);
    margin-bottom: var(--size-4);
  }
  .thread {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-4);
    box-shadow: var(--shadow-card);
    padding: 1rem 1.1rem;
    display: grid;
    align-content: start;
    gap: 0.35rem;
  }
  .thread__meta {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.625rem;
    font-weight: var(--font-weight-6);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
    line-height: 1.3;
  }
  .replies {
    color: var(--brand-teal);
    font-weight: var(--font-weight-7);
    white-space: nowrap;
  }
  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-2);
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
    line-height: 1.25;
  }
  h3 a {
    color: inherit;
  }
  h3 a:hover {
    color: var(--brand-teal);
    text-decoration: none;
  }
  .view {
    margin-top: 0.25rem;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .composer-card {
    display: grid;
    gap: var(--size-4);
    background: linear-gradient(160deg, #f1f6f8 0%, #e8eff2 100%);
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-4);
    padding: var(--size-4) var(--size-5);
  }
  .composer-card__copy h3 {
    margin: 0 0 0.35rem;
    font-size: var(--font-size-3);
  }
  .composer-card__copy p {
    margin: 0;
    max-width: 48rem;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
    line-height: 1.5;
  }
  .composer-card__tools {
    display: grid;
    gap: 0.75rem;
  }
  .prompts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .prompts a {
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-pill);
    background: white;
    border: 1px solid var(--brand-line);
    color: var(--brand-deep);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-6);
  }
  .prompts a:hover {
    border-color: var(--brand-teal);
    color: var(--brand-teal);
    text-decoration: none;
  }
  .composer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0.35rem;
    border-radius: var(--radius-3);
    background: white;
    border: 1px solid var(--brand-line);
  }
  .composer input {
    flex: 1 1 12rem;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 0.65rem 0.75rem;
    font: inherit;
    font-size: var(--font-size-1);
  }
  .composer input:focus {
    outline: none;
  }
  .composer button {
    border: 0;
    border-radius: var(--radius-2);
    background: var(--brand-teal);
    color: white;
    padding: 0.65rem 0.95rem;
    font: inherit;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    cursor: pointer;
    white-space: nowrap;
  }
  .composer button:hover {
    background: #00796b;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  @media (min-width: 900px) {
    .threads {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .composer-card {
      grid-template-columns: minmax(14rem, 0.9fr) minmax(0, 1.4fr);
      align-items: center;
    }
  }
</style>
