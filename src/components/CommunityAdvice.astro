---
import { reactionsFor } from "../data/catalog";
import { href } from "../lib/href";
import ReactionCluster from "./ReactionCluster.astro";
import SectionIntro from "./SectionIntro.astro";

interface Row {
  question: { slug: string; title: string; createdAt: string };
  town?: { name: string };
  replies?: number;
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;

function askedOn(iso: string) {
  return new Date(`${iso}T12:00:00`).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}
---

<section class="advice">
  <div class="container">
    <SectionIntro
      eyebrow="Community Questions"
      title="Ask the 30A Community"
      lede="Have a question about 30A? Get local insight, share recommendations, and connect with others who know the area."
      linkHref="/ask"
      link="Browse answers →"
    />

    <div class="threads h-scroll">
      {
        rows.slice(0, 3).map(({ question, town, replies = 0 }) => {
          return (
            <article class="thread">
              <h3>
                <a href={href(`/ask/${question.slug}`)}>{question.title}</a>
              </h3>
              <p class="town">{town?.name ?? "30A"}</p>
              <p class="meta">
                <time datetime={question.createdAt}>{askedOn(question.createdAt)}</time>
                <span>{replies} {replies === 1 ? "reply" : "replies"}</span>
                <ReactionCluster reactions={reactionsFor("question", question.slug)} />
              </p>
              <a class="view" href={href(`/ask/${question.slug}`)}>View Thread →</a>
            </article>
          );
        })
      }
    </div>

    <aside class="composer-card">
      <div class="composer-card__copy">
        <h3>Straight answers without the scroll</h3>
        <p>
          Ask residents about golf carts, walkovers, parking, dining, and trip logistics — then get
          replies from people who live on the corridor.
        </p>
      </div>
      <div class="composer-card__tools">
        <form class="composer" action={href("/ask")} method="get">
          <label class="sr-only" for="community-ask-q">Ask the community</label>
          <textarea
            id="community-ask-q"
            name="q"
            rows="2"
            placeholder="Ask anything about 30A…"
          ></textarea>
          <button type="submit" aria-label="Ask the community">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                d="M12 19V6M6.5 11.5 12 6l5.5 5.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </form>
      </div>
    </aside>
  </div>
</section>

<style>
  .advice {
    padding-block: clamp(2rem, 4vw, 3rem);
    background: #faf8f4;
  }
  .threads {
    margin-bottom: var(--size-4);
  }
  .thread {
    flex: 0 0 min(20rem, 85vw);
    width: min(20rem, 85vw);
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-4);
    box-shadow: var(--shadow-card);
    padding: 1rem 1.1rem;
    display: grid;
    align-content: start;
    gap: 0.35rem;
  }
  .town {
    margin: 0;
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  .thread h3 {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--font-size-2);
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
    line-height: 1.35;
  }
  .thread h3 a {
    color: inherit;
  }
  .thread h3 a:hover {
    text-decoration: none;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0;
    margin: 0.2rem 0 0;
    font-size: 0.6875rem;
    color: var(--brand-ink-soft);
    line-height: 1.4;
  }
  .meta > * + *::before {
    content: "·";
    margin: 0 0.4rem;
    color: #cbd5e1;
  }
  .view {
    justify-self: start;
    margin-top: 0.7rem;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    color: var(--brand-teal);
  }
  .view:hover {
    text-decoration: none;
  }
  .composer-card {
    display: grid;
    gap: var(--size-4);
    background: linear-gradient(160deg, #f1f6f8 0%, #e8eff2 100%);
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-4);
    padding: var(--size-4) var(--size-5);
  }
  .composer-card__copy h3 {
    margin: 0 0 0.35rem;
    font-size: var(--font-size-3);
  }
  .composer-card__copy p {
    margin: 0;
    max-width: 48rem;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
    line-height: 1.5;
  }
  .composer-card__tools {
    display: flex;
    min-width: 0;
    min-height: 0;
  }
  .composer {
    display: flex;
    align-items: flex-end;
    gap: 0.55rem;
    width: 100%;
    min-height: 5.5rem;
    padding: 0.7rem 0.7rem 0.7rem 1rem;
    border-radius: 1.35rem;
    background: white;
    border: 0;
  }
  .composer textarea {
    flex: 1 1 auto;
    align-self: stretch;
    min-width: 0;
    margin: 0;
    border: 0;
    resize: none;
    background: transparent;
    padding: 0.35rem 0.15rem;
    font: inherit;
    font-size: var(--font-size-1);
    line-height: 1.45;
    color: var(--brand-ink);
  }
  .composer textarea::placeholder {
    color: var(--brand-ink-soft);
  }
  .composer textarea:focus {
    outline: none;
  }
  .composer button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--brand-teal);
    color: white;
    line-height: 0;
    cursor: pointer;
    box-shadow: none;
  }
  .composer button:hover {
    background: #00796b;
  }
  .composer button svg {
    display: block;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  @media (min-width: 900px) {
    .threads {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      overflow: visible;
      scroll-snap-type: none;
      padding-bottom: 0;
    }
    .thread {
      flex: none;
      width: auto;
    }
    .composer-card {
      grid-template-columns: minmax(14rem, 0.9fr) minmax(0, 1.4fr);
      align-items: stretch;
    }
    .composer {
      height: 100%;
    }
  }
</style>
