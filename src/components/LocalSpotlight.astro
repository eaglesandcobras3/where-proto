---
import { href } from "../lib/href";

interface Props {
  href?: string;
}

const { href: ctaHref = "/search?q=bakery" } = Astro.props;
---

<section class="spotlight">
  <div class="container">
    <article class="card">
      <div class="media img-placeholder" aria-hidden="true">
        <span class="pin">Grayton Beach &amp; The Shops at Seaside</span>
      </div>
      <div class="copy">
        <div class="meta">
          <span class="badge">Local Spotlight of the Week</span>
          <span class="cat">Bakery &amp; Cafe</span>
        </div>
        <h2>Crafting Community: The Story of Black Bear Bread Co.</h2>
        <p class="quote">
          “From naturally fermented sourdough starters to bustling morning beach crowds, how Chef
          Phil McDonald created 30A’s favorite gathering spot.”
        </p>
        <p class="body">
          A Grayton institution that still feels like a neighborhood kitchen — loaves for the beach
          cooler, espresso for the bike path, and a morning line that locals swear by.
        </p>
        <div class="actions">
          <a class="cta" href={href(ctaHref)}>Learn more →</a>
          <span class="since">Featured Partner since 2022</span>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .spotlight {
    padding-block: var(--size-5);
  }
  .card {
    display: grid;
    gap: 0;
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-4);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .media {
    position: relative;
    min-height: 16rem;
    aspect-ratio: 4 / 3;
    border-radius: 0;
  }
  .pin {
    position: absolute;
    left: 0.85rem;
    bottom: 0.85rem;
    display: inline-flex;
    align-items: center;
    max-width: calc(100% - 1.7rem);
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-pill);
    background: white;
    color: var(--brand-ink);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-6);
    box-shadow: var(--shadow-card);
  }
  .copy {
    padding: clamp(1.25rem, 3vw, 2rem);
    display: grid;
    align-content: center;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: var(--size-3);
  }
  .badge {
    display: inline-flex;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--brand-teal-soft);
    color: var(--brand-teal);
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cat {
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  .cat::before {
    content: "·";
    margin-right: 0.55rem;
    color: var(--brand-line);
  }
  h2 {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: var(--font-weight-8);
    color: var(--brand-deep);
    line-height: 1.2;
  }
  .quote {
    margin: 0 0 var(--size-3);
    font-size: var(--font-size-2);
    font-style: italic;
    color: var(--brand-ink-soft);
    line-height: 1.5;
  }
  .body {
    margin: 0 0 var(--size-4);
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
    line-height: 1.55;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.25rem;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.65rem 1.25rem;
    border-radius: var(--radius-button);
    background: var(--brand-teal);
    color: white;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
  }
  .cta:hover {
    background: var(--brand-teal-hover);
    text-decoration: none;
  }
  .since {
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  @media (min-width: 900px) {
    .card {
      grid-template-columns: 1fr 1fr;
    }
    .media {
      min-height: 100%;
      aspect-ratio: auto;
    }
  }
</style>
