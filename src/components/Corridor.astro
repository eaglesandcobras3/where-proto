---
import { towns } from "../data/catalog";
import { href } from "../lib/href";

interface Props {
  /** When set, that town is “YOU ARE HERE”; omit on the towns hub */
  currentSlug?: string;
}

/** Approximate corridor mile markers west → east (wireframe). */
const mileBySlug: Record<string, number> = {
  sandestin: 0,
  "santa-rosa-beach": 2.2,
  "dune-allen-beach": 4.1,
  "gulf-place": 5.0,
  "blue-mountain-beach": 7.2,
  "grayton-beach": 9.0,
  watercolor: 10.5,
  seaside: 11.1,
  "seagrove-beach": 13.0,
  watersound: 16.1,
  "seacrest-beach": 17.0,
  "alys-beach": 18.7,
  "rosemary-beach": 20.0,
  "inlet-beach": 22.4,
  "carillon-beach": 23.8,
  "panama-city-beach": 28.0,
};

const { currentSlug } = Astro.props;
const currentMile = currentSlug ? (mileBySlug[currentSlug] ?? 0) : 0;

function formatMiles(delta: number) {
  const abs = Math.abs(delta);
  const label = abs.toFixed(1).replace(/\.0$/, "");
  return delta < 0 ? `${label} miles west` : `${label} miles east`;
}
---

<section class="corridor" aria-label="The 30A corridor">
  <div class="container">
    <p class="eyebrow">The 30A Corridor</p>
    <div class="scroller" data-corridor-scroller>
      <div class="track">
        {
          towns.map((item, index) => {
            const here = Boolean(currentSlug) && item.slug === currentSlug;
            const mile = mileBySlug[item.slug] ?? index;
            const meta = !currentSlug
              ? `Mi ${mile.toFixed(1).replace(/\.0$/, "")}`
              : here
                ? "You are here"
                : formatMiles(mile - currentMile);
            return (
              <a
                class:list={["item", { current: here }]}
                href={href(`/town/${item.slug}`)}
                aria-current={here ? "true" : undefined}
                data-corridor-item={here ? "current" : undefined}
              >
                <p class="name">{item.name}</p>
                <div class="dot img-placeholder" aria-hidden="true">
                  {item.name.charAt(0)}
                  {here && (
                    <span class="pin">
                      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                        <path
                          fill="currentColor"
                          d="M12 2c-3.3 0-6 2.6-6 5.8 0 4.4 6 11.7 6 11.7s6-7.3 6-11.7C18 4.6 15.3 2 12 2zm0 8.2a2.4 2.4 0 1 1 0-4.8 2.4 2.4 0 0 1 0 4.8z"
                        ></path>
                      </svg>
                    </span>
                  )}
                </div>
                <p class:list={["meta", { here }]}>{meta}</p>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

{
  currentSlug && (
    <script>
      const current = document.querySelector("[data-corridor-item='current']");
      current?.scrollIntoView({ inline: "center", block: "nearest", behavior: "auto" });
    </script>
  )
}

<style>
  .corridor {
    background: var(--brand-sand);
    border-bottom: 1px solid var(--brand-line);
    padding: var(--size-5) 0 var(--size-6);
  }
  .eyebrow {
    margin: 0 0 var(--size-4);
    font-family: var(--font-display);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-8);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-deep);
    text-align: center;
  }
  .scroller {
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
  }
  .track {
    --dot: 4.5rem;
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: safe center;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    min-width: max-content;
    margin-inline: auto;
    padding: 0.25rem 1rem 0.5rem;
  }
  .track::before {
    content: "";
    position: absolute;
    left: 1rem;
    right: 1rem;
    top: calc(1.35em + 0.55rem + var(--dot) / 2);
    height: 1px;
    background: var(--brand-line);
    pointer-events: none;
  }
  .item {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    width: 5.75rem;
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    text-align: center;
    color: var(--brand-deep);
    scroll-snap-align: center;
  }
  .item:hover {
    text-decoration: none;
  }
  .name {
    margin: 0;
    min-height: 2.4em;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-6);
    line-height: 1.2;
    color: var(--brand-deep);
  }
  .dot {
    position: relative;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    border: 3px solid white;
    box-shadow: 0 0 0 1px var(--brand-line);
    font-size: var(--font-size-3);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      border-color 160ms ease;
  }
  .item:hover .dot {
    transform: scale(1.06);
  }
  .item.current .name {
    font-weight: var(--font-weight-8);
  }
  .item.current .dot {
    --dot: 5.25rem;
    border-width: 4px;
    border-color: var(--brand-deep);
    box-shadow: none;
    font-size: var(--font-size-4);
  }
  .pin {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: white;
    background: rgba(12, 35, 46, 0.28);
    border-radius: 50%;
  }
  .meta {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: var(--font-weight-5);
    color: var(--brand-ink-soft);
    letter-spacing: 0.02em;
  }
  .meta.here {
    font-weight: var(--font-weight-8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-deep);
  }
</style>
