---
import { towns } from "../data/catalog";
import { href } from "../lib/href";

interface Props {
  /** When set, that town is “YOU ARE HERE”; omit on the towns hub */
  currentSlug?: string;
  /** Larger circles for the home beach-towns strip */
  size?: "default" | "large";
  /** Drop the corridor heading and page chrome when nested in another section */
  bare?: boolean;
  /** Scroll this town to the center on load, without marking it current */
  centerSlug?: string;
}

/** Approximate corridor mile markers west → east (wireframe). */
const mileBySlug: Record<string, number> = {
  sandestin: 0,
  "santa-rosa-beach": 2.2,
  "dune-allen-beach": 4.1,
  "gulf-place": 5.0,
  "blue-mountain-beach": 7.2,
  "grayton-beach": 9.0,
  watercolor: 10.5,
  seaside: 11.1,
  "seagrove-beach": 13.0,
  watersound: 16.1,
  "seacrest-beach": 17.0,
  "alys-beach": 18.7,
  "rosemary-beach": 20.0,
  "inlet-beach": 22.4,
  "carillon-beach": 23.8,
  "panama-city-beach": 28.0,
};

const { currentSlug, size = "default", bare = false, centerSlug } = Astro.props;
const Root = bare ? "div" : "section";
const currentMile = currentSlug ? (mileBySlug[currentSlug] ?? 0) : 0;

function formatMiles(delta: number) {
  const abs = Math.abs(delta);
  const label = abs.toFixed(1).replace(/\.0$/, "");
  return delta < 0 ? `${label} miles west` : `${label} miles east`;
}
---

<Root
  class:list={["corridor", { "corridor--bare": bare, "corridor--large": size === "large" }]}
  aria-label="The 30A corridor"
>
  <div class:list={[{ container: !bare }]}>
    {!bare && <p class="eyebrow">The 30A Corridor</p>}
    <div class="scroller" data-corridor-scroller>
      <div class="track">
        {
          towns.map((item, index) => {
            const here = Boolean(currentSlug) && item.slug === currentSlug;
            const mile = mileBySlug[item.slug] ?? index;
            const meta = !currentSlug
              ? `Mi ${mile.toFixed(1).replace(/\.0$/, "")}`
              : here
                ? "You are here"
                : formatMiles(mile - currentMile);
            return (
              <a
                class:list={["item", { current: here }]}
                href={href(`/town/${item.slug}`)}
                aria-current={here ? "true" : undefined}
                data-corridor-item={here ? "current" : item.slug === centerSlug ? "center" : undefined}
              >
                <p class="name">{item.name}</p>
                <div class="dot img-placeholder" aria-hidden="true">
                  {item.name.charAt(0)}
                  {here && (
                    <span class="pin">
                      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                        <path
                          fill="currentColor"
                          d="M12 2c-3.3 0-6 2.6-6 5.8 0 4.4 6 11.7 6 11.7s6-7.3 6-11.7C18 4.6 15.3 2 12 2zm0 8.2a2.4 2.4 0 1 1 0-4.8 2.4 2.4 0 0 1 0 4.8z"
                        ></path>
                      </svg>
                    </span>
                  )}
                </div>
                <p class:list={["meta", { here }]}>{meta}</p>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</Root>

<script>
  function placeCorridor(scroll: boolean) {
    document.querySelectorAll("[data-corridor-scroller]").forEach((scroller) => {
      if (!(scroller instanceof HTMLElement)) return;
      const track = scroller.querySelector(".track");
      const dots = scroller.querySelectorAll(".dot");
      if (!(track instanceof HTMLElement) || dots.length < 2) return;
      const trackRect = track.getBoundingClientRect();
      const first = dots[0].getBoundingClientRect();
      const last = dots[dots.length - 1].getBoundingClientRect();
      track.style.setProperty("--line-left", `${first.left + first.width / 2 - trackRect.left}px`);
      track.style.setProperty("--line-right", `${trackRect.right - (last.left + last.width / 2)}px`);
      if (!scroll) return;
      const item = scroller.querySelector("[data-corridor-item='current'], [data-corridor-item='center']");
      if (!(item instanceof HTMLElement)) return;
      const scrollerRect = scroller.getBoundingClientRect();
      const itemRect = item.getBoundingClientRect();
      scroller.scrollLeft += itemRect.left + itemRect.width / 2 - (scrollerRect.left + scrollerRect.width / 2);
    });
  }

  placeCorridor(true);
  document.fonts?.ready.then(() => placeCorridor(true));
</script>

<style>
  .corridor {
    background: var(--brand-sand);
    border-bottom: 1px solid var(--brand-line);
    padding: var(--size-5) 0 var(--size-6);
  }
  .eyebrow {
    margin: 0 0 var(--size-4);
    font-family: var(--font-display);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-8);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-deep);
    text-align: center;
  }
  .scroller {
    overflow-x: auto;
    overflow-y: clip;
    overflow-anchor: none;
    padding-bottom: 0.85rem;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(12, 35, 46, 0.35) transparent;
  }
  .scroller::-webkit-scrollbar {
    height: 4px;
  }
  .scroller::-webkit-scrollbar-track {
    background: transparent;
  }
  .scroller::-webkit-scrollbar-thumb {
    background: rgba(12, 35, 46, 0.35);
    border-radius: 999px;
  }
  .track {
    --dot: 4.5rem;
    --name-h: 2.1rem;
    --stack-gap: 0.45rem;
    --item: 7.25rem;
    --pad-top: 0.25rem;
    --pad-x: 1rem;
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: safe center;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    min-width: max-content;
    margin-inline: auto;
    padding: var(--pad-top) var(--pad-x) 0;
  }
  .track::before {
    content: "";
    position: absolute;
    left: var(--line-left, calc(var(--pad-x) + var(--item) / 2));
    right: var(--line-right, calc(var(--pad-x) + var(--item) / 2));
    top: calc(var(--pad-top) + var(--name-h) + var(--stack-gap) + var(--dot) / 2);
    height: 1px;
    background: var(--brand-line);
    transform: translateY(-50%);
    pointer-events: none;
  }
  .item {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    width: var(--item);
    display: grid;
    justify-items: center;
    gap: var(--stack-gap);
    text-align: center;
    color: var(--brand-deep);
    scroll-snap-align: center;
  }
  .item:hover {
    text-decoration: none;
  }
  .name {
    margin: 0;
    height: var(--name-h);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-6);
    line-height: 1.2;
    color: var(--brand-deep);
  }
  .dot {
    position: relative;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    border: 3px solid white;
    box-shadow: 0 0 0 1px var(--brand-line);
    font-size: var(--font-size-3);
    transition: transform 160ms ease;
  }
  .item:hover .dot {
    transform: scale(1.06);
  }
  .item.current .name {
    font-weight: var(--font-weight-8);
  }
  .item.current .dot {
    border-width: 4px;
    border-color: var(--brand-deep);
    box-shadow: none;
    font-size: var(--font-size-4);
  }
  .item.current:hover .dot {
    transform: scale(1.06);
  }
  .pin {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: white;
    background: rgba(12, 35, 46, 0.28);
    border-radius: 50%;
  }
  .meta {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: var(--font-weight-5);
    color: var(--brand-ink-soft);
    letter-spacing: 0.02em;
  }
  .meta.here {
    font-weight: var(--font-weight-8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-deep);
  }
  .corridor--bare {
    background: transparent;
    border: 0;
    padding: 0;
  }
  .corridor--large .track {
    --dot: 6.25rem;
    --name-h: 1.05rem;
    --stack-gap: 1.75rem;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    justify-content: flex-start;
    padding-bottom: 1.15rem;
  }
  .corridor--large .item {
    width: max-content;
    min-width: var(--dot);
  }
  .corridor--large .name {
    white-space: nowrap;
  }
  .corridor--large .scroller {
    scroll-snap-type: none;
  }
  .corridor--large .dot {
    font-size: var(--font-size-5);
    border-width: 3px;
  }
  .corridor--large .item.current .dot {
    --grow: 1.22;
    width: calc(var(--dot) * var(--grow));
    height: calc(var(--dot) * var(--grow));
    margin: calc(var(--dot) * (1 - var(--grow)) / 2);
    transform: none;
    transition: none;
    border-width: 1px;
    border-color: var(--brand-teal);
    font-size: var(--font-size-5);
  }
  .corridor--large .item.current:hover .dot {
    transform: none;
  }
  .corridor--large .meta {
    display: none;
  }
</style>
