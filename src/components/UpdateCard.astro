---
import { href } from "../lib/href";
import { areaBySlug, businessBySlug, townBySlug } from "../data/catalog";
import { formatThrough, updateTypeLabels } from "../lib/labels";
import { businessPath } from "../lib/listing";
import type { Update } from "../data/types";

interface Props {
  update: Update;
}

const { update } = Astro.props;
const business = update.businessSlug ? businessBySlug(update.businessSlug) : undefined;
const area = !business && update.areaSlug ? areaBySlug(update.areaSlug) : undefined;
const town = !business && !area && update.townSlug ? townBySlug(update.townSlug) : undefined;
const source = business
  ? { name: business.name, path: businessPath(business) }
  : area
    ? { name: area.name, path: `/area/${area.slug}` }
    : town
      ? { name: town.name, path: `/town/${town.slug}` }
      : undefined;
---

<article class="card" data-update-slug={update.slug}>
  <div class="top">
    <span class="type">{updateTypeLabels[update.type]}</span>
    <span class="when">Through {formatThrough(update.through)}</span>
  </div>
  {
    source && (
      <p class="source-name">
        <a href={href(source.path)}>{source.name}</a>
      </p>
    )
  }
  <h3>{update.title}</h3>
  <p>{update.body}</p>
</article>

<style>
  .card {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-card);
    padding: var(--size-4);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--size-3);
    margin-bottom: var(--size-2);
  }
  .type {
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.02em;
    color: var(--brand-teal);
    background: var(--brand-teal-soft);
    border-radius: var(--radius-4);
    padding: 2px var(--size-2);
  }
  .when {
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
    white-space: nowrap;
  }
  .source-name {
    margin: 0;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
  }
  .source-name a {
    color: var(--brand-deep);
  }
  h3 {
    font-size: var(--font-size-3);
    margin: var(--size-2) 0;
    color: var(--brand-deep);
  }
  p {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
    margin: 0;
  }
</style>
