---
import SearchBar from "./islands/SearchBar.svelte";

interface Named {
  slug: string;
  name: string;
}

interface Props {
  towns: Named[];
  base?: string;
}

const { towns, base = "/" } = Astro.props;
---

<section class="home-hero">
  <div class="home-hero__media img-placeholder" aria-hidden="true"></div>
  <div class="home-hero__veil" aria-hidden="true"></div>
  <div class="container home-hero__inner">
    <h1>A Better Way to Explore 30A</h1>
    <p class="lede">
      Less searching, more discovering. Easily find places to eat, shop, stay, and explore, plus local
      events, guides, and everything you need to make the most of 30A.
    </p>
    <SearchBar towns={towns} base={base} variant="inline" client:load />
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(3rem, 8vw, 5.5rem) 0 clamp(3rem, 6vw, 4.5rem);
  }
  .home-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: 0;
    background:
      linear-gradient(135deg, #7ec8c0 0%, #2a8f9e 38%, #0c232e 100%),
      var(--brand-map);
  }
  .home-hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(253, 252, 249, 0.82) 0%, rgba(253, 252, 249, 0.72) 45%, rgba(253, 252, 249, 0.88) 100%);
  }
  .home-hero__inner {
    position: relative;
    z-index: 2;
    max-width: none;
    text-align: center;
    display: grid;
    gap: var(--size-4);
    justify-items: center;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 4.6vw, 3.25rem);
    font-weight: var(--font-weight-8);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--brand-deep);
    max-width: 100%;
    white-space: nowrap;
  }
  .lede {
    margin: 0;
    max-width: 48rem;
    font-size: var(--font-size-2);
    line-height: 1.6;
    color: var(--brand-ink-soft);
  }
</style>
