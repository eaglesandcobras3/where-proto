---
import { href } from "../lib/href";
import type { Guide } from "../data/types";
import ListingTile from "./ListingTile.astro";

interface Props {
  guide: Guide;
  wide?: boolean;
}

const { guide, wide = false } = Astro.props;
---

<a class:list={["listing-card", { wide }]} href={href(`/guide/${guide.slug}`)}>
  <ListingTile label={guide.title.charAt(0)} alt="" wide={wide} />
  <div class="body">
    <h3>{guide.title}</h3>
    <p class="excerpt">{guide.summary}</p>
    <span class="read">Read guide</span>
  </div>
</a>

<style>
  .body {
    min-width: 0;
  }
  .body h3 {
    font-size: var(--font-size-2);
    margin-bottom: var(--size-1);
  }
  .excerpt {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
    margin: 0 0 var(--size-2);
  }
  .read {
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    color: var(--brand-teal);
  }
</style>
