---
import { businessesForTown, categories } from "../data/catalog";
import { href } from "../lib/href";

interface Props {
  townSlug: string;
  townName: string;
}

const { townSlug, townName } = Astro.props;
const inTown = businessesForTown(townSlug);
const groups = categories
  .filter((category) => category.slug !== "community" && category.slug !== "stay")
  .map((category) => {
    const listings = inTown.filter((item) => item.categorySlug === category.slug);
    return {
      slug: category.slug,
      name: category.name,
      count: listings.length,
      leaves: category.leaves
        .map((leaf) => ({
          slug: leaf.slug,
          name: leaf.name,
          count: listings.filter((item) => item.leafSlug === leaf.slug).length,
        }))
        .filter((leaf) => leaf.count > 0),
    };
  })
  .filter((category) => category.count > 0);
---

{
  groups.length > 0 && (
    <section class="cats">
      <p class="eyebrow">Businesses</p>
      <h2>Browse {townName}</h2>
      <div class="groups">
        {groups.map((group) => (
          <article class="group">
            <a class="group__head" href={href(`/town/${townSlug}/${group.slug}`)}>
              <h3>{group.name}</h3>
              <span class="count">{group.count}</span>
            </a>
            {group.leaves.length > 0 && (
              <ul>
                {group.leaves.map((leaf) => (
                  <li>
                    <a href={href(`/town/${townSlug}/${leaf.slug}`)}>
                      {leaf.name}
                      <span class="count">{leaf.count}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  .cats {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: var(--size-4);
  }
  h2 {
    margin: 0 0 var(--size-4);
  }
  .groups {
    display: grid;
    gap: var(--size-3);
  }
  .group {
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-card);
    padding: var(--size-3);
  }
  .group__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--size-3);
    color: var(--brand-ink);
  }
  .group__head:hover {
    text-decoration: none;
    color: var(--brand-teal);
  }
  h3 {
    margin: 0;
    font-size: var(--font-size-2);
  }
  ul {
    list-style: none;
    margin: var(--size-3) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  ul a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--brand-sand-dark);
    color: var(--brand-ink);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-6);
  }
  ul a:hover {
    text-decoration: none;
    background: var(--brand-teal-soft);
    color: var(--brand-teal);
  }
  .count {
    font-size: 0.6875rem;
    font-weight: var(--font-weight-6);
    color: var(--brand-ink-soft);
  }
  .group__head .count {
    background: var(--brand-sand-dark);
    border-radius: var(--radius-pill);
    padding: 0.15rem 0.45rem;
  }
</style>
