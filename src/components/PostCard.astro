---
import { href } from "../lib/href";
import { businessBySlug, userBySlug } from "../data/catalog";
import { formatDate, userHandle } from "../lib/labels";
import { businessPath, postPlace } from "../lib/listing";
import type { Post } from "../data/types";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const authorUser = post.authorUserSlug ? userBySlug(post.authorUserSlug) : undefined;
const authorBusiness =
  post.postedAs === "business" && post.authorBusinessSlug
    ? businessBySlug(post.authorBusinessSlug)
    : undefined;
const author = authorBusiness?.name ?? (authorUser ? userHandle(authorUser.slug) : "A visitor");
const authorHref = authorBusiness
  ? href(businessPath(authorBusiness))
  : authorUser
    ? href(`/u/${authorUser.slug}`)
    : undefined;
const place = postPlace(post);
---

<article class="card">
  <p class="meta">
    {
      authorHref ? <a href={authorHref}>{author}</a> : <span>{author}</span>
    }
    &middot; {formatDate(post.createdAt)} &middot;
    <a href={href(place.href)}>{place.kindLabel}</a>
  </p>
  <p>{post.body}</p>
  <p class="more">
    <a href={href(`/posts/${post.slug}`)}>Read post</a>
  </p>
</article>

<style>
  .card {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-card);
    padding: var(--size-4);
  }
  .meta {
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
    margin-bottom: var(--size-2);
  }
  .more {
    margin: var(--size-2) 0 0;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-6);
  }
</style>
