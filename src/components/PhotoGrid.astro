---
import MediaStrip from "./islands/MediaStrip.svelte";
import type { Photo } from "../data/types";

interface Props {
  photos: Photo[];
  empty?: string;
  scroll?: boolean;
}

const { photos, empty = "No photos yet", scroll = false } = Astro.props;
const items = photos.map((photo) => ({ kind: "photo" as const, label: photo.caption }));
---

<MediaStrip items={items} empty={empty} {scroll} client:visible />
