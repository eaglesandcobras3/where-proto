---
import GuideCard from "./GuideCard.astro";
import { href } from "../lib/href";
import type { Guide } from "../data/types";

interface Props {
  guides: Guide[];
}

const { guides } = Astro.props;
---

<section class="panel related-guides">
  <div class="panel__head">
    <h2>Related guides</h2>
    <a href={href("/guides")}>All guides</a>
  </div>
  {
    guides.length > 0 ? (
      <div class="listing-grid">
        {guides.map((guide) => (
          <GuideCard guide={guide} />
        ))}
      </div>
    ) : (
      <p class="empty">No related guides yet. Browse the field journal for corridor tips.</p>
    )
  }
</section>

<style>
  .panel {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-card);
    padding: var(--size-5);
  }
  .panel__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
    margin-bottom: var(--size-3);
  }
  h2 {
    margin: 0;
    font-size: var(--font-size-3);
  }
  .empty {
    margin: 0;
    color: var(--brand-ink-soft);
  }
</style>
