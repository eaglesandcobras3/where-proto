---
import Corridor from "./Corridor.astro";
import SectionIntro from "./SectionIntro.astro";
---

<section class="beach-towns">
  <div class="container">
    <SectionIntro
      eyebrow="Discover"
      title="Beach Towns of 30A"
      lede="Rosemary feels different from Grayton, and Seaside from WaterColor. Compare the towns, then dive into local listings and guides."
      linkHref="/towns"
      link="Explore all towns →"
    />

    <Corridor size="large" bare currentSlug="seaside" />
  </div>
</section>

<style>
  .beach-towns {
    background: #f0f4f5;
    padding-block: clamp(2rem, 4vw, 3rem);
  }
</style>
