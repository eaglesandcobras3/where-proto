---
import Corridor from "./Corridor.astro";
import SectionIntro from "./SectionIntro.astro";
---

<section class="beach-towns">
  <div class="container">
    <SectionIntro
      eyebrow="Beach Towns"
      title="Explore the Towns of 30A"
      lede="From iconic beach communities to laid-back coastal hideaways, discover the distinct character of each town along 30A."
      linkHref="/towns"
      link="Explore all towns →"
    />

    <Corridor size="large" bare currentSlug="seaside" />
  </div>
</section>

<style>
  .beach-towns {
    background: #f0f4f5;
    padding-block: clamp(2rem, 4vw, 3rem);
  }
</style>
