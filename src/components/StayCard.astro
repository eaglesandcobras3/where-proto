---
import { href } from "../lib/href";
import { townBySlug } from "../data/catalog";
import type { Stay } from "../data/types";
import ListingTile from "./ListingTile.astro";

interface Props {
  stay: Stay;
  wide?: boolean;
}

const { stay, wide = false } = Astro.props;
const town = townBySlug(stay.townSlug);
---

<a class:list={["listing-card", { wide }]} href={href(`/stay/${stay.slug}`)}>
  <ListingTile label={stay.name.charAt(0)} alt="" wide={wide} />
  <div class="body">
    <h3>{stay.name}</h3>
    <p class="meta">{town?.name ?? stay.townSlug} · Sleeps {stay.sleeps}</p>
    <p class="desc">{stay.summary}</p>
    <span class="explore">Explore →</span>
  </div>
</a>

<style>
  .body {
    min-width: 0;
  }
  .body h3 {
    font-size: var(--font-size-3);
    margin-bottom: var(--size-1);
  }
  .meta,
  .desc {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
    margin: 0 0 var(--size-1);
  }
  .desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .explore {
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
</style>
