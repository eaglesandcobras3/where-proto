---
interface Props {
  items: { href: string; label: string; meta?: string }[];
}

const { items } = Astro.props;
---

{
  items.length === 0 ? (
    <p>No fake items in this list yet.</p>
  ) : (
    <ul>
      {items.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
          {item.meta ? ` — ${item.meta}` : ""}
        </li>
      ))}
    </ul>
  )
}
