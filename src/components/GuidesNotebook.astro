---
import { href } from "../lib/href";
import { guides, reactionsFor, townBySlug } from "../data/catalog";
import ReactionCluster from "./ReactionCluster.astro";
import SectionIntro from "./SectionIntro.astro";

const cover = guides.find((item) => item.slug === "first-timers-guide") ?? guides[0];
const notebook = guides.filter((item) => item.slug !== cover?.slug).slice(0, 3);
---

<section class="guides-note">
  <div class="container">
    <SectionIntro
      eyebrow="Field Journal"
      title="Guides & Stories"
      lede="Cover story and morning notes from the corridor — towns, beach access, and how 30A actually works."
      linkHref="/guides"
      link="Browse all guides →"
    />

    <div class="layout">
      {
        cover && (
          <article class="cover">
            <div class="cover__media img-placeholder" aria-hidden="true">
              <span class="cover__badge">Cover Story</span>
              <span class="cover__place">Scenic Highway 30A</span>
            </div>
            <div class="cover__body">
              <p class="meta">
                30A · 8 min read
              </p>
              <h3>
                <a href={href(`/guide/${cover.slug}`)}>{cover.title}</a>
              </h3>
              <p class="quote">“{cover.summary}”</p>
              <ReactionCluster reactions={reactionsFor("guide", cover.slug)} />
              <a class="read" href={href(`/guide/${cover.slug}`)}>Read full guide →</a>
            </div>
          </article>
        )
      }

      <aside class="notebook">
        <ul>
          {
            notebook.map((guide) => {
              const town = guide.townSlug ? townBySlug(guide.townSlug) : undefined;
              return (
                <li>
                  <a href={href(`/guide/${guide.slug}`)}>
                    <div class="thumb img-placeholder" aria-hidden="true">
                      {guide.title.charAt(0)}
                    </div>
                    <div class="copy">
                      <p class="tag">
                        {town?.name ?? "30A"} · 4 min read
                      </p>
                      <p class="title">{guide.title}</p>
                      <p class="summary">{guide.summary}</p>
                      <ReactionCluster reactions={reactionsFor("guide", guide.slug)} />
                    </div>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .guides-note {
    padding-block: clamp(2rem, 4vw, 3rem);
    background: white;
  }
  .layout {
    display: grid;
    gap: var(--size-5);
    align-items: start;
  }
  .cover {
    display: grid;
    gap: var(--size-4);
    min-width: 0;
    align-items: center;
    justify-items: center;
    text-align: center;
  }
  .cover__media {
    position: relative;
    aspect-ratio: 3 / 4;
    width: 16rem;
    justify-self: center;
    border-radius: var(--radius-3);
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .cover__body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .cover__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    background: rgba(12, 35, 46, 0.9);
    color: white;
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cover__place {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-2);
    background: rgba(255, 255, 255, 0.92);
    color: var(--brand-deep);
    font-size: 0.625rem;
    font-weight: var(--font-weight-7);
  }
  .meta {
    margin: 0 0 0.35rem;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-teal);
  }
  .cover h3 {
    margin: 0 0 0.45rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    font-weight: var(--font-weight-8);
    line-height: 1.2;
    color: var(--brand-deep);
  }
  .cover h3 a {
    color: inherit;
  }
  .cover h3 a:hover {
    text-decoration: none;
  }
  .quote {
    margin: 0 0 0.35rem;
    font-size: var(--font-size-1);
    font-style: italic;
    color: var(--brand-ink-soft);
    line-height: 1.45;
  }
  .cover__body :global(.reactions) {
    margin: 0 0 0.65rem;
  }
  .copy :global(.reactions) {
    margin-top: 0.35rem;
  }
  .read {
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    color: var(--brand-teal);
  }
  .notebook {
    min-width: 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  li + li {
    border-top: 1px solid var(--brand-line);
    margin-top: var(--size-3);
    padding-top: var(--size-3);
  }
  li a {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    color: inherit;
  }
  li a:hover {
    text-decoration: none;
  }
  .thumb {
    aspect-ratio: 2 / 3;
    border-radius: var(--radius-2);
    font-size: var(--font-size-2);
  }
  .copy {
    min-width: 0;
  }
  .tag {
    margin: 0 0 0.15rem;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-teal);
    font-weight: var(--font-weight-7);
  }
  .title {
    margin: 0 0 0.2rem;
    font-family: var(--font-display);
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    line-height: 1.3;
    color: var(--brand-deep);
  }
  .summary {
    margin: 0;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .cover {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: var(--size-4);
      align-items: center;
      justify-items: stretch;
      text-align: left;
    }
    .cover__media {
      width: 16rem;
      aspect-ratio: 3 / 4;
      justify-self: start;
    }
    .cover__body {
      align-items: flex-start;
    }
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1.45fr) minmax(16rem, 1fr);
      gap: var(--size-6);
      align-items: stretch;
    }
    .cover {
      height: 100%;
      grid-template-columns: 16rem minmax(0, 1fr);
      align-items: center;
    }
    .cover__media {
      width: 16rem;
      aspect-ratio: 3 / 4;
      align-self: center;
    }
  }
</style>
