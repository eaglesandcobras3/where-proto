---
import { href } from "../../lib/href";

interface Props {
  active?: string;
  tone?: "dark" | "light";
}

const { active = "", tone = "dark" } = Astro.props;

const links = [
  { label: "Towns", path: "/towns", key: "towns" },
  { label: "Areas", path: "/areas", key: "areas" },
  { label: "Events", path: "/events", key: "events" },
  { label: "Stays", path: "/stays", key: "stays" },
  { label: "Guides", path: "/guides", key: "guides" },
];
---

<header class={`site-header ${tone === "light" ? "site-header--light" : ""}`}>
  <div class="site-header__bar">
    <a class="site-logo" href={href("/")}>WhereTo30A</a>
    <nav class="site-nav" aria-label="Primary">
      {
        links.map((link) => (
          <a href={href(link.path)} aria-current={active === link.key ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="site-header__actions">
      <a class="site-header__add" href={href("/add-business")}>Add business</a>
      <a class="site-icon-btn" href={href("/ask")} aria-label="Ask">↗</a>
      <a class="site-icon-btn" href={href("/search")} aria-label="Search">⌕</a>
      <button class="site-icon-btn site-icon-btn--menu" type="button" aria-label="Menu">≡</button>
    </div>
  </div>
</header>
