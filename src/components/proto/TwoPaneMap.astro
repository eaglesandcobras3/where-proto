---
interface Props {
  mapLabel?: string;
  pinCount?: number;
  initialMobileView?: "list" | "map";
}

const {
  mapLabel = "Map placeholder",
  pinCount = 18,
  initialMobileView = "list",
} = Astro.props;

const pins = Array.from({ length: pinCount }, (_, index) => index);
---

<div class="two-pane" data-two-pane data-mobile-view={initialMobileView}>
  <section class="two-pane__list" data-two-pane-list>
    <slot />
  </section>
  <aside class="two-pane__map" data-two-pane-map aria-label={mapLabel}>
    <div class="two-pane__zoom" aria-hidden="true">
      <span>+</span>
      <span>−</span>
    </div>
    <div class="two-pane__pins" aria-hidden="true">
      {pins.map(() => <span class="two-pane__pin" />)}
    </div>
    <p class="two-pane__map-label">{mapLabel}</p>
  </aside>
  <button class="two-pane__toggle" type="button" data-two-pane-toggle>
    Map
  </button>
</div>

<script>
  function bindTwoPane(root: HTMLElement) {
    const toggle = root.querySelector<HTMLButtonElement>("[data-two-pane-toggle]");
    if (!toggle) return;

    const setView = (view: "list" | "map") => {
      root.dataset.mobileView = view;
      toggle.textContent = view === "list" ? "Map" : "List";
    };

    setView((root.dataset.mobileView as "list" | "map") || "list");

    toggle.addEventListener("click", () => {
      const next = root.dataset.mobileView === "map" ? "list" : "map";
      setView(next);
    });
  }

  document.querySelectorAll<HTMLElement>("[data-two-pane]").forEach(bindTwoPane);
</script>
