---
import { categories, towns } from "../../data/catalog";

interface Props {
  town?: string;
  category?: string;
  group?: string;
  subcategory?: string;
  /** Start open to show the expanded panel */
  expanded?: boolean;
}

const {
  town = "Any town",
  category = "Any category",
  group = "",
  subcategory = "All in selected group",
  expanded = false,
} = Astro.props;

const selectedGroup =
  categories.find((item) => item.name === group || item.slug === group) ??
  categories.find((item) => item.name === category) ??
  categories[0];

const leaves = selectedGroup?.leaves ?? [];
const hasTown = Boolean(town && town !== "Any town");
const hasCategory = Boolean(category && category !== "Any category");
---

<div class="filter-band" data-filter-bar data-expanded={expanded ? "true" : "false"}>
  <!-- Collapsed: compact pill (town page style) -->
  <div class="filter-bar filter-bar--collapsed" aria-label="Filters collapsed">
    <button class="filter-bar__stack" type="button" data-filter-expand aria-expanded={expanded}>
      <span class="filter-bar__primary">{town}</span>
      <span class="filter-bar__secondary">{category}</span>
    </button>
    <span class="filter-bar__divider" aria-hidden="true"></span>
    <button
      class="filter-bar__btn"
      type="button"
      aria-label="Expand filters"
      data-filter-expand
    >
      <svg class="filter-bar__sliders" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          fill="currentColor"
          d="M4 7h10.2a2.5 2.5 0 0 0 4.6 0H20v-2h-1.2a2.5 2.5 0 0 0-4.6 0H4V7zm0 12h2.2a2.5 2.5 0 0 0 4.6 0H20v-2H10.8a2.5 2.5 0 0 0-4.6 0H4v2zm0-6h6.2a2.5 2.5 0 0 0 4.6 0H20v-2h-5.2a2.5 2.5 0 0 0-4.6 0H4v2z"
        ></path>
      </svg>
    </button>
  </div>

  <!-- Expanded: single white shell with town, category, Explore -->
  <div class="filter-bar filter-bar--expanded" aria-label="Filters expanded" hidden={!expanded}>
    <div class="filter-bar__shell">
      <div class="filter-field">
        <span class="filter-field__label">Town</span>
        <div class="filter-chip">
          <span>{town}</span>
          {
            hasTown && (
              <span class="filter-chip__x" aria-hidden="true">
                ×
              </span>
            )
          }
        </div>
        <label class="visually-hidden" for="filter-town">Town</label>
        <select id="filter-town" class="filter-field__select" disabled>
          <option selected={!hasTown}>Any town</option>
          {
            towns.map((item) => (
              <option selected={item.name === town}>{item.name}</option>
            ))
          }
        </select>
      </div>

      <div class="filter-field filter-field--category" data-filter-category>
        <span class="filter-field__label">Category</span>
        <div class="filter-chip">
          <span>{category}</span>
          {
            hasCategory && (
              <span class="filter-chip__x" aria-hidden="true">
                ×
              </span>
            )
          }
        </div>
        <label class="visually-hidden" for="filter-category-display">Category</label>
        <select id="filter-category-display" class="filter-field__select" disabled>
          <option selected={!hasCategory}>Any category</option>
          {
            categories.map((item) => (
              <option selected={item.name === category || item.name === selectedGroup?.name}>
                {item.name}
              </option>
            ))
          }
        </select>

        <div class="filter-panel" data-filter-panel>
          <label class="filter-panel__field">
            <span>Group</span>
            <select disabled>
              {
                categories.map((item) => (
                  <option selected={item.slug === selectedGroup?.slug}>{item.name}</option>
                ))
              }
            </select>
          </label>
          <label class="filter-panel__field">
            <span>Subcategory</span>
            <select disabled>
              <option selected>{subcategory}</option>
              {leaves.map((leaf) => <option>{leaf.name}</option>)}
            </select>
          </label>
        </div>
      </div>

      <button class="filter-bar__explore" type="button" disabled>Explore</button>
    </div>

    <button class="filter-bar__collapse" type="button" data-filter-collapse aria-label="Collapse filters">
      Collapse
    </button>
  </div>
</div>

<script>
  function bindFilterBar(root: HTMLElement) {
    const collapsed = root.querySelector<HTMLElement>(".filter-bar--collapsed");
    const expanded = root.querySelector<HTMLElement>(".filter-bar--expanded");
    if (!collapsed || !expanded) return;

    const setExpanded = (open: boolean) => {
      root.dataset.expanded = open ? "true" : "false";
      expanded.hidden = !open;
      collapsed.hidden = open;
      root.querySelectorAll<HTMLButtonElement>("[data-filter-expand]").forEach((btn) => {
        btn.setAttribute("aria-expanded", open ? "true" : "false");
      });
    };

    setExpanded(root.dataset.expanded === "true");

    root.querySelectorAll("[data-filter-expand]").forEach((el) => {
      el.addEventListener("click", () => setExpanded(true));
    });

    root.querySelectorAll("[data-filter-collapse]").forEach((el) => {
      el.addEventListener("click", () => setExpanded(false));
    });
  }

  document.querySelectorAll<HTMLElement>("[data-filter-bar]").forEach(bindFilterBar);
</script>
