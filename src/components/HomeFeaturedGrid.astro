---
import { href } from "../lib/href";

const items = [
  {
    name: "Beach Cow Creamery",
    category: "Bakeries & Desserts",
    summary:
      "Beach Cow Creamery serves up hand-dipped ice cream, milkshakes, and sweet treats in the heart of Peddlers Pavilion in Seacrest Beach.",
    href: "/search?q=Beach+Cow+Creamery",
  },
  {
    name: "Ascension Medical Group Sacred Heart at 30A",
    category: "Medical Clinics",
    summary:
      "Ascension Medical Group Sacred Heart at 30A provides primary care, internal medicine, and wellness services in Inlet Beach.",
    href: "/search?q=Ascension+Medical",
  },
  {
    name: "Fiddle Haus",
    category: "Boutiques & Apparel",
    summary:
      "Fiddle Haus is a cozy coastal boutique at The Big Chill featuring curated women’s apparel, loungewear, home decor, and gifts.",
    href: "/search?q=Fiddle+Haus",
  },
  {
    name: "Amavida Donuts",
    category: "Bakeries & Desserts",
    summary:
      "Handcrafted artisan donuts, specialty cold brew, and sweet treats served from a vintage food truck in Seaside’s Central Square.",
    href: "/business/amavida",
  },
];
---

<section class="featured">
  <div class="container">
    <div class="scroller">
    <div class="grid">
      {
        items.map((item) => (
          <a class="card" href={href(item.href)}>
            <div class="media img-placeholder" aria-hidden="true">
              <span>{item.name.charAt(0)}</span>
            </div>
            <p class="cat">{item.category}</p>
            <h3>{item.name}</h3>
            <p class="summary">{item.summary}</p>
            <span class="explore">Explore →</span>
          </a>
        ))
      }
    </div>
    </div>
  </div>
</section>

<style>
  .featured {
    padding-block: var(--size-5) var(--size-6);
  }
  .scroller {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }
  .grid {
    display: grid;
    gap: var(--size-5);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    min-width: 56rem;
    width: 100%;
  }
  .card {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    color: inherit;
    min-width: 0;
  }
  .card:hover {
    text-decoration: none;
  }
  .card:hover h3 {
    color: var(--brand-teal);
  }
  .media {
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-3);
    margin-bottom: 0.35rem;
    font-size: var(--font-size-5);
  }
  .cat {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: var(--font-weight-7);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-3);
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
    line-height: 1.25;
  }
  .summary {
    margin: 0;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .explore {
    margin-top: 0.15rem;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
</style>
