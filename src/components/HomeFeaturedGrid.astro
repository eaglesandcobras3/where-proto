---
import { reactionsFor } from "../data/catalog";
import { href } from "../lib/href";
import { businessPathBySlug } from "../lib/listing";
import ReactionCluster from "./ReactionCluster.astro";

const items = [
  {
    slug: "beach-cow-creamery",
    name: "Beach Cow Creamery",
    town: "Seacrest Beach",
    category: "Bakeries & Desserts",
    summary:
      "Beach Cow Creamery serves up hand-dipped ice cream, milkshakes, and sweet treats in the heart of Peddlers Pavilion in Seacrest Beach.",
    href: businessPathBySlug("beach-cow-creamery"),
  },
  {
    slug: "ascension-sacred-heart-30a",
    name: "Ascension Medical Group Sacred Heart at 30A",
    town: "Inlet Beach",
    category: "Medical Clinics",
    summary:
      "Ascension Medical Group Sacred Heart at 30A provides primary care, internal medicine, and wellness services in Inlet Beach.",
    href: businessPathBySlug("ascension-sacred-heart-30a"),
  },
  {
    slug: "fiddle-haus",
    name: "Fiddle Haus",
    town: "Seacrest Beach",
    category: "Boutiques & Apparel",
    summary:
      "Fiddle Haus is a cozy coastal boutique at The Big Chill featuring curated women’s apparel, loungewear, home decor, and gifts.",
    href: businessPathBySlug("fiddle-haus"),
  },
  {
    slug: "amavida-donuts",
    name: "Amavida Donuts",
    town: "Seaside",
    category: "Bakeries & Desserts",
    summary:
      "Handcrafted artisan donuts, specialty cold brew, and sweet treats served from a vintage food truck in Seaside’s Central Square.",
    href: businessPathBySlug("amavida-donuts"),
  },
];
---

<section class="featured">
  <div class="container">
    <div class="grid">
      {
        items.map((item) => (
          <a class="card" href={href(item.href)}>
            <div class="media img-placeholder" aria-hidden="true">
              <span>{item.name.charAt(0)}</span>
            </div>
            <p class="cat">{item.category}</p>
            <h3>{item.name}</h3>
            <p class="town">{item.town}</p>
            <ReactionCluster reactions={reactionsFor("business", item.slug)} />
            <p class="summary">{item.summary}</p>
            <span class="explore">Explore →</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .featured {
    padding-block: var(--size-5) var(--size-6);
  }
  .grid {
    display: grid;
    gap: var(--size-4);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .card {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    color: inherit;
    min-width: 0;
    border: 0;
    box-shadow: none;
    background: transparent;
  }
  .card:hover {
    text-decoration: none;
  }
  .media {
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-3);
    margin-bottom: 0.35rem;
    font-size: var(--font-size-5);
  }
  .cat {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: var(--font-weight-7);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-3);
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
    line-height: 1.25;
  }
  .town {
    margin: 0;
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  .summary {
    margin: 0;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .explore {
    margin-top: 0.15rem;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    color: var(--brand-teal);
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--size-5);
    }
  }
</style>
