---
import { href } from "../lib/href";

const trending = [
  { label: "Sunset cocktails in Seaside", q: "Sunset cocktails in Seaside" },
  { label: "Dog-friendly beaches today", q: "Dog-friendly beaches today" },
  { label: "Where to rent bikes in WaterColor", q: "Where to rent bikes in WaterColor" },
  { label: "Best seafood without reservations", q: "Best seafood without reservations" },
];
---

<section class="ask-callout">
  <div class="container">
    <div class="panel">
      <div class="panel__top">
        <div class="badges">
          <span class="badge-ai">Ask 30A Community AI</span>
          <span class="badge-verify">Local &amp; 24/7 verified guide</span>
        </div>
      </div>

      <h2>Curated answers in seconds without forum clutter</h2>
      <p class="lede">
        Get instant tailored recommendations powered by verified coastal guides, local secrets, and
        real-time corridor know-how.
      </p>

      <div class="trending">
        <span class="trending__label">Trending</span>
        <div class="trending__chips">
          {
            trending.map((item) => (
              <a class="chip" href={href(`/ask?q=${encodeURIComponent(item.q)}`)}>
                {item.label}
              </a>
            ))
          }
        </div>
      </div>

      <form class="composer" action={href("/ask")} method="get">
        <label class="sr-only" for="home-ask-q">Ask the 30A community</label>
        <input
          id="home-ask-q"
          name="q"
          type="search"
          placeholder="Ask anything: “Where should we take a family of 6 for brunch in Rosemary?”"
        />
        <button type="submit">Ask AI Concierge</button>
      </form>
    </div>
  </div>
</section>

<style>
  .ask-callout {
    padding-block: var(--size-5);
  }
  .panel {
    background: #eef1f4;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-4);
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .panel__top {
    margin-bottom: var(--size-4);
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1rem;
  }
  .badge-ai {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--brand-selected-soft);
    color: var(--brand-selected);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-8);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .badge-verify {
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--brand-teal);
  }
  h2 {
    margin: 0 0 0.65rem;
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3.5vw, 2.35rem);
    font-weight: var(--font-weight-8);
    color: var(--brand-deep);
    line-height: 1.15;
  }
  .lede {
    margin: 0 0 var(--size-4);
    max-width: 52ch;
    font-size: var(--font-size-2);
    color: var(--brand-ink-soft);
    line-height: 1.55;
  }
  .trending {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: var(--size-4);
  }
  .trending__label {
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-8);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .trending__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-pill);
    background: white;
    border: 1px solid var(--brand-line);
    color: var(--brand-ink);
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-5);
  }
  .chip:hover {
    border-color: var(--brand-selected);
    color: var(--brand-selected);
    text-decoration: none;
  }
  .composer {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.5rem;
    padding: 0.4rem;
    border-radius: var(--radius-pill);
    background: white;
    border: 1px solid var(--brand-line);
    box-shadow: var(--shadow-card);
  }
  .composer input {
    flex: 1 1 14rem;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 0.75rem 1rem;
    font: inherit;
    font-size: var(--font-size-1);
    color: var(--brand-ink);
  }
  .composer input::placeholder {
    color: var(--brand-ink-soft);
  }
  .composer input:focus {
    outline: none;
  }
  .composer button {
    flex: 0 0 auto;
    border: 0;
    border-radius: var(--radius-pill);
    padding: 0.75rem 1.25rem;
    background: var(--brand-teal);
    color: white;
    font: inherit;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    cursor: pointer;
  }
  .composer button:hover {
    background: #00796b;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
