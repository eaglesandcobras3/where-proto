---
import HomeEventsGrid from "./islands/HomeEventsGrid.svelte";
import { href } from "../lib/href";
import { townBySlug } from "../data/catalog";
import type { EventItem } from "../data/types";

interface Item {
  event: EventItem;
  badge: string;
  badgeTone: "blue" | "teal" | "mint";
  footerTag: string;
  whenLabel: string;
  types: string[];
}

interface Props {
  items: Item[];
  base?: string;
}

const { items, base = "/" } = Astro.props;

const cards = items.map((item) => {
  const town = item.event.townSlug ? townBySlug(item.event.townSlug) : undefined;
  return {
    slug: item.event.slug,
    name: item.event.name,
    summary: item.event.summary,
    venue: item.event.venue ?? town?.name ?? "30A",
    whenLabel: item.whenLabel,
    badge: item.badge,
    badgeTone: item.badgeTone,
    footerTag: item.footerTag,
    types: item.types,
  };
});
---

<section class="events-home">
  <div class="container">
    <header class="head">
      <div>
        <p class="eyebrow">Community Calendar</p>
        <h2>30A Events &amp; Latest Happenings</h2>
        <p class="lede">
          Live acoustic sets on the lawn, open-air farmer markets, and dune lake excursions.
        </p>
      </div>
      <a class="all" href={href("/events")}>Full calendar →</a>
    </header>

    <HomeEventsGrid items={cards} base={base} client:load />
  </div>
</section>

<style>
  .events-home {
    padding-block: clamp(2rem, 4vw, 3rem);
    background: var(--brand-sand);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--size-4);
    margin-bottom: var(--size-4);
  }
  .eyebrow {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-teal);
  }
  h2 {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.15rem);
    font-weight: var(--font-weight-8);
    color: var(--brand-deep);
  }
  .lede {
    margin: 0;
    max-width: 40rem;
    font-size: var(--font-size-2);
    line-height: 1.55;
    color: var(--brand-ink-soft);
  }
  .all {
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    color: var(--brand-teal);
    white-space: nowrap;
  }
</style>
