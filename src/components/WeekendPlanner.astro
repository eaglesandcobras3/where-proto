---
import HomeEventsGrid from "./islands/HomeEventsGrid.svelte";
import SectionIntro from "./SectionIntro.astro";
import { reactionsFor, townBySlug } from "../data/catalog";
import type { EventItem } from "../data/types";

interface Item {
  event: EventItem;
  whenLabel: string;
  types: string[];
}

interface Props {
  items: Item[];
  base?: string;
}

const { items, base = "/" } = Astro.props;

const cards = items.map((item) => {
  const town = item.event.townSlug ? townBySlug(item.event.townSlug) : undefined;
  return {
    slug: item.event.slug,
    name: item.event.name,
    summary: item.event.summary,
    town: town?.name ?? "30A",
    venue: item.event.venue ?? "",
    whenLabel: item.whenLabel,
    types: item.types,
    reactions: reactionsFor("event", item.event.slug),
  };
});
---

<section class="events-home">
  <div class="container">
    <SectionIntro
      eyebrow="Community Calendar"
      title="30A Events & Latest Happenings"
      lede="Live acoustic sets on the lawn, open-air farmer markets, and dune lake excursions."
      linkHref="/events"
      link="Full calendar →"
    />

    <HomeEventsGrid items={cards} base={base} client:load />
  </div>
</section>

<style>
  .events-home {
    padding-block: clamp(2rem, 4vw, 3rem);
    background: var(--brand-sand);
  }
</style>
