---
/** Site-wide beach flag + weather strip (wireframe static values). */
const flagLabel = "Yellow";
const flagFull = "Yellow Flag: Moderate Surf";
const flagHref = "https://www.visitsouthwalton.com/beach-safety/";
const low = "68°";
const high = "79°";
const sunrise = "6:48a";
const sunset = "6:18p";
const sunriseFull = "Sunrise 6:48 AM";
const sunsetFull = "Sunset 6:18 PM";
---

<div class="conditions" aria-label="Beach and weather conditions">
  <div class="container conditions__inner">
    <a
      class="conditions__flag"
      href={flagHref}
      target="_blank"
      rel="noopener noreferrer"
      title={flagFull}
      aria-label={flagFull}
    >
      <span class="dot" aria-hidden="true"></span>
      <span class="flag-text">{flagLabel}</span>
    </a>

    <span class="sep" aria-hidden="true">·</span>

    <p class="conditions__temps">
      <span title={`Low ${low}`}>
        <span class="icon" aria-hidden="true">↓</span>
        <span class="sr-only">Low </span>{low}
      </span>
      <span title={`High ${high}`}>
        <span class="icon" aria-hidden="true">↑</span>
        <span class="sr-only">High </span>{high}
      </span>
    </p>

    <span class="sep" aria-hidden="true">·</span>

    <p class="conditions__sun">
      <span title={sunriseFull}>
        <svg class="sun-icon" viewBox="0 0 24 24" width="13" height="13" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 18h16M8 18a4 4 0 0 1 8 0M12 4v3M6.5 8.5 8 10M17.5 8.5 16 10"
          ></path>
        </svg>
        <span class="sr-only">Sunrise </span>{sunrise}
      </span>
      <span title={sunsetFull}>
        <svg class="sun-icon" viewBox="0 0 24 24" width="13" height="13" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 18h16M8 18a4 4 0 0 1 8 0M12 12V9M6.5 13.5 8 12M17.5 13.5 16 12"
          ></path>
        </svg>
        <span class="sr-only">Sunset </span>{sunset}
      </span>
    </p>
  </div>
</div>

<style>
  .conditions {
    background: white;
    border-bottom: 1px solid var(--brand-line);
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
    min-height: var(--conditions-h);
  }
  .conditions__inner {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0.4rem;
    min-height: var(--conditions-h);
    padding-block: 0.35rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .conditions__inner::-webkit-scrollbar {
    display: none;
  }
  .conditions__temps,
  .conditions__sun,
  .conditions__flag {
    margin: 0;
    display: inline-flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    flex: 0 0 auto;
  }
  .conditions__flag {
    gap: 0.35rem;
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .conditions__flag:hover {
    color: var(--brand-teal);
  }
  .conditions__temps > span,
  .conditions__sun > span {
    display: inline-flex;
    align-items: center;
    gap: 0.12rem;
  }
  .icon {
    font-size: 0.75em;
    font-weight: var(--font-weight-7);
    line-height: 1;
    color: var(--brand-ink-soft);
  }
  .sun-icon {
    display: block;
    flex-shrink: 0;
    color: var(--brand-ink-soft);
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--brand-sun);
    flex-shrink: 0;
  }
  .sep {
    color: var(--brand-ink-on-navy);
    flex: 0 0 auto;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  @media (min-width: 720px) {
    .conditions__inner {
      gap: 0.55rem;
      overflow: visible;
    }
    .flag-text::after {
      content: " Flag";
    }
  }
</style>
