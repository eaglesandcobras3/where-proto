---
/** Site-wide beach flag + weather strip (wireframe static values). */
const flag = "Yellow Flag: Moderate Surf";
const flagHref = "https://www.visitsouthwalton.com/beach-safety/";
const low = "68°";
const high = "79°";
const sunrise = "6:48 AM";
const sunset = "6:18 PM";
---

<div class="conditions" aria-label="Beach and weather conditions">
  <div class="container conditions__frame">
    <div class="conditions__inner h-scroll">
      <div class="conditions__left">
        <a class="conditions__flag" href={flagHref} target="_blank" rel="noopener noreferrer">
          <span class="dot" aria-hidden="true"></span>
          {flag}
        </a>
        <p class="conditions__temps">
          <span>Low {low}</span>
          <span class="sep" aria-hidden="true">·</span>
          <span>High {high}</span>
        </p>
      </div>
      <p class="conditions__sun">
        <span>Sunrise {sunrise}</span>
        <span class="sep" aria-hidden="true">·</span>
        <span>Sunset {sunset}</span>
      </p>
    </div>
  </div>
</div>

<style>
  .conditions {
    background: white;
    border-bottom: 1px solid var(--brand-line);
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
    min-height: var(--conditions-h);
  }
  .conditions__frame {
    min-height: var(--conditions-h);
    padding-block: 0.4rem;
  }
  .conditions__inner {
    gap: 0.35rem 1.25rem;
    align-items: center;
    min-height: calc(var(--conditions-h) - 0.8rem);
    scroll-snap-type: x proximity;
  }
  .conditions__left,
  .conditions__temps,
  .conditions__sun,
  .conditions__flag {
    margin: 0;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.35rem 0.45rem;
    white-space: nowrap;
  }
  .conditions__left {
    gap: 0.35rem 1rem;
    flex: 0 0 auto;
  }
  .conditions__flag {
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .conditions__flag:hover {
    color: var(--brand-teal);
  }
  .conditions__sun {
    margin-left: auto;
    flex: 0 0 auto;
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--brand-sun);
    flex-shrink: 0;
  }
  .sep {
    color: var(--brand-ink-on-navy);
  }
  @media (min-width: 720px) {
    .conditions__inner {
      justify-content: space-between;
      overflow: visible;
      scroll-snap-type: none;
      padding-bottom: 0;
    }
  }
</style>
