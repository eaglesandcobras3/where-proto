---
/** Site-wide beach flag + weather strip (wireframe static values). */
const flag = "Yellow Flag: Moderate Surf";
const gulf = "76°F Gulf Temp";
const sky = "Sunny 78°F";
const tide = "Low Tide 1:14 PM";
---

<div class="conditions" role="status" aria-label="Beach and weather conditions">
  <div class="container conditions__inner">
    <p class="conditions__flag">
      <span class="dot" aria-hidden="true"></span>
      {flag}
      <span class="sep">·</span>
      {gulf}
    </p>
    <p class="conditions__weather">
      {sky}
      <span class="sep">·</span>
      {tide}
    </p>
  </div>
</div>

<style>
  .conditions {
    background: white;
    border-bottom: 1px solid var(--brand-line);
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
    min-height: var(--conditions-h);
  }
  .conditions__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem 1.25rem;
    align-items: center;
    min-height: var(--conditions-h);
    padding-block: 0.4rem;
  }
  .conditions__flag,
  .conditions__weather {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.45rem;
  }
  .conditions__flag {
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--brand-sun);
    flex-shrink: 0;
  }
  .sep {
    color: #94a3b8;
  }
</style>
