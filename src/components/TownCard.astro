---
import { href } from "../lib/href";
import type { Town } from "../data/types";
import ListingTile from "./ListingTile.astro";

interface Props {
  town: Town;
  wide?: boolean;
}

const { town, wide = false } = Astro.props;
---

<a class:list={["listing-card", { wide }]} href={href(`/town/${town.slug}`)}>
  <ListingTile label={town.name.charAt(0)} alt="" wide={wide} />
  <div class="body">
    <h3>{town.name}</h3>
    <p>{town.summary}</p>
    <span class="explore">Explore →</span>
  </div>
</a>

<style>
  .body {
    min-width: 0;
  }
  .body h3 {
    font-size: var(--font-size-3);
    margin-bottom: var(--size-1);
  }
  .body p {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
    margin: 0 0 var(--size-2);
  }
  .explore {
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    color: var(--brand-teal);
  }
</style>
