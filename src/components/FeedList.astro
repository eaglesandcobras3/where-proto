---
import { businessBySlug, reactionsFor, userBySlug } from "../data/catalog";
import type { Post } from "../data/types";
import { href } from "../lib/href";

interface Props {
  items: Post[];
}

const { items } = Astro.props;
---

{
  items.length === 0 ? (
    <p>No fake feed posts here yet.</p>
  ) : (
    <ul>
      {items.map((post) => {
        const author =
          post.postedAs === "business"
            ? businessBySlug(post.authorBusinessSlug ?? "")?.name
            : userBySlug(post.authorUserSlug ?? "")?.name;
        const reactionText = reactionsFor("post", post.slug)
          .map((item) => `${item.label} ${item.count}`)
          .join(" · ");
        return (
          <li>
            <a href={href(`/posts/${post.slug}`)}>{post.body}</a>
            <br />
            {author} · posted as {post.postedAs} · {post.createdAt}
            {reactionText ? ` · ${reactionText}` : ""}
          </li>
        );
      })}
    </ul>
  )
}
