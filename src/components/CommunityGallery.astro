    handle: "@gulf_light",
    title: "Western Lake",
    alt: "Paddleboarders along Western Lake in WaterColor",
    src: "https://lh3.googleusercontent.com/aida-public/AB6AXuAChaO5qGo8SSUMMe4IESwpFoUueaRzlI93UMOqny7I4lKLkLqlC_GkmMnFnIg2gTZEUXw6Caup-3W6kpnot4eyludgenNBrIC3nluJWh1YXfVMwwQRdVo-QFAXIAEyuMrmwtSzenMYRYm7_5D-C7Lb_68ilMcYBREcXgbclaw7Vd7nqt214p2Zv5eP5MJGQH-Nkh4iHyc6tNFdeTHe1tJJ9kbghZFfSLVZZhqna4O96n9gYGs_cQ_X",
  },
  {
    town: "Seaside",
    handle: "@dune_wanderer",
    title: "Emerald Shore",
    alt: "Crystal waters along Seaside beach walkover",
    src: "https://lh3.googleusercontent.com/aida-public/AB6AXuC-S5n4GjbrTdRUPG27wbhkjWRNX_LW2HI3UJgvwOK0Xnhp1u5ibkFuLeVnCHN_xY6srqNdpriCZ6sn7xoAWZfc9JXPllA2Xa7Yp_M5S7LbSZp1M-vwiYVHYVVfpBd7akiLPFVDMFEmPfDJhkmQHKi-2DNCc8DuZA2GZ8BZDo3W0tBYuSG574F7lOYRpjvN4kUfJsC-dni1yHHAXuPimNY1w7uDdNKXtO1XIEfAKQt6ipMjEsD9mxwn",
