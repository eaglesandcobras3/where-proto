  src: "https://lh3.googleusercontent.com/aida-public/AB6AXuBI5AuKpAidiYVUNuwm4YGGvuoyyxGFhPLknupr0ew8GimuDXfpHEDkVv-_cEApAMVZPQ7OConXhNimWulMn5cbrxXbWr8_XiZAdk2wDr0jh-I5xi19P4g_i4zRFfgieGrJCOr5-mAlrWRiUkS0zm3aGcF2-6q8xta8ew8rvHOwwpX8BKQpWrZhBxnG67ACOruTSnJ3tVRIhTIPbEeWpxONFstwBripIIR9UJBK6Sq6dOSv4gi0twVA",
};

const shots = [
  {
    town: "Alys Beach",
    handle: "@alys_living",
    title: "Courtyard Vistas",
