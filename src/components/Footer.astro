---
import { areas, categories, towns } from "../data/catalog";
import { href } from "../lib/href";

const companyLinks = [
  { label: "About", path: "/about" },
  { label: "Travel guides", path: "/guides" },
  { label: "Events", path: "/events" },
  { label: "Stays", path: "/stays" },
  { label: "Businesses", path: "/search" },
  { label: "Updates", path: "/updates" },
  { label: "List your business", path: "/add-business" },
  { label: "Advertise", path: "/advertise" },
  { label: "Privacy", path: "/legal/privacy" },
  { label: "Terms", path: "/legal/terms" },
];

const shoppingAreas = areas.filter((item) => item.kind === "shopping").slice(0, 6);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="brand-block">
      <a class="logo" href={href("/")}>WhereTo<span>30A</span></a>
      <p>Your local guide to 30A and Florida's Emerald Coast. Curated listings, town guides, and hand-picked local favorites.</p>
      <div class="social">
        <a href={href("/about")} aria-label="About">AB</a>
        <a href={href("/ask")} aria-label="Ask locals">ASK</a>
      </div>
    </div>

    <nav class="col" aria-label="Towns">
      <h4>Towns</h4>
      <ul>
        {towns.map((town) => (
          <li>
            <a href={href(`/town/${town.slug}`)}>{town.name}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="col" aria-label="Areas">
      <h4>Areas</h4>
      <ul>
        {shoppingAreas.map((area) => (
          <li>
            <a href={href(`/area/${area.slug}`)}>{area.name}</a>
          </li>
        ))}
        <li>
          <a href={href("/areas")}>All areas</a>
        </li>
      </ul>
    </nav>

    <nav class="col" aria-label="Businesses">
      <h4>Businesses</h4>
      <ul>
        {categories.map((category) => (
          <li>
            <a href={href("/search")}>{category.name}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="col" aria-label="Company">
      <h4>Company</h4>
      <ul>
        {companyLinks.map((link) => (
          <li>
            <a href={href(link.path)}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="container bottom-bar">
    <span>
      &copy; 2026 WhereTo30A &middot; <a href={href("/legal/terms")}>Terms</a> &middot;
      <a href={href("/legal/privacy")}>Privacy</a> &middot; <a href={href("/ia")}>All routes</a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--brand-line);
    margin-top: var(--size-10);
    padding-top: var(--size-8);
    background: var(--brand-sand);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--size-6);
  }
  .logo {
    font-size: var(--font-size-4);
    font-weight: var(--font-weight-8);
    font-style: italic;
    color: var(--brand-deep);
    text-decoration: none;
  }
  .logo span {
    color: var(--brand-teal);
  }
  .brand-block p {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
    max-width: 28ch;
  }
  .social {
    display: flex;
    gap: var(--size-2);
    margin-top: var(--size-3);
  }
  .social a {
    min-width: 36px;
    height: 36px;
    padding-inline: var(--size-2);
    border: 1px solid var(--brand-line);
    border-radius: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    color: var(--brand-ink-soft);
  }
  .col h4 {
    font-size: var(--font-size-0);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
    margin-bottom: var(--size-3);
  }
  .col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .col li {
    margin-bottom: var(--size-2);
  }
  .col a {
    font-size: var(--font-size-1);
    color: var(--brand-ink);
  }
  .bottom-bar {
    border-top: 1px solid var(--brand-line);
    margin-top: var(--size-8);
    padding-block: var(--size-4);
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  @media (min-width: 900px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr 1fr;
    }
  }
</style>
