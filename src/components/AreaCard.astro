---
import { href } from "../lib/href";
import { areaKindLabel, townBySlug } from "../data/catalog";
import type { Area } from "../data/types";
import ListingTile from "./ListingTile.astro";

interface Props {
  area: Area;
  wide?: boolean;
}

const { area, wide = false } = Astro.props;
const town = townBySlug(area.townSlug);
---

<a class:list={["listing-card", { wide }]} href={href(`/area/${area.slug}`)}>
  <ListingTile label={area.name.charAt(0)} alt="" wide={wide} />
  <div class="body">
    <p class="kind">{areaKindLabel(area.kind)}</p>
    <h3>{area.name}</h3>
    <p class="meta">{town?.name ?? area.townSlug}</p>
    <p class="desc">{area.summary}</p>
  </div>
</a>

<style>
  .body {
    min-width: 0;
  }
  .kind {
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-teal);
    margin-bottom: var(--size-1);
  }
  .body h3 {
    font-size: var(--font-size-2);
    margin-bottom: var(--size-1);
  }
  .meta,
  .desc {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
    margin: 0 0 var(--size-1);
  }
</style>
