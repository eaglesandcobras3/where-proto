---
import { href } from "../lib/href";
import { areaKindLabel, townBySlug } from "../data/catalog";
import type { Area } from "../data/types";

interface Props {
  area: Area;
}

const { area } = Astro.props;
const town = townBySlug(area.townSlug);
---

<a class="card" href={href(`/area/${area.slug}`)}>
  <div class="thumb img-placeholder" aria-hidden="true">{area.name.charAt(0)}</div>
  <div class="body">
    <p class="kind">{areaKindLabel(area.kind)}</p>
    <h3>{area.name}</h3>
    <p class="meta">{town?.name ?? area.townSlug}</p>
    <p class="desc">{area.summary}</p>
  </div>
</a>

<style>
  .card {
    display: block;
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-card);
    overflow: hidden;
    color: var(--brand-ink);
  }
  .card:hover {
    text-decoration: none;
    box-shadow: var(--shadow-card);
  }
  .thumb {
    height: 120px;
    border-radius: 0;
  }
  .body {
    padding: var(--size-3) var(--size-4);
  }
  .kind {
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-teal);
    margin-bottom: var(--size-1);
  }
  .body h3 {
    font-size: var(--font-size-2);
    margin-bottom: var(--size-1);
  }
  .meta,
  .desc {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
    margin: 0 0 var(--size-1);
  }
</style>
