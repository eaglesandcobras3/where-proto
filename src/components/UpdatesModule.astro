---
import UpdateCard from "./UpdateCard.astro";
import { href } from "../lib/href";
import { liveUpdates } from "../data/catalog";
import type { Update } from "../data/types";

interface Props {
  title: string;
  updates: Update[];
  ctaHref?: string;
  ctaLabel?: string;
}

const { title, updates, ctaHref, ctaLabel } = Astro.props;
const shown = liveUpdates(updates).slice(0, 3);
---

{
  shown.length > 0 && (
    <section class="updates-module">
      <h2 class="section-title">{title}</h2>
      <div class="grid">
        {shown.map((update) => (
          <UpdateCard update={update} />
        ))}
      </div>
      <p class="more">
        {ctaHref && ctaLabel && (
          <>
            <a href={href(ctaHref)}>{ctaLabel}</a>
            {" · "}
          </>
        )}
        <a href={href("/updates")}>See all updates</a>
      </p>
    </section>
  )
}

<style>
  .updates-module {
    margin-block: var(--size-8);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--size-4);
    align-items: start;
  }
  .more {
    margin-top: var(--size-4);
    font-size: var(--font-size-1);
  }
</style>
