---
import UpdateCard from "./UpdateCard.astro";
import { href } from "../lib/href";
import { liveUpdates } from "../data/catalog";
import type { Update } from "../data/types";

interface Props {
  entityKind: "business" | "stay" | "town" | "area";
  entityName: string;
  updates: Update[];
  ctaHref: string;
}

const { entityKind, entityName, updates, ctaHref } = Astro.props;
const shown = liveUpdates(updates).slice(0, 3);
const title = entityKind === "town" || entityKind === "area" ? `Updates in ${entityName}` : "Latest updates";
const ctaLabel =
  entityKind === "stay"
    ? "Own this stay? Share an update"
    : entityKind === "business"
      ? "Own this business? Share an update"
      : entityKind === "town"
        ? "Share a town update"
        : "Share an area update";
---

{
  shown.length > 0 && (
    <section class="updates-module" id="updates" data-updates-entity={entityKind}>
      <h2 class="section-title">{title}</h2>
      <div class="grid">
        {shown.map((update) => (
          <UpdateCard update={update} />
        ))}
      </div>
      <p class="more">
        <a href={href(ctaHref)}>{ctaLabel}</a>
      </p>
    </section>
  )
}

<style>
  .updates-module {
    margin-block: var(--size-8);
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-card);
    padding: var(--size-5);
  }
  .section-title {
    margin: 0 0 var(--size-4);
    font-family: var(--font-display);
    font-size: var(--font-size-4);
    color: var(--brand-deep);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--size-4);
    align-items: start;
  }
  .more {
    margin: var(--size-4) 0 0;
    font-size: var(--font-size-1);
  }
  .more a {
    font-weight: var(--font-weight-7);
    color: var(--brand-teal);
  }
</style>
