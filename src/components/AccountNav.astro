---
import { href } from "../lib/href";

interface Props {
  active?: string;
  savedCount?: number;
  questionCount?: number;
  postCount?: number;
}

const { active = "", savedCount = 0, questionCount = 0, postCount = 0 } = Astro.props;

const links = [
  { label: "Saved", path: "/profile/favorites", key: "favorites", count: savedCount },
  { label: "Questions", path: "/profile/questions", key: "questions", count: questionCount },
  { label: "Posts", path: "/profile/posts", key: "posts", count: postCount },
  { label: "Settings", path: "/profile/settings", key: "settings" },
];
---

<nav class="tabs" aria-label="Account">
  {
    links.map((link) => (
      <a class:list={["tab", { active: active === link.key }]} href={href(link.path)}>
        {link.label}
        {typeof link.count === "number" && <span class="count">({link.count})</span>}
      </a>
    ))
  }
</nav>

<style>
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.25rem;
  }
  .tab {
    padding: 0.95rem 0.85rem;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-6);
    color: var(--brand-ink-soft);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .tab:hover {
    text-decoration: none;
    color: var(--brand-deep);
  }
  .tab.active {
    color: var(--brand-teal);
    border-bottom-color: var(--brand-teal);
  }
  .count {
    font-weight: var(--font-weight-5);
  }
</style>
