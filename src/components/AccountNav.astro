---
import { href } from "../lib/href";

interface Props {
  active?: string;
}

const { active = "" } = Astro.props;

const links = [
  { label: "Saved", path: "/profile/favorites", key: "favorites" },
  { label: "My Questions", path: "/profile/questions", key: "questions" },
  { label: "My Posts", path: "/profile/posts", key: "posts" },
  { label: "Settings", path: "/profile/settings", key: "settings" },
];
---

<nav class="tabs" aria-label="Account">
  {
    links.map((link) => (
      <a class:list={["tab", { active: active === link.key }]} href={href(link.path)}>
        {link.label}
      </a>
    ))
  }
</nav>

<style>
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-1);
    border-bottom: 2px solid var(--brand-line);
    margin-bottom: var(--size-5);
  }
  .tab {
    padding: 12px var(--size-4);
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-6);
    color: var(--brand-ink-soft);
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
  }
  .tab:hover {
    text-decoration: none;
    color: var(--brand-deep);
  }
  .tab.active {
    color: var(--brand-deep);
    border-bottom-color: var(--brand-deep);
  }
</style>
