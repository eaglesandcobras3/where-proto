---
import { href } from "../lib/href";
import { EXPLORE_LINKS, type ExploreKey } from "../lib/unified-layout";

interface Props {
  current: ExploreKey;
  townSlug?: string;
}

const { current, townSlug } = Astro.props;

const withTown = (path: string) => {
  if (!townSlug) return path;
  if (path === "/towns") return `/town/${townSlug}`;
  const join = path.includes("?") ? "&" : "?";
  if (path === "/ask") return `${path}${join}town=${townSlug}`;
  return `${path}${join}town=${townSlug}`;
};
---

<section class="widget explore-links">
  <p class="widget__label">Explore</p>
  <ul class="links">
    {
      EXPLORE_LINKS.map((item) => (
        <li>
          {item.key === current ? (
            <span aria-current="page">{item.label}</span>
          ) : (
            <a href={href(withTown(item.path))}>{item.label}</a>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .widget {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-card);
    padding: var(--size-4);
  }
  .widget__label {
    margin: 0 0 var(--size-3);
    font-family: var(--font-display);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-8);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .links a,
  .links span {
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-6);
  }
  .links span {
    color: var(--brand-ink);
  }
</style>
