---
import Layout from "../../layouts/Layout.astro";
import LinkList from "../../components/LinkList.astro";
import { allLeaves, businesses } from "../../data/catalog";
import { href } from "../../lib/href";

export function getStaticPaths() {
  return allLeaves().map((leaf) => ({
    params: { category: leaf.slug },
    props: { leaf },
  }));
}

interface Props {
  leaf: ReturnType<typeof allLeaves>[number];
}

const { leaf } = Astro.props;
const listings = businesses.filter((item) => item.leafSlug === leaf.slug);
---

<Layout title={leaf.name}>
  <p>
    <a href={href("/businesses")}>Businesses</a> / {leaf.groupName}
  </p>
  <h1>Leaf: {leaf.name}</h1>
  <p>Listings live on this leaf. The hub does not render business cards.</p>
  <LinkList
    items={listings.map((item) => ({
      href: href(`/business/${item.slug}`),
      label: item.name,
      meta: item.summary,
    }))}
  />
</Layout>
