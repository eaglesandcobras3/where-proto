---
import Layout from "../../layouts/Layout.astro";
import { categories } from "../../data/catalog";
import { href } from "../../lib/href";
---

<Layout title="Businesses">
  <h1>Businesses</h1>
  <p>Directory hub. Groups open to category pages; listings live on leaf pages.</p>
  {
    categories.map((category) => (
      <section>
        <h2>
          <a href={href(`/categories/${category.slug}`)}>{category.name}</a>
        </h2>
        <ul>
          {category.leaves.map((leaf) => (
            <li>
              <a href={href(`/categories/${category.slug}/${leaf.slug}`)}>{leaf.name}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  <p><a href={href("/stay")}>Stay page</a> is a separate page type from this directory.</p>
</Layout>
