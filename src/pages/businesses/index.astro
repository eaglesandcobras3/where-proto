---
import Layout from "../../layouts/Layout.astro";
import { categories } from "../../data/catalog";
import { href } from "../../lib/href";
---

<Layout title="Businesses">
  <h1>Businesses</h1>
  <p>
    Directory hub. Browse by category group, then open a leaf. No search box and no filters on
    this route. Search is only at <a href={href("/search")}>/search</a>.
  </p>
  {
    categories.map((group) => (
      <section>
        <h2>{group.name}</h2>
        <ul>
          {group.leaves.map((leaf) => (
            <li>
              <a href={href(`/businesses/${leaf.slug}`)}>{leaf.name}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>
