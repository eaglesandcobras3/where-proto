---
import Layout from "../../layouts/Layout.astro";
import { users } from "../../data/catalog";
import type { User } from "../../data/types";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(users);
}

interface Props {
  item: User;
}

const { item: user } = Astro.props;
---

<Layout
  title={`${user.name} (public)`}
  note="External facing profile is still to be defined. This route is a stub so the link exists."
>
  <h1>External facing profile: {user.name}</h1>
  <p>Still need to be defined. Showing only the fake user record.</p>
  <ul>
    <li>Role: {user.role}</li>
    <li>{user.bio}</li>
  </ul>
  <p><a href={href("/profile")}>User facing profile (signed-in)</a></p>
</Layout>
