---
import BaseLayout from "../layouts/BaseLayout.astro";
import TownCard from "../components/TownCard.astro";
import HomeFeaturedBusinessCard from "../components/HomeFeaturedBusinessCard.astro";
import EventCard from "../components/EventCard.astro";
import GuideCard from "../components/GuideCard.astro";
import AreaCard from "../components/AreaCard.astro";
import UpdatesModule from "../components/UpdatesModule.astro";
import { isEnabled } from "../config/flags";
import { areas, businesses, events, guides, liveUpdates, towns } from "../data/catalog";
import { href } from "../lib/href";
---

<BaseLayout title="Your local guide to 30A and Florida's Emerald Coast" showBrowse>
  <section class="hero">
    <div class="container">
      <h1>Find the best of 30A</h1>
      <p class="lede">
        Curated listings, town guides, and hand-picked local favorites along Florida's Emerald Coast.
        Pick a town, then a category. Search is the finder.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Explore the towns</h2>
      <div class="listing-grid">
        {towns.map((town) => <TownCard town={town} />)}
      </div>
      <p class="more"><a href={href("/towns")}>See all towns</a></p>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <h2 class="section-title">Featured businesses</h2>
      <div class="featured-row">
        {businesses.slice(0, 4).map((business) => <HomeFeaturedBusinessCard business={business} />)}
      </div>
      <p class="more"><a href={href("/search")}>Browse all businesses</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Areas</h2>
      <div class="listing-grid">
        {areas.filter((item) => item.kind === "shopping").map((area) => <AreaCard area={area} />)}
      </div>
      <p class="more"><a href={href("/areas")}>See all areas</a></p>
    </div>
  </section>

  {
    isEnabled("events") && (
      <section class="section alt">
        <div class="container">
          <h2 class="section-title">Upcoming events</h2>
          <div class="listing-grid">
            {events.map((event) => (
              <EventCard event={event} />
            ))}
          </div>
          <p class="more">
            <a href={href("/events")}>See all events</a>
          </p>
        </div>
      </section>
    )
  }

  {
    isEnabled("guides") && (
      <section class="section">
        <div class="container">
          <h2 class="section-title">Guides</h2>
          <div class="listing-grid">
            {guides.slice(0, 3).map((guide) => (
              <GuideCard guide={guide} />
            ))}
          </div>
          <p class="more">
            <a href={href("/guides")}>See all guides</a>
          </p>
        </div>
      </section>
    )
  }

  {
    isEnabled("updates") && (
      <div class="container">
        <UpdatesModule title="Latest updates" updates={liveUpdates()} />
      </div>
    )
  }

  <section class="section alt">
    <div class="container subscribe">
      <h2 class="section-title">Add your business</h2>
      <p>Add your business to WhereTo30A. Every submission is reviewed before publishing.</p>
      <p class="more"><a href={href("/add-business")}>Add your business</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--size-10);
    text-align: center;
  }
  .hero h1 {
    font-size: clamp(2rem, 8vw, 3rem);
  }
  .lede {
    font-size: var(--font-size-3);
    color: var(--brand-ink-soft);
    max-width: 60ch;
    margin-inline: auto;
  }
  .alt {
    background: white;
    border-block: 1px solid var(--brand-line);
  }
  .more {
    margin-top: var(--size-4);
  }
  .subscribe {
    max-width: 640px;
  }
</style>
