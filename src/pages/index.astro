---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/HomeHero.astro";
import LocalSpotlight from "../components/LocalSpotlight.astro";
import HomeFeaturedGrid from "../components/HomeFeaturedGrid.astro";
import BeachTownsStrip from "../components/BeachTownsStrip.astro";
import WeekendPlanner from "../components/WeekendPlanner.astro";
import GuidesNotebook from "../components/GuidesNotebook.astro";
import CommunityAdvice from "../components/CommunityAdvice.astro";
import HomeStaysGrid from "../components/HomeStaysGrid.astro";
import SponsoredShowcase from "../components/SponsoredShowcase.astro";
import CommunityGallery from "../components/CommunityGallery.astro";
import { isEnabled } from "../config/flags";
import {
  commentsFor,
  events,
  questions,
  towns,
  townBySlug,
} from "../data/catalog";
import { href } from "../lib/href";

const base = import.meta.env.BASE_URL;
const heroTowns = towns.map(({ slug, name }) => ({ slug, name }));

const homeEvents = [
  {
    event: events.find((item) => item.slug === "grayton-farmers-market") ?? events[0]!,
    badge: "Weekly Favorite",
    badgeTone: "blue" as const,
    footerTag: "Free Admission",
    whenLabel: "Sat · 8:00 AM",
    types: ["weekend", "market"],
  },
  {
    event: events.find((item) => item.slug === "sounds-of-seaside") ?? events[1]!,
    badge: "Live Music",
    badgeTone: "teal" as const,
    footerTag: "All Ages Welcome",
    whenLabel: "Wed · 5:00 PM",
    types: ["music", "weekend"],
  },
  {
    event: events.find((item) => item.slug === "seaside-storytime") ?? events[2]!,
    badge: "Free Admission",
    badgeTone: "blue" as const,
    footerTag: "Family Friendly",
    whenLabel: "Today · 10:00 AM",
    types: ["family"],
  },
  {
    event: events.find((item) => item.slug === "alys-sunset-yoga") ?? events[3]!,
    badge: "Eco Adventure",
    badgeTone: "mint" as const,
    footerTag: "Gear Included",
    whenLabel: "Today · 5:30 PM",
    types: ["weekend", "family"],
  },
];

const askRows = questions.slice(0, 3).map((question) => {
  const town = question.townSlug ? townBySlug(question.townSlug) : undefined;
  const replies = commentsFor("question", question.slug).length;
  return { question, town, replies };
});

---

<BaseLayout title="WhereTo30A — Scenic 30A Chronicle & Field Guide">
  <div class="home">
    <HomeHero towns={heroTowns} base={base} />

    <LocalSpotlight href="/business/cafe-thirty-a" />
    <HomeFeaturedGrid />
    <BeachTownsStrip />
    {isEnabled("events") && <WeekendPlanner items={homeEvents} base={base} />}
    <GuidesNotebook />
    {isEnabled("ask") && <CommunityAdvice rows={askRows} />}
    {isEnabled("stays") && <HomeStaysGrid />}
    <CommunityGallery />
    <SponsoredShowcase />

    <section class="merchant">
      <div class="container merchant__inner">
        <div class="merchant__content">
          <div class="merchant__copy">
            <p class="merchant__eyebrow">For local businesses</p>
            <h2>Add your business to WhereTo30A</h2>
            <p>
              Make it easier for people exploring 30A to find your business. Add your listing for free
              and share what you offer, where to find you, and what visitors should know.
            </p>
            <p>
              Every submission is reviewed before publishing to help keep WhereTo30A accurate, relevant,
              and up to date.
            </p>
          </div>
          <div class="merchant__actions">
            <a class="btn btn--teal" href={href("/merchants")}>For businesses</a>
          </div>
        </div>
        <div class="merchant__media">
          <img
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuC-S5n4GjbrTdRUPG27wbhkjWRNX_LW2HI3UJgvwOK0Xnhp1u5ibkFuLeVnCHN_xY6srqNdpriCZ6sn7xoAWZfc9JXPllA2Xa7Yp_M5S7LbSZp1M-vwiYVHYVVfpBd7akiLPFVDMFEmPfDJhkmQHKi-2DNCc8DuZA2GZ8BZDo3W0tBYuSG574F7lOYRpjvN4kUfJsC-dni1yHHAXuPimNY1w7uDdNKXtO1XIEfAKQt6ipMjEsD9mxwn"
            alt="Emerald Gulf water along Scenic Highway 30A"
            loading="lazy"
          />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    background: var(--brand-sand);
    color: var(--brand-ink);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-button);
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
  }
  .btn:hover {
    text-decoration: none;
  }
  .btn--teal {
    background: var(--brand-teal);
    color: white;
  }
  .btn--teal:hover {
    background: var(--brand-teal-hover);
  }
  .btn--ghost {
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: white;
    background: transparent;
  }
  .btn--ghost:hover {
    border-color: white;
    background: rgba(255, 255, 255, 0.06);
  }
  .merchant {
    background: var(--brand-deep);
    color: white;
    padding-block: var(--size-8);
  }
  .merchant__inner {
    display: grid;
    gap: var(--size-5);
    align-items: center;
  }
  .merchant__content {
    display: grid;
    gap: var(--size-4);
    justify-items: start;
    min-width: 0;
  }
  .merchant__copy {
    max-width: 36rem;
  }
  .merchant__eyebrow {
    margin: 0 0 0.35rem;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-ink-on-navy);
  }
  .merchant h2 {
    margin: 0 0 0.45rem;
    color: white;
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.2;
  }
  .merchant__copy > p:not(.merchant__eyebrow) {
    margin: 0 0 0.4rem;
    color: var(--brand-line);
    font-size: var(--font-size-2);
    line-height: 1.5;
    max-width: 48ch;
  }
  .merchant__copy > p:last-child {
    margin-bottom: 0;
  }
  .merchant__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
  }
  .merchant__media {
    min-width: 0;
    border-radius: var(--radius-4);
    overflow: hidden;
    background: var(--brand-deep);
    aspect-ratio: 4 / 3;
  }
  .merchant__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 900px) {
    .merchant__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--size-6);
    }
    .merchant__media {
      aspect-ratio: 3 / 2;
      min-height: 8rem;
      max-height: 20rem;
    }
  }
</style>
