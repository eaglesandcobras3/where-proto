---
import Layout from "../layouts/Layout.astro";
import LinkList from "../components/LinkList.astro";
import { events, guides, happenings, towns } from "../data/catalog";
import { href } from "../lib/href";
---

<Layout title="Homepage">
  <h1>Homepage</h1>
  <p>Local guide to 30A, Florida. Routes and fake data only.</p>

  <h2>Towns</h2>
  <p><a href={href("/towns")}>All towns</a></p>
  <LinkList
    items={towns.map((item) => ({
      href: href(`/town/${item.slug}`),
      label: item.name,
      meta: item.summary,
    }))}
  />

  <h2>Find businesses</h2>
  <p>
    <a href={href("/search")}>Search</a> is the business finder (town, category, tag, open now).
    Indexable listings are town × category pages such as
    <a href={href("/town/rosemary-beach/restaurants")}>/town/rosemary-beach/restaurants</a>.
  </p>

  <h2>Events</h2>
  <p><a href={href("/events")}>All events</a></p>
  <LinkList
    items={events.map((item) => ({
      href: href(`/event/${item.slug}`),
      label: item.name,
      meta: item.when,
    }))}
  />

  <h2>Happenings</h2>
  <p><a href={href("/happenings")}>All happenings</a></p>
  <LinkList
    items={happenings.map((item) => ({
      href: href("/happenings"),
      label: item.title,
      meta: item.summary,
    }))}
  />

  <h2>Guides</h2>
  <p><a href={href("/guides")}>All guides</a></p>
  <LinkList
    items={guides.map((item) => ({
      href: href(`/guide/${item.slug}`),
      label: item.title,
      meta: item.summary,
    }))}
  />

  <h2>Ask</h2>
  <p><a href={href("/ask")}>Community questions</a></p>
</Layout>
