---
import MerchantLayout from "../../../layouts/MerchantLayout.astro";
import { mentionsForBusiness } from "../../../data/catalog";
import type { Business } from "../../../data/types";
import { href } from "../../../lib/href";
import { VIEW_PUBLIC_LABEL } from "../../../lib/dashboard-v1";
import { ownedBusinessPaths } from "../../../lib/static-paths";

export function getStaticPaths() {
  return ownedBusinessPaths();
}

interface Props {
  business: Business;
}

const { business } = Astro.props;
const mentions = mentionsForBusiness(business);
---

<MerchantLayout title={`Mentions · ${business.name}`} business={business} active="community">
  <header class="head">
    <div>
      <h1>Mentions</h1>
      <p>
        Mentions and questions about {business.name}. Replies go live with the Owner badge, then follow
        the 3-flag auto-hide rule.
      </p>
    </div>
    <a class="btn" href={href(`/business/${business.slug}`)}>{VIEW_PUBLIC_LABEL}</a>
  </header>

  <div class="stack">
    {
      mentions.map((item) => (
        <article class="card">
          <p class="meta">
            {item.kind} · {item.username} · {item.time}
          </p>
          <p>{item.excerpt}</p>
          <p class="actions">
            <a href={href(item.href)}>Open thread</a>
            <button type="button">Reply as {business.name}</button>
          </p>
        </article>
      ))
    }
    {mentions.length === 0 && <p class="empty">No mentions yet.</p>}
  </div>
</MerchantLayout>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  h1 {
    margin: 0 0 0.35rem;
    color: var(--brand-deep);
    font-size: clamp(1.45rem, 3vw, 1.9rem);
  }
  .head p {
    margin: 0;
    color: var(--brand-ink-soft);
    max-width: 48ch;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-button);
    background: var(--brand-sand-dark);
    color: var(--brand-deep);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    text-decoration: none;
  }
  .stack {
    display: grid;
    gap: 0.75rem;
    max-width: 46rem;
  }
  .card {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    padding: 1rem;
  }
  .meta {
    margin: 0 0 0.4rem;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .card > p:nth-child(2) {
    margin: 0 0 0.65rem;
    color: var(--brand-ink);
  }
  .actions {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
  .actions a,
  .actions button {
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    color: var(--brand-teal);
    cursor: pointer;
  }
  .empty {
    color: var(--brand-ink-soft);
  }
</style>
