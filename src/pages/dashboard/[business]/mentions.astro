---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DashboardNav from "../../../components/DashboardNav.astro";
import { postsFor, userBySlug } from "../../../data/catalog";
import type { Business } from "../../../data/types";
import { href } from "../../../lib/href";
import { ownedBusinessPaths } from "../../../lib/static-paths";

export function getStaticPaths() {
  return ownedBusinessPaths();
}

interface Props {
  business: Business;
}

const { business } = Astro.props;
const mentions = postsFor("business", business.slug).filter((item) => item.postedAs === "user");
---

<BaseLayout title={`Mentions · ${business.name}`}>
  <div class="container section">
    <h1>Mentions inbox</h1>
    <DashboardNav businessSlug={business.slug} active="mentions" />
    <div class="stack">
      {mentions.map((post) => (
        <article class="mention">
          <p class="meta">
            Community post · {userBySlug(post.authorUserSlug ?? "")?.name ?? "a visitor"} · {post.createdAt}
          </p>
          <p>{post.body}</p>
          <p>
            <a href={href(`/posts/${post.slug}`)}>Open</a> ·
            <button type="button">Reply as verified owner</button>
          </p>
        </article>
      ))}
      {mentions.length === 0 && <p class="empty">No visitor mentions yet.</p>}
    </div>
  </div>
</BaseLayout>

<style>
  .stack {
    display: grid;
    gap: var(--size-3);
    max-width: 720px;
  }
  .mention {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-card);
    padding: var(--size-4);
  }
  .meta {
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  button {
    border: 0;
    background: none;
    color: var(--brand-teal);
    font: inherit;
    font-weight: var(--font-weight-7);
    cursor: pointer;
    padding: 0;
  }
  .empty {
    color: var(--brand-ink-soft);
  }
</style>
