---
import Layout from "../../../layouts/Layout.astro";
import Box from "../../../components/Box.astro";
import FeedList from "../../../components/FeedList.astro";
import { posts } from "../../../data/catalog";
import type { Business } from "../../../data/types";
import { href } from "../../../lib/href";
import { ownedBusinessPaths } from "../../../lib/static-paths";

export function getStaticPaths() {
  return ownedBusinessPaths();
}

interface Props {
  business: Business;
}

const { business } = Astro.props;
const mentions = posts.filter(
  (item) => item.on.type === "business" && item.on.slug === business.slug && item.postedAs === "user",
);
---

<Layout title={`Mentions · ${business.name}`}>
  <p><a href={href(`/dashboard/${business.slug}`)}>Manage {business.name}</a></p>
  <h1>See mentions</h1>
  <Box label="User posts on this listing">
    <p>User posts that landed on this business page. Still to be defined.</p>
    <FeedList items={mentions} />
  </Box>
</Layout>
