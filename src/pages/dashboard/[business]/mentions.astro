---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DashboardNav from "../../../components/DashboardNav.astro";
import PostCard from "../../../components/PostCard.astro";
import { postsFor } from "../../../data/catalog";
import type { Business } from "../../../data/types";
import { ownedBusinessPaths } from "../../../lib/static-paths";

export function getStaticPaths() {
  return ownedBusinessPaths();
}

interface Props {
  business: Business;
}

const { business } = Astro.props;
const mentions = postsFor("business", business.slug).filter((item) => item.postedAs === "user");
---

<BaseLayout title={`Mentions · ${business.name}`}>
  <div class="container section">
    <h1>Mentions inbox</h1>
    <DashboardNav businessSlug={business.slug} active="mentions" />
    <div class="stack">
      {mentions.map((post) => <PostCard post={post} />)}
      {mentions.length === 0 && <p class="empty">No visitor mentions yet.</p>}
    </div>
  </div>
</BaseLayout>

<style>
  .stack {
    display: grid;
    gap: var(--size-3);
    max-width: 720px;
  }
  .empty {
    color: var(--brand-ink-soft);
  }
</style>
