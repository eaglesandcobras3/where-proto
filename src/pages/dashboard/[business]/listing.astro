---
import Layout from "../../../layouts/Layout.astro";
import Box from "../../../components/Box.astro";
import type { Business } from "../../../data/types";
import { href } from "../../../lib/href";
import { ownedBusinessPaths } from "../../../lib/static-paths";

export function getStaticPaths() {
  return ownedBusinessPaths();
}

interface Props {
  business: Business;
}

const { business } = Astro.props;
---

<Layout title={`Edit listing · ${business.name}`}>
  <p><a href={href(`/dashboard/${business.slug}`)}>Manage {business.name}</a></p>
  <h1>Edit listing</h1>
  <Box label="Listing form">
    <form>
      <p>
        <label>
          Name
          <input type="text" name="name" value={business.name} />
        </label>
      </p>
      <p>
        <label>
          Summary
          <textarea name="summary">{business.summary}</textarea>
        </label>
      </p>
      <p>
        <label>
          Hours
          <input type="text" name="hours" value={business.hours ?? ""} />
        </label>
      </p>
      <p>
        <label>
          Address
          <input type="text" name="address" value={business.address ?? ""} />
        </label>
      </p>
      <button type="button">Save draft</button>
    </form>
  </Box>
</Layout>
