---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DashboardNav from "../../../components/DashboardNav.astro";
import ComposerCard from "../../../components/islands/ComposerCard.svelte";
import type { Business } from "../../../data/types";
import { ownedBusinessPaths } from "../../../lib/static-paths";

export function getStaticPaths() {
  return ownedBusinessPaths();
}

interface Props {
  business: Business;
}

const { business } = Astro.props;
---

<BaseLayout title={`Edit listing · ${business.name}`}>
  <div class="container section">
    <h1>Edit listing</h1>
    <DashboardNav businessSlug={business.slug} active="listing" />
    <ComposerCard
      title={business.name}
      body="Edits go to the owner as proposed changes. Prototype only."
      action="Propose changes"
      kind="settings"
      client:visible
    />
  </div>
</BaseLayout>
