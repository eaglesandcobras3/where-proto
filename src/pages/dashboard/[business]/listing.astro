---
import MerchantLayout from "../../../layouts/MerchantLayout.astro";
import ComposerCard from "../../../components/islands/ComposerCard.svelte";
import { townBySlug } from "../../../data/catalog";
import type { Business } from "../../../data/types";
import { href } from "../../../lib/href";
import { ownedBusinessPaths } from "../../../lib/static-paths";

export function getStaticPaths() {
  return ownedBusinessPaths();
}

interface Props {
  business: Business;
}

const { business } = Astro.props;
const town = townBySlug(business.townSlug);
---

<MerchantLayout title={`Business profile · ${business.name}`} business={business} active="profile">
  <header class="head">
    <div>
      <h1>Business profile</h1>
      <p>Edit what visitors see on your public listing. Name and category always require review.</p>
    </div>
    <a class="btn" href={href(`/business/${business.slug}`)}>View public profile</a>
  </header>

  <div class="grid">
    <section class="card">
      <h2>Listing details</h2>
      <dl>
        <div><dt>Name</dt><dd>{business.name}</dd></div>
        <div><dt>Town</dt><dd>{town?.name ?? "30A"}</dd></div>
        <div><dt>Address</dt><dd>{business.address ?? "—"}</dd></div>
        <div><dt>Phone</dt><dd>{business.phone ?? "—"}</dd></div>
        <div><dt>Hours</dt><dd>{business.hours ?? "—"}</dd></div>
        <div><dt>Website</dt><dd>{business.website ?? "—"}</dd></div>
      </dl>
      <ComposerCard
        title="Propose profile changes"
        body="Edits queue for review before they publish on the public listing."
        action="Propose changes"
        kind="settings"
        client:visible
      />
    </section>

    <aside class="card">
      <h2>Public summary</h2>
      <p>{business.summary}</p>
      <a href={href(`/dashboard/${business.slug}/photos`)}>Manage photos →</a>
    </aside>
  </div>
</MerchantLayout>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  h1 {
    margin: 0 0 0.35rem;
    color: var(--brand-deep);
    font-size: clamp(1.45rem, 3vw, 1.9rem);
  }
  .head p {
    margin: 0;
    color: var(--brand-ink-soft);
    max-width: 42ch;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-pill);
    background: #f1f5f9;
    color: var(--brand-deep);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    text-decoration: none;
  }
  .grid {
    display: grid;
    gap: 1rem;
  }
  .card {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    padding: 1.15rem;
  }
  h2 {
    margin: 0 0 0.85rem;
    color: var(--brand-deep);
    font-size: var(--font-size-3);
  }
  dl {
    display: grid;
    gap: 0.65rem;
    margin: 0 0 1rem;
  }
  dt {
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  dd {
    margin: 0.15rem 0 0;
    color: var(--brand-deep);
    font-weight: var(--font-weight-6);
  }
  .card p {
    margin: 0 0 0.75rem;
    color: var(--brand-ink-soft);
    line-height: 1.5;
  }
  .card a {
    color: var(--brand-teal);
    font-weight: var(--font-weight-7);
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(14rem, 0.8fr);
    }
  }
</style>
