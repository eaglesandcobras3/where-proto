---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import DashboardNav from "../../../../components/DashboardNav.astro";
import ComposerCard from "../../../../components/islands/ComposerCard.svelte";
import type { Business } from "../../../../data/types";
import { ownedBusinessPaths } from "../../../../lib/static-paths";

export function getStaticPaths() {
  return ownedBusinessPaths();
}

interface Props {
  business: Business;
}

const { business } = Astro.props;
---

<BaseLayout title={`New event · ${business.name}`}>
  <div class="container section">
    <h1>Post an event</h1>
    <DashboardNav businessSlug={business.slug} active="event" />
    <ComposerCard
      title="New event"
      body="A dated event for the public calendar. Prototype only."
      action="Submit event"
      kind="event"
      client:visible
    />
  </div>
</BaseLayout>
