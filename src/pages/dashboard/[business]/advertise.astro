---
import MerchantLayout from "../../../layouts/MerchantLayout.astro";
import type { Business } from "../../../data/types";
import { href } from "../../../lib/href";
import { ownedBusinessPaths } from "../../../lib/static-paths";

export function getStaticPaths() {
  return ownedBusinessPaths();
}

interface Props {
  business: Business;
}

const { business } = Astro.props;

const packages = [
  {
    name: "Corridor spotlight",
    detail: "Homepage + town hub placement for a weekend push.",
    cta: "Request spotlight",
  },
  {
    name: "Guide sponsorship",
    detail: "Appear beside editorial guides that match your category.",
    cta: "Talk to sales",
  },
  {
    name: "Always-on boost",
    detail: "Subtle lift in business search across Scenic 30A.",
    cta: "Learn more",
  },
];
---

<MerchantLayout title={`Advertise & grow · ${business.name}`} business={business} active="advertise">
  <header class="head">
    <div>
      <h1>Advertise &amp; grow</h1>
      <p>
        Paid placement options for {business.name}. Finish the free listing first, then pick a boost
        if you want one.
      </p>
    </div>
    <a class="btn" href={href("/merchants")}>Merchants overview</a>
  </header>

  <div class="grid">
    {
      packages.map((item) => (
        <article class="card">
          <h2>{item.name}</h2>
          <p>{item.detail}</p>
          <a href={href("/merchants")}>{item.cta} →</a>
        </article>
      ))
    }
  </div>
</MerchantLayout>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  h1 {
    margin: 0 0 0.35rem;
    color: var(--brand-deep);
    font-size: clamp(1.45rem, 3vw, 1.9rem);
  }
  .head p {
    margin: 0;
    color: var(--brand-ink-soft);
    max-width: 48ch;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-button);
    background: var(--brand-sun-soft);
    color: var(--brand-coral);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    text-decoration: none;
  }
  .grid {
    display: grid;
    gap: 0.85rem;
  }
  .card {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    padding: 1.15rem;
  }
  h2 {
    margin: 0 0 0.4rem;
    color: var(--brand-deep);
    font-size: var(--font-size-3);
  }
  .card p {
    margin: 0 0 0.75rem;
    color: var(--brand-ink-soft);
  }
  .card a {
    color: var(--brand-teal);
    font-weight: var(--font-weight-7);
  }
  @media (min-width: 800px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
