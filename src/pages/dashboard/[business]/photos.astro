---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DashboardNav from "../../../components/DashboardNav.astro";
import PhotoGrid from "../../../components/PhotoGrid.astro";
import ComposerCard from "../../../components/islands/ComposerCard.svelte";
import { photosFor } from "../../../data/catalog";
import type { Business } from "../../../data/types";
import { ownedBusinessPaths } from "../../../lib/static-paths";

export function getStaticPaths() {
  return ownedBusinessPaths();
}

interface Props {
  business: Business;
}

const { business } = Astro.props;
const photos = photosFor("business", business.slug);
---

<BaseLayout title={`Photos · ${business.name}`}>
  <div class="container section">
    <h1>Photos</h1>
    <DashboardNav businessSlug={business.slug} active="photos" />
    <PhotoGrid photos={photos} />
    <div class="composer">
      <ComposerCard
        title="Add a photo"
        body="Only images you own. Prototype upload does nothing."
        action="Choose image"
        kind="photo"
        client:visible
      />
    </div>
  </div>
</BaseLayout>

<style>
  .composer {
    margin-top: var(--size-6);
    max-width: 420px;
  }
</style>
