---
import MerchantLayout from "../../../layouts/MerchantLayout.astro";
import PhotoGrid from "../../../components/PhotoGrid.astro";
import ComposerCard from "../../../components/islands/ComposerCard.svelte";
import { photosFor } from "../../../data/catalog";
import type { Business } from "../../../data/types";
import { ownedBusinessPaths } from "../../../lib/static-paths";

export function getStaticPaths() {
  return ownedBusinessPaths();
}

interface Props {
  business: Business;
}

const { business } = Astro.props;
const photos = photosFor("business", business.slug);
---

<MerchantLayout title={`Photos · ${business.name}`} business={business} active="photos">
  <header class="head">
    <div>
      <h1>Photo gallery</h1>
      <p>Images on your public listing. Confirm you own the rights before uploading.</p>
    </div>
  </header>

  <div class="grid">
    <section class="card">
      <PhotoGrid photos={photos} empty="No photos yet — add a few that show the space." />
    </section>
    <section class="card">
      <ComposerCard
        title="Upload photos"
        body="Queued for review. Prototype only."
        action="Choose images"
        kind="photo"
        client:visible
      />
    </section>
  </div>
</MerchantLayout>

<style>
  .head {
    margin-bottom: 1.25rem;
  }
  h1 {
    margin: 0 0 0.35rem;
    color: var(--brand-deep);
    font-size: clamp(1.45rem, 3vw, 1.9rem);
  }
  .head p {
    margin: 0;
    color: var(--brand-ink-soft);
  }
  .grid {
    display: grid;
    gap: 1rem;
  }
  .card {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    padding: 1.15rem;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(14rem, 0.8fr);
    }
  }
</style>
