---
import MerchantLayout from "../../../layouts/MerchantLayout.astro";
import { guideMentionsForBusiness } from "../../../data/catalog";
import type { Business } from "../../../data/types";
import { href } from "../../../lib/href";
import { ownedBusinessPaths } from "../../../lib/static-paths";

export function getStaticPaths() {
  return ownedBusinessPaths();
}

interface Props {
  business: Business;
}

const { business } = Astro.props;
const mentions = guideMentionsForBusiness(business).map((guide) => ({
  guide,
  note: guide.townSlug
    ? `Listed in the ${guide.title} town guide.`
    : `Listed in ${guide.title}.`,
}));
---

<MerchantLayout title={`Guide mentions · ${business.name}`} business={business} active="guides">
  <header class="head">
    <div>
      <h1>Guide mentions</h1>
      <p>Published guides that name {business.name}.</p>
    </div>
  </header>

  <div class="stack">
    {
      mentions.map(({ guide, note }) => (
        <article class="card">
          <div>
            <p class="eyebrow">Guide</p>
            <h2>{guide.title}</h2>
            <p>{note}</p>
          </div>
          <a href={href(`/guide/${guide.slug}`)}>Open guide →</a>
        </article>
      ))
    }
    {mentions.length === 0 && <p class="empty">No published guides mention this listing yet.</p>}
  </div>
</MerchantLayout>

<style>
  .head {
    margin-bottom: 1.25rem;
  }
  h1 {
    margin: 0 0 0.35rem;
    color: var(--brand-deep);
    font-size: clamp(1.45rem, 3vw, 1.9rem);
  }
  .head p {
    margin: 0;
    color: var(--brand-ink-soft);
    max-width: 48ch;
  }
  .stack {
    display: grid;
    gap: 0.75rem;
  }
  .card {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    padding: 1.1rem;
  }
  .eyebrow {
    margin: 0 0 0.25rem;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-teal);
    font-weight: var(--font-weight-7);
  }
  h2 {
    margin: 0 0 0.35rem;
    font-size: var(--font-size-3);
    color: var(--brand-deep);
  }
  .card p:last-of-type {
    margin: 0;
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
  }
  .card a {
    color: var(--brand-teal);
    font-weight: var(--font-weight-7);
    white-space: nowrap;
  }
  .empty {
    color: var(--brand-ink-soft);
  }
</style>
