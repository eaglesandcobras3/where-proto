---
import MerchantLayout from "../../../layouts/MerchantLayout.astro";
import ComposerCard from "../../../components/islands/ComposerCard.svelte";
import {
  currentUser,
  guideMentionsForBusiness,
  mentionsForBusiness,
  postsFor,
  profileStrength,
} from "../../../data/catalog";
import type { Business } from "../../../data/types";
import { href } from "../../../lib/href";
import { ownedBusinessPaths } from "../../../lib/static-paths";
import {
  listingPublicStatusFromBusiness,
  listingPublicStatusLabel,
  REVIEW_QUEUE_SENTENCE,
  VIEW_PUBLIC_LABEL,
} from "../../../lib/dashboard-v1";

export function getStaticPaths() {
  return ownedBusinessPaths();
}

interface Props {
  business: Business;
}

const { business } = Astro.props;
const owner = currentUser();
const firstName = (owner?.name ?? "there").split(" ")[0];
const mentionCount = mentionsForBusiness(business).length;
const guideCount = guideMentionsForBusiness(business).length;
const feedCount = postsFor("business", business.slug).filter((item) => item.postedAs === "business").length;
const strength = profileStrength(business);
const listingStatus = listingPublicStatusFromBusiness(business);

const metrics = [
  {
    label: "Mentions",
    value: String(mentionCount),
    meta: mentionCount === 1 ? "1 waiting for a reply" : `${mentionCount} waiting for a reply`,
    tone: mentionCount > 0 ? "warn" : "info",
  },
  {
    label: "Guide mentions",
    value: String(guideCount),
    meta: guideCount === 1 ? "1 guide lists you" : `${guideCount} guides list you`,
    tone: "info",
  },
];
---

<MerchantLayout title={`Manage ${business.name}`} business={business} active="overview">
  <header class="welcome">
    <div>
      <div class="welcome__row">
        <h1>Good morning, {firstName}.</h1>
        <span class:list={["live", listingStatus !== "live" && "live--wait"]}>
          {listingPublicStatusLabel(listingStatus)}
        </span>
      </div>
      <p>
        What’s open on <strong>{business.name}</strong>. Mentions replies go live immediately; posts
        and listing edits wait in review.
      </p>
    </div>
    <div class="welcome__actions">
      <a class="btn btn--ghost" href={href(`/business/${business.slug}`)}>{VIEW_PUBLIC_LABEL}</a>
      <a class="btn btn--deep" href={href(`/dashboard/${business.slug}/feed`)}>Post update</a>
    </div>
  </header>

  <div class="metrics">
    {
      metrics.map((item) => (
        <article class="metric">
          <p class:list={["metric__tag", `metric__tag--${item.tone}`]}>{item.meta}</p>
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </article>
      ))
    }
  </div>

  <div class="layout">
    <div class="main-col">
      <section class="card">
        <h2>This week at {business.name}</h2>
        <ul class="checklist">
          <li class:list={[{ done: strength.checks.find((item) => item.label === "Photos")?.done }]}>
            Gallery fresh?
            {!strength.checks.find((item) => item.label === "Photos")?.done && (
              <a href={href(`/dashboard/${business.slug}/photos`)}>+ Add</a>
            )}
          </li>
          <li class:list={[{ done: Boolean(business.hours) }]}>
            Hours current for the season?
            {!business.hours && <a href={href(`/dashboard/${business.slug}/listing`)}>+ Add</a>}
          </li>
          <li class:list={[{ done: mentionCount === 0 }]}>
            Mentions unanswered?
            {mentionCount > 0 && <a href={href(`/dashboard/${business.slug}/mentions`)}>Reply</a>}
          </li>
          <li class:list={[{ done: strength.percent === 100 }]}>
            Profile complete?
            {strength.percent < 100 && <a href={href(`/dashboard/${business.slug}/listing`)}>+ Add</a>}
          </li>
        </ul>
      </section>

      <section class="card">
        <h2>Share something new</h2>
        <ComposerCard
          title="Post an update"
          body={REVIEW_QUEUE_SENTENCE}
          action="Post update"
          kind="update"
          client:visible
        />
        <ComposerCard
          title="Post an offer"
          body={REVIEW_QUEUE_SENTENCE}
          action="Post offer"
          kind="offer"
          client:visible
        />
      </section>

      <section class="card feature">
        <div class="feature__media img-placeholder" aria-hidden="true"></div>
        <div>
          <h3>Photos on your listing</h3>
          <p>Add or replace photos so the public page matches what’s actually there.</p>
          <a href={href(`/dashboard/${business.slug}/photos`)}>Open photos →</a>
        </div>
      </section>

      <section class="card">
        <div class="card__head">
          <h2>Recent activity</h2>
          <a href={href(`/dashboard/${business.slug}/mentions`)}>Open mentions →</a>
        </div>
        <ul class="activity">
          <li>
            <div>
              <strong>Mentions inbox</strong>
              <p>
                {mentionCount === 0
                  ? "No mentions waiting."
                  : `${mentionCount} mention${mentionCount === 1 ? "" : "s"} on your listing or Ask.`}
              </p>
            </div>
            <a class="btn btn--ghost" href={href(`/dashboard/${business.slug}/mentions`)}>Reply now</a>
          </li>
          <li>
            <div>
              <strong>Guide mentions</strong>
              <p>
                {guideCount === 0
                  ? "You are not in a published guide yet."
                  : `${guideCount} published guide${guideCount === 1 ? "" : "s"} mention this listing.`}
              </p>
            </div>
            <a class="btn btn--ghost" href={href(`/dashboard/${business.slug}/guides`)}>View guides</a>
          </li>
          <li>
            <div>
              <strong>Posts &amp; events</strong>
              <p>{feedCount} published business post{feedCount === 1 ? "" : "s"}.</p>
            </div>
            <a class="btn btn--ghost" href={href(`/dashboard/${business.slug}/feed`)}>View posts</a>
          </li>
        </ul>
      </section>
    </div>

    <aside class="side-col">
      <section class="card">
        <h2>Profile strength</h2>
        <p class="score">{strength.percent}%</p>
        <p class="muted">{strength.percent === 100 ? "Listing fields are filled." : "Fill the remaining fields."}</p>
        <ul class="checklist">
          {
            strength.checks.map((item) => (
              <li class:list={[{ done: item.done }]}>
                {item.label}
                {!item.done && <a href={href(`/dashboard/${business.slug}/listing`)}>+ Add</a>}
              </li>
            ))
          }
        </ul>
      </section>
      <section class="card">
        <h2>{VIEW_PUBLIC_LABEL}</h2>
        <p class="muted">Open the listing visitors see.</p>
        <a class="btn btn--deep" href={href(`/business/${business.slug}`)}>{VIEW_PUBLIC_LABEL}</a>
      </section>
    </aside>
  </div>
</MerchantLayout>

<style>
  .welcome {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .welcome__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--brand-deep);
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--brand-teal-soft);
    color: var(--brand-teal);
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .live--wait {
    background: var(--brand-sun-soft);
    color: var(--brand-coral);
  }
  .welcome p {
    margin: 0.4rem 0 0;
    color: var(--brand-ink-soft);
  }
  .welcome__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.4rem;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-2);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    text-decoration: none;
  }
  .btn--deep {
    background: var(--brand-deep);
    color: white;
  }
  .btn--ghost {
    background: var(--brand-sand-dark);
    color: var(--brand-deep);
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .metric {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    padding: 1rem;
  }
  .metric strong {
    display: block;
    margin: 0.35rem 0 0.15rem;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--brand-deep);
    line-height: 1;
  }
  .metric span {
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  .metric__tag {
    margin: 0;
    display: inline-flex;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-pill);
    font-size: 0.625rem;
    font-weight: var(--font-weight-7);
  }
  .metric__tag--up {
    background: var(--brand-teal-soft);
    color: var(--brand-teal);
  }
  .metric__tag--warn {
    background: var(--brand-sun-soft);
    color: var(--brand-coral);
  }
  .metric__tag--info {
    background: var(--brand-sand);
    color: var(--brand-deep);
  }
  .layout {
    display: grid;
    gap: 1rem;
  }
  .main-col,
  .side-col {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .card {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    padding: 1.1rem;
  }
  .card h2,
  .card h3 {
    margin: 0 0 0.65rem;
    color: var(--brand-deep);
    font-size: var(--font-size-3);
  }
  .card__head {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .card__head h2 {
    margin: 0;
  }
  .card__head a,
  .card a {
    color: var(--brand-teal);
    font-weight: var(--font-weight-7);
    font-size: var(--font-size-0);
  }
  .feature {
    display: grid;
    gap: 1rem;
  }
  .feature__media {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-2);
  }
  .eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
    font-weight: var(--font-weight-7);
  }
  .feature p {
    margin: 0 0 0.75rem;
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
  }
  .activity {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .activity li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem;
    border-radius: var(--radius-2);
    background: var(--brand-sand);
  }
  .activity strong {
    display: block;
    color: var(--brand-deep);
  }
  .activity p {
    margin: 0.2rem 0 0;
    color: var(--brand-ink-soft);
    font-size: var(--font-size-0);
  }
  .score {
    margin: 0;
    font-size: 2.5rem;
    font-weight: var(--font-weight-8);
    color: var(--brand-deep);
    line-height: 1;
  }
  .muted {
    margin: 0.25rem 0 0.85rem;
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
  }
  .checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    font-size: var(--font-size-1);
  }
  .checklist .done {
    color: var(--brand-teal);
  }
  .checklist li {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }
  @media (min-width: 700px) {
    .metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .feature {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
    }
  }
  @media (min-width: 1100px) {
    .layout {
      grid-template-columns: minmax(0, 1.6fr) minmax(15rem, 0.75fr);
      align-items: start;
    }
  }
</style>
