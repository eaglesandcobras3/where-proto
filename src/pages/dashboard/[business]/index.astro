---
import Layout from "../../../layouts/Layout.astro";
import Box from "../../../components/Box.astro";
import type { Business } from "../../../data/types";
import { href } from "../../../lib/href";
import { ownedBusinessPaths } from "../../../lib/static-paths";

export function getStaticPaths() {
  return ownedBusinessPaths();
}

interface Props {
  business: Business;
}

const { business } = Astro.props;
---

<Layout
  title={`Manage ${business.name}`}
  note="Anything under manage-my-business is still being defined. These links are placeholders."
>
  <p><a href={href("/dashboard")}>Dashboard</a></p>
  <h1>Manage: {business.name}</h1>
  <p>Public listing: <a href={href(`/business/${business.slug}`)}>{business.name}</a></p>
  <Box label="Manage my business">
    <ul>
      <li><a href={href(`/dashboard/${business.slug}/feed`)}>Post feed (as business)</a></li>
      <li><a href={href(`/dashboard/${business.slug}/events/new`)}>Post event</a></li>
      <li><a href={href(`/dashboard/${business.slug}/mentions`)}>See mentions</a></li>
      <li><a href={href(`/dashboard/${business.slug}/listing`)}>Edit listing</a></li>
      <li><a href={href(`/dashboard/${business.slug}/photos`)}>Photos</a></li>
    </ul>
  </Box>
</Layout>
