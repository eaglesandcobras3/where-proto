---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DashboardNav from "../../../components/DashboardNav.astro";
import ComposerCard from "../../../components/islands/ComposerCard.svelte";
import type { Business } from "../../../data/types";
import { href } from "../../../lib/href";
import { ownedBusinessPaths } from "../../../lib/static-paths";

export function getStaticPaths() {
  return ownedBusinessPaths();
}

interface Props {
  business: Business;
}

const { business } = Astro.props;
---

<BaseLayout title={`Manage ${business.name}`}>
  <div class="container section">
    <p class="eyebrow">Dashboard</p>
    <h1>{business.name}</h1>
    <p>
      Public listing: <a href={href(`/business/${business.slug}`)}>{business.name}</a>
    </p>
    <DashboardNav businessSlug={business.slug} active="overview" />
    <div class="cards">
      <ComposerCard
        title="Post an update"
        body="New menu item, hours change, seasonal special. Goes to the review queue."
        action="Submit update"
        kind="update"
        client:visible
      />
      <ComposerCard
        title="Post an event"
        body="A dated event. Also creates a linked update."
        action="Submit event"
        kind="event"
        client:visible
      />
      <ComposerCard
        title="Post an image"
        body="Add a photo to your gallery. Only images you own."
        action="Choose image"
        kind="photo"
        client:visible
      />
    </div>
  </div>
</BaseLayout>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--size-4);
  }
</style>
