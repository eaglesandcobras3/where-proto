---
import MerchantLayout from "../../../layouts/MerchantLayout.astro";
import ComposerCard from "../../../components/islands/ComposerCard.svelte";
import { businessesOwnedBy, currentUser, postsFor, questions } from "../../../data/catalog";
import type { Business } from "../../../data/types";
import { href } from "../../../lib/href";
import { ownedBusinessPaths } from "../../../lib/static-paths";

export function getStaticPaths() {
  return ownedBusinessPaths();
}

interface Props {
  business: Business;
}

const { business } = Astro.props;
const owner = currentUser();
const firstName = (owner?.name ?? "there").split(" ")[0];
const feedCount = postsFor("business", business.slug).length;
const askHits = questions.filter((item) =>
  item.body.toLowerCase().includes(business.name.split(" ")[0]?.toLowerCase() ?? ""),
).length;

const metrics = [
  { label: "Community mentions", value: String(Math.max(askHits, 3)), meta: "3 need a response", tone: "warn" },
  { label: "Guide features", value: "6", meta: "2 added recently", tone: "info" },
  { label: "Profile actions", value: "83", meta: "Calls, clicks, directions", tone: "up" },
];

const owned = businessesOwnedBy("local_owner");
void owned;
---

<MerchantLayout title={`Manage ${business.name}`} business={business} active="overview">
  <header class="welcome">
    <div>
      <div class="welcome__row">
        <h1>Good morning, {firstName}.</h1>
        <span class="live">Profile is live</span>
      </div>
      <p>
        Here’s what’s happening around <strong>{business.name}</strong> along Highway 30A today.
      </p>
    </div>
    <div class="welcome__actions">
      <a class="btn btn--ghost" href={href(`/business/${business.slug}`)}>Share profile link</a>
      <a class="btn btn--deep" href={href(`/dashboard/${business.slug}/feed`)}>Create post</a>
    </div>
  </header>

  <div class="metrics">
    {
      metrics.map((item) => (
        <article class="metric">
          <p class:list={["metric__tag", `metric__tag--${item.tone}`]}>{item.meta}</p>
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </article>
      ))
    }
  </div>

  <div class="layout">
    <div class="main-col">
      <section class="card">
        <h2>Share something new</h2>
        <ComposerCard
          title="What’s new at your business?"
          body="Photo, update, or event — submissions go to the review queue before they go live."
          action="Publish"
          kind="update"
          client:visible
        />
      </section>

      <section class="card feature">
        <div class="feature__media img-placeholder" aria-hidden="true"></div>
        <div>
          <p class="eyebrow">Active feature</p>
          <h3>Keep your gallery fresh for weekend travelers</h3>
          <p>
            Your listing is surfacing in corridor guides. Update photos and hours so arriving visitors
            get the right picture.
          </p>
          <a href={href(`/dashboard/${business.slug}/photos`)}>Manage photo gallery →</a>
        </div>
      </section>

      <section class="card">
        <div class="card__head">
          <h2>Recent activity</h2>
          <a href={href(`/dashboard/${business.slug}/mentions`)}>See all →</a>
        </div>
        <ul class="activity">
          <li>
            <div>
              <strong>New community question</strong>
              <p>A visitor asked about parking near your listing.</p>
            </div>
            <a class="btn btn--ghost" href={href(`/dashboard/${business.slug}/mentions`)}>Reply now</a>
          </li>
          <li>
            <div>
              <strong>Guide feature</strong>
              <p>You were mentioned in a local weekend guide.</p>
            </div>
            <a class="btn btn--ghost" href={href(`/dashboard/${business.slug}/guides`)}>View guide</a>
          </li>
          <li>
            <div>
              <strong>Post performance</strong>
              <p>{feedCount || 2} recent posts are reaching corridor browsers.</p>
            </div>
            <a class="btn btn--ghost" href={href(`/dashboard/${business.slug}/feed`)}>View posts</a>
          </li>
        </ul>
      </section>
    </div>

    <aside class="side-col">
      <section class="card">
        <h2>Profile strength</h2>
        <p class="score">85%</p>
        <p class="muted">Almost optimized</p>
        <ul class="checklist">
          <li class="done">Contact details</li>
          <li class="done">Hours</li>
          <li class="done">Photos</li>
          <li>
            Seasonal highlight
            <a href={href(`/dashboard/${business.slug}/listing`)}>+ Add</a>
          </li>
        </ul>
      </section>
      <section class="card">
        <h2>View mode</h2>
        <p class="muted">Leave management and open the public listing visitors see.</p>
        <a class="btn btn--deep" href={href("/")}>View public site</a>
      </section>
    </aside>
  </div>
</MerchantLayout>

<style>
  .welcome {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .welcome__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--brand-deep);
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    background: #e0f2f1;
    color: var(--brand-teal);
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .welcome p {
    margin: 0.4rem 0 0;
    color: var(--brand-ink-soft);
  }
  .welcome__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.4rem;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-2);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    text-decoration: none;
  }
  .btn--deep {
    background: var(--brand-deep);
    color: white;
  }
  .btn--ghost {
    background: #f1f5f9;
    color: var(--brand-deep);
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .metric {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    padding: 1rem;
  }
  .metric strong {
    display: block;
    margin: 0.35rem 0 0.15rem;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--brand-deep);
    line-height: 1;
  }
  .metric span {
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  .metric__tag {
    margin: 0;
    display: inline-flex;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-pill);
    font-size: 0.625rem;
    font-weight: var(--font-weight-7);
  }
  .metric__tag--up {
    background: #e0f2f1;
    color: var(--brand-teal);
  }
  .metric__tag--warn {
    background: #fef3c7;
    color: #92400e;
  }
  .metric__tag--info {
    background: #eff4ff;
    color: var(--brand-deep);
  }
  .layout {
    display: grid;
    gap: 1rem;
  }
  .main-col,
  .side-col {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .card {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    padding: 1.1rem;
  }
  .card h2,
  .card h3 {
    margin: 0 0 0.65rem;
    color: var(--brand-deep);
    font-size: var(--font-size-3);
  }
  .card__head {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .card__head h2 {
    margin: 0;
  }
  .card__head a,
  .card a {
    color: var(--brand-teal);
    font-weight: var(--font-weight-7);
    font-size: var(--font-size-0);
  }
  .feature {
    display: grid;
    gap: 1rem;
  }
  .feature__media {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-2);
  }
  .eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-teal);
    font-weight: var(--font-weight-7);
  }
  .feature p {
    margin: 0 0 0.75rem;
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
  }
  .activity {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .activity li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem;
    border-radius: var(--radius-2);
    background: #faf8f4;
  }
  .activity strong {
    display: block;
    color: var(--brand-deep);
  }
  .activity p {
    margin: 0.2rem 0 0;
    color: var(--brand-ink-soft);
    font-size: var(--font-size-0);
  }
  .score {
    margin: 0;
    font-size: 2.5rem;
    font-weight: var(--font-weight-8);
    color: var(--brand-deep);
    line-height: 1;
  }
  .muted {
    margin: 0.25rem 0 0.85rem;
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
  }
  .checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    font-size: var(--font-size-1);
  }
  .checklist .done {
    color: var(--brand-teal);
  }
  .checklist li {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }
  @media (min-width: 700px) {
    .metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .feature {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
    }
  }
  @media (min-width: 1100px) {
    .layout {
      grid-template-columns: minmax(0, 1.6fr) minmax(15rem, 0.75fr);
      align-items: start;
    }
  }
</style>
