---
import Layout from "../../layouts/Layout.astro";
import { businessBySlug, eventBySlug, events, townBySlug } from "../../data/catalog";
import { href } from "../../lib/href";

export function getStaticPaths() {
  return events.map((item) => ({ params: { slug: item.slug } }));
}

const event = eventBySlug(Astro.params.slug!);
if (!event) {
  throw new Error(`Missing event: ${Astro.params.slug}`);
}

const town = event.townSlug ? townBySlug(event.townSlug) : undefined;
const business = event.businessSlug ? businessBySlug(event.businessSlug) : undefined;
---

<Layout title={event.name}>
  <p><a href={href("/events")}>Events</a></p>
  <h1>Event page: {event.name}</h1>
  <p>{event.summary}</p>
  <ul>
    <li>When: {event.when}</li>
    {
      town && (
        <li>
          Town: <a href={href(`/towns/${town.slug}`)}>{town.name}</a>
        </li>
      )
    }
    {
      business && (
        <li>
          Business: <a href={href(`/business/${business.slug}`)}>{business.name}</a>
        </li>
      )
    }
  </ul>
</Layout>
