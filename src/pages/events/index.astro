---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InteriorHero from "../../components/InteriorHero.astro";
import TwoPaneMap from "../../components/TwoPaneMap.astro";
import EventFilters from "../../components/islands/EventFilters.svelte";
import ListingFilters from "../../components/islands/ListingFilters.svelte";
import ListingRail from "../../components/ListingRail.astro";
import { townCountsFor } from "../../lib/unified-layout";
import { businessBySlug, events, towns, townBySlug } from "../../data/catalog";
import { href } from "../../lib/href";
import { markersFromNames, withoutViewMap, withViewMap } from "../../lib/map-markers";

const params = Astro.url.searchParams;
const town = params.get("town") ?? "";
const from = params.get("from") ?? "";
const to = params.get("to") ?? "";
const category = params.get("category") ?? "";
const q = params.get("q") ?? "";
const mapView = params.get("view") === "map";
const base = import.meta.env.BASE_URL;
const searchQs = Astro.url.search;
const mapHref = withViewMap("/events", searchQs);
const gridHref = withoutViewMap("/events", searchQs);

const categoryOptions = [
  { slug: "Music", name: "Live Music" },
  { slug: "Wellness", name: "Wellness & Yoga" },
  { slug: "Market", name: "Farmers Markets" },
  { slug: "Food", name: "Food & Wine" },
  { slug: "Arts", name: "Arts & Culture" },
  { slug: "Family", name: "Family Friendly" },
];

const rows = events.map((event) => {
  const townRow = event.townSlug ? townBySlug(event.townSlug) : undefined;
  const host = event.businessSlug ? businessBySlug(event.businessSlug)?.name : undefined;
  return {
    slug: event.slug,
    name: event.name,
    town: event.townSlug,
    townName: townRow?.name,
    when: event.when,
    time: event.time,
    venue: event.venue,
    category: event.category,
    price: event.price,
    summary: event.summary,
    host: host ?? (townRow ? `${townRow.name} Events` : "Community host"),
    bucket: event.bucket,
  };
});

const townCounts = towns
  .map((item) => ({
    slug: item.slug,
    name: item.name,
    count: events.filter((event) => event.townSlug === item.slug).length,
  }))
  .filter((item) => item.count > 0);
const allTownCounts = townCountsFor(towns, events, (event) => event.townSlug);
const categoryCounts = categoryOptions.map((item) => ({
  ...item,
  count: events.filter((event) => (event.category ?? "").toLowerCase() === item.slug.toLowerCase()).length,
}));

const exploreTowns = towns.map(({ slug, name }) => ({ slug, name }));

const venueCounts = [
  { name: "Seaside Amphitheatre", count: events.filter((e) => e.venue?.includes("Amphitheatre")).length || 2 },
  { name: "Alys Beach Green", count: events.filter((e) => e.townSlug === "alys-beach").length || 1 },
  { name: "Barrett Square", count: events.filter((e) => e.venue?.includes("Barrett")).length || 1 },
  { name: "Grayton town core", count: events.filter((e) => e.townSlug === "grayton-beach").length || 1 },
];

const mapMarkers = markersFromNames(
  rows.map((event) => ({
    name: event.name,
    href: href(`/event/${event.slug}`),
    detail: `${event.townName ?? "30A"} · ${event.when}`,
  })),
);
---

<BaseLayout
  title="30A Events & Community Calendar"
  description="Upcoming concerts, markets, wellness, and community gatherings along Scenic Highway 30A."
  active="events"
  crumbs={[{ label: "Events" }]}
>
  <div class="events-page">
    <InteriorHero
      title="30A Events & Community Calendar"
      lede="Live music, markets, wellness, and neighborhood gatherings across the corridor."
    />

    {
      mapView ? (
        <TwoPaneMap
          mapLabel="30A events map"
          resultLabel={`${events.length} Events along Scenic 30A`}
          gridHref={href(gridHref)}
          markers={mapMarkers}
          searchArea
        >
          <EventFilters
            events={rows}
            initialTown={town}
            initialCategory={category}
            initialQuery={q}
            base={base}
            client:load
          />
        </TwoPaneMap>
      ) : (
        <div class="container layout">
          <div class="filters-col">
            
            <div>
              <ListingFilters
                surface="events"
                eventName="w30a:events-filters"
                extraSearch="from"
                initialFrom={from}
                initialQuery={q}
                towns={allTownCounts}
                initialTown={town}
                townTotal={events.length}
                primaryLabel="Category"
                primaryKey="category"
                primaryOptions={categoryCounts}
                initialPrimary={category}
                note={{
                  label: "Local ordinance",
                  title: "Bonfire permits required",
                  body: "Evening beach bonfires need a Walton County permit and a licensed container. Leave no trace at dune accesses.",
                }}
                client:load
              />
            </div>
          </div>

          <EventFilters
            events={rows}
            initialTown={town}
            initialCategory={category}
            initialQuery={q}
            base={base}
            client:load
          />

          <aside class="rail">
            
            <div>
              <ListingRail mapTitle="Events map" mapHref={mapHref} contributeKind="event" current="events">
                <section class="widget" slot="discovery">
                  <p class="widget__label">Trending venues</p>
                  <ul class="venues">
                    {venueCounts.map((item) => (
                      <li>
                        <span>{item.name}</span>
                        <span>{item.count}</span>
                      </li>
                    ))}
                  </ul>
                </section>
              </ListingRail>
            </div>
          </aside>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .events-page {
    background: var(--brand-sand);
    color: var(--brand-ink);
  }
  .layout {
    display: grid;
    gap: var(--size-5);
    padding-block: var(--size-6) var(--size-10);
    align-items: start;
  }
  .rail {
    display: none;
    gap: var(--size-4);
  }
  .widget {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-card);
    padding: var(--size-4);
  }
  .widget__label {
    margin: 0 0 var(--size-3);
    font-family: var(--font-display);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .venues {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .venues li {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: var(--font-size-1);
    color: var(--brand-ink);
  }
  .venues li span:last-child {
    color: var(--brand-teal);
    font-weight: var(--font-weight-7);
  }
  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: 15.5rem minmax(0, 1fr) 16.5rem;
    }
    .rail {
      display: grid;
    }
  }
</style>
