---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import EventCard from "../../components/EventCard.astro";
import { events } from "../../data/catalog";
---

<BaseLayout title="Events on 30A" description="Upcoming events along Scenic Highway 30A." active="events">
  <div class="container section">
    <PageHeader eyebrow="Events" title="What's on" lede="Concerts, markets, and seasonal gatherings. Fake dates for the prototype." />
    <div class="grid">
      {events.map((event) => <EventCard event={event} />)}
    </div>
  </div>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--size-4);
  }
</style>
