---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TwoPaneMap from "../../components/TwoPaneMap.astro";
import EventFilters from "../../components/islands/EventFilters.svelte";
import { events, townBySlug } from "../../data/catalog";
import { href } from "../../lib/href";

const params = Astro.url.searchParams;
const town = params.get("town") ?? "";
const from = params.get("from") ?? "";
const to = params.get("to") ?? "";
const q = params.get("q") ?? "";
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Events on 30A"
  description="Upcoming events along Scenic Highway 30A."
  active="events"
  showEvents
  eventsTown={town}
  eventsFrom={from}
  eventsTo={to}
  eventsQuery={q}
>
  <TwoPaneMap mapLabel="30A events map" pinCount={Math.max(6, events.length)} searchArea>
    <p class="cta"><a href={href("/dashboard")}>Submit your event</a></p>
    <EventFilters
      events={events.map((event) => ({
        slug: event.slug,
        name: event.name,
        town: event.townSlug,
        townName: event.townSlug ? townBySlug(event.townSlug)?.name : undefined,
        when: event.when,
        time: event.time,
        venue: event.venue,
        category: event.category,
        bucket: event.bucket,
      }))}
      initialTown={town}
      initialQuery={q}
      base={base}
      client:load
    />
  </TwoPaneMap>
</BaseLayout>

<style>
  .cta {
    margin-bottom: var(--size-4);
    font-weight: var(--font-weight-6);
  }
</style>
