---
import Layout from "../../layouts/Layout.astro";
import Box from "../../components/Box.astro";
import { stories } from "../../data/catalog";
import type { Story } from "../../data/types";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(stories, "story");
}

interface Props {
  item: Story;
}

const { item: story } = Astro.props;
---

<Layout title={story.title}>
  <p><a href={href("/stories")}>Stories</a></p>
  <h1>Story: {story.title}</h1>
  <p>{story.summary}</p>
  <Box label="Body">
    <p>{story.body}</p>
  </Box>
</Layout>
