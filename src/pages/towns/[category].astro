---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InteriorHero from "../../components/InteriorHero.astro";
import ListingFilters from "../../components/islands/ListingFilters.svelte";
import ListingRail from "../../components/ListingRail.astro";
import FilterBar from "../../components/islands/FilterBar.svelte";
import { allLeaves, categories, searchableBusinesses, tags, towns } from "../../data/catalog";
import type { Category, CategoryLeaf } from "../../data/types";
import { categoryGroupsFor, townCountsFor } from "../../lib/unified-layout";
import { toFilterBusiness } from "../../lib/listing";
import { withViewMap } from "../../lib/map-markers";

type LeafWithGroup = CategoryLeaf & { groupSlug: string; groupName: string };

export function getStaticPaths() {
  return [
    ...categories.map((group) => ({
      params: { category: group.slug },
      props: { group, leaf: null as LeafWithGroup | null },
    })),
    ...allLeaves().map((leaf) => {
      const group = categories.find((item) => item.slug === leaf.groupSlug) ?? categories[0];
      return {
        params: { category: leaf.slug },
        props: { group, leaf },
      };
    }),
  ];
}

interface Props {
  group: Category;
  leaf: LeafWithGroup | null;
}

const { group, leaf } = Astro.props;
const heading = leaf?.name ?? group.name;
const consumerCategories = categories.filter((item) => item.slug !== "community");
const listings = searchableBusinesses.filter((item) => item.categorySlug !== "community");
const categoryGroups = categoryGroupsFor(consumerCategories, listings, (item) => item.leafSlug);
const filterCategories = [
  ...consumerCategories.map((item) => ({ slug: item.slug, name: item.name })),
  ...allLeaves()
    .filter((item) => item.groupSlug !== "community")
    .map((item) => ({ slug: item.slug, name: item.name })),
];
const filterGroups = consumerCategories.map(({ slug, name, leaves }) => ({ slug, name, leaves }));
const allTownCounts = townCountsFor(towns, listings, (biz) => biz.townSlug);
const amenityCounts = tags.map((item) => ({
  slug: item.slug,
  name: item.name,
  count: listings.filter((biz) => biz.tagSlugs.includes(item.slug)).length,
}));
const base = import.meta.env.BASE_URL;
const mapHref = withViewMap("/search", `?category=${leaf?.slug ?? group.slug}`);
---

<BaseLayout
  title={`${heading} on 30A`}
  description={`Find ${heading.toLowerCase()} in every town along 30A.`}
  active="towns"
  crumbs={[{ label: "Towns", path: "/towns" }, { label: heading }]}
>
  <div class="category-page">
    <InteriorHero title={`${heading} on 30A`} lede={`Find ${heading.toLowerCase()} in every town along Scenic Highway 30A.`} />
    <div class="container layout">
      <div class="filters-col">
        <ListingFilters
          surface="search"
          eventName="w30a:search-filters"
          towns={allTownCounts}
          townTotal={listings.length}
          categoryGroups={categoryGroups}
          initialPrimary={leaf?.slug ?? group.slug}
          tags={amenityCounts}
          tagsLabel="Tags"
          tagsKey="tag"
          client:load
        />
      </div>

      <div class="main">
        <FilterBar
          businesses={listings.map(toFilterBusiness)}
          towns={towns}
          categories={filterCategories}
          categoryGroups={filterGroups}
          tags={tags}
          initialCategory={leaf?.slug ?? group.slug}
          externalChrome
          base={base}
          client:load
        />
      </div>

      <aside class="rail">
        <ListingRail mapTitle={`${heading} map`} mapHref={mapHref} contributeKind="business" current="towns" />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .category-page {
    background: var(--brand-sand);
    color: var(--brand-ink);
  }
  .layout {
    display: grid;
    gap: var(--size-5);
    padding-block: var(--size-6) var(--size-10);
    align-items: start;
  }
  .main {
    min-width: 0;
  }
  .rail {
    display: none;
    gap: var(--size-4);
  }
  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: 15.5rem minmax(0, 1fr) 16.5rem;
    }
    .rail {
      display: grid;
    }
  }
</style>
