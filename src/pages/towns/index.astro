---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import TownCard from "../../components/TownCard.astro";
import { towns } from "../../data/catalog";
---

<BaseLayout title="Towns on 30A" description="Compare the towns along Scenic Highway 30A." active="towns" showBrowse>
  <div class="container section">
    <PageHeader
      eyebrow="Towns"
      title="The 30A corridor"
      lede="West to east along the corridor. Each town has a one-line description and an Explore link. Town pages are discovery surfaces: glance facts plus local businesses, guides, and events."
    />
    <div class="listing-grid-full">
      {towns.map((town) => <TownCard town={town} />)}
    </div>
  </div>
</BaseLayout>
