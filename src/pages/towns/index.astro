---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InteriorHero from "../../components/InteriorHero.astro";
import Corridor from "../../components/Corridor.astro";
import TwoPaneMap from "../../components/TwoPaneMap.astro";
import TownsList from "../../components/islands/TownsList.svelte";
import ListingFilters from "../../components/islands/ListingFilters.svelte";
import ListingRail from "../../components/ListingRail.astro";
import LocalsPick from "../../components/LocalsPick.astro";
import { businessesForTown, towns } from "../../data/catalog";
import { townView } from "../../lib/town-view";
import { href } from "../../lib/href";
import { markersFromNames, withoutViewMap, withViewMap } from "../../lib/map-markers";

const params = Astro.url.searchParams;
const q = params.get("q") ?? "";
const region = params.get("region") ?? "";
const vibe = params.get("vibe") ?? "";
const mapView = params.get("view") === "map";
const base = import.meta.env.BASE_URL;
const searchQs = Astro.url.search;
const mapHref = withViewMap("/towns", searchQs);
const gridHref = withoutViewMap("/towns", searchQs);

const west = new Set(["sandestin", "santa-rosa-beach", "dune-allen-beach", "gulf-place", "blue-mountain-beach"]);
const central = new Set(["grayton-beach", "watercolor", "seaside", "seagrove-beach"]);
const east = new Set(["watersound", "alys-beach", "seacrest-beach", "rosemary-beach", "inlet-beach"]);

const vibeMap: Record<string, { vibe: string; vibeSlug: string }> = {
  seaside: { vibe: "New Urbanist", vibeSlug: "new-urbanism" },
  "rosemary-beach": { vibe: "New Urbanist", vibeSlug: "new-urbanism" },
  "alys-beach": { vibe: "New Urbanist", vibeSlug: "new-urbanism" },
  watercolor: { vibe: "Planned Family", vibeSlug: "planned" },
  watersound: { vibe: "Planned Family", vibeSlug: "planned" },
  "grayton-beach": { vibe: "Old Florida", vibeSlug: "old-florida" },
  "blue-mountain-beach": { vibe: "Old Florida", vibeSlug: "old-florida" },
  sandestin: { vibe: "Resort & Activity", vibeSlug: "resort" },
  "gulf-place": { vibe: "Public Beach Hub", vibeSlug: "public-hub" },
};

const beachSlugFor = (access: string) => {
  const lower = access.toLowerCase();
  if (lower.includes("private")) return "private";
  if (lower.includes("public")) return "public";
  return "mixed";
};

const townItems = towns.map((town, index) => {
  const view = townView(town);
  const meta = vibeMap[town.slug] ?? { vibe: "Coastal Town", vibeSlug: "coastal" };
  return {
    slug: town.slug,
    name: town.name,
    summary: town.summary,
    tagline: view.tagline,
    vibe: meta.vibe,
    vibeSlug: meta.vibeSlug,
    region: (west.has(town.slug) ? "west" : east.has(town.slug) ? "east" : "central") as
      | "west"
      | "central"
      | "east",
    beachSlug: beachSlugFor(town.beachAccess),
    walkScore: 70 + ((town.name.length * 3 + index * 5) % 28),
    highlights: view.highlights,
    eateries: Math.max(2, businessesForTown(town.slug).length),
    accesses: 2 + (index % 4),
  };
});

const vibes = [
  { slug: "new-urbanism", name: "New Urbanism" },
  { slug: "old-florida", name: "Old Florida Coastal" },
  { slug: "planned", name: "Planned Family" },
  { slug: "resort", name: "Resort & Activity" },
  { slug: "public-hub", name: "Public Beach Hub" },
];

const beachTypes = [
  { slug: "public", name: "Regional public walkovers" },
  { slug: "private", name: "Guest / private access" },
  { slug: "mixed", name: "Mixed public & private" },
];

const regionCounts = [
  { slug: "west", name: "West 30A", count: townItems.filter((item) => item.region === "west").length },
  { slug: "central", name: "Central 30A", count: townItems.filter((item) => item.region === "central").length },
  { slug: "east", name: "East 30A", count: townItems.filter((item) => item.region === "east").length },
];
const vibeCounts = vibes.map((item) => ({
  ...item,
  count: townItems.filter((town) => town.vibeSlug === item.slug).length,
}));
const beachCounts = beachTypes.map((item) => ({
  ...item,
  count: townItems.filter((town) => town.beachSlug === item.slug).length,
}));

const mapMarkers = markersFromNames(
  townItems.map((item) => ({
    name: item.name,
    href: href(`/town/${item.slug}`),
    detail: `${item.vibe} · Walk ${item.walkScore}`,
  })),
  8,
);
---

<BaseLayout
  title="30A Towns & Neighborhoods"
  description="Compare the towns along Scenic Highway 30A — walkability, beach access, and local character."
  active="towns"
>
  <div class="towns-page">
    <InteriorHero
      title="30A Towns & Neighborhoods"
      lede="Discover the distinctive architectural character, beach access rules, and vibrant town centers stretching across Scenic Highway 30A."
      crumbs={[{ label: "Towns" }]}
    />

    <Corridor />

    {
      mapView ? (
        <TwoPaneMap
          mapLabel="30A towns map"
          resultLabel={`${towns.length} Towns along Scenic 30A`}
          gridHref={href(gridHref)}
          markers={mapMarkers}
          searchArea
        >
          <TownsList
            towns={townItems}
            initialQuery={q}
            initialRegion={region}
            initialVibe={vibe}
            base={base}
            client:load
          />
        </TwoPaneMap>
      ) : (
        <div class="container layout">
          <div class="filters-col">
            
            <div>
              <ListingFilters
                surface="towns"
                eventName="w30a:towns-filters"
                initialQuery={q}
                primaryLabel="Region"
                primaryKey="region"
                primaryOptions={regionCounts}
                initialPrimary={region}
                secondaries={[
                  { key: "vibe", label: "Vibe", options: vibeCounts },
                  { key: "beach", label: "Beach access", options: beachCounts },
                ]}
                client:load
              />
            </div>
          </div>

          <TownsList
            towns={townItems}
            initialQuery={q}
            initialRegion={region}
            initialVibe={vibe}
            base={base}
            client:load
          />

          <aside class="rail">
            
            <div>
              <ListingRail mapTitle="Towns map" mapHref={mapHref} contributeKind="business" current="towns">
                <LocalsPick
                  slot="discovery"
                  name="Seaside"
                  quote="Start on the square, then walk a town in each direction before you lock a stay."
                  byline="Capt. Dave · Seagrove Resident"
                  href="/town/seaside"
                />
              </ListingRail>
            </div>
          </aside>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .towns-page {
    background: var(--brand-sand);
    color: var(--brand-ink);
  }
  .layout {
    display: grid;
    gap: var(--size-5);
    padding-block: var(--size-6) var(--size-10);
    align-items: start;
  }
  .rail {
    display: none;
    gap: var(--size-4);
  }
  .widget {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-card);
    padding: var(--size-4);
  }
  .widget__label {
    margin: 0 0 var(--size-3);
    font-family: var(--font-display);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .copy {
    margin: 0;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .story {
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: 15rem minmax(0, 1fr) 16rem;
    }
    .rail {
      display: grid;
    }
  }
</style>
