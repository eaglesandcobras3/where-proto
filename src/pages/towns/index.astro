---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TwoPaneMap from "../../components/TwoPaneMap.astro";
import Corridor from "../../components/Corridor.astro";
import TownCard from "../../components/TownCard.astro";
import { towns } from "../../data/catalog";
---

<BaseLayout
  title="Towns on 30A"
  description="Compare the towns along Scenic Highway 30A."
  active="towns"
  showBrowse
  browseInitialPanel="town"
>
  <TwoPaneMap mapLabel="30A towns map" pinCount={towns.length}>
    <Corridor />
    <div class="listing-grid-split">
      {towns.map((town) => <TownCard town={town} />)}
    </div>
  </TwoPaneMap>
</BaseLayout>
