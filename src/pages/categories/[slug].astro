---
import Layout from "../../layouts/Layout.astro";
import LinkList from "../../components/LinkList.astro";
import { categories } from "../../data/catalog";
import type { Category } from "../../data/types";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(categories);
}

interface Props {
  item: Category;
}

const { item: category } = Astro.props;
---

<Layout title={category.name}>
  <p><a href={href("/businesses")}>Businesses</a></p>
  <h1>Category: {category.name}</h1>
  <p>Leaf pages hold the listings.</p>
  <LinkList
    items={category.leaves.map((leaf) => ({
      href: href(`/categories/${category.slug}/${leaf.slug}`),
      label: leaf.name,
    }))}
  />
</Layout>
