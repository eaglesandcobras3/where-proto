---
import Layout from "../../../layouts/Layout.astro";
import LinkList from "../../../components/LinkList.astro";
import { businesses, categories } from "../../../data/catalog";
import type { Category, CategoryLeaf } from "../../../data/types";
import { href } from "../../../lib/href";

export function getStaticPaths() {
  return categories.flatMap((category) =>
    category.leaves.map((leaf) => ({
      params: { slug: category.slug, leaf: leaf.slug },
      props: { category, leaf },
    })),
  );
}

interface Props {
  category: Category;
  leaf: CategoryLeaf;
}

const { category, leaf } = Astro.props;

const listings = businesses.filter(
  (item) => item.categorySlug === category.slug && item.leafSlug === leaf.slug,
);
---

<Layout title={leaf.name}>
  <p>
    <a href={href("/businesses")}>Businesses</a> /
    <a href={href(`/categories/${category.slug}`)}>{category.name}</a>
  </p>
  <h1>Leaf: {leaf.name}</h1>
  <LinkList
    items={listings.map((item) => ({
      href: href(`/business/${item.slug}`),
      label: item.name,
      meta: item.summary,
    }))}
  />
</Layout>
