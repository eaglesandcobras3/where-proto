---
import PlaceLayout from "../../layouts/PlaceLayout.astro";
import BusinessCard from "../../components/BusinessCard.astro";
import PhotoGrid from "../../components/PhotoGrid.astro";
import AreaCard from "../../components/AreaCard.astro";
import {
  areaKindLabel,
  areas,
  areasForTown,
  businessesForArea,
  photosFor,
  townBySlug,
} from "../../data/catalog";
import type { Area } from "../../data/types";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(areas, "area");
}

interface Props {
  item: Area;
}

const { item: area } = Astro.props;
const town = townBySlug(area.townSlug);
const areaPhotos = photosFor("area", area.slug);
const inArea = businessesForArea(area.slug);
const siblings = areasForTown(area.townSlug).filter((item) => item.slug !== area.slug);
---

<PlaceLayout
  title={area.name}
  description={area.summary}
  active="areas"
  browseTown={town?.name}
  crumbs={[
    { label: "Areas", path: "/areas" },
    ...(town ? [{ label: town.name, path: `/town/${town.slug}` }] : []),
    { label: area.name },
  ]}
>
  <div class="container section">
    <p class="eyebrow">{areaKindLabel(area.kind)}</p>
    <h1>{area.name}</h1>
    <p class="lede">{area.summary}</p>
    {
      town && (
        <p>
          Inside <a href={href(`/town/${town.slug}`)}>{town.name}</a>. Indexable category pages stay on the town.
        </p>
      )
    }

    <h2 class="section-title">Photos</h2>
    <PhotoGrid photos={areaPhotos} />

    <h2 class="section-title">In this area</h2>
    {
      inArea.length === 0 ? (
        <p class="empty">No listings sit in this area yet.</p>
      ) : (
        <div class="grid">
          {inArea.map((business) => (
            <BusinessCard business={business} />
          ))}
        </div>
      )
    }

    {
      siblings.length > 0 && (
        <section>
          <h2 class="section-title">Other areas in {town?.name ?? "this town"}</h2>
          <div class="tiles">
            {siblings.map((item) => (
              <AreaCard area={item} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</PlaceLayout>

<style>
  .lede {
    color: var(--brand-ink-soft);
    max-width: 64ch;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--size-4);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--size-4);
  }
  .empty {
    color: var(--brand-ink-soft);
  }
</style>
