---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Advertise"
  note="Advertise is still being defined."
>
  <h1>Advertise</h1>
  <p>Placeholder for paid placement. No products or pricing yet.</p>
  <form>
    <p>
      <label>
        Business name
        <input type="text" name="name" />
      </label>
    </p>
    <p>
      <label>
        Email
        <input type="email" name="email" />
      </label>
    </p>
    <button type="button">Request info</button>
  </form>
</Layout>
