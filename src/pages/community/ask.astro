---
import Layout from "../../layouts/Layout.astro";
import { towns } from "../../data/catalog";
import { href } from "../../lib/href";
---

<Layout title="Ask a question">
  <p><a href={href("/community")}>Community</a></p>
  <h1>Ask a question</h1>
  <p>Wireframe form. Submit does nothing.</p>
  <form>
    <p>
      <label>
        Title
        <input type="text" name="title" />
      </label>
    </p>
    <p>
      <label>
        Town
        <select name="town">
          <option value="">None</option>
          {towns.map((town) => (
            <option value={town.slug}>{town.name}</option>
          ))}
        </select>
      </label>
    </p>
    <p>
      <label>
        Question
        <textarea name="body"></textarea>
      </label>
    </p>
    <button type="button">Post question</button>
  </form>
</Layout>
