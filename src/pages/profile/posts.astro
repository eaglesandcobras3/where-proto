---
import AccountLayout from "../../layouts/AccountLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { currentUserSlug, posts } from "../../data/catalog";

const mine = posts.filter((item) => item.authorUserSlug === currentUserSlug);
---

<AccountLayout title="My posts" active="posts">
  <div class="stack">
    {mine.map((post) => <PostCard post={post} />)}
    {mine.length === 0 && <p>No posts yet.</p>}
  </div>
</AccountLayout>

<style>
  .stack {
    display: grid;
    gap: var(--size-3);
    max-width: 720px;
  }
</style>
