---
import AccountLayout from "../../layouts/AccountLayout.astro";
import {
  commentsFor,
  currentUserSlug,
  posts,
} from "../../data/catalog";
import { href } from "../../lib/href";
import { postPlace } from "../../lib/listing";
import { countLabel, formatDate } from "../../lib/labels";

const pageLabel = {
  town: "Town Page",
  business: "Business Page",
  stay: "Stay Page",
} as const;

const mine = posts.filter((item) => item.authorUserSlug === currentUserSlug);

const rows = mine.map((post) => {
  const place = postPlace(post);
  return {
    ...post,
    placeName: place.name,
    placeHref: href(place.href),
    streamLabel: `Posted on ${place.name}`,
    pageLabel: pageLabel[post.on.type],
    comments: commentsFor("post", post.slug).length,
  };
});
---

<AccountLayout title="Posts" active="posts">
  <section class="panel">
    <div class="panel__head">
      <div>
        <h2>Posts</h2>
        <p>Notes you posted on town, stay, and business pages.</p>
      </div>
    </div>

    <div class="stack">
      {
        rows.map((post) => (
          <article class="card">
            <div class="card__top">
              <p class="stream">{post.streamLabel}</p>
              <a class="town-link" href={post.placeHref}>
                {post.pageLabel}
              </a>
            </div>
            <p class="when">{formatDate(post.createdAt)}</p>
            <p class="body">{post.body}</p>
            <div class="card__foot">
              <span>{countLabel(post.comments, "comment")}</span>
              <a href={href(`/posts/${post.slug}`)}>View post →</a>
            </div>
          </article>
        ))
      }
      {rows.length === 0 && <p class="empty">No posts yet.</p>}
    </div>
  </section>
</AccountLayout>

<style>
  .panel {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-card);
    padding: var(--size-5);
  }
  .panel__head {
    margin-bottom: var(--size-4);
  }
  .panel__head h2 {
    margin: 0 0 0.35rem;
    font-size: var(--font-size-4);
  }
  .panel__head p {
    margin: 0;
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
  }
  .stack {
    display: grid;
    gap: var(--size-3);
  }
  .card {
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    padding: var(--size-4);
    background: var(--brand-sand);
  }
  .card__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }
  .stream {
    margin: 0;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-teal);
  }
  .town-link {
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-6);
    color: var(--brand-ink-soft);
  }
  .when {
    margin: 0 0 0.65rem;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .body {
    margin: 0 0 0.85rem;
    font-size: var(--font-size-2);
    color: var(--brand-ink);
  }
  .card__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .card__foot a {
    color: var(--brand-teal);
    font-weight: var(--font-weight-7);
  }
  .empty {
    color: var(--brand-ink-soft);
  }
</style>
