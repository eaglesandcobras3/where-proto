---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AccountNav from "../../components/AccountNav.astro";
import QuestionCard from "../../components/QuestionCard.astro";
import { currentUserSlug, questions } from "../../data/catalog";

const mine = questions.filter((item) => item.authorUserSlug === currentUserSlug);
---

<BaseLayout title="My questions">
  <div class="container section">
    <h1>My questions</h1>
    <AccountNav active="questions" />
    <div class="stack">
      {mine.map((question) => <QuestionCard question={question} />)}
      {mine.length === 0 && <p>No questions yet.</p>}
    </div>
  </div>
</BaseLayout>

<style>
  .stack {
    display: grid;
    gap: var(--size-3);
    max-width: 720px;
  }
</style>
