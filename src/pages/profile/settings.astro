---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AccountNav from "../../components/AccountNav.astro";
import { currentUser } from "../../data/catalog";

const user = currentUser();
---

<BaseLayout title="Account settings">
  <div class="container section">
    <h1>Settings</h1>
    <AccountNav active="settings" />
    <form class="form" onsubmit="return false;">
      <wa-input label="Display name" value={user?.name ?? ""}></wa-input>
      <wa-input label="Email" type="email" value="kelley@example.com"></wa-input>
      <wa-switch checked>Email me weekly town roundups</wa-switch>
      <wa-button variant="brand">Save settings</wa-button>
    </form>
  </div>
</BaseLayout>

<style>
  .form {
    display: grid;
    gap: var(--size-4);
    max-width: 480px;
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-card);
    padding: var(--size-5);
    justify-items: start;
  }
  .form wa-input {
    width: 100%;
  }
</style>
