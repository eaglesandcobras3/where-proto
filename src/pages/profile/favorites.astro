---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AccountNav from "../../components/AccountNav.astro";
import {
  businessBySlug,
  currentUserSlug,
  eventBySlug,
  favorites,
  guideBySlug,
  townBySlug,
} from "../../data/catalog";
import { href } from "../../lib/href";

const mine = favorites.filter((item) => item.userSlug === currentUserSlug);

function label(item: (typeof mine)[number]) {
  if (item.type === "business") return businessBySlug(item.slug)?.name ?? item.slug;
  if (item.type === "event") return eventBySlug(item.slug)?.name ?? item.slug;
  if (item.type === "guide") return guideBySlug(item.slug)?.title ?? item.slug;
  return townBySlug(item.slug)?.name ?? item.slug;
}

function path(item: (typeof mine)[number]) {
  if (item.type === "business") return href(`/business/${item.slug}`);
  if (item.type === "event") return href(`/event/${item.slug}`);
  if (item.type === "guide") return href(`/guide/${item.slug}`);
  return href(`/town/${item.slug}`);
}
---

<BaseLayout title="Favorites">
  <div class="container section">
    <h1>Saved</h1>
    <AccountNav active="favorites" />
    <ul class="list">
      {
        mine.map((item) => (
          <li>
            <span class="type">{item.type}</span>
            <a href={path(item)}>{label(item)}</a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--size-3);
    max-width: 560px;
  }
  li {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-2);
    padding: var(--size-3) var(--size-4);
    display: flex;
    gap: var(--size-3);
    align-items: center;
  }
  .type {
    font-size: var(--font-size-0);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-teal);
  }
</style>
