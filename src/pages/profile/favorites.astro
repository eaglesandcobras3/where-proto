---
import AccountLayout from "../../layouts/AccountLayout.astro";
import SavedList from "../../components/islands/SavedList.svelte";
import {
  areas,
  businesses,
  currentUserSlug,
  events,
  favorites,
  guides,
  leafBySlug,
  stays,
  townBySlug,
  towns,
} from "../../data/catalog";
import { cardImageSrc } from "../../lib/card-image";
import { href } from "../../lib/href";
import type { SavedEntityType } from "../../lib/saved";

const seed = favorites
  .filter((item) => item.userSlug === currentUserSlug)
  .map((item) => ({ type: item.type as SavedEntityType, slug: item.slug }));

const cards = [
  ...businesses
    .filter((biz) => !biz.entityKind || biz.entityKind === "business")
    .map((biz) => {
      const town = townBySlug(biz.townSlug);
      const leaf = leafBySlug(biz.leafSlug);
      return {
        type: "business" as const,
        slug: biz.slug,
        title: biz.name,
        meta: [town?.name, leaf?.name].filter(Boolean).join(" · "),
        summary: biz.summary,
        href: href(`/business/${biz.slug}`),
        cta: "View Business",
        letter: biz.name.charAt(0),
        image: cardImageSrc(biz.name.charAt(0), "4/3"),
      };
    }),
  ...stays.map((stay) => ({
    type: "stay" as const,
    slug: stay.slug,
    title: stay.name,
    meta: townBySlug(stay.townSlug)?.name ?? "30A",
    summary: stay.summary,
    href: href(`/stay/${stay.slug}`),
    cta: "View stay",
    letter: stay.name.charAt(0),
    image: cardImageSrc(stay.name.charAt(0), "4/3"),
  })),
  ...events.map((event) => ({
    type: "event" as const,
    slug: event.slug,
    title: event.name,
    meta: [event.townSlug ? townBySlug(event.townSlug)?.name : null, event.category]
      .filter(Boolean)
      .join(" · "),
    summary: event.summary,
    href: href(`/event/${event.slug}`),
    cta: "Event Details",
    letter: event.name.charAt(0),
    image: cardImageSrc(event.name.charAt(0), "4/3"),
  })),
  ...guides.map((guide) => ({
    type: "guide" as const,
    slug: guide.slug,
    title: guide.title,
    meta: "Editorial",
    summary: guide.summary,
    href: href(`/guide/${guide.slug}`),
    cta: "Read Guide",
    letter: guide.title.charAt(0),
    image: cardImageSrc(guide.title.charAt(0), "4/3"),
  })),
  ...towns.map((town) => ({
    type: "town" as const,
    slug: town.slug,
    title: town.name,
    meta: "Scenic 30A",
    summary: town.summary,
    href: href(`/town/${town.slug}`),
    cta: "Explore Town",
    letter: town.name.charAt(0),
    image: cardImageSrc(town.name.charAt(0), "4/3"),
  })),
  ...areas.map((area) => ({
    type: "area" as const,
    slug: area.slug,
    title: area.name,
    meta: townBySlug(area.townSlug)?.name ?? "30A",
    summary: area.summary,
    href: href(`/area/${area.slug}`),
    cta: "Explore area",
    letter: area.name.charAt(0),
    image: cardImageSrc(area.name.charAt(0), "4/3"),
  })),
];
---

<AccountLayout title="Saved" active="favorites">
  <section class="panel">
    <div class="panel__head">
      <div>
        <h2>Saved</h2>
        <p>Collections for your 30A trip — businesses, towns, stays, events, and guides.</p>
      </div>
    </div>

    <SavedList seed={seed} cards={cards} client:load />
  </section>
</AccountLayout>

<style>
  .panel {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: var(--size-5);
  }
  .panel__head h2 {
    margin: 0 0 0.35rem;
    font-size: var(--font-size-4);
  }
  .panel__head p {
    margin: 0 0 var(--size-4);
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
  }
</style>
