---
import Layout from "../../layouts/Layout.astro";
import { currentUser } from "../../data/catalog";

const user = currentUser();
---

<Layout title="Profile">
  <h1>Profile</h1>
  <p>Signed-in view for {user?.name}. Fake session.</p>
  <ul>
    <li>Role: {user?.role}</li>
    <li>{user?.bio}</li>
  </ul>
</Layout>
