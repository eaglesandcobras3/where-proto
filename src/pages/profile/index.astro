---
import Layout from "../../layouts/Layout.astro";
import Box from "../../components/Box.astro";
import { currentUser } from "../../data/catalog";
import { href } from "../../lib/href";

const user = currentUser();
---

<Layout title="Profile">
  <h1>User facing profile</h1>
  <p>Signed-in view for {user?.name}. Fake session.</p>

  <Box label="Account">
    <ul>
      <li>Role: {user?.role}</li>
      <li>{user?.bio}</li>
    </ul>
  </Box>

  <Box label="Profile sections">
    <ul>
      <li><a href={href("/profile/favorites")}>View favorites</a></li>
      <li><a href={href("/profile/posts")}>Posts</a></li>
      <li><a href={href("/profile/settings")}>Account settings</a></li>
      <li><a href={href(`/u/${user?.slug}`)}>External facing profile</a></li>
      <li><a href={href("/dashboard")}>Business management / dashboard</a></li>
      <li><a href={href("/auth/login")}>Login</a></li>
    </ul>
  </Box>
</Layout>
