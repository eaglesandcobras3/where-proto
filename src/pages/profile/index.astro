---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AccountNav from "../../components/AccountNav.astro";
import { currentUser, favorites, posts, questions } from "../../data/catalog";
import { href } from "../../lib/href";

const user = currentUser();
const stats = [
  { label: "Saved", value: String(favorites.filter((item) => item.userSlug === user?.slug).length) },
  { label: "Questions", value: String(questions.filter((item) => item.authorUserSlug === user?.slug).length) },
  { label: "Posts", value: String(posts.filter((item) => item.authorUserSlug === user?.slug).length) },
];
---

<BaseLayout title={`${user?.name ?? "Member"} on WhereTo30A`}>
  <div class="container section">
    <section class="head">
      <div class="avatar img-placeholder" aria-hidden="true">{user?.name.charAt(0) ?? "M"}</div>
      <div>
        <h1>{user?.name ?? "Member"}</h1>
        <p class="meta">{user?.role} · fake signed-in session</p>
        <div class="stats">
          {
            stats.map((stat) => (
              <div class="stat">
                <span class="value">{stat.value}</span>
                <span class="label">{stat.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>
    <AccountNav active="profile" />
    <p>{user?.bio}</p>
    <p>
      <a href={href(`/u/${user?.slug}`)}>Public profile</a> · <a href={href("/dashboard")}>Dashboard</a> ·
      <a href={href("/auth/login")}>Login</a>
    </p>
  </div>
</BaseLayout>

<style>
  .head {
    display: flex;
    gap: var(--size-5);
    align-items: center;
    margin-bottom: var(--size-6);
  }
  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    flex-shrink: 0;
    font-size: var(--font-size-7);
  }
  .meta {
    color: var(--brand-ink-soft);
    text-transform: capitalize;
  }
  .stats {
    display: flex;
    gap: var(--size-5);
    margin-top: var(--size-2);
  }
  .stat {
    display: flex;
    flex-direction: column;
  }
  .stat .value {
    font-size: var(--font-size-4);
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .stat .label {
    font-size: var(--font-size-0);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-ink-soft);
  }
</style>
