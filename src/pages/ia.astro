---
import BaseLayout from "../layouts/BaseLayout.astro";
import { href } from "../lib/href";

const routes = [
  ["Homepage", "/"],
  ["Towns hub", "/towns"],
  ["Town", "/town/rosemary-beach"],
  ["Town × category (indexable)", "/town/rosemary-beach/restaurants"],
  ["Areas hub", "/areas"],
  ["Shopping area", "/area/barrett-square"],
  ["Neighborhood", "/area/east-rosemary"],
  ["Search (business finder)", "/search"],
  ["Search filtered", "/search?town=seaside&category=coffee-shops"],
  ["Business", "/business/edwards-fine-food-and-wine"],
  ["Events", "/events"],
  ["Event", "/event/sounds-of-seaside"],
  ["Guides", "/guides"],
  ["Guide", "/guide/first-timers-guide"],
  ["Ask", "/ask"],
  ["Question", "/ask/parking-near-seaside"],
  ["Stays", "/stays"],
  ["Stay", "/stay/the-pearl-hotel"],
  ["Updates (footer only)", "/updates"],
  ["Post", "/posts/sunset-on-the-square"],
  ["Dashboard", "/dashboard"],
  ["Manage business", "/dashboard/edwards-fine-food-and-wine"],
  ["Post feed as business", "/dashboard/edwards-fine-food-and-wine/feed"],
  ["Post event", "/dashboard/edwards-fine-food-and-wine/events/new"],
  ["Mentions", "/dashboard/edwards-fine-food-and-wine/mentions"],
  ["Edit listing", "/dashboard/edwards-fine-food-and-wine/listing"],
  ["Photos", "/dashboard/edwards-fine-food-and-wine/photos"],
  ["Profile", "/profile"],
  ["Favorites", "/profile/favorites"],
  ["Posts (user)", "/profile/posts"],
  ["Account settings", "/profile/settings"],
  ["External profile", "/u/beachlocal"],
  ["Update detail", "/updates/edwards-weekend-hours"],
  ["My questions", "/profile/questions"],
  ["Add business", "/add-business"],
  ["Admin", "/admin"],
  ["Review queue", "/admin/review-queue"],
  ["SEO overrides", "/admin/seo"],
  ["Knowledge", "/admin/knowledge"],
  ["Entities", "/admin/entities"],
  ["Login", "/auth/login"],
  ["Sign up", "/auth/signup"],
  ["Forgot password", "/auth/forgot-password"],
  ["About", "/about"],
  ["Legal", "/legal"],
  ["Advertise", "/advertise"],
];
---

<BaseLayout title="Route scaffold">
  <div class="container section">
    <h1>Route scaffold</h1>
    <p>No /businesses hub. /search is the finder. Town × category pages are the indexable leaves.</p>
    <ol>
      <li>There is no /businesses hub or /businesses/{"{category}"} leaf.</li>
      <li>/search is the business finder and stays noindex, follow.</li>
      <li>Town hubs are discovery surfaces with local businesses, plus /town/{"{town}"}/{"{leaf}"} leaves.</li>
      <li>/ask is the community route. Threads at /ask/{"{question}"}.</li>
      <li>Updates appear on town and business pages. /updates is footer only.</li>
      <li>Areas extend a town: shopping areas and neighborhoods.</li>
    </ol>
    <ul class="routes">
      {
        routes.map(([label, path]) => (
          <li>
            <a href={href(path)}>{label}</a>
            <span>{path}</span>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  ol {
    max-width: 64ch;
    color: var(--brand-ink-soft);
  }
  .routes {
    list-style: none;
    margin: var(--size-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--size-2);
  }
  .routes li {
    display: flex;
    justify-content: space-between;
    gap: var(--size-4);
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-2);
    padding: var(--size-3) var(--size-4);
  }
  .routes span {
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
  }
</style>
