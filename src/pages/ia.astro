---
import BaseLayout from "../layouts/BaseLayout.astro";
import { href } from "../lib/href";

const routes = [
  ["Homepage", "/"],
  ["Towns hub", "/towns"],
  ["Town", "/town/rosemary-beach"],
  ["Town × business category", "/town/rosemary-beach/business/restaurants"],
  ["Areas hub", "/areas"],
  ["Shopping area", "/area/barrett-square"],
  ["Neighborhood", "/area/east-rosemary"],
  ["Search (business finder)", "/search"],
  ["Search filtered", "/search?town=seaside&category=coffee-shops"],
  ["Business", "/town/rosemary-beach/business/food-and-drink/restaurants/edwards-fine-food-and-wine"],
  ["Events", "/events"],
  ["Event", "/event/sounds-of-seaside"],
  ["Guides", "/guides"],
  ["Guide", "/guide/first-timers-guide"],
  ["Ask", "/ask"],
  ["Question", "/ask/parking-near-seaside"],
  ["Stays", "/stays"],
  ["Town stays", "/town/rosemary-beach/stay"],
  ["Stay", "/town/rosemary-beach/stay/hotels/the-pearl-hotel"],
  ["Post", "/posts/sunset-on-the-square"],
  ["Manage business", "/dashboard"],
  ["Overview", "/dashboard/edwards-fine-food-and-wine"],
  ["Business profile", "/dashboard/edwards-fine-food-and-wine/listing"],
  ["Posts & events", "/dashboard/edwards-fine-food-and-wine/feed"],
  ["FAQs & knowledge", "/dashboard/edwards-fine-food-and-wine/faqs"],
  ["Community feed", "/dashboard/edwards-fine-food-and-wine/mentions"],
  ["Guide mentions", "/dashboard/edwards-fine-food-and-wine/guides"],
  ["Advertise & grow", "/dashboard/edwards-fine-food-and-wine/advertise"],
  ["Photos", "/dashboard/edwards-fine-food-and-wine/photos"],
  ["Post event", "/dashboard/edwards-fine-food-and-wine/events/new"],
  ["Profile", "/profile"],
  ["Favorites", "/profile/favorites"],
  ["Posts (user)", "/profile/posts"],
  ["Account settings", "/profile/settings"],
  ["External profile", "/u/beachlocal"],
  ["My questions", "/profile/questions"],
  ["Add another business", "/add-business"],
  ["Admin", "/admin"],
  ["Review queue", "/admin/review-queue"],
  ["SEO overrides", "/admin/seo"],
  ["Knowledge", "/admin/knowledge"],
  ["Entities", "/admin/entities"],
  ["Videos (admin)", "/admin/videos"],
  ["Login", "/auth/login"],
  ["Sign up", "/auth/signup"],
  ["Forgot password", "/auth/forgot-password"],
  ["About", "/about"],
  ["Connect", "/connect"],
  ["Legal", "/legal"],
  ["Merchants", "/merchants"],
];
---

<BaseLayout title="Route scaffold">
  <div class="container section">
    <h1>Route scaffold</h1>
    <p>No /businesses hub. /search is the finder. Town × category pages are the indexable leaves.</p>
    <ol>
      <li>There is no /businesses hub or /businesses/{"{category}"} leaf.</li>
      <li>/search is the business finder and stays noindex, follow.</li>
      <li>Town hubs are discovery surfaces. Business leaves live at /town/{"{town}"}/business/{"{category}"}; stays at /town/{"{town}"}/stay/{"{category}"}.</li>
      <li>/ask is the community route. Threads at /ask/{"{question}"}. Every question gets an instant AI answer, a later AI follow-up, a local-guide note, then community replies.</li>
      <li>Updates and events from a business or stay stay on that listing. Town/area updates stay on those pages. Never a public /updates rollup or homepage module.</li>
      <li>Visitor notes about a place are a community feed on town, business, and stay pages — not ratings or reviews. Ask the Locals sits last.</li>
      <li>Videos are admin-only YouTube links on town, business, and stay pages — never a public /videos rollup.</li>
      <li>Areas extend a town: shopping areas and neighborhoods.</li>
    </ol>
    <ul class="routes">
      {
        routes.map(([label, path]) => (
          <li>
            <a href={href(path)}>{label}</a>
            <span>{path}</span>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  ol {
    max-width: 64ch;
    color: var(--brand-ink-soft);
  }
  .routes {
    list-style: none;
    margin: var(--size-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--size-2);
  }
  .routes li {
    display: flex;
    justify-content: space-between;
    gap: var(--size-4);
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-2);
    padding: var(--size-3) var(--size-4);
  }
  .routes span {
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
  }
</style>
