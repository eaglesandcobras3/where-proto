---
import Layout from "../layouts/Layout.astro";
import { href } from "../lib/href";

const routes = [
  ["Homepage", "/"],
  ["Towns hub", "/towns"],
  ["Town", "/town/rosemary-beach"],
  ["Town + category leaf", "/town/rosemary-beach/restaurants"],
  ["Areas hub", "/areas"],
  ["Area", "/area/barrett-square"],
  ["Businesses hub", "/businesses"],
  ["Businesses leaf", "/businesses/restaurants"],
  ["Business", "/business/edwards-fine-food-and-wine"],
  ["Search", "/search?q=seaside"],
  ["Events", "/events"],
  ["Event", "/event/sounds-of-seaside"],
  ["Happenings", "/happenings"],
  ["Guides", "/guides"],
  ["Guide", "/guide/first-timers-guide"],
  ["Ask", "/ask"],
  ["Question", "/ask/parking-near-seaside"],
  ["Stories", "/stories"],
  ["Story", "/story/finding-30a"],
  ["Stays (ship-dark)", "/stays"],
  ["Dashboard", "/dashboard"],
  ["Profile", "/profile"],
  ["Add business", "/add-business"],
  ["About", "/about"],
  ["Legal", "/legal"],
  ["Advertise", "/advertise"],
];
---

<Layout title="Route scaffold">
  <h1>Route scaffold</h1>
  <p>Matches the 2026-10-07 handoff. Click through to confirm structure.</p>

  <h2>Rules</h2>
  <ol>
    <li>/businesses is a directory hub. Category groups only. No search box, no filters.</li>
    <li>/search is the only search page.</li>
    <li>Town pages own town-scoped category browsing via /town/{"{town}"}/{'{category}'}.</li>
    <li>
      Listings live on leaf pages only. /businesses, /towns, and /town/{"{town}"} never render
      business cards.
    </li>
    <li>Filtered or searched views are noindex, follow, canonical to the unfiltered URL.</li>
    <li>/ask is the community route. Threads at /ask/{"{question}"}.</li>
  </ol>

  <h2>Routes</h2>
  <ul>
    {
      routes.map(([label, path]) => (
        <li>
          <a href={href(path)}>{label}</a> — {path}
        </li>
      ))
    }
  </ul>
</Layout>
