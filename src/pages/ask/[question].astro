---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntityText from "../../components/EntityText.astro";
import AskReplyComposer from "../../components/islands/AskReplyComposer.svelte";
import {
  commentsFor,
  questions,
  reactionsFor,
  townBySlug,
  userBySlug,
} from "../../data/catalog";
import { relativeTime } from "../../lib/labels";
import type { Question } from "../../data/types";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(questions, "question");
}

interface Props {
  item: Question;
}

const { item: question } = Astro.props;
const author = userBySlug(question.authorUserSlug);
const town = question.townSlug ? townBySlug(question.townSlug) : undefined;
const replies = commentsFor("question", question.slug);
const questionUp = reactionsFor("question", question.slug).find((item) => item.label === "up")?.count ?? 0;
const accepted = replies[0];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "QAPage",
  mainEntity: {
    "@type": "Question",
    name: question.title,
    text: question.body,
    dateCreated: question.createdAt,
    author: { "@type": "Person", name: author?.name ?? "a visitor" },
    answerCount: replies.length,
    acceptedAnswer: accepted
      ? {
          "@type": "Answer",
          text: accepted.body,
          author: { "@type": "Person", name: userBySlug(accepted.authorUserSlug)?.name ?? "A local" },
        }
      : undefined,
    suggestedAnswer: replies.slice(1).map((item) => ({
      "@type": "Answer",
      text: item.body,
      author: { "@type": "Person", name: userBySlug(item.authorUserSlug)?.name ?? "A local" },
    })),
  },
};
---

<BaseLayout title={question.title} description={question.body} active="ask" jsonLd={jsonLd}>
  <div class="thread">
    <p class="back">
      <a href={href("/ask")}>← Back to Ask</a>
    </p>
    <article class="card">
      <div class="meta">
        <span class="avatar" aria-hidden="true">{author?.name.charAt(0) ?? "?"}</span>
        <span>{relativeTime(question.createdAt)}</span>
        {town && <span class="town">· {town.name}</span>}
      </div>
      <h1>{question.title}</h1>
      {
        question.body && (
          <p class="body">
            <EntityText text={question.body} />
          </p>
        )
      }
      <div class="actions">
        <button type="button">👍 Like{questionUp ? ` ${questionUp}` : ""}</button>
      </div>
    </article>

    <h2>{replies.length} {replies.length === 1 ? "reply" : "replies"}</h2>

    {
      replies.map((item) => {
        const replyAuthor = userBySlug(item.authorUserSlug);
        const up = reactionsFor("answer", item.slug).find((reaction) => reaction.label === "up")?.count ?? 0;
        return (
          <article class="card reply">
            <div class="meta">
              <span class="avatar" aria-hidden="true">{replyAuthor?.name.charAt(0) ?? "?"}</span>
              <span>{relativeTime(question.createdAt)}</span>
            </div>
            <p class="body">
              <EntityText text={item.body} />
            </p>
            <div class="actions">
              <button type="button">👍 Like{up ? ` ${up}` : ""}</button>
              <button type="button" class="reply-btn">Reply</button>
            </div>
          </article>
        );
      })
    }

    <AskReplyComposer
      signedIn={false}
      loginHref={href("/auth/login")}
      signupHref={href("/auth/signup")}
      client:visible
    />
  </div>
</BaseLayout>

<style>
  .thread {
    width: min(44rem, 100%);
    margin: 0 auto;
    padding: var(--size-6) var(--size-4) var(--size-10);
    display: grid;
    gap: var(--size-4);
  }
  .back {
    margin: 0;
  }
  .back a {
    color: var(--brand-deep);
    font-weight: var(--font-weight-6);
  }
  .card {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: 1rem;
    padding: var(--size-5);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: var(--size-2);
    margin-bottom: var(--size-3);
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--brand-deep);
    color: white;
    display: grid;
    place-items: center;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    flex-shrink: 0;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    line-height: 1.25;
    color: var(--brand-deep);
  }
  h2 {
    margin: var(--size-3) 0 0;
    font-size: var(--font-size-4);
    color: var(--brand-deep);
  }
  .body {
    margin: var(--size-3) 0 0;
    color: var(--brand-ink);
    font-size: var(--font-size-2);
  }
  .actions {
    display: flex;
    gap: var(--size-4);
    margin-top: var(--size-4);
    padding-top: var(--size-3);
    border-top: 1px solid var(--brand-line);
  }
  .actions button {
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
    cursor: pointer;
  }
  .reply-btn {
    color: var(--brand-deep) !important;
    font-weight: var(--font-weight-6);
  }
</style>

