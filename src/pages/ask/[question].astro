---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InteriorHero from "../../components/InteriorHero.astro";
import EntityText from "../../components/EntityText.astro";
import AskReplyComposer from "../../components/islands/AskReplyComposer.svelte";
import ReactionBar from "../../components/ReactionBar.astro";
import AskAnswerThread from "../../components/islands/AskAnswerThread.svelte";
import {
  answersForQuestion,
  questions,
  townBySlug,
  userBySlug,
} from "../../data/catalog";
import { threadForQuestion } from "../../lib/ask-thread";
import { countLabel, formatDate, userHandle } from "../../lib/labels";
import type { Question } from "../../data/types";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(questions, "question");
}

interface Props {
  item: Question;
}

const { item: question } = Astro.props;
const author = userBySlug(question.authorUserSlug);
const town = question.townSlug ? townBySlug(question.townSlug) : undefined;
const answers = threadForQuestion(question, answersForQuestion(question.slug));
const accepted = answers.find((item) => item.kind === "local_guide") ?? answers[0];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "QAPage",
  mainEntity: {
    "@type": "Question",
    name: question.title,
    text: question.body,
    dateCreated: question.createdAt,
    author: { "@type": "Person", name: author?.name ?? "a visitor" },
    answerCount: answers.length,
    acceptedAnswer: accepted
      ? {
          "@type": "Answer",
          text: accepted.body,
          author: { "@type": "Person", name: accepted.author },
        }
      : undefined,
    suggestedAnswer: answers
      .filter((item) => item !== accepted)
      .map((item) => ({
        "@type": "Answer",
        text: item.body,
        author: { "@type": "Person", name: item.author },
      })),
  },
};
---

<BaseLayout
  title={question.title}
  description={question.body}
  active="ask"
  jsonLd={jsonLd}
>
  <InteriorHero
    title={question.title}
    kicker="Ask the locals"
    lede={town ? `${town.name} · ${formatDate(question.createdAt)}` : formatDate(question.createdAt)}
    crumbs={[
      { label: "Ask", path: "/ask" },
      ...(town ? [{ label: town.name, path: `/town/${town.slug}` }] : []),
      { label: question.title },
    ]}
  />
  <div class="thread">
    <article class="card">
      <div class="meta">
        <span class="avatar" aria-hidden="true">{author?.slug.charAt(0) ?? "?"}</span>
        <span>
          {author ? (
            <a href={href(`/u/${author.slug}`)}>{userHandle(author.slug)}</a>
          ) : (
            "A visitor"
          )}
        </span>
        <span>· {formatDate(question.createdAt)}</span>
        {town && <span class="town">· {town.name}</span>}
      </div>
      {
        question.body && (
          <p class="body">
            <EntityText text={question.body} />
          </p>
        )
      }
      <div class="actions">
        <ReactionBar />
      </div>
    </article>

    <h2>{countLabel(answers.length, "answer")}</h2>
    <p class="thread-note">Every question gets an instant AI answer, an AI follow-up a few minutes later, a local-guide note, and any community replies.</p>
    <div class="card replies">
      <AskAnswerThread {answers} client:visible />
    </div>

    <AskReplyComposer client:visible />
  </div>
</BaseLayout>

<style>
  .thread {
    width: min(44rem, 100%);
    margin: 0 auto;
    padding: var(--size-6) var(--size-4) var(--size-10);
    display: grid;
    gap: var(--size-4);
  }
  .card {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: 1rem;
    padding: var(--size-5);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: var(--size-2);
    margin-bottom: var(--size-3);
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--brand-deep);
    color: white;
    display: grid;
    place-items: center;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    flex-shrink: 0;
  }
  h2 {
    margin: var(--size-3) 0 0;
    font-size: var(--font-size-4);
    color: var(--brand-deep);
  }
  .thread-note {
    margin: 0;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .replies {
    padding: var(--size-5);
  }
  .body {
    margin: var(--size-3) 0 0;
    color: var(--brand-ink);
    font-size: var(--font-size-2);
  }
  .actions {
    display: flex;
    gap: var(--size-4);
    margin-top: var(--size-4);
    padding-top: var(--size-3);
    border-top: 1px solid var(--brand-line);
  }
  .actions button {
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
    cursor: pointer;
  }
  .reply-btn {
    color: var(--brand-deep);
    font-weight: var(--font-weight-6);
    font-size: var(--font-size-1);
    align-self: center;
  }
</style>

