---
import Layout from "../../layouts/Layout.astro";
import Box from "../../components/Box.astro";
import {
  commentsFor,
  questions,
  reactionsFor,
  townBySlug,
  userBySlug,
} from "../../data/catalog";
import type { Question } from "../../data/types";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(questions, "question");
}

interface Props {
  item: Question;
}

const { item: question } = Astro.props;
const author = userBySlug(question.authorUserSlug);
const town = question.townSlug ? townBySlug(question.townSlug) : undefined;
const replies = commentsFor("question", question.slug);
const questionReactions = reactionsFor("question", question.slug);
---

<Layout title={question.title}>
  <p><a href={href("/ask")}>Ask</a></p>
  <h1>Question: {question.title}</h1>

  <Box label="Question">
    <p>{question.body}</p>
    <ul>
      {author && (
        <li>
          Asked by: <a href={href(`/u/${author.slug}`)}>{author.name}</a>
        </li>
      )}
      {
        town && (
          <li>
            Town: <a href={href(`/town/${town.slug}`)}>{town.name}</a>
          </li>
        )
      }
    </ul>
  </Box>

  <Box label="Reactions">
    {
      questionReactions.length === 0 ? (
        <p>No fake reactions.</p>
      ) : (
        <ul>
          {questionReactions.map((item) => (
            <li>
              {item.label}: {item.count}
            </li>
          ))}
        </ul>
      )
    }
  </Box>

  <Box label="Comments">
    <ul>
      {
        replies.map((item) => (
          <li>
            {item.body} — <a href={href(`/u/${item.authorUserSlug}`)}>{userBySlug(item.authorUserSlug)?.name}</a>
          </li>
        ))
      }
    </ul>
  </Box>

  <Box label="Reply">
    <form>
      <label>
        Comment
        <textarea name="body"></textarea>
      </label>
      <button type="button">Add comment</button>
    </form>
  </Box>
</Layout>
