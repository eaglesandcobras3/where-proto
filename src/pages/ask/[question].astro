---
import PlaceLayout from "../../layouts/PlaceLayout.astro";
import { commentsFor, questions, reactionsFor, townBySlug, userBySlug } from "../../data/catalog";
import type { Question } from "../../data/types";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(questions, "question");
}

interface Props {
  item: Question;
}

const { item: question } = Astro.props;
const author = userBySlug(question.authorUserSlug);
const town = question.townSlug ? townBySlug(question.townSlug) : undefined;
const replies = commentsFor("question", question.slug);
const questionReactions = reactionsFor("question", question.slug);
---

<PlaceLayout
  title={question.title}
  description={question.body}
  active="ask"
  showBrowse={false}
  crumbs={[{ label: "Ask", path: "/ask" }, { label: question.title }]}
>
  <article class="container section article">
    <h1>{question.title}</h1>
    <p class="lede">{question.body}</p>
    <p class="meta">
      Asked by {author ? <a href={href(`/u/${author.slug}`)}>{author.name}</a> : "a visitor"}
      {town && (
        <>
          {" in "}
          <a href={href(`/town/${town.slug}`)}>{town.name}</a>
        </>
      )}
    </p>
    {
      questionReactions.length > 0 && (
        <p class="meta">{questionReactions.map((item) => `${item.label} ${item.count}`).join(" · ")}</p>
      )
    }
    <section>
      <h2 class="section-title">Answers</h2>
      {
        replies.map((item) => (
          <article class="answer">
            <p>{item.body}</p>
            <p class="meta">
              <a href={href(`/u/${item.authorUserSlug}`)}>{userBySlug(item.authorUserSlug)?.name ?? "A local"}</a>
            </p>
          </article>
        ))
      }
    </section>
    <form class="form" onsubmit="return false;">
      <wa-textarea label="Your answer" rows="3"></wa-textarea>
      <wa-button variant="brand">Add comment</wa-button>
    </form>
  </article>
</PlaceLayout>

<style>
  .article {
    max-width: 720px;
  }
  .lede {
    font-size: var(--font-size-3);
    color: var(--brand-ink-soft);
  }
  .meta {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .answer {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-card);
    padding: var(--size-4);
    margin-bottom: var(--size-3);
  }
  .form {
    display: grid;
    gap: var(--size-3);
    margin-top: var(--size-6);
  }
</style>
