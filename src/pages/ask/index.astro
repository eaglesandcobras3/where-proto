---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InteriorHero from "../../components/InteriorHero.astro";
import TwoPaneMap from "../../components/TwoPaneMap.astro";
import AskComposer from "../../components/islands/AskComposer.svelte";
import AskIndex from "../../components/islands/AskIndex.svelte";
import ListingFilters from "../../components/islands/ListingFilters.svelte";
import ListingRail from "../../components/ListingRail.astro";
import TopContributors from "../../components/TopContributors.astro";
import { townCountsFor } from "../../lib/unified-layout";
import { commentsFor, questions, towns, townBySlug, userBySlug } from "../../data/catalog";
import { formatDate, roleLabel, userHandle } from "../../lib/labels";
import { href } from "../../lib/href";
import { markersFromNames, withoutViewMap, withViewMap } from "../../lib/map-markers";

const params = Astro.url.searchParams;
const town = params.get("town") ?? "";
const topic = params.get("topic") ?? "";
const q = params.get("q") ?? "";
const mapView = params.get("view") === "map";
const base = import.meta.env.BASE_URL;
const searchQs = Astro.url.search;
const mapHref = withViewMap("/ask", searchQs);
const gridHref = withoutViewMap("/ask", searchQs);

const topicOptions = [
  { slug: "beach-access", name: "Beach Access" },
  { slug: "getting-around", name: "Golf Carts & Biking" },
  { slug: "dining", name: "Dining & Food" },
  { slug: "parking", name: "Parking Tips" },
  { slug: "family", name: "Family" },
];

const rows = questions.map((question) => {
  const author = userBySlug(question.authorUserSlug);
  const townRow = question.townSlug ? townBySlug(question.townSlug) : undefined;
  return {
    slug: question.slug,
    title: question.title,
    body: question.body,
    author: author ? userHandle(author.slug) : "a visitor",
    handle: author ? userHandle(author.slug) : "",
    role: author ? roleLabel(author.role) : "Visitor",
    createdAt: question.createdAt,
    relative: formatDate(question.createdAt),
    answers: commentsFor("question", question.slug).length,
    town: townRow?.name,
    townSlug: question.townSlug,
  };
});

const townCounts = towns
  .map((item) => ({
    slug: item.slug,
    name: item.name,
    count: questions.filter((question) => question.townSlug === item.slug).length,
  }))
  .filter((item) => item.count > 0);
const allTownCounts = townCountsFor(towns, questions, (question) => question.townSlug);
const topicWords: Record<string, string[]> = {
  parking: ["parking", "park", "access"],
  dining: ["eat", "dinner", "food", "restaurant", "dining"],
  family: ["kids", "family", "children"],
  "getting-around": ["bike", "cart", "trail", "golf"],
  "beach-access": ["beach", "access", "parking"],
};
const topicCounts = topicOptions.map((item) => ({
  ...item,
  count: rows.filter((question) => {
    const words = topicWords[item.slug] ?? [item.slug];
    const hay = `${question.title} ${question.body ?? ""}`.toLowerCase();
    return words.some((word) => hay.includes(word));
  }).length,
}));

const exploreTowns = towns.map(({ slug, name }) => ({ slug, name }));
const mapMarkers = markersFromNames(
  rows.map((item) => ({
    name: item.title,
    href: href(`/ask/${item.slug}`),
    detail: `${item.town ?? "30A"} · ${item.answers === 1 ? "1 answer" : `${item.answers} answers`}`,
  })),
);
---

<BaseLayout
  title="Ask locals about 30A"
  description="Local Q and A about visiting or living on 30A."
  active="ask"
  crumbs={[{ label: "Ask" }]}
>
  <div class="ask-page">
    <InteriorHero
      title="Ask the Locals"
      lede="Straight answers on golf carts, walkovers, parking, and dining from residents across Scenic Highway 30A."
    />

    {
      mapView ? (
        <TwoPaneMap
          mapLabel="30A ask map"
          resultLabel={`${questions.length} Questions along Scenic 30A`}
          gridHref={href(gridHref)}
          markers={mapMarkers}
          searchArea
        >
          <AskIndex
            questions={rows}
            initialTown={town}
            initialTopic={topic}
            initialQuery={q}
            base={base}
            client:load
          />
        </TwoPaneMap>
      ) : (
        <div class="container layout">
          <div class="filters-col">
            <ListingFilters
              surface="ask"
              eventName="w30a:ask-filters"
              initialQuery={q}
              towns={allTownCounts}
              initialTown={town}
              townTotal={questions.length}
              primaryLabel="Topic"
              primaryKey="topic"
              primaryOptions={topicCounts}
              initialPrimary={topic}
              note={{
                label: "Leave no trace",
                body: "Pack out what you pack in, stay on marked paths, and respect dune fencing along 30A.",
              }}
              client:load
            />
          </div>

          <div class="main">
            <AskComposer towns={exploreTowns} topics={topicOptions} client:visible />
            <AskIndex
              questions={rows}
              initialTown={town}
              initialTopic={topic}
              initialQuery={q}
              base={base}
              client:load
            />
          </div>

          <aside class="rail">
            <div>
              <ListingRail mapTitle="Questions map" mapHref={mapHref} contributeKind="ask" current="ask">
                <TopContributors
                  slot="discovery"
                  people={[
                    { initials: "B", name: "beachlocal", detail: "Seaside" },
                    { initials: "L", name: "local_owner", detail: "Rosemary" },
                    { initials: "F", name: "first_timer", detail: "WaterColor" },
                  ]}
                  topics={[{ label: "#SeasideParking" }, { label: "#GolfCartRules" }, { label: "#QuietBeaches" }]}
                />
              </ListingRail>
            </div>
          </aside>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .ask-page {
    --ask-navy: var(--brand-deep);
    --ask-teal: var(--brand-teal);
    --ask-teal-soft: var(--brand-teal-soft);
    --ask-line: var(--brand-line);
    background: var(--brand-sand);
    color: var(--brand-ink);
  }
  .layout {
    display: grid;
    gap: var(--size-5);
    padding-block: var(--size-6) var(--size-10);
    align-items: start;
  }
  .main {
    display: grid;
    gap: var(--size-4);
    min-width: 0;
  }
  .rail {
    display: none;
    gap: var(--size-4);
  }
  .widget {
    background: white;
    border: 1px solid var(--ask-line);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: var(--size-4);
  }
  .widget__label {
    margin: 0 0 var(--size-3);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .guides strong {
    color: var(--ask-teal);
  }
  .guides,
  .trending,
  .code {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .guides li {
    display: flex;
    gap: 0.65rem;
    align-items: center;
  }
  .guides__avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--ask-teal-soft);
    color: var(--ask-navy);
    display: grid;
    place-items: center;
    font-weight: var(--font-weight-7);
  }
  .guides div {
    display: grid;
    gap: 0.1rem;
  }
  .guides span,
  .trending,
  .code {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .guides strong {
    font-size: var(--font-size-1);
  }
  .trending li,
  .code li {
    color: var(--brand-ink);
  }
  .code {
    list-style: disc;
    padding-left: 1.1rem;
  }
  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: 15.5rem minmax(0, 1fr) 16.5rem;
    }
    .rail {
      display: grid;
    }
  }
</style>
