---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import QuestionCard from "../../components/QuestionCard.astro";
import AskComposer from "../../components/islands/AskComposer.svelte";
import { isEnabled } from "../../config/flags";
import { questions, towns } from "../../data/catalog";
---

<BaseLayout title="Ask locals about 30A" description="Local Q and A about visiting or living on 30A." active="ask">
  <div class="container section">
    <PageHeader
      eyebrow="Ask"
      title="Ask locals"
      lede="Real questions from visitors, answered by locals. Short and honest."
    />
    <div class="list">
      {questions.map((question) => <QuestionCard question={question} />)}
    </div>
    {
      isEnabled("ask") && (
        <section class="composer">
          <h2 class="section-title">Ask a question</h2>
          <AskComposer towns={towns} client:visible />
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .list {
    display: grid;
    gap: var(--size-3);
    max-width: 720px;
  }
  .composer {
    margin-top: var(--size-8);
    max-width: 640px;
  }
</style>
