---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import AskComposer from "../../components/islands/AskComposer.svelte";
import AskIndex from "../../components/islands/AskIndex.svelte";
import { commentsFor, questions, townBySlug, towns, userBySlug } from "../../data/catalog";
import { relativeTime } from "../../lib/labels";
import { href } from "../../lib/href";

const base = import.meta.env.BASE_URL;
const rows = questions.map((question) => {
  const author = userBySlug(question.authorUserSlug);
  const town = question.townSlug ? townBySlug(question.townSlug) : undefined;
  return {
    slug: question.slug,
    title: question.title,
    author: author?.name ?? "a visitor",
    createdAt: question.createdAt,
    relative: relativeTime(question.createdAt),
    answers: commentsFor("question", question.slug).length,
    town: town?.name,
  };
});
---

<BaseLayout title="Ask locals about 30A" description="Local Q and A about visiting or living on 30A." active="ask">
  <div class="container section">
    <PageHeader
      eyebrow="Ask"
      title="Ask locals"
      lede="Real questions from visitors, answered by locals. Newest first, or sort by most answered."
    />
    <section class="composer">
      <h2 class="section-title">Ask a question</h2>
      <AskComposer
        towns={towns}
        signedIn={true}
        loginHref={href("/auth/login")}
        signupHref={href("/auth/signup")}
        client:visible
      />
    </section>
    <AskIndex questions={rows} base={base} client:load />
  </div>
</BaseLayout>

<style>
  .composer {
    margin-bottom: var(--size-8);
    max-width: 640px;
  }
</style>
