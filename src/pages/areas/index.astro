---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import AreaCard from "../../components/AreaCard.astro";
import { areasForTown, towns } from "../../data/catalog";
import { href } from "../../lib/href";
---

<BaseLayout title="Areas on 30A" description="Shopping areas and neighborhoods that sit inside a town." active="areas">
  <div class="container section">
    <PageHeader
      eyebrow="Areas"
      title="Shopping areas and neighborhoods"
      lede="An area belongs to one town. A town can have many of each. Areas extend a town. They are not a second directory."
    />
    {
      towns.map((town) => {
        const townAreas = areasForTown(town.slug);
        return (
          <section class="town-block">
            <h2>
              <a href={href(`/town/${town.slug}`)}>{town.name}</a>
            </h2>
            <div class="listing-grid-full">
              {townAreas.map((area) => (
                <AreaCard area={area} />
              ))}
            </div>
          </section>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .town-block {
    margin-bottom: var(--size-8);
  }
  .town-block h2 {
    font-size: var(--font-size-4);
  }
</style>
