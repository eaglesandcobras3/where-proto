---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InteriorHero from "../../components/InteriorHero.astro";
import AreaCard from "../../components/AreaCard.astro";
import { areasForTown, towns } from "../../data/catalog";
import { href } from "../../lib/href";
---

<BaseLayout
  title="Areas on 30A"
  description="Shopping areas and neighborhoods that extend a parent town along Scenic Highway 30A."
  active="towns"
>
  <div class="areas-page">
    <InteriorHero
      title="Shopping areas & neighborhoods"
      lede="Every area belongs to one town. Events, bulletins, and the live feed come from that town — areas are not a second community directory."
    />

    <div class="container section">
      {
        towns.map((town) => {
          const townAreas = areasForTown(town.slug);
          if (!townAreas.length) return null;
          return (
            <section class="town-block">
              <div class="town-block__head">
                <h2>
                  <a href={href(`/town/${town.slug}`)}>{town.name}</a>
                </h2>
                <a href={href(`/town/${town.slug}`)}>Town page · events &amp; updates</a>
              </div>
              <div class="listing-grid-full">
                {townAreas.map((area) => (
                  <AreaCard area={area} />
                ))}
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</BaseLayout>

<style>
  .areas-page {
    background: var(--brand-sand);
  }
  .town-block {
    margin-bottom: var(--size-8);
  }
  .town-block__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
    margin-bottom: var(--size-4);
  }
  .town-block h2 {
    margin: 0;
    font-size: var(--font-size-4);
  }
  .town-block h2 a {
    color: var(--brand-deep);
  }
  .town-block__head > a {
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    color: var(--brand-teal);
  }
</style>
