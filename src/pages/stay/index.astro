---
import Layout from "../../layouts/Layout.astro";
import LinkList from "../../components/LinkList.astro";
import { stays, townBySlug } from "../../data/catalog";
import { href } from "../../lib/href";
---

<Layout title="Stay">
  <h1>Stay</h1>
  <p>Lodging page type. Separate from the businesses directory, using fake rentals and hotels.</p>
  <LinkList
    items={stays.map((item) => ({
      href: href(`/stay/${item.slug}`),
      label: item.name,
      meta: `${townBySlug(item.townSlug)?.name ?? item.townSlug} · sleeps ${item.sleeps}`,
    }))}
  />
</Layout>
