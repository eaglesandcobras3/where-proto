---
import PlaceLayout from "../../layouts/PlaceLayout.astro";
import { stays, townBySlug } from "../../data/catalog";
import type { Stay } from "../../data/types";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(stays, "stay");
}

interface Props {
  item: Stay;
}

const { item: stay } = Astro.props;
const town = townBySlug(stay.townSlug);
---

<PlaceLayout
  title={stay.name}
  description={stay.summary}
  active="stays"
  browseTown={town?.name}
  browseCategory="Stay"
  crumbs={[{ label: "Stays", path: "/stays" }, { label: stay.name }]}
>
  <div class="container section">
    <div class="hero">
      <div class="hero-img img-placeholder" aria-hidden="true">{stay.name.charAt(0)}</div>
      <div>
        <h1>{stay.name}</h1>
        <p class="lede">{stay.summary}</p>
        <p>Sleeps {stay.sleeps}</p>
        {
          town && (
            <p>
              <a href={href(`/town/${town.slug}`)}>{town.name}</a>
              {" · "}
              <a href={href(`/town/${town.slug}/vacation-rentals`)}>Vacation rentals</a>
              {" · "}
              <a href={href(`/town/${town.slug}/hotels`)}>Hotels</a>
            </p>
          )
        }
        {
          stay.businessSlug && (
            <p>
              Listing: <a href={href(`/business/${stay.businessSlug}`)}>{stay.name}</a>
            </p>
          )
        }
      </div>
    </div>
  </div>
</PlaceLayout>

<style>
  .hero {
    display: flex;
    gap: var(--size-6);
  }
  .hero-img {
    width: 220px;
    height: 180px;
    border-radius: var(--radius-card);
    flex-shrink: 0;
  }
  .lede {
    color: var(--brand-ink-soft);
  }
  @media (max-width: 640px) {
    .hero {
      flex-direction: column;
    }
  }
</style>
