---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InteriorHero from "../../components/InteriorHero.astro";
import EntityGallery from "../../components/EntityGallery.astro";
import CommunityQA from "../../components/CommunityQA.astro";
import RelatedGuides from "../../components/RelatedGuides.astro";
import HappeningHere from "../../components/HappeningHere.astro";
import ExploreLinks from "../../components/ExploreLinks.astro";
import StayCard from "../../components/StayCard.astro";
import UpdatesModule from "../../components/UpdatesModule.astro";
import PostedUpdates from "../../components/islands/PostedUpdates.svelte";
import {
  businessBySlug,
  events,
  faqsForStay,
  guides,
  photosFor,
  stays,
  townBySlug,
  updateSharePath,
  updatesForBusiness,
} from "../../data/catalog";
import type { Stay } from "../../data/types";
import SaveShare from "../../components/islands/SaveShare.svelte";
import { href } from "../../lib/href";
import { businessPathBySlug } from "../../lib/listing";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(stays, "stay");
}

interface Props {
  item: Stay;
}

const { item: stay } = Astro.props;
const town = townBySlug(stay.townSlug);
const listing = stay.businessSlug ? businessBySlug(stay.businessSlug) : undefined;
const related = stays.filter((item) => item.slug !== stay.slug).slice(0, 3);
const listingEvents = listing ? events.filter((item) => item.businessSlug === listing.slug) : [];
const nearbyEvents =
  listingEvents.length > 0
    ? listingEvents
    : events.filter((item) => item.townSlug === stay.townSlug).slice(0, 3);
const isInn = /hotel|inn/i.test(stay.name);
const stayPhotos = photosFor("business", stay.businessSlug ?? stay.slug);
const relatedGuides = guides
  .filter((item) => item.townSlug === stay.townSlug)
  .concat(guides)
  .filter((item, index, list) => list.findIndex((row) => row.slug === item.slug) === index)
  .slice(0, 3);
const faq = faqsForStay(stay);
const claimed = Boolean(listing?.ownerUserSlug);
const stayUpdates = listing ? updatesForBusiness(listing.slug) : [];
---

<BaseLayout
  title={stay.name}
  description={stay.summary}
  active="stays"
>
  <div class="stay-page">
    <InteriorHero
      title={stay.name}
      kicker={isInn ? "Boutique inn" : "Coastal stay"}
      lede={stay.summary}
      crumbs={[
        { label: "Stays", path: "/stays" },
        ...(town ? [{ label: town.name, path: `/town/${town.slug}` }] : []),
        { label: stay.name },
      ]}
    >
      <div slot="actions">
        <SaveShare type="stay" slug={stay.slug} name={stay.name} href={href(`/stay/${stay.slug}`)} client:load />
        {
          listing?.phone && (
            <a class="hero-btn hero-btn--ghost" href={`tel:${listing.phone.replace(/[^\d+]/g, "")}`}>
              Call {listing.phone}
            </a>
          )
        }
        {
          stay.businessSlug ? (
            <a class="hero-btn" href={href(businessPathBySlug(stay.businessSlug))}>
              Visit official booking site
            </a>
          ) : (
            <a class="hero-btn" href={href("/ask")}>
              Ask about availability
            </a>
          )
        }
      </div>
      <div class="snapshot">
        <div>
          <span class="label">Town</span>
          <strong>{town?.name ?? "30A"}</strong>
        </div>
        <div>
          <span class="label">Sleeps</span>
          <strong>{stay.sleeps}</strong>
        </div>
        <div>
          <span class="label">Type</span>
          <strong>{isInn ? "Boutique inn" : "Coastal stay"}</strong>
        </div>
      </div>
    </InteriorHero>

    <div class="container layout">
      

      <div class="main">
        <section class="panel">
          <p class="eyebrow">About</p>
          <h2>{isInn ? "Boutique grandeur on the dunes" : "A coastal home base"}</h2>
          <p>{stay.summary}</p>
        </section>
        <EntityGallery photos={stayPhotos} fallbackName={stay.name} />
        <section class="panel">
          <h2>Amenities</h2>
          <div class="perks">
            <div><strong>Beach setups</strong><span>Chairs &amp; umbrellas guidance</span></div>
            <div><strong>Bikes / carts</strong><span>Ask host about LSV rules</span></div>
            <div><strong>Town access</strong><span>Walkable to dining &amp; shops</span></div>
            <div><strong>Sleeps {stay.sleeps}</strong><span>{town?.name ?? "30A"}</span></div>
          </div>
        </section>
        <section class="panel">
          <h2>Hours &amp; location</h2>
          <p>{listing?.address ?? (town ? `${town.name}, FL` : "Scenic 30A")}</p>
          <p class="muted">{listing?.hours ?? "Hours vary"}</p>
        </section>
        {
          listing && (
            <UpdatesModule
              entityKind="stay"
              entityName={stay.name}
              updates={stayUpdates}
              ctaHref={updateSharePath("business", listing.slug)}
            />
          )
        }
        {listing && <PostedUpdates businessSlug={listing.slug} client:load />}
        <HappeningHere events={nearbyEvents} placeName={stay.name} townSlug={stay.townSlug} />
        <CommunityQA
          question={faq[0]?.q ?? `What should first-timers know before staying at ${stay.name}?`}
          answer={faq[0]?.a ?? "Ask your host about carts, beach access, and check-in before you lock the day."}
        />
        <section class="panel faq">
          <h2>Good to know</h2>
          {faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </section>
        <RelatedGuides guides={relatedGuides} />
        <section class="panel">
          <h2>Similar nearby</h2>
          <div class="listing-grid">
            {related.map((item) => (
              <StayCard stay={item} />
            ))}
          </div>
        </section>
      </div>

      <aside class="rail">
        
        <div>
          <section class="widget">
            <p class="widget__label">Location</p>
            <div class="mini-map img-placeholder" aria-hidden="true">{town?.name ?? "30A"}</div>
            <p class="addr">{listing?.address ?? (town ? `${town.name}, FL` : "Scenic 30A")}</p>
          </section>
          <section class="widget book">
            <p class="widget__label">Book this stay</p>
            <p class="book__meta">{town?.name ?? "30A"} · Sleeps {stay.sleeps}</p>
            {
              stay.businessSlug ? (
                <a class="book__btn" href={href(businessPathBySlug(stay.businessSlug))}>Book this stay</a>
              ) : (
                <a class="book__btn" href={href("/ask")}>Ask about this stay</a>
              )
            }
          </section>
          {
            town && (
              <section class="widget">
                <p class="widget__label">Get directions</p>
                <a class="btn btn--deep" href={href(`/town/${town.slug}`)}>
                  Get directions
                </a>
              </section>
            )
          }
          {
            listing && !claimed && (
              <section class="widget claim">
                <p class="widget__label">Property owner or GM?</p>
                <p>Claim this stay to post updates, events, and verified hours.</p>
                <a class="btn btn--teal" href={href("/dashboard")}>Claim this listing</a>
              </section>
            )
          }
          <ExploreLinks current="stays" townSlug={stay.townSlug} />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .stay-page {
    background: var(--brand-sand);
    color: var(--brand-ink);
  }
  .gallery {
    display: grid;
    gap: 0.65rem;
  }
  .gallery__main {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-3);
  }
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem;
  }
  .gallery__grid > * {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-2);
  }
  .layout {
    display: grid;
    gap: var(--size-5);
    padding-block: var(--size-6) var(--size-10);
    align-items: start;
  }
  .main {
    display: grid;
    gap: var(--size-4);
    min-width: 0;
  }
  .quick {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .quick > div,
  .panel,
  .widget {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-card);
    padding: var(--size-4);
  }
  .quick .label {
    margin: 0 0 0.2rem;
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .quick p:last-child {
    margin: 0;
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .cert {
    background: var(--brand-teal-soft);
    border-color: var(--mint);
  }
  .cert__label {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-weight: var(--font-weight-8);
    color: var(--brand-deep);
  }
  .cert p:last-child,
  .panel p {
    margin: 0;
    color: var(--brand-ink-soft);
    line-height: 1.6;
  }
  .panel h2 {
    margin: 0 0 var(--size-3);
    font-family: var(--font-display);
    font-size: var(--font-size-4);
    color: var(--brand-deep);
  }
  .panel p + p {
    margin-top: var(--size-3);
  }
  .eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: var(--font-size-0);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .muted {
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
  }
  .faq details {
    border-top: 1px solid var(--brand-line);
    padding: var(--size-3) 0;
  }
  .faq details:first-of-type {
    border-top: 0;
  }
  .faq summary {
    cursor: pointer;
    font-weight: var(--font-weight-6);
  }
  .faq p {
    margin: 0.5rem 0 0;
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
  }
  .addr {
    margin: 0;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-6);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-2);
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
  }
  .btn:hover {
    text-decoration: none;
  }
  .btn--teal {
    background: var(--brand-teal);
    color: white;
  }
  .btn--teal:hover {
    background: var(--brand-teal-hover);
  }
  .btn--deep {
    width: 100%;
    background: var(--brand-deep);
    color: white;
    margin-top: var(--size-3);
  }
  .claim {
    background: var(--brand-deep);
    border-color: var(--brand-deep);
    color: white;
  }
  .claim .widget__label {
    color: var(--brand-ink-on-navy);
  }
  .claim p {
    margin: 0 0 var(--size-3);
    font-size: var(--font-size-1);
    color: var(--brand-line);
  }
  .panel__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
    margin-bottom: var(--size-3);
  }
  .panel__head h2 {
    margin: 0;
  }
  .panel__head a {
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    color: var(--brand-teal);
  }
  .perks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .perks div {
    display: grid;
    gap: 0.15rem;
    padding: 0.85rem;
    border-radius: var(--radius-2);
    background: var(--brand-sand);
    border: 1px solid var(--brand-line);
  }
  .perks strong {
    font-size: var(--font-size-1);
    color: var(--brand-deep);
  }
  .perks span {
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  .alert {
    padding: var(--size-4);
    border-radius: var(--radius-2);
    background: var(--brand-teal-soft);
    border: 1px solid var(--brand-line);
    border-left: 4px solid var(--brand-sun);
  }
  .alert__label {
    margin: 0 0 0.35rem;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-8);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-coral);
  }
  .alert p:last-child {
    margin: 0;
    font-size: var(--font-size-1);
    color: var(--brand-coral);
  }
  .mini-map {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-2);
    margin-bottom: var(--size-3);
    display: grid;
    place-items: center;
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .walks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .walks span {
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--brand-sand-dark);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-6);
  }
  .events,
  .related {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .events a,
  .related a {
    display: grid;
    gap: 0.15rem;
    color: var(--brand-ink);
  }
  .events a:hover,
  .related a:hover {
    text-decoration: none;
  }
  .events span,
  .related span {
    font-size: 0.625rem;
    font-weight: var(--font-weight-7);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-teal);
  }
  .events strong,
  .related strong {
    color: var(--brand-deep);
  }
  .qa {
    padding: var(--size-4);
    border-radius: var(--radius-2);
    background: var(--brand-sand);
    border: 1px solid var(--brand-line);
  }
  .qa__q {
    margin: 0 0 0.5rem;
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .qa__a {
    margin: 0;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .rail {
    display: grid;
    gap: var(--size-4);
  }
  .widget__label {
    margin: 0 0 var(--size-3);
    font-family: var(--font-display);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .book__meta {
    margin: 0 0 var(--size-3);
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .book__btn,
  .ghost {
    display: inline-flex;
    width: 100%;
    justify-content: center;
    align-items: center;
    min-height: 2.5rem;
    margin-bottom: 0.5rem;
    text-decoration: none;
  }
  .book__btn {
    border-radius: var(--radius-2);
    background: var(--brand-teal);
    color: white;
    font-weight: var(--font-weight-7);
  }
  .book__btn:hover {
    background: var(--brand-teal-hover);
    text-decoration: none;
  }
  @media (min-width: 800px) {
    .gallery {
      grid-template-columns: 1.4fr 1fr;
    }
    .gallery__main {
      min-height: 100%;
    }
    .gallery__grid {
      grid-template-columns: 1fr 1fr;
    }
    .quick {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .perks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
    .rail {
      position: sticky;
      top: calc(var(--header-h) + 1rem);
    }
  }
  @media (max-width: 640px) {
    .gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
