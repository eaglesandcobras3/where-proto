---
import { stays } from "../../data/catalog";
import { href } from "../../lib/href";
import { stayPath } from "../../lib/listing";
import { slugPaths } from "../../lib/static-paths";
import type { Stay } from "../../data/types";

export function getStaticPaths() {
  return slugPaths(stays, "stay");
}

interface Props {
  item: Stay;
}

const { item: stay } = Astro.props;
return Astro.redirect(href(stayPath(stay)), 301);
---
