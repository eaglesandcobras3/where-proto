---
import Layout from "../../layouts/Layout.astro";
import { stays, townBySlug } from "../../data/catalog";
import type { Stay } from "../../data/types";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(stays);
}

interface Props {
  item: Stay;
}

const { item: stay } = Astro.props;

const town = townBySlug(stay.townSlug);
---

<Layout title={stay.name}>
  <p><a href={href("/stay")}>Stay</a></p>
  <h1>Stay page: {stay.name}</h1>
  <p>{stay.summary}</p>
  <ul>
    <li>Sleeps: {stay.sleeps}</li>
    {
      town && (
        <li>
          Town: <a href={href(`/towns/${town.slug}`)}>{town.name}</a>
        </li>
      )
    }
    {
      stay.businessSlug && (
        <li>
          Business page: <a href={href(`/business/${stay.businessSlug}`)}>{stay.name}</a>
        </li>
      )
    }
  </ul>
</Layout>
