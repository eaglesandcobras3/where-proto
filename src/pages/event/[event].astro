---
import Layout from "../../layouts/Layout.astro";
import Box from "../../components/Box.astro";
import Placeholder from "../../components/Placeholder.astro";
import { businessBySlug, events, photosFor, townBySlug } from "../../data/catalog";
import type { EventItem } from "../../data/types";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(events, "event");
}

interface Props {
  item: EventItem;
}

const { item: event } = Astro.props;
const town = event.townSlug ? townBySlug(event.townSlug) : undefined;
const business = event.businessSlug ? businessBySlug(event.businessSlug) : undefined;
const eventPhotos = photosFor("event", event.slug);
---

<Layout title={event.name}>
  <p><a href={href("/events")}>Events</a></p>
  <h1>Event: {event.name}</h1>
  <p>{event.summary}</p>

  <Box label="Facts">
    <ul>
      <li>When: {event.when}</li>
      {event.venue && <li>Venue: {event.venue}</li>}
      {
        town && (
          <li>
            Town: <a href={href(`/town/${town.slug}`)}>{town.name}</a>
          </li>
        )
      }
      {
        business && (
          <li>
            Business: <a href={href(`/business/${business.slug}`)}>{business.name}</a>
          </li>
        )
      }
    </ul>
  </Box>

  <Box label="Photos">
    {
      eventPhotos.length === 0 ? (
        <Placeholder caption="No event photos yet" />
      ) : (
        <div class="row">
          {eventPhotos.map((photo) => (
            <Placeholder caption={photo.caption} />
          ))}
        </div>
      )
    }
  </Box>

  <Box label="Map">
    <Placeholder kind="map" caption={event.venue ?? event.name} />
  </Box>
</Layout>
