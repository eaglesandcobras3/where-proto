---
import PlaceLayout from "../../layouts/PlaceLayout.astro";
import PhotoGrid from "../../components/PhotoGrid.astro";
import EventCard from "../../components/EventCard.astro";
import { businessBySlug, events, photosFor, townBySlug } from "../../data/catalog";
import type { EventItem } from "../../data/types";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(events, "event");
}

interface Props {
  item: EventItem;
}

const { item: event } = Astro.props;
const town = event.townSlug ? townBySlug(event.townSlug) : undefined;
const business = event.businessSlug ? businessBySlug(event.businessSlug) : undefined;
const photos = photosFor("event", event.slug);
const related = events.filter((item) => item.slug !== event.slug && item.townSlug === event.townSlug).slice(0, 3);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: event.name,
  description: event.summary,
  startDate: event.when,
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  location: {
    "@type": "Place",
    name: event.venue ?? town?.name ?? "30A",
    address: town?.name ? `${town.name}, FL` : "30A, FL",
  },
  offers: event.price
    ? {
        "@type": "Offer",
        price: event.price.replace(/[^0-9.]/g, "") || "0",
        priceCurrency: "USD",
        url: event.ticketUrl,
      }
    : undefined,
};
---

<PlaceLayout
  title={event.name}
  description={event.summary}
  active="events"
  showBrowse={false}
  crumbs={[{ label: "Events", path: "/events" }, { label: event.name }]}
  jsonLd={jsonLd}
>
  <div class="container section">
    <p class="date">{event.when}</p>
    <h1>{event.name}</h1>
    <p class="lede">{event.summary}</p>
    <dl class="facts">
      {event.time && (
        <div>
          <dt>Time</dt>
          <dd>{event.time}</dd>
        </div>
      )}
      {event.venue && (
        <div>
          <dt>Venue</dt>
          <dd>{event.venue}</dd>
        </div>
      )}
      {town && (
        <div>
          <dt>Town</dt>
          <dd>
            <a href={href(`/town/${town.slug}`)}>{town.name}</a>
          </dd>
        </div>
      )}
      {business && (
        <div>
          <dt>Venue listing</dt>
          <dd>
            <a href={href(`/business/${business.slug}`)}>{business.name}</a>
          </dd>
        </div>
      )}
      {event.category && (
        <div>
          <dt>Category</dt>
          <dd>{event.category}</dd>
        </div>
      )}
      {event.price && (
        <div>
          <dt>Price</dt>
          <dd>{event.price}</dd>
        </div>
      )}
      {event.ticketUrl && (
        <div>
          <dt>Tickets</dt>
          <dd>
            <a href={event.ticketUrl}>Buy tickets</a>
          </dd>
        </div>
      )}
    </dl>
    <p>
      <a href={href(`/event/${event.slug}.ics`)}>Add to calendar (.ics)</a>
      <span class="note"> — wireframe link; the real build emits an ICS file.</span>
    </p>
    <h2 class="section-title">Photos</h2>
    <PhotoGrid photos={photos} />
    {
      related.length > 0 && (
        <section>
          <h2 class="section-title">Related events</h2>
          <div class="grid">
            {related.map((item) => (
              <EventCard event={item} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</PlaceLayout>

<style>
  .date {
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-teal);
  }
  .lede {
    color: var(--brand-ink-soft);
    max-width: 64ch;
  }
  .facts {
    display: grid;
    gap: var(--size-2);
    margin-block: var(--size-5);
  }
  .facts div {
    display: grid;
    grid-template-columns: 110px 1fr;
    font-size: var(--font-size-1);
  }
  .facts dt {
    font-weight: var(--font-weight-7);
    color: var(--brand-ink-soft);
  }
  .facts dd {
    margin: 0;
  }
  .note {
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--size-4);
  }
</style>
