---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhotoGrid from "../../components/PhotoGrid.astro";
import { businessBySlug, events, photosFor, townBySlug } from "../../data/catalog";
import type { EventItem } from "../../data/types";
import SaveShare from "../../components/islands/SaveShare.svelte";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(events, "event");
}

interface Props {
  item: EventItem;
}

const { item: event } = Astro.props;
const town = event.townSlug ? townBySlug(event.townSlug) : undefined;
const business = event.businessSlug ? businessBySlug(event.businessSlug) : undefined;
const photos = photosFor("event", event.slug);
const related = events.filter((item) => item.slug !== event.slug).slice(0, 3);
const isFree = (event.price ?? "").toLowerCase().includes("free");
const hostName = business?.name ?? (town ? `${town.name} Events` : "Community host");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: event.name,
  description: event.summary,
  startDate: event.when,
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  location: {
    "@type": "Place",
    name: event.venue ?? town?.name ?? "30A",
    address: town?.name ? `${town.name}, FL` : "30A, FL",
  },
  offers: event.price
    ? {
        "@type": "Offer",
        price: event.price.replace(/[^0-9.]/g, "") || "0",
        priceCurrency: "USD",
        url: event.ticketUrl,
      }
    : undefined,
};
---

<BaseLayout title={event.name} description={event.summary} active="events" jsonLd={jsonLd}>
  <div class="event-page">
    <section class="hero">
      <div class="container hero__inner">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={href("/")}>Home</a>
          <span>/</span>
          <a href={href("/events")}>Events</a>
          {town && (
            <>
              <span>/</span>
              <a href={href(`/town/${town.slug}`)}>{town.name}</a>
            </>
          )}
          <span>/</span>
          <span class="current">{event.name}</span>
        </nav>

        <div class="badges">
          {event.category && <span class="badge badge--teal">{event.category}</span>}
          {isFree && <span class="badge">Free Admission</span>}
          {town && <span class="badge">{town.name}</span>}
        </div>

        <h1>{event.name}</h1>
        <p class="lede">{event.summary}</p>

        <dl class="facts">
          <div>
            <dt>Date &amp; time</dt>
            <dd>
              {event.when}{event.time ? ` · ${event.time}` : ""}
              <p class="save-nudge">Interested? Save it to your trip.</p>
            </dd>
          </div>
          <div>
            <dt>Venue</dt>
            <dd>{event.venue ?? town?.name ?? "30A"}</dd>
          </div>
          <div>
            <dt>Host</dt>
            <dd>
              {hostName}
              <span class="verified">Verified</span>
            </dd>
          </div>
        </dl>

        <div class="actions">
          <a class="btn btn--teal" href={event.ticketUrl ?? href(`/event/${event.slug}.ics`)}>
            {isFree ? "Free event" : event.price ? `Tickets · ${event.price}` : "Get details"}
          </a>
          <a class="btn btn--ghost" href={href(`/event/${event.slug}.ics`)}>Add to Calendar</a>
          <SaveShare
            type="event"
            slug={event.slug}
            name={event.name}
            href={href(`/event/${event.slug}`)}
            saveLabel="Save"
            client:load
          />
          {town && (
            <a class="btn btn--link" href={href(`/town/${town.slug}`)}>Get Directions</a>
          )}
        </div>
      </div>
    </section>

    <div class="container layout">
      <div class="main">
        <div class="hero-media img-placeholder" aria-hidden="true">
          <span class="hero-media__tag">Weekly community tradition</span>
          <div class="hero-media__caption">
            <span>Live Gulf weather</span>
            <p>{event.venue ?? "Scenic 30A"} · {town?.name ?? "South Walton"}</p>
          </div>
        </div>

        <section class="panel glance">
          <h2>At a glance</h2>
          <div class="glance__grid">
            <div>
              <p class="label">Cost</p>
              <p>{event.price ?? "See host"}</p>
            </div>
            <div>
              <p class="label">Bring</p>
              <p>{event.category === "Wellness" ? "Mat & water" : "Comfortable shoes"}</p>
            </div>
            <div>
              <p class="label">Parking</p>
              <p>{town?.name ?? "Nearby lots"}</p>
            </div>
            <div>
              <p class="label">Weather</p>
              <p>Rain plan active</p>
            </div>
          </div>
        </section>

        <section class="panel">
          <h2>About the gathering</h2>
          <p>{event.summary}</p>
          <p>
            Arrive a few minutes early, follow host guidance for seating and carts, and check today’s beach flag if you’re
            pairing the event with Gulf time.
          </p>
          {
            event.category === "Wellness" && (
              <ol class="timeline">
                <li><span>5:15 PM</span> Arrival & lawn settle-in</li>
                <li><span>5:30 PM</span> Sunset flow begins</li>
                <li><span>6:20 PM</span> Golden-hour close</li>
              </ol>
            )
          }
        </section>

        <section class="alert">
          <p class="alert__label">Local ordinance</p>
          <p>
            Low-speed vehicles follow posted town rules. Park only in marked stalls and keep dune accesses clear after dusk.
          </p>
        </section>

        {
          photos.length > 0 && (
            <section class="panel">
              <h2>Photos</h2>
              <PhotoGrid photos={photos} />
            </section>
          )
        }

        <section class="panel ask">
          <div class="ask__head">
            <h2>Questions from the 30A community</h2>
            <a href={href("/ask")}>Ask a question</a>
          </div>
          <article class="qa">
            <span class="qa__tag">Equipment</span>
            <p class="qa__q">Do I need to bring my own mat for outdoor sessions?</p>
            <p class="qa__a">
              <strong>Local tip:</strong> Bring a mat or towel when you can. Hosts sometimes have a few extras, but they go fast near sunset.
            </p>
          </article>
          <a class="ask__cta" href={href("/ask")}>+ Ask the 30A community</a>
        </section>
      </div>

      <aside class="rail">
        <section class="widget status">
          <span class="status__badge">{isFree ? "Free weekly series" : event.category ?? "Community event"}</span>
          <p class="status__copy">{event.when}</p>
          <a class="status__btn" href={href(`/event/${event.slug}.ics`)}>Get event reminder</a>
        </section>

        <section class="widget">
          <p class="widget__label">Host</p>
          <div class="host">
            <span class="avatar" aria-hidden="true">{hostName.charAt(0)}</span>
            <div>
              <strong>{hostName}</strong>
              <span>Verified community partner</span>
            </div>
          </div>
          {
            business ? (
              <a class="ghost" href={href(`/business/${business.slug}`)}>
                View host listing
              </a>
            ) : (
              <a class="ghost" href={href("/ask")}>
                Contact organizer
              </a>
            )
          }
        </section>

        <section class="widget">
          <p class="widget__label">Map</p>
          <div class="mini-map img-placeholder" aria-hidden="true">{town?.name ?? "30A"}</div>
          {town && <a href={href(`/town/${town.slug}`)}>Open town page →</a>}
        </section>

        {
          related.length > 0 && (
            <section class="widget">
              <p class="widget__label">More 30A gatherings</p>
              <ul class="related">
                {related.map((item) => (
                  <li>
                    <a href={href(`/event/${item.slug}`)}>
                      <span class="related__when">{item.when}</span>
                      <strong>{item.name}</strong>
                      <span>{item.venue ?? "30A"}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .event-page {
    background: var(--brand-sand);
    color: var(--brand-ink);
  }
  .hero {
    background: var(--brand-deep);
    color: white;
    padding: var(--size-6) 0 var(--size-7);
  }
  .hero__inner {
    display: grid;
    gap: var(--size-4);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
    font-size: var(--font-size-0);
    color: var(--brand-ink-on-navy);
  }
  .crumbs a {
    color: var(--brand-ink-on-navy);
  }
  .crumbs a:hover {
    color: var(--mint);
  }
  .crumbs .current {
    color: var(--mint);
    font-weight: var(--font-weight-7);
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .badge {
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.35);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-6);
  }
  .badge--teal {
    background: rgba(0, 137, 123, 0.25);
    border-color: rgba(133, 246, 229, 0.45);
    color: var(--mint);
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 2.75rem);
    color: white;
    letter-spacing: -0.02em;
  }
  .lede {
    margin: 0;
    max-width: 46rem;
    color: var(--brand-line);
    font-size: var(--font-size-2);
    line-height: 1.55;
  }
  .facts {
    display: grid;
    gap: var(--size-3);
    margin: 0;
  }
  .facts div {
    display: grid;
    gap: 0.2rem;
  }
  .facts dt {
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-ink-on-navy);
  }
  .save-nudge {
    margin: 0.35rem 0 0;
    font-size: var(--font-size-0);
    color: var(--mint);
  }
  .facts dd {
    margin: 0;
    font-size: var(--font-size-2);
    color: white;
  }
  .verified {
    margin-left: 0.4rem;
    font-size: 0.625rem;
    font-weight: var(--font-weight-7);
    color: var(--mint);
    background: rgba(0, 137, 123, 0.25);
    border-radius: 0.25rem;
    padding: 0.1rem 0.35rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-2);
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    border: 1px solid transparent;
    cursor: pointer;
    font: inherit;
  }
  .btn--teal {
    background: var(--brand-teal);
    color: white;
  }
  .btn--teal:hover {
    background: var(--brand-teal-hover);
    text-decoration: none;
  }
  .btn--ghost {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.35);
    color: white;
  }
  .btn--ghost:hover {
    border-color: white;
    text-decoration: none;
  }
  .btn--link {
    background: transparent;
    color: var(--mint);
    margin-left: auto;
  }
  .layout {
    display: grid;
    gap: var(--size-5);
    padding-block: var(--size-6) var(--size-10);
    align-items: start;
  }
  .main {
    display: grid;
    gap: var(--size-4);
    min-width: 0;
  }
  .hero-media {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-3);
    overflow: hidden;
    border: 1px solid var(--brand-line);
  }
  .hero-media__tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
    background: rgba(12, 35, 46, 0.85);
    color: white;
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .hero-media__caption {
    position: absolute;
    inset: auto 0 0;
    padding: var(--size-4);
    background: linear-gradient(transparent, rgba(12, 35, 46, 0.9));
    color: white;
  }
  .hero-media__caption span {
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .hero-media__caption p {
    margin: 0.25rem 0 0;
    font-size: var(--font-size-1);
  }
  .panel,
  .widget {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-card);
    padding: var(--size-5);
  }
  .panel h2,
  .ask__head h2 {
    margin: 0 0 var(--size-3);
    font-family: var(--font-display);
    font-size: var(--font-size-4);
    color: var(--brand-deep);
  }
  .panel p {
    margin: 0 0 var(--size-3);
    color: var(--brand-ink-soft);
    line-height: 1.6;
  }
  .glance__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .glance__grid div {
    background: var(--brand-sand);
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-2);
    padding: 0.85rem;
  }
  .glance__grid .label {
    margin: 0 0 0.25rem;
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .glance__grid p:last-child {
    margin: 0;
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .timeline {
    margin: var(--size-3) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
    align-items: center;
    font-size: var(--font-size-1);
    color: var(--brand-ink);
  }
  .timeline span {
    display: inline-flex;
    justify-content: center;
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-2);
    background: var(--brand-deep);
    color: white;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
  }
  .alert {
    padding: var(--size-4);
    border-radius: var(--radius-2);
    background: var(--brand-teal-soft);
    border: 1px solid var(--brand-line);
    border-left: 4px solid var(--brand-sun);
  }
  .alert__label {
    margin: 0 0 0.35rem;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-8);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-coral);
  }
  .alert p:last-child {
    margin: 0;
    font-size: var(--font-size-1);
    color: var(--brand-coral);
  }
  .ask__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
  }
  .ask__head a {
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    color: var(--brand-teal);
  }
  .qa {
    padding: var(--size-4);
    border-radius: var(--radius-2);
    background: var(--brand-sand);
    border: 1px solid var(--brand-line);
  }
  .qa__tag {
    display: inline-flex;
    margin-bottom: 0.5rem;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--brand-teal-soft);
    color: var(--brand-teal);
    font-size: 0.625rem;
    font-weight: var(--font-weight-7);
  }
  .qa__q {
    margin: 0 0 0.65rem;
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .qa__a {
    margin: 0;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .ask__cta {
    display: inline-flex;
    margin-top: var(--size-3);
    font-weight: var(--font-weight-7);
    color: var(--brand-teal);
  }
  .rail {
    display: grid;
    gap: var(--size-4);
  }
  .widget__label {
    margin: 0 0 var(--size-3);
    font-family: var(--font-display);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .status__badge {
    display: inline-flex;
    margin-bottom: var(--size-3);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    background: var(--brand-teal-soft);
    color: var(--brand-teal);
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .status__copy {
    margin: 0 0 var(--size-3);
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .status__btn,
  .ghost {
    display: inline-flex;
    width: 100%;
    justify-content: center;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-2);
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
  }
  .status__btn {
    background: var(--brand-deep);
    color: white;
  }
  .status__btn:hover {
    background: var(--brand-teal);
    text-decoration: none;
  }
  .ghost {
    border: 1px solid var(--brand-line);
    background: white;
    color: var(--brand-ink);
    text-decoration: none;
  }
  .ghost:hover {
    border-color: var(--brand-deep);
  }
  .host {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    margin-bottom: var(--size-3);
  }
  .avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--brand-deep);
    color: white;
    display: grid;
    place-items: center;
    font-weight: var(--font-weight-7);
  }
  .host div {
    display: grid;
    gap: 0.1rem;
  }
  .host strong {
    color: var(--brand-deep);
    font-size: var(--font-size-1);
  }
  .host span {
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  .mini-map {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-2);
    margin-bottom: var(--size-3);
    display: grid;
    place-items: center;
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .related {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .related a {
    display: grid;
    gap: 0.15rem;
    color: var(--brand-ink);
  }
  .related a:hover {
    text-decoration: none;
  }
  .related a:hover strong {
    color: var(--brand-teal);
  }
  .related__when {
    font-size: 0.625rem;
    font-weight: var(--font-weight-7);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-teal);
  }
  .related strong {
    font-size: var(--font-size-1);
    color: var(--brand-deep);
  }
  .related span:last-child {
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  @media (min-width: 800px) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
    .rail {
      position: sticky;
      top: calc(var(--header-h) + 1rem);
    }
  }
</style>
