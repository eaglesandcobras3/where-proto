---
import BaseLayout from "../layouts/BaseLayout.astro";
import UpdateFilters from "../components/islands/UpdateFilters.svelte";
import { isEnabled } from "../config/flags";
import { businessBySlug, liveUpdates, townBySlug } from "../data/catalog";
import { formatThrough, updateTypeLabels } from "../lib/labels";
import { href } from "../lib/href";

const params = Astro.url.searchParams;
const town = params.get("town") ?? "";
const type = params.get("type") ?? "";
const q = params.get("q") ?? "";
const base = import.meta.env.BASE_URL;
const rows = liveUpdates().map((update) => {
  const business = update.businessSlug ? businessBySlug(update.businessSlug) : undefined;
  const townRow = update.townSlug ? townBySlug(update.townSlug) : undefined;
  return {
    slug: update.slug,
    title: update.title,
    body: update.body,
    type: update.type,
    typeLabel: updateTypeLabels[update.type],
    throughLabel: formatThrough(update.through),
    sourceName: business?.name ?? townRow?.name,
    sourceHref: business ? href(`/business/${business.slug}`) : townRow ? href(`/town/${townRow.slug}`) : undefined,
    town: update.townSlug,
  };
});
---

<BaseLayout
  title="Updates around 30A"
  description="Short, timely updates from local businesses and towns around 30A."
  active="updates"
  showUpdates
  updatesTown={town}
  updatesType={type}
  updatesQuery={q}
>
  <div class="container section">
    <p class="cta"><a href={href("/dashboard")}>Own a business? Share an update</a></p>
    {
      isEnabled("updates") && (
        <UpdateFilters
          updates={rows}
          initialTown={town}
          initialType={type}
          initialQuery={q}
          base={base}
          client:load
        />
      )
    }
  </div>
</BaseLayout>

<style>
  .cta {
    margin-bottom: var(--size-5);
    font-weight: var(--font-weight-6);
  }
</style>
