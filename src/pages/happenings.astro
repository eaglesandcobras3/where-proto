---
import Layout from "../layouts/Layout.astro";
import { happenings, townBySlug } from "../data/catalog";
---

<Layout title="Happenings">
  <h1>Happenings</h1>
  <p>Corridor-level happening notes. No detail route in this scaffold.</p>
  <ul>
    {
      happenings.map((item) => (
        <li>
          {item.title} — {item.summary}
          {item.townSlug ? ` · ${townBySlug(item.townSlug)?.name}` : ""}
        </li>
      ))
    }
  </ul>
</Layout>
