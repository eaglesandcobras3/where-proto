---
import BaseLayout from "../layouts/BaseLayout.astro";
import TwoPaneMap from "../components/TwoPaneMap.astro";
import FilterBar from "../components/islands/FilterBar.svelte";
import { allLeaves, businesses, categories, tags, towns } from "../data/catalog";
import { toFilterBusiness } from "../lib/listing";
import { href } from "../lib/href";

const params = Astro.url.searchParams;
const town = params.get("town") ?? "";
const category = params.get("category") ?? "";
const tag = params.get("tag") ?? "";
const q = params.get("q") ?? "";
const openNow = params.get("open") === "1";
const comboCanonical = Boolean(town && category && !tag && !openNow && !q);
const canonicalPath = comboCanonical ? `/town/${town}/${category}` : "/search";
const filterCategories = [
  ...categories.map((item) => ({ slug: item.slug, name: item.name })),
  ...allLeaves().map((item) => ({ slug: item.slug, name: `${item.groupName} / ${item.name}` })),
];
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Search businesses on 30A"
  description="Search every business on 30A by town, category, tag, or keyword."
  active="businesses"
  noindex
  canonicalPath={canonicalPath}
  showSearch
  searchTown={town}
  searchCategory={category}
  searchQuery={q}
>
  {
    comboCanonical && (
      <div class="container notice">
        <p>
          Indexable page for this combo:
          <a href={href(`/town/${town}/${category}`)}>
            /town/{town}/{category}
          </a>
        </p>
      </div>
    )
  }
  <TwoPaneMap mapLabel="30A businesses map" pinCount={Math.max(8, businesses.length)} searchArea>
    <FilterBar
      businesses={businesses.map(toFilterBusiness)}
      towns={towns}
      categories={filterCategories}
      tags={tags}
      initialTown={town}
      initialCategory={category}
      initialTag={tag}
      initialOpenNow={openNow}
      initialQuery={q}
      externalChrome
      base={base}
      client:load
    />
  </TwoPaneMap>
</BaseLayout>

<style>
  .notice {
    padding-block: var(--size-3);
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
</style>
