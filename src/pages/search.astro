---
import Layout from "../layouts/Layout.astro";
import LinkList from "../components/LinkList.astro";
import { businesses, events, guides, questions, towns } from "../data/catalog";
import { href } from "../lib/href";

const query = (Astro.url.searchParams.get("q") ?? "").trim().toLowerCase();

function matches(text: string) {
  return !query || text.toLowerCase().includes(query);
}

const townHits = towns.filter((item) => matches(`${item.name} ${item.summary}`));
const businessHits = businesses.filter((item) => matches(`${item.name} ${item.summary}`));
const eventHits = events.filter((item) => matches(`${item.name} ${item.summary}`));
const guideHits = guides.filter((item) => matches(`${item.title} ${item.summary}`));
const askHits = questions.filter((item) => matches(`${item.title} ${item.body}`));
---

<Layout title="Search" noindex canonicalPath="/search">
  <h1>Search</h1>
  <p>The only search page. Filtered views are noindex, follow, canonical to /search.</p>
  <form action={href("/search")} method="get">
    <label>
      Query
      <input type="search" name="q" value={Astro.url.searchParams.get("q") ?? ""} />
    </label>
    <button type="submit">Search</button>
  </form>
  <p>{query ? `Fake matches for “${query}”.` : "No query yet."}</p>

  <h2>Towns</h2>
  <LinkList
    items={townHits.map((item) => ({
      href: href(`/town/${item.slug}`),
      label: item.name,
    }))}
  />

  <h2>Businesses</h2>
  <LinkList
    items={businessHits.map((item) => ({
      href: href(`/business/${item.slug}`),
      label: item.name,
    }))}
  />

  <h2>Events</h2>
  <LinkList
    items={eventHits.map((item) => ({
      href: href(`/event/${item.slug}`),
      label: item.name,
    }))}
  />

  <h2>Guides</h2>
  <LinkList
    items={guideHits.map((item) => ({
      href: href(`/guide/${item.slug}`),
      label: item.title,
    }))}
  />

  <h2>Ask</h2>
  <LinkList
    items={askHits.map((item) => ({
      href: href(`/ask/${item.slug}`),
      label: item.title,
    }))}
  />
</Layout>
