---
import Layout from "../layouts/Layout.astro";
import LinkList from "../components/LinkList.astro";
import Box from "../components/Box.astro";
import { allLeaves, businesses, listingMeta, tags, towns } from "../data/catalog";
import { href } from "../lib/href";

const params = Astro.url.searchParams;
const town = params.get("town") ?? "";
const category = params.get("category") ?? "";
const tag = params.get("tag") ?? "";
const openNow = params.get("open") === "1";
const filtered = Boolean(town || category || tag || openNow);

const hits = businesses.filter((item) => {
  if (town && item.townSlug !== town) return false;
  if (category && item.leafSlug !== category) return false;
  if (tag && !item.tagSlugs.includes(tag)) return false;
  if (openNow && !item.openNow) return false;
  return true;
});

const comboCanonical = town && category && !tag && !openNow;
const canonicalPath = comboCanonical ? `/town/${town}/${category}` : "/search";
---

<Layout title="Search" noindex canonicalPath={canonicalPath}>
  <h1>Search</h1>
  <p>
    Business finder. Filters: town, category, tag, open now. Indexable category pages are the
    town × category combos, not this route.
  </p>

  <Box label="Filters">
    <form action={href("/search")} method="get">
      <p>
        <label>
          Town
          <select name="town">
            <option value="">Any</option>
            {
              towns.map((item) => (
                <option value={item.slug} selected={item.slug === town}>
                  {item.name}
                </option>
              ))
            }
          </select>
        </label>
      </p>
      <p>
        <label>
          Category
          <select name="category">
            <option value="">Any</option>
            {
              allLeaves().map((leaf) => (
                <option value={leaf.slug} selected={leaf.slug === category}>
                  {leaf.groupName} / {leaf.name}
                </option>
              ))
            }
          </select>
        </label>
      </p>
      <p>
        <label>
          Tag
          <select name="tag">
            <option value="">Any</option>
            {
              tags.map((item) => (
                <option value={item.slug} selected={item.slug === tag}>
                  {item.name}
                </option>
              ))
            }
          </select>
        </label>
      </p>
      <p>
        <label>
          <input type="checkbox" name="open" value="1" checked={openNow} />
          Open now
        </label>
      </p>
      <button type="submit">Find businesses</button>
    </form>
  </Box>

  {
    comboCanonical && (
      <Box label="Canonical">
        <p>
          Indexable page for this combo:{" "}
          <a href={href(`/town/${town}/${category}`)}>
            /town/{town}/{category}
          </a>
        </p>
      </Box>
    )
  }

  <Box label="Results">
    <p>{filtered ? `${hits.length} fake matches.` : "No filters. Showing all fake businesses."}</p>
    <LinkList
      items={hits.map((item) => ({
        href: href(`/business/${item.slug}`),
        label: item.name,
        meta: listingMeta(item),
      }))}
    />
  </Box>
</Layout>
