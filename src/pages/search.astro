---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import FilterBar from "../components/islands/FilterBar.svelte";
import { allLeaves, businesses, categories, tags, towns } from "../data/catalog";
import { toFilterBusiness } from "../lib/listing";
import { href } from "../lib/href";

const params = Astro.url.searchParams;
const town = params.get("town") ?? "";
const category = params.get("category") ?? "";
const tag = params.get("tag") ?? "";
const openNow = params.get("open") === "1";
const comboCanonical = Boolean(town && category && !tag && !openNow);
const canonicalPath = comboCanonical ? `/town/${town}/${category}` : "/search";
const filterCategories = [
  ...categories.map((item) => ({ slug: item.slug, name: item.name })),
  ...allLeaves().map((item) => ({ slug: item.slug, name: `${item.groupName} / ${item.name}` })),
];
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Search businesses on 30A"
  description="Search every business on 30A by town, category, tag, or open now."
  active="businesses"
  noindex
  canonicalPath={canonicalPath}
  showBrowse
>
  <div class="container section">
    <PageHeader
      title="Find a business"
      lede="Search is the finder. Indexable listings live on town plus category pages. This route stays noindex."
    />
    {
      comboCanonical && (
        <p class="canonical">
          Indexable page for this combo:
          <a href={href(`/town/${town}/${category}`)}>
            /town/{town}/{category}
          </a>
        </p>
      )
    }
    <FilterBar
      businesses={businesses.map(toFilterBusiness)}
      towns={towns}
      categories={filterCategories}
      tags={tags}
      initialTown={town}
      initialCategory={category}
      initialTag={tag}
      initialOpenNow={openNow}
      base={base}
      client:load
    />
  </div>
</BaseLayout>

<style>
  .canonical {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
</style>
