---
import PlaceLayout from "../../layouts/PlaceLayout.astro";
import Corridor from "../../components/Corridor.astro";
import CategoriesInTown from "../../components/CategoriesInTown.astro";
import AreasInTown from "../../components/AreasInTown.astro";
import AtAGlance from "../../components/AtAGlance.astro";
import UpdatesModule from "../../components/UpdatesModule.astro";
import PhotoGrid from "../../components/PhotoGrid.astro";
import { isEnabled } from "../../config/flags";
import { photosFor, towns, updatesForTown } from "../../data/catalog";
import type { Town } from "../../data/types";
import { townView } from "../../lib/town-view";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(towns, "town");
}

interface Props {
  item: Town;
}

const { item: town } = Astro.props;
const view = townView(town);
const townUpdates = updatesForTown(town.slug);
const photos = photosFor("town", town.slug);
---

<PlaceLayout
  title={`${town.name}: stay, eat, and beach on 30A`}
  description={town.summary}
  active="towns"
  browseTown={town.name}
  crumbs={[{ label: "Towns", path: "/towns" }, { label: town.name }]}
>
  <div class="container">
    <Corridor currentSlug={town.slug} />

    <section class="hero">
      <div class="hero-img img-placeholder" aria-hidden="true">{town.name.charAt(0)}</div>
      <div>
        <h1>{town.name}</h1>
        <p class="tagline">{view.tagline}</p>
        <p class="desc">{town.summary}</p>
      </div>
    </section>

    <CategoriesInTown townSlug={town.slug} townName={town.name} />
    <AreasInTown townSlug={town.slug} townName={town.name} />
    <AtAGlance town={view} />

    <section>
      <h2 class="section-title">Photos</h2>
      <PhotoGrid photos={photos} empty={`No ${town.name} photos yet.`} />
    </section>

    {isEnabled("updates") && <UpdatesModule title={`Updates in ${town.name}`} updates={townUpdates} />}
  </div>
</PlaceLayout>

<style>
  .hero {
    display: flex;
    gap: var(--size-6);
    align-items: center;
    padding-block: var(--size-6);
  }
  .hero-img {
    width: 180px;
    height: 180px;
    border-radius: var(--radius-card);
    flex-shrink: 0;
    font-size: var(--font-size-8);
  }
  .tagline {
    font-weight: var(--font-weight-6);
    color: var(--brand-teal);
    margin-bottom: var(--size-1);
  }
  .desc {
    color: var(--brand-ink-soft);
    max-width: 64ch;
  }
  @media (max-width: 640px) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
