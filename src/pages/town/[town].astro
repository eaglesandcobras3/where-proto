---
import ProtoLayout from "../../layouts/ProtoLayout.astro";
import TwoPaneMap from "../../components/proto/TwoPaneMap.astro";
import {
  areasForTown,
  businessesForTown,
  categories,
  towns,
  updatesForTown,
} from "../../data/catalog";
import type { Town } from "../../data/types";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(towns, "town");
}

interface Props {
  item: Town;
}

const { item: town } = Astro.props;
const townBusinesses = businessesForTown(town.slug);
const townAreas = areasForTown(town.slug);
const townUpdates = updatesForTown(town.slug);

const categoryCounts = categories
  .map((category) => {
    const count = townBusinesses.filter((item) => item.categorySlug === category.slug).length;
    const firstLeaf = category.leaves[0];
    return {
      slug: category.slug,
      name: category.name,
      count,
      href: firstLeaf ? href(`/town/${town.slug}/${firstLeaf.slug}`) : href(`/town/${town.slug}`),
    };
  })
  .filter((item) => item.count > 0);

const currentIndex = towns.findIndex((item) => item.slug === town.slug);
---

<ProtoLayout
  title={town.name}
  activeNav="towns"
  filterTown={town.name}
  filterCategory="Any category"
>
  <TwoPaneMap mapLabel={`${town.name} map`} pinCount={Math.max(8, townBusinesses.length * 3)}>
    <section class="corridor" aria-label="The 30A corridor">
      <p class="corridor__label">The 30A Corridor</p>
      <div class="corridor__track">
        {
          towns.map((item, index) => {
            const here = item.slug === town.slug;
            const delta = index - currentIndex;
            const meta = here
              ? "You are here"
              : delta < 0
                ? `${Math.abs(delta)} west`
                : `${delta} east`;
            return (
              <a
                class="corridor__item"
                href={href(`/town/${item.slug}`)}
                aria-current={here ? "true" : undefined}
              >
                <div class="corridor__dot">{here ? "●" : ""}</div>
                <p class="corridor__name">{item.name}</p>
                <p class="corridor__meta">{meta}</p>
              </a>
            );
          })
        }
      </div>
    </section>

    <section class="town-hero">
      <div class="town-hero__media" role="img" aria-label={`${town.name} photo placeholder`}></div>
      <div>
        <h1 class="town-hero__title">{town.name}</h1>
        <span class="town-hero__tag">All 30A</span>
        <p class="town-hero__summary">{town.summary}</p>
        <a class="town-hero__suggest" href={href("/ask")}>Suggest an update</a>
      </div>
    </section>

    {
      categoryCounts.length > 0 && (
        <section>
          <p class="section-label">Categories in {town.name}</p>
          <div class="pill-row">
            {categoryCounts.map((item) => (
              <a class="pill" href={item.href}>
                {item.name} ({item.count})
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="glance">
      <h2 class="glance__title">{town.name} at a glance</h2>
      <div class="glance__grid">
        <div class="glance__card">
          <div class="glance__icon" aria-hidden="true"></div>
          <strong>Walkability</strong>
          <span>{town.walkability}</span>
        </div>
        <div class="glance__card">
          <div class="glance__icon" aria-hidden="true"></div>
          <strong>Beach access</strong>
          <span>{town.beachAccess}</span>
        </div>
        <div class="glance__card">
          <div class="glance__icon" aria-hidden="true"></div>
          <strong>Areas</strong>
          <span>{townAreas.length} in this town</span>
        </div>
      </div>
    </section>

    {
      townAreas.length > 0 && (
        <section>
          <p class="section-label">Areas in {town.name}</p>
          <div class="pill-row">
            {townAreas.map((area) => (
              <a class="pill" href={href(`/area/${area.slug}`)}>
                {area.name}
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      townUpdates.length > 0 && (
        <section class="updates-block">
          <p class="section-label">Updates</p>
          <ul>
            {townUpdates.map((item) => (
              <li>
                <strong>{item.title}</strong> — {item.body}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </TwoPaneMap>
</ProtoLayout>
