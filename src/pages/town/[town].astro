---
import Layout from "../../layouts/Layout.astro";
import LinkList from "../../components/LinkList.astro";
import Box from "../../components/Box.astro";
import Placeholder from "../../components/Placeholder.astro";
import FeedList from "../../components/FeedList.astro";
import {
  allLeaves,
  areaKindLabel,
  areasForTown,
  events,
  guides,
  photosFor,
  postsFor,
  questions,
  towns,
  updatesForTown,
} from "../../data/catalog";
import UpdatesList from "../../components/UpdatesList.astro";
import type { Town } from "../../data/types";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(towns, "town");
}

interface Props {
  item: Town;
}

const { item: town } = Astro.props;
const townAreas = areasForTown(town.slug);
const shopping = townAreas.filter((item) => item.kind === "shopping");
const neighborhoods = townAreas.filter((item) => item.kind === "neighborhood");
const townUpdates = updatesForTown(town.slug);
const townEvents = events.filter((item) => item.townSlug === town.slug);
const townGuides = guides.filter((item) => item.townSlug === town.slug);
const townQuestions = questions.filter((item) => item.townSlug === town.slug);
const townPosts = postsFor("town", town.slug);
const townPhotos = photosFor("town", town.slug);
const leaves = allLeaves();
---

<Layout
  title={town.name}
  note="Posting to the feed as a user happens on this town page. Posting as a business happens from the dashboard. How a signed-in owner chooses user vs business is still an open question."
>
  <p><a href={href("/towns")}>Towns</a></p>
  <h1>Town: {town.name}</h1>
  <p>{town.summary}</p>

  <Box label="Facts">
    <ul>
      <li>Walkability: {town.walkability}</li>
      <li>Beach access: {town.beachAccess}</li>
    </ul>
  </Box>

  <Box label="Map">
    <Placeholder kind="map" caption={town.name} />
  </Box>

  <Box label="Photos">
    {
      townPhotos.length === 0 ? (
        <Placeholder caption="No town photos yet" />
      ) : (
        <div class="row">
          {townPhotos.map((photo) => (
            <Placeholder caption={photo.caption} />
          ))}
        </div>
      )
    }
  </Box>

  <Box label="Categories in this town">
    <p>Leaf pages hold listings. This hub does not render business cards.</p>
    <ul>
      {
        leaves.map((leaf) => (
          <li>
            <a href={href(`/town/${town.slug}/${leaf.slug}`)}>{leaf.name}</a>
          </li>
        ))
      }
    </ul>
  </Box>

  <Box label="Areas in this town">
    <p>Shopping areas and neighborhoods. An area is an extension of this town.</p>
    <LinkList
      items={[
        ...shopping.map((item) => ({
          href: href(`/area/${item.slug}`),
          label: item.name,
          meta: `${areaKindLabel(item.kind)} · ${item.summary}`,
        })),
        ...neighborhoods.map((item) => ({
          href: href(`/area/${item.slug}`),
          label: item.name,
          meta: `${areaKindLabel(item.kind)} · ${item.summary}`,
        })),
      ]}
    />
  </Box>

  <Box label="Updates">
    <UpdatesList items={townUpdates} />
  </Box>

  <Box label="Related">
    <LinkList
      items={[
        ...townEvents.map((item) => ({
          href: href(`/event/${item.slug}`),
          label: item.name,
          meta: "event",
        })),
        ...townGuides.map((item) => ({
          href: href(`/guide/${item.slug}`),
          label: item.title,
          meta: "guide",
        })),
        ...townQuestions.map((item) => ({
          href: href(`/ask/${item.slug}`),
          label: item.title,
          meta: "ask",
        })),
      ]}
    />
  </Box>

  <Box label="Stay">
    <p>
      Stay is ship-dark. <a href={href("/stays")}>Stays hub</a>
    </p>
  </Box>

  <Box label="Feed posts">
    <FeedList items={townPosts} />
  </Box>

  <Box label="Post to this town feed (as user)">
    <p>Wireframe form. Submit does nothing.</p>
    <form>
      <label>
        Post
        <input type="text" name="body" />
      </label>
      <button type="button">Post as user</button>
    </form>
  </Box>
</Layout>
