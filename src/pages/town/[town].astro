---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Corridor from "../../components/Corridor.astro";
import MapToggle from "../../components/MapToggle.astro";
import EntityGallery from "../../components/EntityGallery.astro";
import CommunityQA from "../../components/CommunityQA.astro";
import RelatedGuides from "../../components/RelatedGuides.astro";
import HappeningHere from "../../components/HappeningHere.astro";
import TownStays from "../../components/TownStays.astro";
import ExploreLinks from "../../components/ExploreLinks.astro";
import UpdatesModule from "../../components/UpdatesModule.astro";
import PostedUpdates from "../../components/islands/PostedUpdates.svelte";
import { events, guides, photosFor, stays, towns, updateSharePath, updatesForTown } from "../../data/catalog";
import type { Town } from "../../data/types";
import SaveShare from "../../components/islands/SaveShare.svelte";
import { href } from "../../lib/href";
import { townView } from "../../lib/town-view";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(towns, "town");
}

interface Props {
  item: Town;
}

const { item: town } = Astro.props;
const view = townView(town);
const photos = photosFor("town", town.slug);
const townGuides = guides.filter((item) => item.townSlug === town.slug);
const relatedGuides = (townGuides.length ? townGuides : guides).slice(0, 3);
const townIndex = towns.findIndex((item) => item.slug === town.slug);
const townEvents = events.filter((item) => item.townSlug === town.slug);
const townStays = stays.filter((item) => item.townSlug === town.slug);
const nearbyTowns = [towns[townIndex - 1], towns[townIndex + 1]].filter(
  (item): item is (typeof towns)[number] => Boolean(item),
);
---

<BaseLayout
  title={`${town.name}: stay, eat, and beach on 30A`}
  description={town.summary}
  active="towns"
>
  <div class="town-page">
    <section class="hero">
      <div class="container hero__inner">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={href("/")}>Home</a>
          <span>/</span>
          <a href={href("/towns")}>Towns</a>
          <span>/</span>
          <span class="current">{town.name}</span>
        </nav>

        <div class="hero__title">
          <div>
            <div class="eyebrow-row">
              <span class="live-pill">Scenic 30A community</span>
              <span class="tagline">{view.tagline}</span>
            </div>
            <h1>{town.name}</h1>
            <p class="lede">{town.summary}</p>
          </div>
          <div class="hero__actions">
            <SaveShare type="town" slug={town.slug} name={town.name} href={href(`/town/${town.slug}`)} client:load />
            <p class="save-nudge">Save {town.name} to your trip</p>
            <a class="map-btn" href="#map">Corridor map</a>
          </div>
        </div>

        <div class="snapshot">
          <div>
            <span class="label">Walkability</span>
            <strong>{town.walkability}</strong>
          </div>
          <div>
            <span class="label">Beach access</span>
            <strong>{town.beachAccess}</strong>
          </div>
        </div>
      </div>
    </section>

    <Corridor currentSlug={town.slug} />

    <div class="container layout">
      

      <div class="main">
        <section class="panel">
          <p class="eyebrow">About</p>
          <h2>{town.name} overview</h2>
          <p>{town.summary}</p>
          <div class="glance">
            {view.glance.map((fact) => (
              <div>
                <p class="label">{fact.label}</p>
                <p class="value">{fact.value}</p>
                <p class="detail">{fact.detail}</p>
              </div>
            ))}
          </div>
        </section>
        <EntityGallery photos={photos} fallbackName={town.name} />
        <section class="panel">
          <h2>Town facts</h2>
          <div class="glance">
            <div>
              <p class="label">Walkability</p>
              <p class="value">{town.walkability}</p>
            </div>
            <div>
              <p class="label">Beach access</p>
              <p class="value">{town.beachAccess}</p>
            </div>
          </div>
        </section>
        <UpdatesModule
          entityKind="town"
          entityName={town.name}
          updates={updatesForTown(town.slug)}
          ctaHref={updateSharePath("town", town.slug)}
        />
        <PostedUpdates townSlug={town.slug} client:load />
        <HappeningHere events={townEvents} placeName={town.name} townSlug={town.slug} />
        <TownStays stays={townStays} townName={town.name} townSlug={town.slug} />
        <CommunityQA
          question={`What's the best public beach access near ${town.name}?`}
          answer="Prefer Walton County regional accesses when you need parking, restrooms, and seasonal lifeguards. Guest-only paths may be marked private."
        />
        <RelatedGuides guides={relatedGuides} />
        <section class="panel">
          <h2>Similar nearby</h2>
          <ul class="links">
            {nearbyTowns.map((item) => (
              <li>
                <a href={href(`/town/${item.slug}`)}>{item.name}</a>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <aside class="rail">
        
        <div>
          <MapToggle title={`${town.name} map`} href={`/search?town=${town.slug}&view=map`} showRatings={false} />
          <section class="widget">
            <p class="widget__label">Get directions</p>
            <p class="copy">Open the corridor map for {town.name} walkovers, parking, and neighboring towns.</p>
            <a class="map-btn" href="#map">Open map</a>
          </section>
          <ExploreLinks current="towns" townSlug={town.slug} />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .town-page {
    background: var(--brand-sand);
    color: var(--brand-ink);
  }
  .hero {
    background: var(--brand-deep);
    color: white;
    padding: var(--size-6) 0 var(--size-7);
  }
  .hero__inner {
    display: grid;
    gap: var(--size-5);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
    font-size: var(--font-size-0);
    color: var(--brand-ink-on-navy);
  }
  .crumbs a {
    color: var(--brand-ink-on-navy);
  }
  .crumbs a:hover {
    color: var(--mint);
  }
  .crumbs .current {
    color: var(--mint);
    font-weight: var(--font-weight-7);
  }
  .hero__title {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--size-4);
    align-items: flex-end;
  }
  .eyebrow-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .live-pill {
    display: inline-flex;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    background: rgba(0, 137, 123, 0.22);
    color: var(--mint);
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tagline {
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-6);
    color: var(--brand-line);
  }
  h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    color: white;
  }
  .lede {
    margin: 0;
    max-width: 40rem;
    color: var(--brand-line);
    font-size: var(--font-size-2);
    line-height: 1.55;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .save-nudge {
    margin: 0;
    width: 100%;
    font-size: var(--font-size-0);
    color: var(--mint);
  }
  .hero__actions button,
  .map-btn {
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-2);
    padding: 0.5rem 0.85rem;
    font: inherit;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-6);
    color: white;
    cursor: pointer;
  }
  .map-btn {
    background: var(--brand-teal);
    border-color: var(--brand-teal);
    text-decoration: none;
  }
  .map-btn:hover {
    background: var(--brand-teal-hover);
    text-decoration: none;
  }
  .snapshot {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--size-3);
    padding-top: var(--size-4);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .snapshot .label {
    display: block;
    margin-bottom: 0.2rem;
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-ink-on-navy);
  }
  .snapshot strong {
    font-size: var(--font-size-1);
    color: white;
  }
  .layout {
    display: grid;
    gap: var(--size-5);
    padding-block: var(--size-6) var(--size-10);
    align-items: start;
  }
  .main {
    display: grid;
    gap: var(--size-4);
    min-width: 0;
  }
  .copy {
    margin: 0 0 var(--size-3);
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .panel,
  .widget {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-card);
    padding: var(--size-5);
  }
  .panel__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
    margin-bottom: var(--size-3);
  }
  .panel__head h2,
  .panel > h2 {
    margin: 0 0 var(--size-3);
    font-family: var(--font-display);
    font-size: var(--font-size-4);
    color: var(--brand-deep);
  }
  .panel__head h2 {
    margin-bottom: 0;
  }
  .panel__head a {
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    color: var(--brand-teal);
  }
  .eyebrow {
    margin: 0 0 0.2rem;
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-teal);
  }
  .glance {
    display: grid;
    gap: 0.75rem;
  }
  .glance > div {
    padding: 0.85rem;
    border-radius: var(--radius-2);
    background: var(--brand-sand);
    border: 1px solid var(--brand-line);
  }
  .glance .label {
    margin: 0 0 0.2rem;
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .glance .value {
    margin: 0 0 0.25rem;
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .glance .detail {
    margin: 0;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .map {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-2);
    margin-bottom: var(--size-3);
    display: grid;
    place-items: center;
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .highlights span {
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--brand-sand-dark);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-6);
  }
  .events,
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .events a {
    display: grid;
    gap: 0.15rem;
    color: var(--brand-ink);
  }
  .events a:hover {
    text-decoration: none;
  }
  .events span {
    font-size: 0.625rem;
    font-weight: var(--font-weight-7);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-teal);
  }
  .events strong {
    color: var(--brand-deep);
  }
  .events em {
    font-style: normal;
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  .bulletin-list {
    display: grid;
    gap: 0.75rem;
  }
  .bulletin {
    padding: var(--size-4);
    border-radius: var(--radius-2);
    background: var(--brand-sand);
    border: 1px solid var(--brand-line);
  }
  .bulletin__type {
    display: inline-flex;
    margin-bottom: 0.35rem;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--brand-teal-soft);
    color: var(--brand-teal);
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .bulletin h3 {
    margin: 0 0 0.35rem;
    font-size: var(--font-size-2);
    color: var(--brand-deep);
  }
  .bulletin p {
    margin: 0;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .bulletin__meta {
    margin-top: 0.5rem !important;
    font-size: var(--font-size-0) !important;
  }
  .composer {
    margin-bottom: var(--size-4);
    padding: var(--size-4);
    border-radius: var(--radius-2);
    background: var(--brand-teal-soft);
    border: 1px solid var(--mint);
  }
  .composer__prompt {
    margin: 0 0 var(--size-3);
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
  }
  .composer__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: var(--size-3);
  }
  .composer__tags span {
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
    background: white;
    border: 1px solid var(--brand-line);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-6);
  }
  .composer__btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-2);
    background: var(--brand-deep);
    color: white;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
  }
  .composer__btn:hover {
    background: var(--brand-teal);
    text-decoration: none;
  }
  .alert {
    padding: var(--size-4);
    border-radius: var(--radius-2);
    background: var(--brand-teal-soft);
    border: 1px solid var(--brand-line);
    border-left: 4px solid var(--brand-sun);
  }
  .alert__label {
    margin: 0 0 0.5rem;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-8);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-coral);
  }
  .alert ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--brand-coral);
    font-size: var(--font-size-1);
  }
  .qa {
    padding: var(--size-4);
    border-radius: var(--radius-2);
    background: var(--brand-sand);
    border: 1px solid var(--brand-line);
  }
  .qa__q {
    margin: 0 0 0.5rem;
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .qa__a {
    margin: 0;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .empty {
    margin: 0;
    color: var(--brand-ink-soft);
  }
  .rail {
    display: grid;
    gap: var(--size-4);
  }
  .widget__label {
    margin: 0 0 var(--size-3);
    font-family: var(--font-display);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .links a {
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-6);
    color: var(--brand-deep);
  }
  .links a:hover {
    color: var(--brand-teal);
  }
  @media (min-width: 800px) {
    .snapshot {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .glance {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 17rem;
    }
    .rail {
      position: sticky;
      top: calc(var(--header-h) + 1rem);
    }
    .glance {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
