---
import PlaceLayout from "../../layouts/PlaceLayout.astro";
import Corridor from "../../components/Corridor.astro";
import CategoriesInTown from "../../components/CategoriesInTown.astro";
import AreasInTown from "../../components/AreasInTown.astro";
import AtAGlance from "../../components/AtAGlance.astro";
import UpdatesModule from "../../components/UpdatesModule.astro";
import PhotoGrid from "../../components/PhotoGrid.astro";
import BusinessCard from "../../components/BusinessCard.astro";
import GuideCard from "../../components/GuideCard.astro";
import EventCard from "../../components/EventCard.astro";
import { isEnabled } from "../../config/flags";
import {
  businessesForTown,
  events,
  guides,
  photosFor,
  towns,
  updatesForTown,
} from "../../data/catalog";
import type { Town } from "../../data/types";
import { href } from "../../lib/href";
import { townView } from "../../lib/town-view";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(towns, "town");
}

interface Props {
  item: Town;
}

const { item: town } = Astro.props;
const view = townView(town);
const townUpdates = updatesForTown(town.slug);
const photos = photosFor("town", town.slug);
const localBusinesses = businessesForTown(town.slug);
const townGuides = guides.filter((item) => item.townSlug === town.slug);
const townEvents = events.filter((item) => item.townSlug === town.slug);
---

<PlaceLayout
  title={`${town.name}: stay, eat, and beach on 30A`}
  description={town.summary}
  active="towns"
  browseTown={town.name}
  crumbs={[{ label: "Towns", path: "/towns" }, { label: town.name }]}
>
  <div class="container">
    <Corridor currentSlug={town.slug} />

    <section class="hero">
      <div class="hero-img img-placeholder" aria-hidden="true">{town.name.charAt(0)}</div>
      <div>
        <h1>{town.name}</h1>
        <p class="tagline">{view.tagline}</p>
        <p class="desc">{town.summary}</p>
      </div>
    </section>

    <AtAGlance town={view} />
    <CategoriesInTown townSlug={town.slug} townName={town.name} />
    <AreasInTown townSlug={town.slug} townName={town.name} />

    {
      localBusinesses.length > 0 && (
        <section>
          <h2 class="section-title">Local businesses in {town.name}</h2>
          <div class="grid cards">
            {localBusinesses.slice(0, 6).map((business) => (
              <BusinessCard business={business} />
            ))}
          </div>
          <p class="more">
            <a href={href(`/search?town=${town.slug}`)}>Browse all businesses</a>
          </p>
        </section>
      )
    }

    {
      isEnabled("guides") && townGuides.length > 0 && (
        <section>
          <h2 class="section-title">Guides for {town.name}</h2>
          <div class="grid tiles">
            {townGuides.map((guide) => (
              <GuideCard guide={guide} />
            ))}
          </div>
        </section>
      )
    }

    {
      isEnabled("events") && townEvents.length > 0 && (
        <section>
          <h2 class="section-title">Events in {town.name}</h2>
          <div class="grid tiles">
            {townEvents.map((event) => (
              <EventCard event={event} />
            ))}
          </div>
        </section>
      )
    }

    <section>
      <h2 class="section-title">Photos</h2>
      <PhotoGrid photos={photos} empty={`No ${town.name} photos yet.`} />
    </section>

    {isEnabled("updates") && <UpdatesModule title={`Updates in ${town.name}`} updates={townUpdates} />}
  </div>
</PlaceLayout>

<style>
  .hero {
    display: flex;
    gap: var(--size-6);
    align-items: center;
    padding-block: var(--size-6);
  }
  .hero-img {
    width: 180px;
    height: 180px;
    border-radius: var(--radius-card);
    flex-shrink: 0;
    font-size: var(--font-size-8);
  }
  .tagline {
    font-weight: var(--font-weight-6);
    color: var(--brand-teal);
    margin-bottom: var(--size-1);
  }
  .desc {
    color: var(--brand-ink-soft);
    max-width: 64ch;
  }
  .grid {
    display: grid;
    gap: var(--size-4);
  }
  .cards {
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  }
  .tiles {
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .more {
    margin-top: var(--size-4);
  }
  @media (max-width: 640px) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
