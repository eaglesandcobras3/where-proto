---
import PlaceLayout from "../../../layouts/PlaceLayout.astro";
import TwoPaneMap from "../../../components/TwoPaneMap.astro";
import Corridor from "../../../components/Corridor.astro";
import FilterBar from "../../../components/islands/FilterBar.svelte";
import {
  allLeaves,
  businesses,
  categories,
  guides,
  tags,
  towns,
} from "../../../data/catalog";
import GuideCard from "../../../components/GuideCard.astro";
import type { Category, CategoryLeaf, Town } from "../../../data/types";
import { href } from "../../../lib/href";
import { toFilterBusiness } from "../../../lib/listing";

type LeafWithGroup = CategoryLeaf & { groupSlug: string; groupName: string };

export function getStaticPaths() {
  return towns.flatMap((town) => [
    ...categories.map((group) => ({
      params: { town: town.slug, category: group.slug },
      props: { town, group, leaf: null as LeafWithGroup | null, showAll: true },
    })),
    ...allLeaves().map((leaf) => {
      const group = categories.find((item) => item.slug === leaf.groupSlug) ?? categories[0];
      return {
        params: { town: town.slug, category: leaf.slug },
        props: { town, group, leaf, showAll: false },
      };
    }),
  ]);
}

interface Props {
  town: Town;
  group: Category;
  leaf: LeafWithGroup | null;
  showAll: boolean;
}

const { town, group, leaf, showAll } = Astro.props;
const groupListings = businesses.filter(
  (item) => item.townSlug === town.slug && item.categorySlug === group.slug,
);
const leafCounts = group.leaves
  .map((item) => ({
    ...item,
    count: groupListings.filter((listing) => listing.leafSlug === item.slug).length,
  }))
  .filter((item) => item.count > 0);
const displayListings = showAll ? groupListings : groupListings.filter((item) => item.leafSlug === leaf?.slug);
const filterCategories = [
  { slug: group.slug, name: group.name },
  ...group.leaves.map((item) => ({ slug: item.slug, name: item.name })),
];
const moreCategories = categories.filter((item) => item.slug !== group.slug);
const relatedGuides = guides.filter(
  (item) => item.categorySlug === group.slug || item.townSlug === town.slug,
);
const base = import.meta.env.BASE_URL;
const searchHref = href(`/search?town=${town.slug}&category=${leaf?.slug ?? group.slug}`);
---

<PlaceLayout
  title={`${group.name} in ${town.name}`}
  description={`Find ${group.name.toLowerCase()} in ${town.name}, Florida.`}
  active="towns"
  showBrowse
  browseTown={town.name}
  browseCategory={leaf?.name ?? group.name}
  browseExpanded
  crumbs={[
    { label: "Towns", path: "/towns" },
    { label: town.name, path: `/town/${town.slug}` },
    { label: leaf?.name ?? group.name },
  ]}
>
  <TwoPaneMap mapLabel={`${town.name} map`} pinCount={Math.max(6, displayListings.length * 2)}>
    <Corridor currentSlug={town.slug} />

    <h1>{leaf?.name ?? group.name} in {town.name}</h1>

    <div class="chips">
      <a class="chip active" href={href(`/town/${town.slug}`)}>
        {town.name} <span aria-hidden="true">&times;</span>
      </a>
      <a class="chip active" href={href(`/town/${town.slug}`)}>
        {group.name} <span aria-hidden="true">&times;</span>
      </a>
    </div>

    {
      leafCounts.length > 0 && (
        <section>
          <p class="eyebrow">Types of {group.name.toLowerCase()} in {town.name}</p>
          <div class="chips">
            <a class:list={["chip", showAll && "active"]} href={href(`/town/${town.slug}/${group.slug}`)}>
              All ({groupListings.length})
            </a>
            {leafCounts.map((item) => (
              <a
                class:list={["chip", !showAll && item.slug === leaf?.slug && "active"]}
                href={href(`/town/${town.slug}/${item.slug}`)}
              >
                {item.name} ({item.count})
              </a>
            ))}
          </div>
        </section>
      )
    }

    <FilterBar
      businesses={displayListings.map(toFilterBusiness)}
      towns={towns}
      categories={filterCategories}
      tags={tags}
      initialTown={town.slug}
      initialCategory={leaf?.slug ?? group.slug}
      base={base}
      searchHref={searchHref}
      totalCount={groupListings.length}
      client:load
    />

    {
      moreCategories.length > 0 && (
        <section>
          <h2 class="section-title">More categories in {town.name}</h2>
          <div class="chips">
            {moreCategories.map((item) => (
              <a class="chip" href={href(`/town/${town.slug}/${item.slug}`)}>
                {item.name}
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      relatedGuides.length > 0 && (
        <section>
          <h2 class="section-title">Guides for {group.name}</h2>
          <div class="listing-grid-split">
            {relatedGuides.map((guide) => (
              <GuideCard guide={guide} />
            ))}
          </div>
        </section>
      )
    }
  </TwoPaneMap>
</PlaceLayout>

<style>
  h1 {
    font-size: var(--font-size-6);
    margin-top: var(--size-4);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2);
    margin-block: var(--size-3);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--size-2);
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-4);
    padding: var(--size-1) var(--size-3);
    background: white;
    color: var(--brand-ink);
    font-size: var(--font-size-1);
  }
  .chip:hover {
    text-decoration: none;
    border-color: var(--brand-teal);
  }
  .chip.active {
    border-color: var(--brand-teal);
  }
</style>
