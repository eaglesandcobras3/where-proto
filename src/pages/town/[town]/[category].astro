---
import { allLeaves, categories, towns } from "../../../data/catalog";
import { href } from "../../../lib/href";
import { businessCategoryPath } from "../../../lib/listing";
import type { Town } from "../../../data/types";

export function getStaticPaths() {
  const reserved = new Set(["stay", "business"]);
  return towns.flatMap((town) => [
    ...categories
      .filter((group) => !reserved.has(group.slug))
      .map((group) => ({
        params: { town: town.slug, category: group.slug },
        props: { town, category: group.slug },
      })),
    ...allLeaves()
      .filter((leaf) => !reserved.has(leaf.slug) && leaf.groupSlug !== "stay")
      .map((leaf) => ({
        params: { town: town.slug, category: leaf.slug },
        props: { town, category: leaf.slug },
      })),
  ]);
}

interface Props {
  town: Town;
  category: string;
}

const { town, category } = Astro.props;
return Astro.redirect(href(businessCategoryPath(town.slug, category)), 301);
---
