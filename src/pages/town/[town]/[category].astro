---
import ProtoLayout from "../../../layouts/ProtoLayout.astro";
import TwoPaneMap from "../../../components/proto/TwoPaneMap.astro";
import {
  allLeaves,
  businesses,
  categories,
  leafBySlug,
  listingMeta,
  towns,
} from "../../../data/catalog";
import type { Town } from "../../../data/types";
import { href } from "../../../lib/href";

export function getStaticPaths() {
  return towns.flatMap((town) =>
    allLeaves().map((leaf) => ({
      params: { town: town.slug, category: leaf.slug },
      props: { town, leaf },
    })),
  );
}

interface Props {
  town: Town;
  leaf: ReturnType<typeof allLeaves>[number];
}

const { town, leaf } = Astro.props;
const group = categories.find((item) => item.slug === leaf.groupSlug) ?? categories[0];

const groupListings = businesses.filter(
  (item) => item.townSlug === town.slug && item.categorySlug === group.slug,
);

const leafCounts = group.leaves
  .map((item) => ({
    ...item,
    count: groupListings.filter((listing) => listing.leafSlug === item.slug).length,
  }))
  .filter((item) => item.count > 0);

const listings = groupListings.filter((item) => item.leafSlug === leaf.slug);
const displayListings = listings.length > 0 ? listings : groupListings;

const currentIndex = towns.findIndex((item) => item.slug === town.slug);
---

<ProtoLayout
  title={`${group.name} in ${town.name}`}
  activeNav="towns"
  headerTone="light"
  filterTown={town.name}
  filterCategory={group.name}
  filterGroup={group.name}
  filterSubcategory="All in selected group"
  filterExpanded={true}
>
  <TwoPaneMap mapLabel={`${town.name} map`} pinCount={Math.max(6, displayListings.length * 2)}>
    <section class="corridor" aria-label="The 30A corridor">
      <p class="corridor__label">The 30A Corridor</p>
      <div class="corridor__track">
        {
          towns.map((item, index) => {
            const here = item.slug === town.slug;
            const delta = index - currentIndex;
            const meta = here
              ? "Town hub"
              : delta < 0
                ? `${Math.abs(delta)} west`
                : `${delta} east`;
            return (
              <a
                class="corridor__item"
                href={href(`/town/${item.slug}`)}
                aria-current={here ? "true" : undefined}
              >
                <div class="corridor__dot">{here ? "●" : ""}</div>
                <p class="corridor__name">{item.name}</p>
                <p class="corridor__meta">{meta}</p>
              </a>
            );
          })
        }
      </div>
    </section>

    <section class="listing-head">
      <h1 class="listing-head__title">
        {group.name} in {town.name}
      </h1>
      <div class="pill-row">
        <span class="pill pill--active">
          {town.name} <span aria-hidden="true">×</span>
        </span>
        <span class="pill pill--active">
          {group.name} <span aria-hidden="true">×</span>
        </span>
      </div>
    </section>

    {
      leafCounts.length > 0 && (
        <section>
          <p class="section-label">Types of {group.name} in {town.name}</p>
          <div class="pill-row">
            {leafCounts.map((item) => (
              <a
                class:list={["pill", item.slug === leaf.slug && "pill--active"]}
                href={href(`/town/${town.slug}/${item.slug}`)}
              >
                {item.name} ({item.count})
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="biz-grid" aria-label="Business listings">
      {
        displayListings.map((item) => (
          <article class="biz-card">
            <div class="biz-card__media" role="img" aria-label={`${item.name} photo placeholder`}></div>
            <div class="biz-card__body">
              <h2 class="biz-card__title">{item.name}</h2>
              <p class="biz-card__town">{town.name}</p>
              <p class="biz-card__meta">
                {(leafBySlug(item.leafSlug)?.name ?? leaf.name)} in {town.name}
              </p>
              <p class="biz-card__summary">{item.summary || listingMeta(item)}</p>
              <a class="biz-card__link" href={href(`/business/${item.slug}`)}>
                Explore →
              </a>
            </div>
          </article>
        ))
      }
    </section>

    {
      displayListings.length === 0 && (
        <p class="listing-empty">No listings in this combo yet.</p>
      )
    }
  </TwoPaneMap>
</ProtoLayout>
