---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AuthForm from "../../components/islands/AuthForm.svelte";
import { href } from "../../lib/href";
---

<BaseLayout title="Reset password">
  <div class="container section">
    <h1>Forgot password</h1>
    <AuthForm
      mode="forgot"
      loginHref={href("/auth/login")}
      signupHref={href("/auth/signup")}
      forgotHref={href("/auth/forgot-password")}
      client:load
    />
  </div>
</BaseLayout>
