---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import AddBusinessFlow from "../components/islands/AddBusinessFlow.svelte";
import { isEnabled } from "../config/flags";
import { businesses, categories, towns } from "../data/catalog";
import { href } from "../lib/href";

const listings = businesses.map((biz) => ({
  slug: biz.slug,
  name: biz.name,
  townSlug: biz.townSlug,
  summary: biz.summary,
  ownerUserSlug: biz.ownerUserSlug,
  entityKind: biz.entityKind ?? (biz.isStay ? ("stay" as const) : ("business" as const)),
}));

const seedBusinesses = businesses.map((biz) => ({
  slug: biz.slug,
  name: biz.name,
  townSlug: biz.townSlug,
  summary: biz.summary,
  ownerUserSlug: biz.ownerUserSlug,
  entityKind: biz.entityKind ?? (biz.isStay ? ("stay" as const) : ("business" as const)),
  isStay: biz.isStay,
}));
---

<BaseLayout title="Add your business" description="Add a new listing, claim one already on WhereTo30A, or attach a rental property.">
  <div class="container section add-page">
    <header class="page-head">
      <Breadcrumbs onDark={false} />
      <p class="eyebrow">Add a business or stay</p>
      <h1>Add your business</h1>
      <p>
        One form, three jobs. Add somewhere new, claim a listing that’s already live, or attach a
        rental property. All of it attaches to the account you’re already signed in with.
      </p>
    </header>
    {
      isEnabled("addBusiness") && (
        <AddBusinessFlow
          towns={towns.map(({ slug, name }) => ({ slug, name }))}
          categories={categories.map(({ slug, name }) => ({ slug, name }))}
          listings={listings}
          seedBusinesses={seedBusinesses}
          dashboardHref={href("/dashboard")}
          merchantsHref={href("/merchants")}
          client:load
        />
      )
    }
  </div>
</BaseLayout>

<style>
  .add-page {
    max-width: 70rem;
  }
  .page-head {
    max-width: 42rem;
    margin-bottom: var(--size-5);
  }
  .eyebrow {
    margin: 0 0 0.5rem;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-teal);
  }
  h1 {
    margin: 0;
    font-size: clamp(1.85rem, 3.5vw, 2.5rem);
    font-weight: var(--font-weight-8);
    color: var(--brand-deep);
    letter-spacing: -0.02em;
  }
  .page-head p:last-child {
    margin: 0.75rem 0 0;
    font-size: var(--font-size-2);
    color: var(--brand-ink-soft);
    line-height: 1.55;
  }
</style>
