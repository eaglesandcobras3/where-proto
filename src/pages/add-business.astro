---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import AddBusinessForm from "../components/islands/AddBusinessForm.svelte";
import { isEnabled } from "../config/flags";
import { categories, towns } from "../data/catalog";
---

<BaseLayout title="Add your business" description="List your 30A business on WhereTo30A.">
  <div class="container section form-page">
    <PageHeader
      title="Add your business"
      lede="Free to list. Every submission is reviewed before it goes live."
    />
    {isEnabled("addBusiness") && <AddBusinessForm towns={towns} categories={categories} client:load />}
  </div>
</BaseLayout>

<style>
  .form-page {
    max-width: 640px;
  }
</style>
