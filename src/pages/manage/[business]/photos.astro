---
import Layout from "../../../layouts/Layout.astro";
import { photos } from "../../../data/catalog";
import type { Business } from "../../../data/types";
import { href } from "../../../lib/href";
import { ownedBusinessPaths } from "../../../lib/static-paths";

export function getStaticPaths() {
  return ownedBusinessPaths();
}

interface Props {
  business: Business;
}

const { business } = Astro.props;

const shots = photos.filter(
  (item) => item.attachedTo.type === "business" && item.attachedTo.slug === business.slug,
);
---

<Layout title={`Photos · ${business.name}`}>
  <p><a href={href(`/manage/${business.slug}`)}>Manage {business.name}</a></p>
  <h1>Photos</h1>
  <ul>
    {shots.map((item) => (
      <li>{item.caption}</li>
    ))}
  </ul>
  <form>
    <label>
      Caption
      <input type="text" name="caption" />
    </label>
    <button type="button">Upload placeholder</button>
  </form>
</Layout>
