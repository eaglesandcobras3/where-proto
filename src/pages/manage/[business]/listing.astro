---
import Layout from "../../../layouts/Layout.astro";
import { businessBySlug, businesses } from "../../../data/catalog";
import { href } from "../../../lib/href";

export function getStaticPaths() {
  return businesses
    .filter((item) => item.ownerUserSlug)
    .map((item) => ({ params: { business: item.slug } }));
}

const business = businessBySlug(Astro.params.business!);
if (!business) {
  throw new Error(`Missing business: ${Astro.params.business}`);
}
---

<Layout title={`Edit listing · ${business.name}`}>
  <p><a href={href(`/manage/${business.slug}`)}>Manage {business.name}</a></p>
  <h1>Edit listing</h1>
  <p>Placeholder for “anything manage my business.”</p>
  <form>
    <p>
      <label>
        Name
        <input type="text" name="name" value={business.name} />
      </label>
    </p>
    <p>
      <label>
        Summary
        <textarea name="summary">{business.summary}</textarea>
      </label>
    </p>
    <button type="button">Save draft</button>
  </form>
</Layout>
