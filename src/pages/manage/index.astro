---
import Layout from "../../layouts/Layout.astro";
import LinkList from "../../components/LinkList.astro";
import { businessesOwnedBy, currentUser, currentUserSlug } from "../../data/catalog";
import { href } from "../../lib/href";

const user = currentUser();
const owned = businessesOwnedBy("brett");
---

<Layout
  title="Business selector"
  note="Business management is still being defined. This is a selector stub plus the manage surfaces listed in the IA."
>
  <h1>Business management · selector</h1>
  <p>
    Signed-in user on this wireframe is {user?.name}. Owned businesses are attached to Brett so
    the selector has fake rows to click.
  </p>
  <LinkList
    items={owned.map((item) => ({
      href: href(`/manage/${item.slug}`),
      label: item.name,
      meta: item.summary,
    }))}
  />
  <p>Current user slug in fake session: {currentUserSlug}.</p>
</Layout>
