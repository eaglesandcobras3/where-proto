---
import Layout from "../../layouts/Layout.astro";
import Box from "../../components/Box.astro";
import { reviewQueue } from "../../data/catalog";
import { href } from "../../lib/href";
---

<Layout title="Review queue">
  <p><a href={href("/admin")}>Admin</a></p>
  <h1>Review queue</h1>
  <Box label="Pending items">
    <table>
      <thead>
        <tr>
          <th>Kind</th>
          <th>Target</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {
          reviewQueue.map((item) => (
            <tr>
              <td>{item.kind}</td>
              <td>{item.targetSlug}</td>
              <td>{item.status}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </Box>
</Layout>
