---
import Layout from "../../layouts/Layout.astro";
import { seoOverrides } from "../../data/catalog";
import { href } from "../../lib/href";
---

<Layout title="SEO overrides">
  <p><a href={href("/admin")}>Admin</a></p>
  <h1>SEO overrides</h1>
  <table>
    <thead>
      <tr>
        <th>Path</th>
        <th>Title</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {
        seoOverrides.map((item) => (
          <tr>
            <td>{item.path}</td>
            <td>{item.title}</td>
            <td>{item.description}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Layout>
