---
import Layout from "../../layouts/Layout.astro";
import { knowledge } from "../../data/catalog";
import { href } from "../../lib/href";
---

<Layout title="Knowledge">
  <p><a href={href("/admin")}>Admin</a></p>
  <h1>Knowledge</h1>
  <ul>
    {
      knowledge.map((item) => (
        <li>
          <strong>{item.title}</strong> — {item.body}
        </li>
      ))
    }
  </ul>
</Layout>
