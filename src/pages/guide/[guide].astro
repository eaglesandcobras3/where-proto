---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntityText from "../../components/EntityText.astro";
import ReactionBar from "../../components/ReactionBar.astro";
import EntityGallery from "../../components/EntityGallery.astro";
import CommunityQA from "../../components/CommunityQA.astro";
import RelatedGuides from "../../components/RelatedGuides.astro";
import HappeningHere from "../../components/HappeningHere.astro";
import ExploreLinks from "../../components/ExploreLinks.astro";
import GuideSaveSpots from "../../components/islands/GuideSaveSpots.svelte";
import { businessesForTown, commentsFor, events, guides, photosFor, reactionsFor, townBySlug } from "../../data/catalog";
import type { Guide } from "../../data/types";
import SaveShare from "../../components/islands/SaveShare.svelte";
import AskReplyComposer from "../../components/islands/AskReplyComposer.svelte";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(guides, "guide");
}

interface Props {
  item: Guide;
}

const { item: guide } = Astro.props;
const town = guide.townSlug ? townBySlug(guide.townSlug) : undefined;
const comments = commentsFor("guide", guide.slug);
const reactions = reactionsFor("guide", guide.slug);
const related = guides.filter((item) => item.slug !== guide.slug).slice(0, 3);
const guidePhotos = photosFor("town", guide.townSlug ?? "");
const townEvents = guide.townSlug ? events.filter((item) => item.townSlug === guide.townSlug) : [];
const minutes = 5 + (guide.title.length % 8);
const isFeatured = guide.slug === "first-timers-guide";
const guideSpots = (town ? businessesForTown(town.slug) : []).slice(0, 6).map((biz) => ({
  slug: biz.slug,
  name: biz.name,
}));

const sections = [
  { id: "overview", label: "Town overview" },
  { id: "access", label: "Beach access" },
  { id: "getting-around", label: "Getting around" },
  { id: "checklist", label: "First-day checklist" },
];
---

<BaseLayout
  title={guide.title}
  description={guide.summary}
  active="guides"
  crumbs={[
    { label: "Guides", path: "/guides" },
    ...(town ? [{ label: town.name, path: `/town/${town.slug}` }] : []),
    { label: guide.title },
  ]}
>
  <div class="guide-page">
    <div class="container layout">
      <article class="article">
        <div class="badges">
          <span class="badge badge--teal">{town?.name ?? "All 30A Corridor"}</span>
          <span class="badge">First-Timers</span>
          {guide.categorySlug && <span class="badge">{guide.categorySlug.replaceAll("_", " ")}</span>}
        </div>

        <h1>{guide.title}</h1>
        <p class="lede">{guide.summary}</p>

        <div class="dossier">
          <div class="who">
            <span class="avatar" aria-hidden="true">{isFeatured ? "CD" : "ED"}</span>
            <div>
              <p class="name">
                {isFeatured ? "Capt. Dave" : "Local Editor"}
                <span class="verified">Verified Local</span>
              </p>
              <p class="meta">Published Oct 8, 2026 · {minutes} min read</p>
            </div>
          </div>
          <div class="actions">
            <SaveShare type="guide" slug={guide.slug} name={guide.title} href={href(`/guide/${guide.slug}`)} client:load />
          </div>
        </div>

        <div class="hero-media img-placeholder" aria-hidden="true">
          <div class="hero-media__caption">
            <span>Scenic Highway 30A</span>
            <p>{town ? `${town.name} and the surrounding corridor.` : "South Walton’s coastal towns along one scenic road."}</p>
          </div>
        </div>

        {
          isFeatured && (
            <div class="summary">
              <h2>The 60-Second First Timer Summary</h2>
              <div class="summary__grid">
                <p><strong>Not one single town:</strong> 30A links many distinct hamlets with different characters.</p>
                <p><strong>Beach access is nuanced:</strong> Prefer Walton County regional accesses with parking and lifeguards.</p>
                <p><strong>Golf carts are not universal:</strong> Some town centers restrict LSVs—check rules before renting.</p>
                <p><strong>Rent bikes early:</strong> The Timpoochee Trail is often calmer than peak car traffic.</p>
              </div>
            </div>
          )
        }

        <section class="section" id="overview">
          <div class="section__head">
            <span class="num">1</span>
            <h2>Understanding the corridor</h2>
          </div>
          <p><EntityText text={guide.body} /></p>
          {
            town && (
              <p>
                Related town: <a href={href(`/town/${town.slug}`)}>{town.name}</a>
              </p>
            )
          }
        </section>

        <section class="section" id="access">
          <div class="section__head">
            <span class="num">2</span>
            <h2>Beach access reality</h2>
          </div>
          <p>
            Stick to marked regional accesses when you need parking, restrooms, and seasonal lifeguards.
            Private dry-sand areas may be restricted even when the wet sand remains publicly walkable.
          </p>
          <div class="alert">
            <p class="alert__label">Walton County advisory</p>
            <p>
              Pack out chairs, tents, and towels before evening turtle-protection hours. Unattended gear can be cleared.
            </p>
          </div>
        </section>

        <section class="section" id="getting-around">
          <div class="section__head">
            <span class="num">3</span>
            <h2>Getting around without the stress</h2>
          </div>
          <p>
            Park once when you can, use the Timpoochee Trail for short hops, and treat golf carts as a town-by-town
            decision rather than a corridor-wide default.
          </p>
        </section>

        <section class="section" id="checklist">
          <div class="section__head">
            <span class="num">4</span>
            <h2>First-day checklist</h2>
          </div>
          <ul class="checklist">
            <li>Pick a home-base town before locking lodging</li>
            <li>Confirm beach access and parking for that stretch</li>
            <li>Check today’s beach flag before planning water time</li>
            <li>Ask locals about carts, bikes, and dinner waits</li>
          </ul>
        </section>

        <GuideSaveSpots spots={guideSpots} client:visible />
        <ReactionBar reactions={reactions} />

        {
          comments.length > 0 && (
            <section class="section">
              <h2>Comments</h2>
              {comments.map((item) => (
                <p class="comment">{item.body}</p>
              ))}
              <AskReplyComposer client:visible />
            </section>
          )
        }

        {
          comments.length === 0 && (
            <section class="section">
              <h2>Comments</h2>
              <AskReplyComposer client:visible />
            </section>
          )
        }

        
        <div>
          <EntityGallery photos={guidePhotos} fallbackName={guide.title} />
          <HappeningHere events={townEvents} placeName={town?.name ?? "30A"} townSlug={guide.townSlug} />
          <CommunityQA
            question={`What should first-timers take from “${guide.title}”?`}
            answer="Start with a town, not a hotel dump. Confirm beach access, carts, and dinner waits before you lock the day."
          />
          <RelatedGuides guides={related} />
          <section class="section">
            <h2>Similar nearby</h2>
            <ul class="related">
              {related.map((item) => (
                <li>
                  <a href={href(`/guide/${item.slug}`)}>{item.title}</a>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </article>

      <aside class="rail">
        
        <div>
          <section class="widget">
            <p class="widget__label">Location</p>
            <p>{town?.name ?? "Scenic 30A"}</p>
          </section>
          <section class="widget cta">
            <p class="widget__label">Download sheet</p>
            <p class="cta__copy">Flags, LSV rules, and top accesses on one page.</p>
            <a class="cta__btn" href={href("/guides")}>Download sheet</a>
          </section>
          <ExploreLinks current="guides" townSlug={guide.townSlug} />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .guide-page {
    background: var(--brand-sand);
    color: var(--brand-ink);
  }
  .layout {
    display: grid;
    gap: var(--size-5);
    padding-block: var(--size-6) var(--size-10);
    align-items: start;
  }
  .article {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-card);
    padding: clamp(1.25rem, 3vw, 2rem);
    min-width: 0;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: var(--size-4);
  }
  .badge {
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-2);
    background: var(--brand-sand-dark);
    border: 1px solid var(--brand-line);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-6);
    color: var(--brand-ink);
    text-transform: capitalize;
  }
  .badge--teal {
    background: var(--brand-teal-soft);
    border-color: var(--mint);
    color: var(--brand-coral);
  }
  h1 {
    margin: 0 0 var(--size-3);
    font-size: clamp(1.75rem, 4vw, 2rem);
    color: var(--brand-deep);
    letter-spacing: -0.02em;
  }
  .lede {
    margin: 0 0 var(--size-5);
    font-size: var(--font-size-2);
    color: var(--brand-ink-soft);
    line-height: 1.6;
  }
  .dossier {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--size-3);
    align-items: center;
    padding: var(--size-4);
    margin-bottom: var(--size-5);
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-2);
    background: var(--brand-sand);
  }
  .who {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }
  .avatar {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--brand-deep);
    color: white;
    display: grid;
    place-items: center;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
  }
  .name {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .verified {
    font-size: 0.625rem;
    font-weight: var(--font-weight-7);
    color: var(--brand-coral);
    background: var(--brand-teal-soft);
    border-radius: 0.25rem;
    padding: 0.1rem 0.35rem;
  }
  .meta {
    margin: 0.15rem 0 0;
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  .actions {
    display: flex;
    gap: 0.5rem;
  }
  .actions button,
  .ghost {
    border: 1px solid var(--brand-line);
    background: white;
    border-radius: var(--radius-2);
    padding: 0.4rem 0.75rem;
    font: inherit;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-6);
    color: var(--brand-ink);
    cursor: pointer;
  }
  .hero-media {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-2);
    overflow: hidden;
    margin-bottom: var(--size-5);
    border: 1px solid var(--brand-line);
  }
  .hero-media__caption {
    position: absolute;
    inset: auto 0 0;
    padding: var(--size-4);
    background: linear-gradient(transparent, rgba(12, 35, 46, 0.9));
    color: white;
  }
  .hero-media__caption span {
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .hero-media__caption p {
    margin: 0.25rem 0 0;
    font-size: var(--font-size-1);
    color: var(--brand-line);
  }
  .summary {
    margin-bottom: var(--size-6);
    padding: var(--size-5);
    border-radius: var(--radius-2);
    background: var(--brand-teal-soft);
    border: 1px solid var(--mint);
  }
  .summary h2 {
    margin: 0 0 var(--size-3);
    font-size: var(--font-size-1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-deep);
  }
  .summary__grid {
    display: grid;
    gap: 0.65rem;
  }
  .summary__grid p {
    margin: 0;
    padding: 0.75rem;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--brand-teal-soft);
    border-radius: var(--radius-2);
    font-size: var(--font-size-1);
    color: var(--brand-ink);
  }
  .section {
    margin-bottom: var(--size-6);
    padding-bottom: var(--size-5);
    border-bottom: 1px solid var(--brand-line);
  }
  .section:last-of-type {
    border-bottom: 0;
  }
  .section__head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: var(--size-3);
  }
  .num {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--brand-deep);
    color: white;
    display: grid;
    place-items: center;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-8);
  }
  .section h2 {
    margin: 0;
    font-size: var(--font-size-4);
    color: var(--brand-deep);
  }
  .section p,
  .comment {
    font-size: var(--font-size-2);
    color: var(--brand-ink-soft);
    line-height: 1.65;
  }
  .alert {
    margin-top: var(--size-4);
    padding: var(--size-4);
    border-radius: var(--radius-2);
    background: var(--brand-teal-soft);
    border: 1px solid var(--brand-line);
    border-left: 4px solid var(--brand-sun);
  }
  .alert__label {
    margin: 0 0 0.35rem;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-8);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-coral);
  }
  .alert p:last-child {
    margin: 0;
    font-size: var(--font-size-1);
    color: var(--brand-coral);
  }
  .checklist {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.5rem;
    color: var(--brand-ink);
    font-size: var(--font-size-2);
  }
  .ask-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--size-3);
    align-items: center;
    margin-top: var(--size-5);
    padding: var(--size-5);
    border-radius: var(--radius-2);
    background: var(--brand-teal-soft);
    border: 1px solid var(--mint);
  }
  .ask-cta__title {
    margin: 0 0 0.25rem;
    font-family: var(--font-display);
    font-weight: var(--font-weight-7);
    color: var(--brand-deep);
  }
  .ask-cta p:last-child {
    margin: 0;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .ask-cta__btn,
  .cta__btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-2);
    background: var(--brand-deep);
    color: white;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
  }
  .ask-cta__btn:hover,
  .cta__btn:hover {
    background: var(--brand-teal);
    text-decoration: none;
  }
  .rail {
    display: grid;
    gap: var(--size-4);
  }
  .widget {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-card);
    padding: var(--size-4);
  }
  .widget__label {
    margin: 0 0 var(--size-3);
    font-family: var(--font-display);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .toc {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.55rem;
    font-size: var(--font-size-1);
  }
  .toc a {
    color: var(--brand-ink);
  }
  .toc a:hover {
    color: var(--brand-teal);
  }
  .author {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    margin-bottom: var(--size-3);
  }
  .author div {
    display: grid;
    gap: 0.1rem;
  }
  .author strong {
    color: var(--brand-deep);
    font-size: var(--font-size-1);
  }
  .author span {
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  .ghost {
    display: inline-flex;
    width: 100%;
    justify-content: center;
    text-decoration: none;
  }
  .ghost:hover {
    border-color: var(--brand-deep);
    text-decoration: none;
  }
  .cta__copy {
    margin: 0 0 var(--size-3);
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .related {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }
  .related a {
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-6);
    color: var(--brand-deep);
  }
  .related a:hover {
    color: var(--brand-teal);
  }
  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
    .rail {
      position: sticky;
      top: calc(var(--header-h) + 1rem);
    }
  }
</style>
