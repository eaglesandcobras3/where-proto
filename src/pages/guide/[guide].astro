---
import PlaceLayout from "../../layouts/PlaceLayout.astro";
import EntityText from "../../components/EntityText.astro";
import ReactionBar from "../../components/ReactionBar.astro";
import GuideCard from "../../components/GuideCard.astro";
import { commentsFor, guides, reactionsFor, townBySlug } from "../../data/catalog";
import type { Guide } from "../../data/types";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(guides, "guide");
}

interface Props {
  item: Guide;
}

const { item: guide } = Astro.props;
const town = guide.townSlug ? townBySlug(guide.townSlug) : undefined;
const comments = commentsFor("guide", guide.slug);
const reactions = reactionsFor("guide", guide.slug);
const related = guides.filter((item) => item.slug !== guide.slug).slice(0, 3);
---

<PlaceLayout
  title={guide.title}
  description={guide.summary}
  active="guides"
  showBrowse={false}
  crumbs={[{ label: "Guides", path: "/guides" }, { label: guide.title }]}
>
  <article class="container section article">
    <h1>{guide.title}</h1>
    <p class="byline">By a local editor · reading guide</p>
    <p class="lede">{guide.summary}</p>
    {town && (
      <p>
        Related town: <a href={href(`/town/${town.slug}`)}>{town.name}</a>
      </p>
    )}
    <p><EntityText text={guide.body} /></p>
    <ReactionBar reactions={reactions} />
    {
      comments.length > 0 && (
        <section>
          <h2 class="section-title">Comments</h2>
          {comments.map((item) => (
            <p class="comment">{item.body}</p>
          ))}
        </section>
      )
    }
    {
      related.length > 0 && (
        <section>
          <h2 class="section-title">Related guides</h2>
          <div class="listing-grid">
            {related.map((item) => (
              <GuideCard guide={item} />
            ))}
          </div>
        </section>
      )
    }
  </article>
</PlaceLayout>

<style>
  .article {
    max-width: 720px;
  }
  .lede {
    font-size: var(--font-size-3);
    color: var(--brand-ink-soft);
  }
  .byline,
  .comment {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
</style>
