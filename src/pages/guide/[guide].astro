---
import Layout from "../../layouts/Layout.astro";
import Box from "../../components/Box.astro";
import { commentsFor, guides, reactionsFor, townBySlug, userBySlug } from "../../data/catalog";
import type { Guide } from "../../data/types";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(guides, "guide");
}

interface Props {
  item: Guide;
}

const { item: guide } = Astro.props;
const town = guide.townSlug ? townBySlug(guide.townSlug) : undefined;
const guideComments = commentsFor("guide", guide.slug);
const guideReactions = reactionsFor("guide", guide.slug);
---

<Layout title={guide.title}>
  <p><a href={href("/guides")}>Guides</a></p>
  <h1>Guide: {guide.title}</h1>
  <p>{guide.summary}</p>
  {
    town && (
      <p>
        Related town: <a href={href(`/town/${town.slug}`)}>{town.name}</a>
      </p>
    )
  }

  <Box label="Body">
    <p>{guide.body}</p>
  </Box>

  <Box label="Reactions">
    {
      guideReactions.length === 0 ? (
        <p>No fake reactions on this guide.</p>
      ) : (
        <ul>
          {guideReactions.map((item) => (
            <li>
              {item.label}: {item.count}
            </li>
          ))}
        </ul>
      )
    }
  </Box>

  <Box label="Comments">
    {
      guideComments.length === 0 ? (
        <p>No fake comments on this guide.</p>
      ) : (
        <ul>
          {guideComments.map((item) => (
            <li>
              {item.body} — {userBySlug(item.authorUserSlug)?.name}
            </li>
          ))}
        </ul>
      )
    }
  </Box>
</Layout>
