---
import BaseLayout from "../layouts/BaseLayout.astro";
import { href } from "../lib/href";
---

<BaseLayout
  title="Connect"
  description="Explore WhereTo30A, add your business, or get in touch — the mobile link hub for South Walton."
  bare
>
  <div class="connect-page">
    <div class="hub">
      <div class="hero">
        <div class="hero__copy">
          <p class="pill">
            <span class="dot" aria-hidden="true"></span>
            Local Guide · South Walton, FL
          </p>
          <h1>WhereTo<span>30A</span></h1>
        </div>
      </div>

      <div class="body">
        <header class="intro">
          <h2>Helping people find the places and local businesses that make 30A special.</h2>
          <p>
            Explore towns, discover local favorites, and make your business easier to find. Everything you
            need along the corridor is right here.
          </p>
        </header>

        <div class="actions">
          <a class="primary" href={href("/")}>
            <span class="primary__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor">
                <circle cx="12" cy="12" r="9" stroke-width="2"></circle>
                <path d="M12 3v18M3 12h18" stroke-width="1.8"></path>
                <path d="M7.5 7.5l9 9M16.5 7.5l-9 9" stroke-width="1.8"></path>
              </svg>
            </span>
            <span class="primary__copy">
              <strong>Explore WhereTo30A</strong>
              <span>Towns, beaches, local picks &amp; stays</span>
            </span>
            <span class="primary__chev" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor">
                <path d="M9 5l7 7-7 7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>

          <div class="pair">
            <a class="card" href={href("/merchants")}>
              <span class="card__top">
                <span class="card__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                    <path
                      d="M3 9l2-5h14l2 5M3 9h18M3 9v10a1 1 0 001 1h16a1 1 0 001-1V9M9 20V13h6v7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                </span>
                <svg class="card__chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" aria-hidden="true">
                  <path d="M9 5l7 7-7 7" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <strong>For businesses</strong>
              <span>List free &amp; grow on WhereTo30A</span>
            </a>

            <a class="card" href={href("/about")}>
              <span class="card__top">
                <span class="card__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 8v.01M12 11v5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
                <svg class="card__chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" aria-hidden="true">
                  <path d="M9 5l7 7-7 7" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <strong>Our story</strong>
              <span>Why we built WhereTo30A</span>
            </a>
          </div>

          <div class="pair">
            <a class="util" href="mailto:hello@whereto30a.com">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
              Email us
            </a>
            <a class="util" href={href("/whereto30a.vcf")} download="WhereTo30A.vcf">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path
                  d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
              Save contact
            </a>
          </div>

          <aside class="quick">
            <p class="quick__label">
              <span class="quick__dot" aria-hidden="true"></span>
              Quick Intro
            </p>
            <p>
              WhereTo30A is a local guide that helps visitors and neighbors discover great places across 30A,
              while giving local businesses a direct way to be found.
            </p>
          </aside>
        </div>

        <footer class="foot">
          <p>
            Coast image via <a href={href("/about")}>The 30A Beach House</a>
          </p>
          <p>© 2026 WhereTo30A · South Walton, Florida</p>
        </footer>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  :global(body.bare-shell) {
    background: #f8f9ff;
  }
  :global(body.bare-shell main) {
    margin: 0;
    padding: 0;
    max-width: none;
  }
  .connect-page {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 0;
    background: #f8f9ff;
  }
  .hub {
    width: 100%;
    max-width: 27rem;
    min-height: 100vh;
    background: white;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 14rem;
    padding: 1.5rem;
    background: var(--brand-deep);
  }
  .hero__copy {
    width: 100%;
  }
  .pill {
    margin: 0 0 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(226, 232, 240, 0.8);
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-deep);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--brand-teal);
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2.35rem;
    font-weight: var(--font-weight-8);
    letter-spacing: -0.03em;
    color: white;
    line-height: 1.1;
  }
  h1 span {
    color: #85f6e5;
  }
  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1rem 1.5rem 2rem;
  }
  .intro {
    margin-bottom: 1.35rem;
  }
  h2 {
    margin: 0 0 0.65rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 4vw, 1.55rem);
    font-weight: var(--font-weight-8);
    color: var(--brand-deep);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .intro p {
    margin: 0;
    font-size: var(--font-size-1);
    line-height: 1.55;
    color: var(--brand-ink-soft);
  }
  .actions {
    display: grid;
    gap: 0.85rem;
  }
  .primary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    padding: 1rem;
    border-radius: 1rem;
    background: var(--brand-teal);
    color: white;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(0, 137, 123, 0.22);
  }
  .primary:hover {
    background: #007a6e;
    text-decoration: none;
    color: white;
  }
  .primary__icon,
  .primary__chev {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
  }
  .primary__icon {
    width: 2.75rem;
    height: 2.75rem;
  }
  .primary__chev {
    width: 1.75rem;
    height: 1.75rem;
  }
  .primary__copy {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
  }
  .primary__copy strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: var(--font-weight-8);
  }
  .primary__copy span {
    font-size: 0.8rem;
    color: rgba(236, 253, 245, 0.92);
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 7.9rem;
    padding: 1rem;
    border-radius: 1rem;
    border: 1px solid var(--brand-line);
    background: white;
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px -6px rgba(12, 35, 46, 0.08);
    text-decoration: none;
    color: inherit;
  }
  .card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.75rem;
  }
  .card__icon {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.75rem;
    display: grid;
    place-items: center;
    background: #e0f2f1;
    color: var(--brand-teal);
  }
  .card__chev {
    color: #94a3b8;
  }
  .card:hover .card__chev {
    color: var(--brand-deep);
  }
  .card strong {
    display: block;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: var(--font-weight-8);
    color: var(--brand-deep);
    line-height: 1.3;
  }
  .card > span:last-child {
    margin-top: 0.2rem;
    font-size: 0.75rem;
    color: var(--brand-ink-soft);
  }
  .util {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 3rem;
    border-radius: 0.75rem;
    border: 1px solid var(--brand-line);
    background: white;
    color: var(--brand-deep);
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
    text-decoration: none;
  }
  .util:hover {
    background: #f8fafc;
    text-decoration: none;
  }
  .util svg {
    color: var(--brand-teal);
  }
  .quick {
    margin-top: 0.25rem;
    padding: 1.15rem 1.2rem;
    border-radius: 1rem;
    border: 1px solid rgba(226, 232, 240, 0.9);
    background: #f4f7f6;
  }
  .quick__label {
    margin: 0 0 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #dc2626;
  }
  .quick__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #ef4444;
  }
  .quick p:last-child {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--brand-ink-soft);
  }
  .foot {
    margin-top: auto;
    padding-top: 1.5rem;
    text-align: center;
    border-top: 1px solid rgba(226, 232, 240, 0.8);
  }
  .foot p {
    margin: 0;
    font-size: 0.75rem;
    color: #94a3b8;
  }
  .foot p + p {
    margin-top: 0.35rem;
    font-size: 0.6875rem;
  }
  .foot a {
    color: var(--brand-deep);
    text-decoration: underline;
  }
  .foot a:hover {
    color: var(--brand-teal);
  }
  @media (min-width: 520px) {
    .connect-page {
      padding: 2rem 1rem;
    }
    .hub {
      min-height: 0;
      border-radius: 2.25rem;
      border: 1px solid rgba(226, 232, 240, 0.85);
      box-shadow: 0 20px 50px rgba(12, 35, 46, 0.08);
    }
  }
</style>
