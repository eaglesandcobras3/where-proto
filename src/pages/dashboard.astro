---
import BaseLayout from "../layouts/BaseLayout.astro";
import BusinessesPanel from "../components/islands/BusinessesPanel.svelte";
import ShareUpdateForm from "../components/islands/ShareUpdateForm.svelte";
import { areas, businesses, towns } from "../data/catalog";
import { href } from "../lib/href";

const seedBusinesses = businesses.map((biz) => ({
  slug: biz.slug,
  name: biz.name,
  townSlug: biz.townSlug,
  summary: biz.summary,
  ownerUserSlug: biz.ownerUserSlug,
  entityKind: biz.entityKind ?? (biz.isStay ? ("stay" as const) : ("business" as const)),
  isStay: biz.isStay,
}));

const townNames = Object.fromEntries(towns.map((town) => [town.slug, town.name]));
const areaNames = Object.fromEntries(areas.map((area) => [area.slug, area.name]));
---

<BaseLayout
  title="Manage business"
  description="Your businesses on WhereTo30A — add, claim, or open a dashboard."
  active="dashboard"
>
  <div class="container section dash">
    <ShareUpdateForm townNames={townNames} areaNames={areaNames} client:load />
    <BusinessesPanel
      seedBusinesses={seedBusinesses}
      townNames={townNames}
      merchantsHref={href("/merchants")}
      addHref={href("/add-business")}
      dashboardRoot={href("/dashboard").replace(/\/$/, "")}
      variant="page"
      client:load
    />
  </div>
</BaseLayout>

<style>
  .dash {
    max-width: 70rem;
  }
</style>
