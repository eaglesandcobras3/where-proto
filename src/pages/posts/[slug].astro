---
import Layout from "../../layouts/Layout.astro";
import { businessBySlug, postBySlug, posts, townBySlug, userBySlug } from "../../data/catalog";
import { href } from "../../lib/href";

export function getStaticPaths() {
  return posts.map((item) => ({ params: { slug: item.slug } }));
}

const post = postBySlug(Astro.params.slug!);
if (!post) {
  throw new Error(`Missing post: ${Astro.params.slug}`);
}

const user = post.authorUserSlug ? userBySlug(post.authorUserSlug) : undefined;
const business = post.authorBusinessSlug ? businessBySlug(post.authorBusinessSlug) : undefined;
const target =
  post.on.type === "town" ? townBySlug(post.on.slug) : businessBySlug(post.on.slug);
const targetHref =
  post.on.type === "town" ? href(`/towns/${post.on.slug}`) : href(`/business/${post.on.slug}`);
---

<Layout title="Post">
  <h1>Post</h1>
  <p>{post.body}</p>
  <ul>
    <li>Posted as: {post.postedAs}</li>
    <li>Created: {post.createdAt}</li>
    {
      user && (
        <li>
          User: <a href={href(`/u/${user.slug}`)}>{user.name}</a>
        </li>
      )
    }
    {
      business && (
        <li>
          Business: <a href={href(`/business/${business.slug}`)}>{business.name}</a>
        </li>
      )
    }
    {
      target && (
        <li>
          On {post.on.type}: <a href={targetHref}>{"name" in target ? target.name : post.on.slug}</a>
        </li>
      )
    }
  </ul>
</Layout>
