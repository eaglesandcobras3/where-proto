---
import PlaceLayout from "../../layouts/PlaceLayout.astro";
import AskReplyComposer from "../../components/islands/AskReplyComposer.svelte";
import ReactionBar from "../../components/ReactionBar.astro";
import {
  businessBySlug,
  commentsFor,
  photosFor,
  posts,
  reactionsFor,
  userBySlug,
} from "../../data/catalog";
import type { Post } from "../../data/types";
import { href } from "../../lib/href";
import { cardImageSrc } from "../../lib/card-image";
import { formatDate, userHandle } from "../../lib/labels";
import { businessPath, postPlace } from "../../lib/listing";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(posts, "post");
}

interface Props {
  item: Post;
}

const { item: post } = Astro.props;
const user = post.authorUserSlug ? userBySlug(post.authorUserSlug) : undefined;
const business = post.authorBusinessSlug ? businessBySlug(post.authorBusinessSlug) : undefined;
const place = postPlace(post);
const shots = photosFor("post", post.slug);
const postComments = commentsFor("post", post.slug);
const postReactions = reactionsFor("post", post.slug);
---

<PlaceLayout
  title="Community post"
  description={post.body}
  showBrowse={false}
  crumbs={[{ label: "Ask", path: "/ask" }, { label: "Post" }]}
>
  <article class="container section article">
    <h1>Post</h1>
    <p>{post.body}</p>
    <p class="meta">
      Posted {formatDate(post.createdAt)}
      {
        user && (
          <>
            {" by "}
            <a href={href(`/u/${user.slug}`)}>{userHandle(user.slug)}</a>
          </>
        )
      }
      {
        business && (
          <>
            {" from "}
            <a href={href(businessPath(business))}>{business.name}</a>
          </>
        )
      }
      <>
        {" on "}
        <a href={href(place.href)}>{place.name}</a>
      </>
    </p>
    {
      shots.length > 0 && (
        <div class="shots">
          {shots.map((photo) => (
            <figure>
              <img
                src={cardImageSrc(photo.caption.charAt(0), "4/3")}
                alt={photo.caption}
                width="400"
                height="300"
              />
              <figcaption>
                <span class="badge">Community</span>
                {photo.caption}
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }
    <ReactionBar reactions={postReactions} />
    {
      postComments.map((item) => (
        <p class="comment">
          {item.body} · {userBySlug(item.authorUserSlug) ? userHandle(item.authorUserSlug) : "a visitor"}
        </p>
      ))
    }
    <AskReplyComposer client:visible />
  </article>
</PlaceLayout>

<style>
  .article {
    max-width: 720px;
  }
  .meta,
  .comment {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .shots {
    display: flex;
    gap: 0.65rem;
    overflow-x: auto;
    margin: var(--size-4) 0;
  }
  figure {
    margin: 0;
    flex: 0 0 10rem;
  }
  img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-2);
    background: var(--brand-sand-dark);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.35rem;
    font-size: var(--font-size-0);
    color: var(--brand-ink-soft);
  }
  .badge {
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--brand-teal-soft);
    color: var(--brand-deep);
    font-weight: var(--font-weight-8);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.5625rem;
  }
</style>
