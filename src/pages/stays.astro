---
import Layout from "../layouts/Layout.astro";
import LinkList from "../components/LinkList.astro";
import Box from "../components/Box.astro";
import { stays, townBySlug } from "../data/catalog";
import { href } from "../lib/href";
---

<Layout title="Stays" note="Ship-dark. Route exists; product is not launched.">
  <h1>Stays</h1>
  <Box label="Stay listings">
    <LinkList
      items={stays.map((item) => ({
        href: href(`/stay/${item.slug}`),
        label: item.name,
        meta: `${townBySlug(item.townSlug)?.name ?? item.townSlug} · sleeps ${item.sleeps}`,
      }))}
    />
  </Box>
</Layout>
