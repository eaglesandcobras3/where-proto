---
import BaseLayout from "../layouts/BaseLayout.astro";
import InteriorHero from "../components/InteriorHero.astro";
import TwoPaneMap from "../components/TwoPaneMap.astro";
import StaysList from "../components/islands/StaysList.svelte";
import ListingFilters from "../components/islands/ListingFilters.svelte";
import ListingRail from "../components/ListingRail.astro";
import { parsePriceValue, townCountsFor } from "../lib/unified-layout";
import { isEnabled } from "../config/flags";
import { stays, towns } from "../data/catalog";
import { href } from "../lib/href";
import { stayPath } from "../lib/listing";
import { markersFromNames, withoutViewMap, withViewMap } from "../lib/map-markers";

const params = Astro.url.searchParams;
const town = params.get("town") ?? "";
const guests = params.get("guests") ?? "";
const kind = params.get("kind") ?? "";
const q = params.get("q") ?? "";
const mapView = params.get("view") === "map";
const base = import.meta.env.BASE_URL;
const searchQs = Astro.url.search;
const mapHref = withViewMap("/stays", searchQs);
const gridHref = withoutViewMap("/stays", searchQs);

const guestOptions = [
  { slug: "2", name: "Sleeps 2+" },
  { slug: "4", name: "Sleeps 4+" },
  { slug: "6", name: "Sleeps 6+" },
  { slug: "8", name: "Sleeps 8+" },
];

const lodgingTypes = [
  { slug: "inn", name: "Luxury Boutique Inns" },
  { slug: "cottage", name: "Beachfront Cottages & Houses" },
  { slug: "villa", name: "Private Courtyard Villas" },
];

const amenities = [
  { slug: "lsv", name: "Street-Legal Golf Cart (LSV)" },
  { slug: "pool", name: "Private Pool or Gulf Views" },
  { slug: "boardwalk", name: "Private Boardwalk Beach Access" },
  { slug: "pets", name: "Pet-Friendly Seaside Haven" },
];

const metaFor = (slug: string) => {
  if (slug.includes("pearl") || slug.includes("inn")) {
    return {
      kind: "inn" as const,
      badge: "Signature Boutique Inn",
      vibe: "Couples & Adults",
      fromPrice: "From $540/night",
      roomsLabel: "Suites & rooms",
    };
  }
  if (slug.includes("cottage")) {
    return {
      kind: "cottage" as const,
      badge: "Beach Cottage",
      vibe: "Families",
      fromPrice: "From $385/night",
      roomsLabel: "Whole-home rental",
    };
  }
  return {
    kind: "villa" as const,
    badge: "Coastal Stay",
    vibe: "Groups",
    fromPrice: "From $420/night",
    roomsLabel: "Private residence",
  };
};

const stayItems = stays.map((stay) => {
  const meta = metaFor(stay.slug);
  return {
    slug: stay.slug,
    name: stay.name,
    town: stay.townSlug,
    townName: towns.find((item) => item.slug === stay.townSlug)?.name ?? stay.townSlug,
    summary: stay.summary,
    sleeps: stay.sleeps,
    href: stayPath(stay),
    ...meta,
    priceValue: parsePriceValue(meta.fromPrice),
  };
});

const townCounts = towns
  .map((item) => ({
    slug: item.slug,
    name: item.name,
    count: stays.filter((stay) => stay.townSlug === item.slug).length,
  }))
  .filter((item) => item.count > 0);
const allTownCounts = townCountsFor(towns, stays, (stay) => stay.townSlug);
const lodgingCounts = lodgingTypes.map((item) => ({
  ...item,
  count: stayItems.filter((stay) => stay.kind === item.slug).length,
}));
const amenityCounts = amenities.map((item) => ({
  ...item,
  count: stayItems.filter((stay) => {
    if (item.slug === "lsv") return stay.sleeps >= 6;
    if (item.slug === "pool") return /inn|pearl|watercolor/i.test(stay.name);
    if (item.slug === "boardwalk") return stay.kind !== "inn";
    if (item.slug === "pets") return stay.kind === "cottage" || stay.sleeps >= 6;
    return false;
  }).length,
}));

const exploreTowns = towns.map(({ slug, name }) => ({ slug, name }));
const mapMarkers = markersFromNames(
  stayItems.map((stay) => ({
    name: stay.name,
    href: href(stayPath(stay)),
    detail: `${stay.townName} · ${stay.fromPrice}`,
  })),
);
---

<BaseLayout
  title="30A Stays & Vacation Rentals"
  description="Curated boutique inns, cottages, and vacation rentals along Scenic Highway 30A."
  active="stays"
>
  <div class="stays-page">
    <InteriorHero
      title="30A Stays & Vacation Rentals"
      lede="Boutique inns, walkable cottages, and direct-book homes inspected for the corridor — filtered by town, guests, and how you want to move around."
      crumbs={[{ label: "Stays" }]}
    />

    {
      mapView ? (
        <TwoPaneMap
          mapLabel="30A stays map"
          resultLabel={`${stays.length} Stays along Scenic 30A`}
          gridHref={href(gridHref)}
          markers={mapMarkers}
          searchArea
        >
          {isEnabled("stays") ? (
            <StaysList
              stays={stayItems}
              initialTown={town}
              initialGuests={guests}
              initialKind={kind}
              initialQuery={q}
              base={base}
              client:load
            />
          ) : (
            <p class="note">Stays are reserved for the real build.</p>
          )}
        </TwoPaneMap>
      ) : (
        <div class="container layout">
          <div class="filters-col">
            
            <div>
              <ListingFilters
                surface="stays"
                eventName="w30a:stays-filters"
                extraSearch="guests"
                guestOptions={guestOptions}
                initialGuests={guests}
                initialQuery={q}
                towns={allTownCounts}
                initialTown={town}
                townTotal={stays.length}
                primaryLabel="Lodging type"
                primaryKey="kind"
                primaryOptions={lodgingCounts}
                initialPrimary={kind}
                tags={amenityCounts}
                tagsLabel="Amenities"
                tagsKey="amenity"
                note={{
                  label: "Walton County rules",
                  body: "Short-term rental parking and LSV ordinances are enforced. Beach gear must be cleared nightly under Leave No Trace.",
                }}
                client:load
              />
            </div>
          </div>

          {isEnabled("stays") ? (
            <StaysList
              stays={stayItems}
              initialTown={town}
              initialGuests={guests}
              initialKind={kind}
              initialQuery={q}
              base={base}
              client:load
            />
          ) : (
            <p class="note">Stays are reserved for the real build.</p>
          )}

          <aside class="rail">
            
            <div>
              <ListingRail mapTitle="Stays map" mapHref={mapHref} contributeKind="stay" current="stays">
                <section class="widget" slot="discovery">
                  <p class="widget__label">Concierge</p>
                  <p class="copy">
                    Book verified properties with clear town rules, walkability, and host notes — not
                    anonymous inventory dumps.
                  </p>
                </section>
              </ListingRail>
            </div>
          </aside>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .stays-page {
    background: var(--brand-sand);
    color: var(--brand-ink);
  }
  .layout {
    display: grid;
    gap: var(--size-5);
    padding-block: var(--size-6) var(--size-10);
    align-items: start;
  }
  .rail {
    display: none;
    gap: var(--size-4);
  }
  .widget {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-card);
    padding: var(--size-4);
  }
  .widget__label {
    margin: 0 0 var(--size-3);
    font-family: var(--font-display);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .copy {
    margin: 0;
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  .note {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: 15.5rem minmax(0, 1fr) 16.5rem;
    }
    .rail {
      display: grid;
    }
  }
</style>
