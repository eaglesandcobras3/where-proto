---
import BaseLayout from "../layouts/BaseLayout.astro";
import TwoPaneMap from "../components/TwoPaneMap.astro";
import StaysList from "../components/islands/StaysList.svelte";
import { isEnabled } from "../config/flags";
import { stays, towns } from "../data/catalog";

const params = Astro.url.searchParams;
const town = params.get("town") ?? "";
const guests = params.get("guests") ?? "";
const q = params.get("q") ?? "";
const townName = (slug: string) => towns.find((item) => item.slug === slug)?.name ?? slug;
const stayItems = stays.map((stay) => ({
  slug: stay.slug,
  name: stay.name,
  town: stay.townSlug,
  townName: townName(stay.townSlug),
  summary: stay.summary,
  sleeps: stay.sleeps,
}));
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Stays on 30A"
  description="Book direct with local 30A rental partners."
  active="stays"
  showStays
  staysTown={town}
  staysGuests={guests}
  staysQuery={q}
>
  <TwoPaneMap mapLabel="30A stays map" pinCount={Math.max(6, stays.length)} searchArea>
    {
      isEnabled("stays") ? (
        <StaysList
          stays={stayItems}
          initialTown={town}
          initialGuests={guests}
          initialQuery={q}
          base={base}
          client:load
        />
      ) : (
        <p class="note">Stays are reserved for the real build.</p>
      )
    }
  </TwoPaneMap>
</BaseLayout>

<style>
  .note {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
</style>
