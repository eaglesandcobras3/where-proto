---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import StayCard from "../components/StayCard.astro";
import { isEnabled } from "../config/flags";
import { stays } from "../data/catalog";
---

<BaseLayout title="Stays on 30A" description="Book direct with local 30A rental partners." active="stays">
  <div class="container section">
    <PageHeader
      eyebrow="Stays"
      title="Book direct on 30A"
      lede="Hotels and rental properties. Book on the partner site — no native booking, payments, or availability UI here."
    />
    <div class="reserve">
      <label>
        Search stays
        <input type="search" placeholder="Town, sleeps, or partner" />
      </label>
      <p class="note">Search, partner badges, and booking click-outs are reserved slots for the real build.</p>
    </div>
    {
      isEnabled("stays") && (
        <div class="listing-grid-full">
          {stays.map((stay) => (
            <StayCard stay={stay} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .reserve {
    margin-bottom: var(--size-6);
    max-width: 420px;
  }
  label {
    display: grid;
    gap: var(--size-1);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-ink-soft);
  }
  input {
    font: inherit;
    font-size: var(--font-size-1);
    padding: var(--size-2) var(--size-3);
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-2);
  }
  .note {
    font-size: var(--font-size-1);
    color: var(--brand-ink-soft);
  }
</style>
