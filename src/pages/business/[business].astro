---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BusinessCard from "../../components/BusinessCard.astro";
import EntityGallery from "../../components/EntityGallery.astro";
import CommunityQA from "../../components/CommunityQA.astro";
import RelatedGuides from "../../components/RelatedGuides.astro";
import HappeningHere from "../../components/HappeningHere.astro";
import ExploreLinks from "../../components/ExploreLinks.astro";
import {
  areaBySlug,
  businesses,
  events,
  leafBySlug,
  photosFor,
  tagBySlug,
  townBySlug,
  guides,
} from "../../data/catalog";
import type { Business } from "../../data/types";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(businesses, "business");
}

interface Props {
  item: Business;
}

const { item: business } = Astro.props;
const town = townBySlug(business.townSlug);
const area = business.areaSlug ? areaBySlug(business.areaSlug) : undefined;
const leaf = leafBySlug(business.leafSlug);
const businessEvents = events.filter((item) => item.businessSlug === business.slug);
const businessPhotos = photosFor("business", business.slug);
const similar = businesses
  .filter(
    (item) =>
      item.slug !== business.slug &&
      (item.townSlug === business.townSlug || item.leafSlug === business.leafSlug),
  )
  .slice(0, 3);
const relatedGuides = guides
  .filter((item) => item.townSlug === business.townSlug || item.categorySlug === business.categorySlug)
  .concat(guides)
  .filter((item, index, list) => list.findIndex((row) => row.slug === item.slug) === index)
  .slice(0, 3);

const chipTags = business.tagSlugs
  .map((slug) => tagBySlug(slug)?.name ?? slug)
  .concat(leaf?.name ? [leaf.name] : [])
  .slice(0, 6);

const faq = [
  {
    q: "Is there outdoor seating?",
    a: business.tagSlugs.includes("walkable")
      ? "Yes — patio or courtyard seating is part of the local vibe here."
      : "Ask the host on arrival; many 30A spots rotate patio tables seasonally.",
  },
  {
    q: "Any dietary or dairy-free options?",
    a: "Most corridor cafes and kitchens can guide dairy-free and gluten-aware picks — confirm at the counter.",
  },
  {
    q: "Where should I park or bike?",
    a: town
      ? `Use posted ${town.name} lots, or roll up on the Timpoochee Trail when bike racks are available.`
      : "Use posted town lots or the Timpoochee Trail bike racks nearby.",
  },
  {
    q: "How close is the beach?",
    a: "Most 30A outposts sit a short walk or golf-cart hop from a public walkover — check the map pin for the nearest access.",
  },
];
---

<BaseLayout title={business.name} description={business.summary} active="businesses">
  <div class="biz-page">
    <section class="hero">
      <div class="container hero__inner">
        <div class="hero__top">
          <a class="back" href={href("/search")}>← Back to Businesses</a>
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href={href("/")}>Home</a>
            <span>/</span>
            <a href={href("/search")}>Businesses</a>
            {
              town && (
                <>
                  <span>/</span>
                  <a href={href(`/town/${town.slug}`)}>{town.name}</a>
                </>
              )
            }
            <span>/</span>
            <span class="current">{business.name}</span>
          </nav>
        </div>

        <div class="badges">
          {town && <span class="badge">{town.name} 30A Merchant</span>}
          {area && <span class="badge">{area.name}</span>}
          {business.openNow && <span class="badge badge--teal">Open now</span>}
          <span class="badge badge--teal">Verified 30A Merchant</span>
        </div>

        <div class="hero__row">
          <div>
            <h1>{business.name}</h1>
            <p class="place">
              {business.address ?? (town ? `${town.name}, FL` : "Scenic 30A")}
              {area && <> · {area.name}</>}
            </p>
          </div>
          <div class="actions">
            <button class="btn btn--ghost" type="button">Save</button>
            <button class="btn btn--ghost" type="button">Share</button>
          </div>
          
        </div>

        <div class="chips">
          {chipTags.map((label) => (
            <span class="chip">{label}</span>
          ))}
          {business.priceBand && <span class="chip">{business.priceBand}</span>}
        </div>
      </div>
    </section>

    <div class="container layout">
      

      <div class="main">
        <section class="panel">
          <p class="eyebrow">About</p>
          <h2>About {business.name}</h2>
          <p>{business.summary}</p>
        </section>
        <EntityGallery photos={businessPhotos} fallbackName={business.name} />
        <section class="panel">
          <h2>Hours &amp; location</h2>
          <p>{business.address ?? (town ? `${town.name}, FL` : "Scenic 30A")}</p>
          <p class="muted">{business.hours ?? "Hours vary"}</p>
        </section>
        <HappeningHere events={businessEvents} placeName={business.name} townSlug={town?.slug} />
        <CommunityQA
          question={`What should first-timers know before visiting ${business.name}?`}
          answer={faq[0]?.a ?? "Arrive early for peak hours and follow host guidance for carts and seating."}
        />
        <section class="panel faq">
          <h2>Good to know</h2>
          {faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </section>
        <RelatedGuides guides={relatedGuides} />
        <section class="panel">
          <h2>Similar nearby</h2>
          <div class="listing-grid">
            {similar.map((item) => (
              <BusinessCard business={item} />
            ))}
          </div>
        </section>
      </div>

      <aside class="rail">
        
        <div>
          <section class="widget">
            <p class="widget__label">Location</p>
            <div class="map img-placeholder" aria-hidden="true">
              <span class="map__tag">{town?.name ?? "30A"}</span>
            </div>
            <p class="addr">{business.address ?? (town ? `${town.name}, FL` : "Scenic 30A")}</p>
          </section>
          <section class="widget">
            <p class="widget__label">Get directions</p>
            {town && (
              <a class="btn btn--deep" href={href(`/town/${town.slug}`)}>
                Get directions
              </a>
            )}
          </section>
          <ExploreLinks current="businesses" townSlug={town?.slug} />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .biz-page {
    background: var(--brand-sand);
    color: var(--brand-ink);
  }
  .hero {
    background: var(--brand-deep);
    color: white;
    padding: var(--size-6) 0 var(--size-7);
  }
  .hero__inner {
    display: grid;
    gap: var(--size-4);
  }
  .hero__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--size-3);
    align-items: center;
  }
  .back,
  .crumbs a {
    color: #cbd5e1;
    font-size: var(--font-size-1);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    font-size: var(--font-size-0);
    color: #94a3b8;
  }
  .crumbs .current {
    color: white;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0.2rem 0.7rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.06);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-6);
    color: #e2e8f0;
  }
  .badge--teal {
    background: rgba(0, 137, 123, 0.25);
    border-color: rgba(133, 246, 229, 0.35);
    color: #85f6e5;
  }
  .hero__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--size-4);
    align-items: flex-end;
  }
  .hero h1 {
    margin: 0 0 0.4rem;
    font-size: clamp(2rem, 4.5vw, 3rem);
    color: white;
  }
  .place {
    margin: 0;
    color: #cbd5e1;
    font-size: var(--font-size-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-2);
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
  }
  .btn:hover {
    text-decoration: none;
  }
  .btn--teal {
    background: var(--brand-teal);
    color: white;
  }
  .btn--teal:hover {
    background: #00796b;
  }
  .btn--ghost {
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: white;
    background: transparent;
  }
  .btn--ghost:hover {
    background: rgba(255, 255, 255, 0.08);
  }
  .btn--deep {
    width: 100%;
    background: var(--brand-deep);
    color: white;
    margin-top: var(--size-3);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .chip {
    display: inline-flex;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: var(--font-size-0);
    color: #e2e8f0;
  }
  .layout {
    display: grid;
    gap: var(--size-5);
    padding-block: var(--size-6) var(--size-8);
    align-items: start;
  }
  .main {
    display: grid;
    gap: var(--size-4);
    min-width: 0;
  }
  .panel,
  .widget {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-card);
    padding: var(--size-5);
  }
  .panel__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
    margin-bottom: var(--size-3);
  }
  .panel__head h2,
  .panel > h2 {
    margin: 0 0 var(--size-3);
    font-size: var(--font-size-4);
  }
  .panel__head h2 {
    margin-bottom: 0;
  }
  .panel__head a {
    color: var(--brand-teal);
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-6);
  }
  .eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: var(--font-size-0);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .muted {
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
  }
  .highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--size-3);
    margin-top: var(--size-4);
  }
  .highlights .label {
    margin: 0 0 0.2rem;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .highlights p:last-child {
    margin: 0;
    font-size: var(--font-size-1);
    text-transform: capitalize;
  }
  .updates {
    display: grid;
    gap: var(--size-3);
  }
  .update {
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-2);
    padding: var(--size-3);
    background: var(--brand-sand);
  }
  .update__tag {
    margin: 0 0 0.35rem;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    color: var(--brand-teal);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .update h3 {
    margin: 0 0 0.35rem;
    font-size: var(--font-size-2);
  }
  .update p {
    margin: 0;
    font-size: var(--font-size-1);
  }
  .composer {
    display: grid;
    gap: var(--size-3);
    margin-bottom: var(--size-4);
    padding: var(--size-4);
    border-radius: var(--radius-2);
    background: var(--brand-sand);
    border: 1px dashed var(--brand-line);
  }
  .composer__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .composer__tags span {
    font-size: var(--font-size-0);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
    background: white;
    border: 1px solid var(--brand-line);
    color: var(--brand-ink-soft);
  }
  .composer .btn {
    justify-self: start;
  }
  .stack {
    display: grid;
    gap: var(--size-3);
  }
  .faq details {
    border-top: 1px solid var(--brand-line);
    padding: var(--size-3) 0;
  }
  .faq details:first-of-type {
    border-top: 0;
  }
  .faq summary {
    cursor: pointer;
    font-weight: var(--font-weight-6);
  }
  .faq p {
    margin: 0.5rem 0 0;
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
  }
  .rail {
    display: grid;
    gap: var(--size-4);
  }
  .widget__label {
    margin: 0 0 var(--size-3);
    font-family: var(--font-display);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-8);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .map {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-2);
    margin-bottom: var(--size-3);
  }
  .map__tag {
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-pill);
    background: rgba(12, 35, 46, 0.85);
    color: #85f6e5;
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .addr {
    margin: 0 0 0.35rem;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-6);
  }
  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .contact li {
    display: grid;
    gap: 0.15rem;
    font-size: var(--font-size-1);
  }
  .contact span {
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .contact a {
    color: var(--brand-teal);
  }
  .claim {
    background: var(--brand-deep);
    border-color: var(--brand-deep);
    color: white;
  }
  .claim .widget__label {
    color: #94a3b8;
  }
  .claim p {
    margin: 0 0 var(--size-3);
    font-size: var(--font-size-1);
    color: #cbd5e1;
  }
  .similar {
    padding: 0 0 var(--size-10);
  }
  .similar h2 {
    margin: 0 0 var(--size-4);
    font-size: var(--font-size-4);
  }
  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
    .highlights {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
