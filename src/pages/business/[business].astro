---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhotoGrid from "../../components/PhotoGrid.astro";
import EventCard from "../../components/EventCard.astro";
import PostCard from "../../components/PostCard.astro";
import BusinessCard from "../../components/BusinessCard.astro";
import UpdatesModule from "../../components/UpdatesModule.astro";
import { isEnabled } from "../../config/flags";
import {
  areaBySlug,
  businesses,
  events,
  faqsForBusiness,
  leafBySlug,
  photosFor,
  postsFor,
  stayBySlug,
  tagBySlug,
  townBySlug,
  updateSharePath,
  updatesForBusiness,
} from "../../data/catalog";
import type { Business } from "../../data/types";
import SaveShare from "../../components/islands/SaveShare.svelte";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(businesses, "business");
}

interface Props {
  item: Business;
}

const { item: business } = Astro.props;
const town = townBySlug(business.townSlug);
const area = business.areaSlug ? areaBySlug(business.areaSlug) : undefined;
const leaf = leafBySlug(business.leafSlug);
const stay = stayBySlug(business.slug);
const businessEvents = events.filter((item) => item.businessSlug === business.slug);
const businessPosts = postsFor("business", business.slug);
const businessPhotos = photosFor("business", business.slug);
const businessUpdates = updatesForBusiness(business.slug);
const similar = businesses
  .filter(
    (item) =>
      item.slug !== business.slug &&
      (item.townSlug === business.townSlug || item.leafSlug === business.leafSlug),
  )
  .slice(0, 3);

const chipTags = business.tagSlugs
  .map((slug) => tagBySlug(slug)?.name ?? slug)
  .concat(leaf?.name ? [leaf.name] : [])
  .slice(0, 6);

const highlights = [
  { label: leaf?.name ?? "Local Spot", detail: business.categorySlug.replace(/-/g, " ") },
  { label: business.openNow ? "Open now" : "See hours", detail: business.hours ?? "Hours vary" },
  { label: "Town core", detail: town?.name ?? "30A" },
  { label: business.priceBand ?? "Local", detail: area?.name ?? "Scenic 30A" },
];

const faq = faqsForBusiness(business);
const claimed = Boolean(business.ownerUserSlug);
---

<BaseLayout title={business.name} description={business.summary} active="businesses">
  <div class="biz-page">
    <section class="hero">
      <div class="container hero__inner">
        <div class="hero__top">
          <a class="back" href={href("/search")}>← Back to Businesses</a>
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href={href("/")}>Home</a>
            <span>/</span>
            <a href={href("/search")}>Businesses</a>
            {
              town && (
                <>
                  <span>/</span>
                  <a href={href(`/town/${town.slug}`)}>{town.name}</a>
                </>
              )
            }
            <span>/</span>
            <span class="current">{business.name}</span>
          </nav>
        </div>

        <div class="badges">
          {town && <span class="badge">{town.name} 30A Merchant</span>}
          {area && <span class="badge">{area.name}</span>}
          {business.openNow && <span class="badge badge--teal">Open now</span>}
          {claimed && <span class="badge badge--teal">Verified owner</span>}
        </div>

        <div class="hero__row">
          <div>
            <h1>{business.name}</h1>
            <p class="place">
              {business.address ?? (town ? `${town.name}, FL` : "Scenic 30A")}
              {area && <> · {area.name}</>}
            </p>
          </div>
          <div class="actions">
            <SaveShare type="business" slug={business.slug} name={business.name} href={href(`/business/${business.slug}`)} client:load />
            {
              business.phone && (
                <a class="btn btn--ghost" href={`tel:${business.phone.replace(/[^\d+]/g, "")}`}>
                  Call {business.phone}
                </a>
              )
            }
            {
              business.website ? (
                <a class="btn btn--teal" href={business.website} target="_blank" rel="noopener noreferrer">
                  Visit Official Website →
                </a>
              ) : !claimed ? (
                <a class="btn btn--teal" href={href("/dashboard")}>Claim this listing →</a>
              ) : null}
            }
          </div>
        </div>

        <div class="chips">
          {chipTags.map((label) => (
            <span class="chip">{label}</span>
          ))}
          {business.priceBand && <span class="chip">{business.priceBand}</span>}
        </div>
      </div>
    </section>

    <div class="container layout">
      <div class="main">
        <section class="panel">
          <p class="eyebrow">Insider Profile · Curated by 30A Editorial</p>
          <h2>About {business.name}</h2>
          <p>{business.summary}</p>
          <p>
            A locally rooted stop on Scenic 30A
            {town && <> in {town.name}</>}
            {leaf && <> for {leaf.name.toLowerCase()}</>}. Arrive early for peak hours, check today’s beach flag if you’re
            pairing the visit with Gulf time, and follow host guidance for carts and seating.
          </p>
          <div class="highlights">
            {highlights.map((item) => (
              <div>
                <p class="label">{item.label}</p>
                <p>{item.detail}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="panel">
          <div class="panel__head">
            <h2>Official Photo Gallery</h2>
            <span class="muted">{businessPhotos.length || 4} photos</span>
          </div>
          <p class="muted">Authentic atmosphere from the corridor outpost.</p>
          <PhotoGrid
            photos={businessPhotos}
            empty={`Photos for ${business.name} will appear here.`}
          />
        </section>

        {
          isEnabled("updates") && (
            <UpdatesModule
              entityKind="business"
              entityName={business.name}
              updates={businessUpdates}
              ctaHref={updateSharePath("business", business.slug)}
            />
          )
        }

        {
          businessEvents.length > 0 && (
            <section class="panel">
              <div class="panel__head">
                <h2>Events at {business.name}</h2>
                {town && <a href={href(`/events?town=${town.slug}`)}>See all in {town.name} →</a>}
              </div>
              <div class="listing-grid">
                {businessEvents.map((event) => (
                  <EventCard event={event} />
                ))}
              </div>
            </section>
          )
        }

        {
          isEnabled("communityFeed") && (
            <section class="panel">
              <h2>Community Feedback &amp; Tips</h2>
              <div class="composer">
                <p class="muted">Share a tip, photo vibe, or local favorite for visitors.</p>
                <div class="composer__tags">
                  <span>Coffee Review</span>
                  <span>Photo Vibe</span>
                  <span>Meeting Tip</span>
                  <span>Local Favorite</span>
                </div>
                <a class="btn btn--teal" href={href("/dashboard")}>Post to Feed</a>
              </div>
              {businessPosts.length === 0 ? (
                <p class="muted">Visitor posts about {business.name} will appear here.</p>
              ) : (
                <div class="stack">
                  {businessPosts.map((post) => (
                    <PostCard post={post} />
                  ))}
                </div>
              )}
            </section>
          )
        }

        <section class="panel faq">
          <h2>Curated Knowledge Bank</h2>
          {faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </section>
      </div>

      <aside class="rail">
        <section class="widget">
          <p class="widget__label">Location &amp; Access</p>
          <div class="map img-placeholder" aria-hidden="true">
            <span class="map__tag">{town?.name ?? "30A"}</span>
          </div>
          <p class="addr">{business.address ?? (town ? `${town.name}, FL` : "Scenic 30A")}</p>
          {business.hours && <p class="muted">Hours · {business.hours}</p>}
          {area && <p class="muted">Neighborhood · {area.name}</p>}
          {
            town && (
              <a class="btn btn--deep" href={href(`/town/${town.slug}`)}>
                Get Turn-By-Turn Directions
              </a>
            )
          }
        </section>

        <section class="widget">
          <p class="widget__label">Direct Contact</p>
          <ul class="contact">
            {business.phone && (
              <li>
                <span>Phone</span>
                <a href={`tel:${business.phone.replace(/[^\d+]/g, "")}`}>{business.phone}</a>
              </li>
            )}
            {business.website && (
              <li>
                <span>Website</span>
                <a href={business.website} target="_blank" rel="noopener noreferrer">
                  Visit official site →
                </a>
              </li>
            )}
            {business.address && (
              <li>
                <span>Address</span>
                <a href={`https://maps.google.com/?q=${encodeURIComponent(business.address)}`}>
                  Open in Maps
                </a>
              </li>
            )}
            {stay && (
              <li>
                <span>Stay</span>
                <a href={href(`/stay/${stay.slug}`)}>{stay.name}</a>
              </li>
            )}
          </ul>
        </section>

        {
          !claimed && (
            <section class="widget claim">
              <p class="widget__label">Business Owner or GM?</p>
              <p>Claim this listing to post updates, events, and verified hours.</p>
              <a class="btn btn--teal" href={href("/dashboard")}>Claim this listing</a>
            </section>
          )
        }
      </aside>
    </div>

    {
      similar.length > 0 && (
        <section class="similar">
          <div class="container">
            <h2>Similar Nearby Places</h2>
            <div class="listing-grid">
              {similar.map((item) => (
                <BusinessCard business={item} />
              ))}
            </div>
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .biz-page {
    background: var(--brand-sand);
    color: var(--brand-ink);
  }
  .hero {
    background: var(--brand-deep);
    color: white;
    padding: var(--size-6) 0 var(--size-7);
  }
  .hero__inner {
    display: grid;
    gap: var(--size-4);
  }
  .hero__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--size-3);
    align-items: center;
  }
  .back,
  .crumbs a {
    color: #cbd5e1;
    font-size: var(--font-size-1);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    font-size: var(--font-size-0);
    color: #94a3b8;
  }
  .crumbs .current {
    color: white;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0.2rem 0.7rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.06);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-6);
    color: #e2e8f0;
  }
  .badge--teal {
    background: rgba(0, 137, 123, 0.25);
    border-color: rgba(133, 246, 229, 0.35);
    color: #85f6e5;
  }
  .hero__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--size-4);
    align-items: flex-end;
  }
  .hero h1 {
    margin: 0 0 0.4rem;
    font-size: clamp(2rem, 4.5vw, 3rem);
    color: white;
  }
  .place {
    margin: 0;
    color: #cbd5e1;
    font-size: var(--font-size-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-2);
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-7);
  }
  .btn:hover {
    text-decoration: none;
  }
  .btn--teal {
    background: var(--brand-teal);
    color: white;
  }
  .btn--teal:hover {
    background: #00796b;
  }
  .btn--ghost {
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: white;
    background: transparent;
  }
  .btn--ghost:hover {
    background: rgba(255, 255, 255, 0.08);
  }
  .btn--deep {
    width: 100%;
    background: var(--brand-deep);
    color: white;
    margin-top: var(--size-3);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .chip {
    display: inline-flex;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: var(--font-size-0);
    color: #e2e8f0;
  }
  .layout {
    display: grid;
    gap: var(--size-5);
    padding-block: var(--size-6) var(--size-8);
    align-items: start;
  }
  .main {
    display: grid;
    gap: var(--size-4);
    min-width: 0;
  }
  .panel,
  .widget {
    background: white;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-card);
    padding: var(--size-5);
  }
  .panel__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
    margin-bottom: var(--size-3);
  }
  .panel__head h2,
  .panel > h2 {
    margin: 0 0 var(--size-3);
    font-size: var(--font-size-4);
  }
  .panel__head h2 {
    margin-bottom: 0;
  }
  .panel__head a {
    color: var(--brand-teal);
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-6);
  }
  .eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: var(--font-size-0);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .muted {
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
  }
  .highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--size-3);
    margin-top: var(--size-4);
  }
  .highlights .label {
    margin: 0 0 0.2rem;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .highlights p:last-child {
    margin: 0;
    font-size: var(--font-size-1);
    text-transform: capitalize;
  }
  .composer {
    display: grid;
    gap: var(--size-3);
    margin-bottom: var(--size-4);
    padding: var(--size-4);
    border-radius: var(--radius-2);
    background: var(--brand-sand);
    border: 1px dashed var(--brand-line);
  }
  .composer__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .composer__tags span {
    font-size: var(--font-size-0);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
    background: white;
    border: 1px solid var(--brand-line);
    color: var(--brand-ink-soft);
  }
  .composer .btn {
    justify-self: start;
  }
  .stack {
    display: grid;
    gap: var(--size-3);
  }
  .faq details {
    border-top: 1px solid var(--brand-line);
    padding: var(--size-3) 0;
  }
  .faq details:first-of-type {
    border-top: 0;
  }
  .faq summary {
    cursor: pointer;
    font-weight: var(--font-weight-6);
  }
  .faq p {
    margin: 0.5rem 0 0;
    color: var(--brand-ink-soft);
    font-size: var(--font-size-1);
  }
  .rail {
    display: grid;
    gap: var(--size-4);
  }
  .widget__label {
    margin: 0 0 var(--size-3);
    font-family: var(--font-display);
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-8);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .map {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-2);
    margin-bottom: var(--size-3);
  }
  .map__tag {
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-pill);
    background: rgba(12, 35, 46, 0.85);
    color: #85f6e5;
    font-size: 0.625rem;
    font-weight: var(--font-weight-8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .addr {
    margin: 0 0 0.35rem;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-6);
  }
  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .contact li {
    display: grid;
    gap: 0.15rem;
    font-size: var(--font-size-1);
  }
  .contact span {
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-7);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-ink-soft);
  }
  .contact a {
    color: var(--brand-teal);
  }
  .claim {
    background: var(--brand-deep);
    border-color: var(--brand-deep);
    color: white;
  }
  .claim .widget__label {
    color: #94a3b8;
  }
  .claim p {
    margin: 0 0 var(--size-3);
    font-size: var(--font-size-1);
    color: #cbd5e1;
  }
  .similar {
    padding: 0 0 var(--size-10);
  }
  .similar h2 {
    margin: 0 0 var(--size-4);
    font-size: var(--font-size-4);
  }
  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
    .highlights {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
