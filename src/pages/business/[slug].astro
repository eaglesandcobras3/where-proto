---
import Layout from "../../layouts/Layout.astro";
import LinkList from "../../components/LinkList.astro";
import {
  areaBySlug,
  businesses,
  events,
  photos,
  postsFor,
  townBySlug,
  userBySlug,
} from "../../data/catalog";
import type { Business } from "../../data/types";
import { href } from "../../lib/href";
import { slugPaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return slugPaths(businesses);
}

interface Props {
  item: Business;
}

const { item: business } = Astro.props;

const town = townBySlug(business.townSlug);
const area = business.areaSlug ? areaBySlug(business.areaSlug) : undefined;
const owner = business.ownerUserSlug ? userBySlug(business.ownerUserSlug) : undefined;
const businessEvents = events.filter((item) => item.businessSlug === business.slug);
const businessPosts = postsFor("business", business.slug);
const businessPhotos = photos.filter(
  (item) => item.attachedTo.type === "business" && item.attachedTo.slug === business.slug,
);
---

<Layout
  title={business.name}
  note="Posting to the feed as a user happens on this business page. Posting as the business happens from business management. How to post as business vs user is still an open question."
>
  <p><a href={href("/businesses")}>Businesses</a></p>
  <h1>Business page: {business.name}</h1>
  <p>{business.summary}</p>
  <ul>
    {
      town && (
        <li>
          Town: <a href={href(`/towns/${town.slug}`)}>{town.name}</a>
        </li>
      )
    }
    {
      area && (
        <li>
          Area: <a href={href(`/areas/${area.slug}`)}>{area.name}</a>
        </li>
      )
    }
    <li>
      Category:
      <a href={href(`/categories/${business.categorySlug}`)}>{business.categorySlug}</a>
      /
      <a href={href(`/categories/${business.categorySlug}/${business.leafSlug}`)}>
        {business.leafSlug}
      </a>
    </li>
    {
      business.isStay && (
        <li>
          Stay listing: <a href={href(`/stay/${business.slug}`)}>{business.name}</a>
        </li>
      )
    }
    {
      owner && (
        <li>
          Owner (external profile still undefined):{" "}
          <a href={href(`/u/${owner.slug}`)}>{owner.name}</a>
        </li>
      )
    }
  </ul>

  <h2>Photos</h2>
  <ul>
    {businessPhotos.map((photo) => (
      <li>{photo.caption}</li>
    ))}
  </ul>

  <h2>Events</h2>
  <LinkList
    items={businessEvents.map((item) => ({
      href: href(`/events/${item.slug}`),
      label: item.name,
      meta: item.when,
    }))}
  />

  <h2>Feed posts</h2>
  <ul>
    {
      businessPosts.map((post) => (
        <li>
          <a href={href(`/posts/${post.slug}`)}>{post.body}</a> — posted as {post.postedAs}
        </li>
      ))
    }
  </ul>

  <h2>Post to this business feed (as user)</h2>
  <p>Wireframe form. Submit does nothing.</p>
  <form>
    <label>
      Post
      <input type="text" name="body" />
    </label>
    <button type="button">Post as user</button>
  </form>

  {
    owner && (
      <p>
        Manage this business:{" "}
        <a href={href(`/manage/${business.slug}`)}>Business management</a>
      </p>
    )
  }
</Layout>
